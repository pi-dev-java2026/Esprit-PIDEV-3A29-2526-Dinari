{% extends 'admin/layout.html.twig' %}
{% block title %}Admin — Modes de paiement{% endblock %}
{% block topbar_title %}Modes de paiement{% endblock %}
{% block topbar_sub %}Gestion des modes de paiement{% endblock %}

{% block stylesheets %}
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style>
.main-content, .main-content * { font-family: 'Poppins', sans-serif; }

/* ── Page Header ── */
.ph-wrap {
    display: flex; align-items: flex-start; justify-content: space-between;
    margin-bottom: 28px; flex-wrap: wrap; gap: 14px;
}
.ph-left h1 {
    font-size: 22px; font-weight: 700; color: #1e293b; margin: 0 0 4px;
    display: flex; align-items: center; gap: 10px;
}
.ph-left h1 .ph-icon {
    width: 38px; height: 38px; border-radius: 10px;
    background: linear-gradient(135deg, #1a6fc4, #2563eb);
    display: flex; align-items: center; justify-content: center;
    color: #fff; font-size: 17px; flex-shrink: 0;
    box-shadow: 0 4px 12px rgba(26,111,196,0.35);
}
.ph-breadcrumb { font-size: 12px; color: #94a3b8; }
.ph-breadcrumb a { color: #1a6fc4; text-decoration: none; font-weight: 500; }
.ph-breadcrumb a:hover { text-decoration: underline; }

/* ── Premium Button ── */
.btn-premium {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 10px 22px;
    background: linear-gradient(135deg, #1a6fc4 0%, #2563eb 100%);
    color: #fff; border-radius: 10px; font-size: 13px; font-weight: 600;
    text-decoration: none; border: none; cursor: pointer;
    box-shadow: 0 4px 14px rgba(26,111,196,0.35);
    transition: all 0.25s ease; font-family: 'Poppins', sans-serif;
}
.btn-premium:hover {
    background: linear-gradient(135deg, #1558a0 0%, #1d4ed8 100%);
    color: #fff; text-decoration: none;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(26,111,196,0.45);
}
.btn-premium i { font-size: 15px; }
.btn-back-dep {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 10px 18px; border-radius: 10px;
    background: #f8fafc; color: #1a6fc4;
    border: 1.5px solid rgba(26,111,196,0.3);
    font-size: 13px; font-weight: 600;
    text-decoration: none; transition: all 0.22s ease;
    font-family: 'Poppins', sans-serif;
}
.btn-back-dep:hover {
    background: linear-gradient(135deg, #1a6fc4 0%, #2563eb 100%);
    color: #fff; border-color: transparent;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(26,111,196,0.35);
    text-decoration: none;
}
.btn-back-dep i { font-size: 14px; }

/* ── Glassmorphism Card ── */
.glass-card {
    background: rgba(255,255,255,0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,0.6);
    border-radius: 16px;
    box-shadow: 0 4px 24px rgba(30,41,59,0.08), 0 1px 4px rgba(30,41,59,0.04);
    overflow: hidden;
    transition: box-shadow 0.25s;
    animation: fadeInUp 0.35s ease both;
}
.glass-card:hover {
    box-shadow: 0 8px 32px rgba(30,41,59,0.12), 0 2px 8px rgba(30,41,59,0.06);
}

/* ── Card Header ── */
.gc-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 18px 24px;
    background: linear-gradient(135deg, rgba(26,111,196,0.04) 0%, rgba(37,99,235,0.02) 100%);
    border-bottom: 1px solid rgba(226,232,240,0.8);
}
.gc-title {
    font-size: 14px; font-weight: 700; color: #1e293b;
    display: flex; align-items: center; gap: 8px;
}
.gc-title i { color: #1a6fc4; font-size: 17px; }
.gc-count {
    display: inline-flex; align-items: center;
    padding: 3px 10px; border-radius: 20px;
    background: rgba(26,111,196,0.1); color: #1a6fc4;
    font-size: 11px; font-weight: 700; margin-left: 6px;
}

/* ── Modern Table ── */
.tbl-modern { width: 100%; border-collapse: collapse; }
.tbl-modern thead th {
    padding: 12px 20px;
    font-size: 10px; font-weight: 700; letter-spacing: 1.2px;
    text-transform: uppercase; color: #94a3b8;
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    white-space: nowrap;
}
.tbl-modern tbody tr {
    border-bottom: 1px solid #f1f5f9;
    transition: background 0.18s;
}
.tbl-modern tbody tr:last-child { border-bottom: none; }
.tbl-modern tbody tr:hover {
    background: linear-gradient(90deg, rgba(26,111,196,0.03) 0%, rgba(37,99,235,0.015) 100%);
}
.tbl-modern tbody td {
    padding: 14px 20px; font-size: 13px; color: #334155;
    vertical-align: middle;
}

/* ── ID Cell ── */
.id-cell { font-size: 11px; font-weight: 600; color: #94a3b8; }

/* ── Payment Method Cell ── */
.pm-cell { display: flex; align-items: center; gap: 12px; }
.pm-icon-wrap {
    width: 36px; height: 36px; border-radius: 10px;
    background: linear-gradient(135deg, rgba(26,111,196,0.1), rgba(37,99,235,0.06));
    border: 1px solid rgba(26,111,196,0.15);
    display: flex; align-items: center; justify-content: center;
    color: #1a6fc4; font-size: 15px; flex-shrink: 0;
    transition: all 0.2s;
}
.tbl-modern tbody tr:hover .pm-icon-wrap {
    background: linear-gradient(135deg, #1a6fc4, #2563eb);
    color: #fff; border-color: transparent;
    box-shadow: 0 3px 10px rgba(26,111,196,0.3);
}
.pm-label { font-weight: 600; color: #1e293b; font-size: 13px; }

/* ── Count Badge ── */
.count-badge {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 4px 11px; border-radius: 20px;
    font-size: 11px; font-weight: 600;
    background: #f1f5f9; color: #64748b;
    transition: all 0.2s;
}
.count-badge.active { background: rgba(26,111,196,0.1); color: #1a6fc4; }
.count-badge i { font-size: 11px; }

/* ── Action Buttons ── */
.actions-cell { display: flex; gap: 6px; align-items: center; }
.btn-act {
    display: inline-flex; align-items: center; justify-content: center;
    width: 32px; height: 32px; border-radius: 8px;
    font-size: 14px; text-decoration: none;
    border: none; cursor: pointer;
    transition: all 0.2s ease;
}
.btn-act-edit {
    background: rgba(26,111,196,0.08); color: #1a6fc4;
    border: 1px solid rgba(26,111,196,0.15);
}
.btn-act-edit:hover {
    background: linear-gradient(135deg, #1a6fc4, #2563eb);
    color: #fff; border-color: transparent;
    transform: translateY(-1px);
    box-shadow: 0 4px 10px rgba(26,111,196,0.3);
}
.btn-act-delete {
    background: rgba(239,68,68,0.08); color: #ef4444;
    border: 1px solid rgba(239,68,68,0.15);
}
.btn-act-delete:hover {
    background: linear-gradient(135deg, #ef4444, #dc2626);
    color: #fff; border-color: transparent;
    transform: translateY(-1px);
    box-shadow: 0 4px 10px rgba(239,68,68,0.3);
}
.btn-act-delete:disabled {
    opacity: 0.35; cursor: not-allowed;
    transform: none; box-shadow: none;
}

/* ── Empty State ── */
.empty-state-p {
    text-align: center; padding: 64px 24px; color: #94a3b8;
}
.empty-state-p .es-icon {
    width: 64px; height: 64px; border-radius: 16px;
    background: rgba(26,111,196,0.06);
    display: flex; align-items: center; justify-content: center;
    font-size: 28px; color: #1a6fc4; margin: 0 auto 16px;
}
.empty-state-p p { font-size: 14px; font-weight: 500; margin: 0; }

@keyframes fadeInUp {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
}
</style>
{% endblock %}

{% block body %}

<div class="ph-wrap">
    <div class="ph-left">
        <h1>
            <span class="ph-icon"><i class="ri-bank-card-line"></i></span>
            Modes de paiement
        </h1>
        <div class="ph-breadcrumb">
            <a href="{{ path('admin_index') }}">Dashboard</a>
            <span style="margin:0 5px;color:#cbd5e1;">›</span>
            <a href="{{ path('admin_depenses_dashboard') }}">Dépenses</a>
            <span style="margin:0 5px;color:#cbd5e1;">›</span>
            Modes de paiement
        </div>
    </div>
    <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
        <a href="{{ path('admin_depenses_dashboard') }}" class="btn-back-dep">
            <i class="ri-arrow-left-line"></i> Retour aux Dépenses
        </a>
        <a href="{{ path('admin_mode_paiement_new') }}" class="btn-premium">
            <i class="ri-add-line"></i> Nouveau mode
        </a>
    </div>
</div>

<div class="glass-card">
    <div class="gc-header">
        <span class="gc-title">
            <i class="ri-list-check-2"></i>
            Liste des modes de paiement
            <span class="gc-count">{{ data|length }}</span>
        </span>
    </div>

    {% if data is empty %}
        <div class="empty-state-p">
            <div class="es-icon"><i class="ri-bank-card-line"></i></div>
            <p>Aucun mode de paiement enregistré.</p>
        </div>
    {% else %}
        <table class="tbl-modern">
            <thead>
                <tr>
                    <th style="width:60px;">#</th>
                    <th>Mode de paiement</th>
                    <th>Dépenses liées</th>
                    <th style="width:100px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for item in data %}
                <tr>
                    <td><span class="id-cell">{{ item.mode.id }}</span></td>
                    <td>
                        <div class="pm-cell">
                            <div class="pm-icon-wrap">
                                {% if 'carte' in item.mode.label|lower %}
                                    <i class="ri-bank-card-line"></i>
                                {% elseif 'virement' in item.mode.label|lower %}
                                    <i class="ri-exchange-line"></i>
                                {% elseif 'espèce' in item.mode.label|lower or 'cash' in item.mode.label|lower %}
                                    <i class="ri-money-dollar-circle-line"></i>
                                {% elseif 'chèque' in item.mode.label|lower or 'cheque' in item.mode.label|lower %}
                                    <i class="ri-file-text-line"></i>
                                {% else %}
                                    <i class="ri-secure-payment-line"></i>
                                {% endif %}
                            </div>
                            <span class="pm-label">{{ item.mode.label }}</span>
                        </div>
                    </td>
                    <td>
                        <span class="count-badge {{ item.nbDepenses > 0 ? 'active' : '' }}">
                            <i class="ri-shopping-cart-line"></i>
                            {{ item.nbDepenses }} dépense{{ item.nbDepenses > 1 ? 's' : '' }}
                        </span>
                    </td>
                    <td>
                        <div class="actions-cell">
                            <a href="{{ path('admin_mode_paiement_edit', {id: item.mode.id}) }}"
                               class="btn-act btn-act-edit" title="Modifier">
                                <i class="ri-pencil-line"></i>
                            </a>
                            <form method="post" action="{{ path('admin_mode_paiement_delete', {id: item.mode.id}) }}"
                                  onsubmit="return confirm('Supprimer « {{ item.mode.label }} » ?');"
                                  style="display:inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_mode' ~ item.mode.id) }}">
                                <button type="submit" class="btn-act btn-act-delete"
                                        {{ item.nbDepenses > 0 ? 'disabled' : '' }}
                                        title="{{ item.nbDepenses > 0 ? 'Impossible : dépenses liées' : 'Supprimer' }}">
                                    <i class="ri-delete-bin-line"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
</div>

{% endblock %}
