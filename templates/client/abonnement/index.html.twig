<script>
/* ── Smooth scroll CTA avec animation "drop" ── */
function smoothScrollPacks(e) {
  e.preventDefault();
  const target = document.getElementById('nos-packs');
  if (!target) return;

  const start  = window.pageYOffset;
  const end    = target.getBoundingClientRect().top + start - 60;
  const dist   = end - start;
  const dur    = 900;
  let startTime = null;

  function easeInOutCubic(t) {
    return t < .5 ? 4*t*t*t : 1 - Math.pow(-2*t+2,3)/2;
  }
  function step(ts) {
    if (!startTime) startTime = ts;
    const elapsed = ts - startTime;
    const progress = Math.min(elapsed / dur, 1);
    window.scrollTo(0, start + dist * easeInOutCubic(progress));
    if (progress < 1) requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
}

/* ── Band slider ── */
const BAND_SLIDES = [
  [
    {icon:'🌐', text:'Un accès illimité à vos services préférés, sans interruption publicitaire'},
    {icon:'📱', text:'Des abonnements adaptés à tous vos écrans, mobiles et tablettes compris'},
    {icon:'🔍', text:'Une visibilité claire sur vos dépenses mensuelles et vos renouvellements'},
    {icon:'📈', text:'Développer votre expérience numérique et améliorer votre productivité'},
  ],
  [
    {icon:'🎬', text:'Accédez à des milliers de films, séries et podcasts en illimité'},
    {icon:'🎮', text:'Des offres gaming pour tous les profils, solo ou en famille'},
    {icon:'📚', text:'Des abonnements éducatifs pour apprendre à votre rythme'},
    {icon:'🔒', text:'Votre sécurité en ligne garantie avec les meilleurs outils VPN'},
  ],
  [
    {icon:'💡', text:'Des recommandations personnalisées selon vos usages et préférences'},
    {icon:'🤝', text:'Un service client réactif disponible 7j/7 pour vous accompagner'},
    {icon:'💰', text:'Des tarifs négociés exclusivement pour les utilisateurs Dinari'},
    {icon:'⭐', text:'Des avis vérifiés et des offres sélectionnées avec soin'},
  ]
];
let currentSlide = 0;

function renderBandSlide(idx) {
  const track = document.getElementById('band-track');
  const items = BAND_SLIDES[idx];
  track.style.opacity = '0';
  setTimeout(() => {
    track.innerHTML = items.map((item, i) => `
      <div class="band-item" style="animation-delay:${i * 0.08}s">
        <div class="band-icon">${item.icon}</div>
        <p>${item.text}</p>
      </div>
    `).join('');
    track.style.opacity = '1';
    track.style.transition = 'opacity .35s ease';
  }, 200);

  document.querySelectorAll('.band-dot').forEach((d, i) => {
    d.classList.toggle('active', i === idx);
  });
}

function slideband(dir) {
  currentSlide = (currentSlide + dir + BAND_SLIDES.length) % BAND_SLIDES.length;
  renderBandSlide(currentSlide);
}
function gotoBandSlide(idx) {
  currentSlide = idx;
  renderBandSlide(currentSlide);
}

/* Auto-slide toutes les 5s */
setInterval(() => slideband(1), 5000);

/* ── Filtres ── */
let currentCategory = 'all';
let currentSearch   = '';

function filterCat(cat, btn) {
  currentCategory = cat;
  document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  applyFilters();
}
function filterServices() {
  currentSearch = document.getElementById('search-input').value.toLowerCase();
  applyFilters();
}
function applyFilters() {
  document.querySelectorAll('.svc-card').forEach(card => {
    const matchCat    = currentCategory === 'all' || card.dataset.cat === currentCategory;
    const matchSearch = (card.dataset.service || '').includes(currentSearch);
    card.style.display = (matchCat && matchSearch) ? '' : 'none';
  });
}

/* ── Carousel Testimonials ── */
let currentTestimonialIndex = 0;
let totalTestimonials = 0;
let autoSlideInterval = null;

function initCarousel() {
  const cards = document.querySelectorAll('.testimonial-card-carousel');
  if (!cards || cards.length === 0) return;
  
  totalTestimonials = cards.length;
  showCard(0);
  startAutoSlide();
  
  // Setup hover pause
  const carousel = document.querySelector('.testimonials-carousel');
  if (carousel) {
    carousel.addEventListener('mouseenter', stopAutoSlide);
    carousel.addEventListener('mouseleave', startAutoSlide);
  }
}

function showCard(index) {
  const cards = document.querySelectorAll('.testimonial-card-carousel');
  const dots = document.querySelectorAll('.carousel-dot');
  
  if (!cards || cards.length === 0) return;
  
  // Ensure index is valid
  index = Math.max(0, Math.min(index, cards.length - 1));
  currentTestimonialIndex = index;
  
  // Hide all cards, show only current, reset flip
  cards.forEach((card, i) => {
    if (i === index) {
      card.style.opacity = '1';
      card.style.pointerEvents = 'auto';
      card.style.visibility = 'visible';
      card.classList.remove('flipped'); // Reset flip on slide change
    } else {
      card.style.opacity = '0';
      card.style.pointerEvents = 'none';
      card.style.visibility = 'hidden';
    }
  });
  
  // Update dots
  dots.forEach((dot, i) => {
    dot.classList.toggle('active', i === index);
  });
}

function nextTestimonial() {
  if (totalTestimonials === 0) return;
  currentTestimonialIndex = (currentTestimonialIndex + 1) % totalTestimonials;
  showCard(currentTestimonialIndex);
}

function prevTestimonial() {
  if (totalTestimonials === 0) return;
  currentTestimonialIndex = (currentTestimonialIndex - 1 + totalTestimonials) % totalTestimonials;
  showCard(currentTestimonialIndex);
}

function goToTestimonial(index) {
  if (totalTestimonials === 0) return;
  showCard(index);
}

function toggleCardFlip() {
  const cards = document.querySelectorAll('.testimonial-card-carousel');
  if (cards[currentTestimonialIndex]) {
    cards[currentTestimonialIndex].classList.toggle('flipped');
  }
}

function startAutoSlide() {
  if (autoSlideInterval) clearInterval(autoSlideInterval);
  autoSlideInterval = setInterval(() => nextTestimonial(), 6000);
}

function stopAutoSlide() {
  if (autoSlideInterval) clearInterval(autoSlideInterval);
}

// Initialiser au chargement du DOM
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initCarousel);
} else {
  setTimeout(initCarousel, 10);
}

// Flip card on click
document.addEventListener('click', function(e) {
  const card = e.target.closest('.testimonial-card-carousel');
  if (card) {
    // Only flip if clicking on the current card
    const currentCard = document.querySelectorAll('.testimonial-card-carousel')[currentTestimonialIndex];
    if (card === currentCard) {
      toggleCardFlip();
    }
  }
});

/* ── Scroll reveal ── */
const revealObserver = new IntersectionObserver((entries) => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      e.target.classList.add('visible');
      revealObserver.unobserve(e.target);
    }
  });
}, { threshold: 0.12 });
document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));
</script>
<!-- Widget Chatbot -->
<!-- Widget Chatbot avec Micro et Réponse Vocale -->
<!-- Widget Chatbot avec Micro et Contrôle Vocal -->
<div id="chatbot-widget" style="position:fixed; bottom:20px; right:20px; z-index:9999;">
    
    <button id="chatbot-toggle" style="
        background:#4f46e5; color:white; border:none; border-radius:50px;
        padding:12px 20px; cursor:pointer; font-size:16px; box-shadow:0 4px 15px rgba(0,0,0,0.2);">
        💬 Assistant
    </button>

    <div id="chatbot-box" style="
        display:none; flex-direction:column;
        width:380px; height:550px; background:white;
        border-radius:16px; box-shadow:0 8px 30px rgba(0,0,0,0.15);
        margin-bottom:10px; overflow:hidden;">
        
        <div style="background:#4f46e5; color:white; padding:15px; display:flex; justify-content:space-between; align-items:center;">
            <span>🤖 Assistant Dinari</span>
            <div style="display:flex; gap:8px;">
                <button id="chatbot-voice-btn" style="background:rgba(255,255,255,0.2); border:none; color:white; cursor:pointer; font-size:16px; border-radius:50%; width:32px; height:32px;" title="Parler">🎤</button>
                <button id="chatbot-speaker-btn" style="background:rgba(255,255,255,0.2); border:none; color:white; cursor:pointer; font-size:16px; border-radius:50%; width:32px; height:32px;" title="Désactiver la voix">🔊</button>
                <button id="chatbot-close" style="background:none; border:none; color:white; cursor:pointer; font-size:20px;">✕</button>
            </div>
        </div>

        <div id="chatbot-messages" style="flex:1; overflow-y:auto; padding:15px; display:flex; flex-direction:column; gap:10px;">
            <div style="background:#f3f4f6; padding:10px; border-radius:10px; font-size:14px;">
                Bonjour ! Je suis l'assistant Dinari. Comment puis-je vous aider ?<br>
                <small style="color:#666;">🎤 Cliquez sur le micro pour parler | 🔊 Cliquez pour couper la voix</small>
            </div>
        </div>

        <div style="padding:10px; border-top:1px solid #e5e7eb; display:flex; gap:8px;">
            <input type="text" id="chatbot-input" placeholder="Votre question ou cliquez sur le micro..."
                style="flex:1; padding:8px 12px; border:1px solid #e5e7eb; border-radius:20px; outline:none; font-size:14px;" />
            <button id="chatbot-send" style="
                background:#4f46e5; color:white; border:none;
                border-radius:50%; width:36px; height:36px; cursor:pointer; font-size:16px;">
                ➤
            </button>
        </div>
        
        <div id="voice-status" style="padding:5px 15px; font-size:11px; color:#666; text-align:center; display:none;">
            🎤 Écoute en cours...
        </div>
    </div>

    <script>
    // Éléments DOM
    const toggle   = document.getElementById('chatbot-toggle');
    const box      = document.getElementById('chatbot-box');
    const closeBtn = document.getElementById('chatbot-close');
    const input    = document.getElementById('chatbot-input');
    const sendBtn  = document.getElementById('chatbot-send');
    const messages = document.getElementById('chatbot-messages');
    const voiceBtn = document.getElementById('chatbot-voice-btn');
    const speakerBtn = document.getElementById('chatbot-speaker-btn');
    const voiceStatus = document.getElementById('voice-status');
    
    // Variables
    let recognition = null;
    let isListening = false;
    let speechEnabled = true;
    let currentUtterance = null;
    
    // Initialiser la reconnaissance vocale
    if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
        recognition = new SpeechRecognition();
        recognition.lang = 'fr-FR';
        recognition.continuous = false;
        recognition.interimResults = false;
        
        recognition.onstart = () => {
            isListening = true;
            voiceStatus.style.display = 'block';
            voiceStatus.innerHTML = '🎤 Parlez maintenant...';
            voiceStatus.style.color = '#4f46e5';
            voiceBtn.style.background = 'rgba(255,255,255,0.5)';
            voiceBtn.style.transform = 'scale(1.1)';
        };
        
        recognition.onend = () => {
            isListening = false;
            voiceBtn.style.background = 'rgba(255,255,255,0.2)';
            voiceBtn.style.transform = 'scale(1)';
            setTimeout(() => {
                if (voiceStatus.style.display !== 'none') {
                    voiceStatus.style.display = 'none';
                }
            }, 1000);
        };
        
        recognition.onresult = (event) => {
            const texte = event.results[0][0].transcript;
            input.value = texte;
            voiceStatus.innerHTML = '✅ Transcrit: "' + texte + '"';
            voiceStatus.style.color = '#4caf50';
            setTimeout(() => {
                voiceStatus.style.display = 'none';
            }, 1500);
            // Envoyer automatiquement
            setTimeout(() => {
                if (input.value.trim()) {
                    sendMessage();
                }
            }, 500);
        };
        
        recognition.onerror = (event) => {
            console.error('Erreur:', event.error);
            voiceStatus.innerHTML = '❌ Erreur: ' + event.error;
            voiceStatus.style.color = '#f44336';
            setTimeout(() => {
                voiceStatus.style.display = 'none';
            }, 2000);
            isListening = false;
            voiceBtn.style.background = 'rgba(255,255,255,0.2)';
            voiceBtn.style.transform = 'scale(1)';
        };
        
        voiceBtn.addEventListener('click', () => {
            if (isListening) {
                recognition.stop();
            } else {
                recognition.start();
            }
        });
    } else {
        voiceBtn.style.display = 'none';
        console.log('Reconnaissance vocale non supportée');
    }
    
    // Synthèse vocale avec contrôle
    function speakText(text) {
        if (!speechEnabled) return;
        
        // Arrêter toute lecture en cours
        if (currentUtterance) {
            window.speechSynthesis.cancel();
            currentUtterance = null;
        }
        
        const utterance = new SpeechSynthesisUtterance(text);
        utterance.lang = 'fr-FR';
        utterance.rate = 0.9;
        utterance.pitch = 1.0;
        utterance.volume = 1.0;
        
        // Choisir une voix française
        const voices = window.speechSynthesis.getVoices();
        const frenchVoice = voices.find(voice => voice.lang === 'fr-FR');
        if (frenchVoice) {
            utterance.voice = frenchVoice;
        }
        
        utterance.onstart = () => {
            speakerBtn.style.background = '#4caf50';
            speakerBtn.title = 'Lecture en cours...';
        };
        
        utterance.onend = () => {
            currentUtterance = null;
            speakerBtn.style.background = speechEnabled ? 'rgba(255,255,255,0.2)' : 'rgba(255,255,255,0.6)';
            speakerBtn.title = speechEnabled ? 'Désactiver la voix' : 'Activer la voix';
        };
        
        utterance.onerror = () => {
            currentUtterance = null;
            speakerBtn.style.background = 'rgba(255,255,255,0.2)';
        };
        
        currentUtterance = utterance;
        window.speechSynthesis.speak(utterance);
    }
    
    // Arrêter la lecture vocale
    function stopSpeaking() {
        if (currentUtterance) {
            window.speechSynthesis.cancel();
            currentUtterance = null;
            speakerBtn.style.background = speechEnabled ? 'rgba(255,255,255,0.2)' : 'rgba(255,255,255,0.6)';
        }
    }
    
    // Bouton pour activer/désactiver la voix
    speakerBtn.addEventListener('click', () => {
        if (speechEnabled) {
            // Désactiver la voix
            speechEnabled = false;
            stopSpeaking();
            speakerBtn.style.background = 'rgba(255,255,255,0.6)';
            speakerBtn.title = 'Activer la voix';
            // Ajouter un message temporaire
            const statusDiv = document.createElement('div');
            statusDiv.style.cssText = 'background:#f3f4f6; padding:8px; border-radius:8px; font-size:12px; color:#666; text-align:center; margin:5px 0;';
            statusDiv.textContent = '🔇 Voix désactivée';
            messages.appendChild(statusDiv);
            setTimeout(() => statusDiv.remove(), 1500);
        } else {
            // Activer la voix
            speechEnabled = true;
            speakerBtn.style.background = 'rgba(255,255,255,0.2)';
            speakerBtn.title = 'Désactiver la voix';
            const statusDiv = document.createElement('div');
            statusDiv.style.cssText = 'background:#f3f4f6; padding:8px; border-radius:8px; font-size:12px; color:#666; text-align:center; margin:5px 0;';
            statusDiv.textContent = '🔊 Voix activée';
            messages.appendChild(statusDiv);
            setTimeout(() => statusDiv.remove(), 1500);
        }
    });
    
    toggle.addEventListener('click', () => {
        box.style.display = box.style.display === 'none' ? 'flex' : 'none';
    });
    closeBtn.addEventListener('click', () => {
        box.style.display = 'none';
        stopSpeaking();
    });
    
    function addMessage(text, role) {
        const div = document.createElement('div');
        div.style.cssText = role === 'user'
            ? 'background:#4f46e5; color:white; padding:10px; border-radius:10px; font-size:14px; align-self:flex-end; max-width:80%; word-wrap:break-word;'
            : 'background:#f3f4f6; padding:10px; border-radius:10px; font-size:14px; max-width:80%; word-wrap:break-word;';
        div.textContent = text;
        if (role === 'loading') div.id = 'loading-msg';
        messages.appendChild(div);
        messages.scrollTop = messages.scrollHeight;
        
        // Si c'est une réponse du bot et que la voix est activée, la lire
        if (role === 'bot' && speechEnabled) {
            speakText(text);
        }
    }
    
    async function sendMessage() {
        const msg = input.value.trim();
        if (!msg) return;
    
        addMessage(msg, 'user');
        input.value = '';
        addMessage('...', 'loading');
    
        try {
            const res = await fetch('{{ path("chatbot_message") }}', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: msg })
            });
            const data = await res.json();
            document.getElementById('loading-msg')?.remove();
            addMessage(data.response, 'bot');
        } catch(e) {
            document.getElementById('loading-msg')?.remove();
            addMessage('Erreur de connexion.', 'bot');
        }
    }
    
    sendBtn.addEventListener('click', sendMessage);
    input.addEventListener('keydown', e => { if (e.key === 'Enter') sendMessage(); });
    
    // Charger les voix
    window.speechSynthesis.getVoices();
    </script>
</div>

{% endblock %}
