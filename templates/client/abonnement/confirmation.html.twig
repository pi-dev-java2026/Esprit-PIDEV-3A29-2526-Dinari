{% extends 'base.html.twig' %}
{% block title %}Abonnement confirmé — Dinari{% endblock %}

{% block stylesheets %}
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --teal:#00b4c6;--teal-deep:#007f8c;
  --navy:#0d1b2a;--navy2:#112240;
  --lime:#8cc63f;
  --green:#10b981;
  --ink:#0d1b2a;--muted:#64748b;--border:#e2eaf0;--bg:#f8fbfc;
}
html{scroll-behavior:smooth}
body{background:var(--bg);font-family:'Plus Jakarta Sans',sans-serif;color:var(--ink);overflow-x:hidden}
.material-symbols-outlined{font-variation-settings:'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24}

/* ══ ANIMATIONS ══ */
@keyframes popCheck{from{opacity:0;transform:scale(.2) rotate(-20deg)}to{opacity:1;transform:scale(1) rotate(0deg)}}
@keyframes fadeUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
@keyframes slideRight{from{opacity:0;transform:translateX(-24px)}to{opacity:1;transform:translateX(0)}}
@keyframes shimmer{0%,100%{opacity:.5}50%{opacity:1}}
@keyframes ringPulse{0%{box-shadow:0 0 0 0 rgba(16,185,129,.4)}70%{box-shadow:0 0 0 22px rgba(16,185,129,0)}100%{box-shadow:0 0 0 0 rgba(16,185,129,0)}}

/* ══ HERO CONFIRMATION ══ */
.confirm-hero{
  position:relative;overflow:hidden;
  background:linear-gradient(135deg,var(--navy) 0%,#0a2e26 45%,#064030 75%,#073d2e 100%);
  padding:72px 40px 100px;text-align:center;
}
.confirm-hero::before{
  content:'';position:absolute;inset:0;
  background:
    radial-gradient(ellipse 70% 60% at 50% 50%,rgba(16,185,129,.1),transparent 70%),
    radial-gradient(ellipse 40% 40% at 20% 20%,rgba(0,180,198,.06),transparent 60%);
  pointer-events:none;
}
.confirm-hero::after{
  content:'';position:absolute;bottom:0;left:0;right:0;height:64px;
  background:linear-gradient(to bottom,transparent,var(--bg));z-index:2;
}

/* Anneau success */
.check-ring{
  width:96px;height:96px;border-radius:50%;
  background:linear-gradient(135deg,var(--green),#059669);
  display:flex;align-items:center;justify-content:center;
  margin:0 auto 28px;
  box-shadow:0 0 0 18px rgba(16,185,129,.12);
  position:relative;z-index:1;
  animation:popCheck .65s cubic-bezier(.34,1.56,.64,1) both, ringPulse 2s ease 1s both;
}

.confirm-hero h1{
  font-family:'Syne',sans-serif;
  font-size:clamp(34px,5vw,56px);font-weight:900;
  letter-spacing:-0.03em;color:#fff;
  margin-bottom:12px;position:relative;z-index:1;
  animation:fadeUp .55s ease .2s both;
}
.confirm-hero p{
  font-size:16px;color:rgba(255,255,255,.6);
  position:relative;z-index:1;line-height:1.6;
  animation:fadeUp .55s ease .3s both;
}
.confirm-hero p strong{color:rgba(255,255,255,.9);}

/* Badge "Actif" animé */
.badge-actif{
  display:inline-flex;align-items:center;gap:8px;
  background:rgba(16,185,129,.15);
  border:1.5px solid rgba(16,185,129,.35);
  color:var(--green);
  border-radius:999px;padding:6px 18px;
  font-size:12px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;
  margin-bottom:24px;position:relative;z-index:1;
  animation:fadeUp .5s ease .1s both;
}
.badge-actif-dot{
  width:7px;height:7px;border-radius:50%;background:var(--green);
  animation:shimmer 1.5s ease-in-out infinite;
}

/* ══ LAYOUT ══ */
.page-wrap{max-width:980px;margin:0 auto;padding:0 32px 80px;}

/* ══ GRID 2 COLONNES ══ */
.content-grid{
  display:grid;grid-template-columns:1fr 300px;gap:24px;
  margin-top:40px;align-items:start;
}

/* ══ CARTE DÉTAILS ══ */
.card{
  background:#fff;border-radius:18px;
  border:1.5px solid var(--border);
  box-shadow:0 4px 24px rgba(0,0,0,.05);
  overflow:hidden;
}
.card-header{
  padding:22px 26px;
  display:flex;align-items:center;gap:16px;
  border-bottom:1.5px solid var(--border);
  background:linear-gradient(to right,#f8fbfc,#fff);
}
.card-logo{
  width:52px;height:52px;border-radius:14px;
  background:#f3f4f6;border:1.5px solid var(--border);
  display:flex;align-items:center;justify-content:center;
  overflow:hidden;padding:6px;flex-shrink:0;
}
.card-logo img{width:100%;height:100%;object-fit:contain;}
.card-logo-fb{font-size:16px;font-weight:800;color:var(--muted);font-family:'Syne',sans-serif;}
.card-title{font-family:'Syne',sans-serif;font-size:19px;font-weight:800;color:var(--ink);margin-bottom:3px;}
.card-meta{font-size:12px;color:var(--muted);font-weight:500;}
.card-price-block{margin-left:auto;text-align:right;}
.card-price{font-family:'Syne',sans-serif;font-size:26px;font-weight:900;color:var(--ink);}
.card-freq{font-size:12px;color:var(--muted);}

/* Rows détails */
.detail-body{padding:6px 26px 18px;}
.detail-row{
  display:flex;justify-content:space-between;align-items:center;
  padding:13px 0;border-bottom:1px solid #f3f4f6;font-size:14px;
}
.detail-row:last-child{border-bottom:none;}
.detail-label{color:var(--muted);font-weight:500;display:flex;align-items:center;gap:8px;}
.detail-value{font-weight:700;color:var(--ink);}

/* ══ COLONNE DROITE ══ */
.actions-card{
  background:#fff;border-radius:18px;
  border:1.5px solid var(--border);
  box-shadow:0 4px 24px rgba(0,0,0,.05);
  padding:22px;
}
.actions-label{
  font-size:11px;font-weight:800;color:var(--muted);
  text-transform:uppercase;letter-spacing:.08em;margin-bottom:16px;
}

.btn-primary{
  width:100%;padding:13px 16px;border-radius:10px;
  background:linear-gradient(135deg,var(--teal-deep),var(--teal));
  color:#fff;border:none;font-family:'Plus Jakarta Sans',sans-serif;
  font-size:14px;font-weight:800;cursor:pointer;
  display:flex;align-items:center;justify-content:center;gap:8px;
  transition:all .25s;box-shadow:0 6px 20px rgba(0,127,140,.25);
  margin-bottom:10px;text-decoration:none;
}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 10px 28px rgba(0,127,140,.35);color:#fff;}

.btn-secondary{
  width:100%;padding:12px 16px;border-radius:10px;
  background:#f3f4f6;border:1.5px solid var(--border);
  color:var(--ink);font-family:'Plus Jakarta Sans',sans-serif;
  font-size:14px;font-weight:600;cursor:pointer;
  display:flex;align-items:center;justify-content:center;gap:8px;
  transition:all .2s;margin-bottom:10px;text-decoration:none;
}
.btn-secondary:hover{background:#e9ecef;color:var(--ink);}

.btn-danger{
  width:100%;padding:12px 16px;border-radius:10px;
  background:#fff;border:1.5px solid #fecaca;
  color:#ef4444;font-family:'Plus Jakarta Sans',sans-serif;
  font-size:14px;font-weight:600;cursor:pointer;
  display:flex;align-items:center;justify-content:center;gap:8px;
  transition:all .2s;
}
.btn-danger:hover{background:#fef2f2;}

/* ══ TIMELINE STATUT ══ */
.timeline{
  background:#fff;border-radius:18px;
  border:1.5px solid var(--border);
  box-shadow:0 4px 24px rgba(0,0,0,.05);
  padding:24px 26px;margin-top:24px;
}
.timeline-title{
  font-family:'Syne',sans-serif;font-size:16px;font-weight:800;
  color:var(--ink);margin-bottom:20px;
}
.timeline-steps{display:flex;flex-direction:column;gap:0;}
.t-step{display:flex;gap:14px;position:relative;}
.t-step:not(:last-child)::before{
  content:'';position:absolute;left:15px;top:32px;
  width:2px;height:calc(100% - 8px);
  background:var(--border);
}
.t-dot{
  width:32px;height:32px;border-radius:50%;
  flex-shrink:0;display:flex;align-items:center;justify-content:center;
  font-size:14px;position:relative;z-index:1;
}
.t-dot.done{background:var(--green);color:#fff;box-shadow:0 4px 12px rgba(16,185,129,.3);}
.t-dot.active{background:var(--teal);color:#fff;box-shadow:0 4px 12px rgba(0,180,198,.3);}
.t-dot.pending{background:#f3f4f6;color:var(--muted);border:2px solid var(--border);}
.t-content{padding-bottom:20px;}
.t-label{font-size:14px;font-weight:700;color:var(--ink);margin-bottom:2px;}
.t-date{font-size:12px;color:var(--muted);}

/* ══ SUGGESTIONS ══ */
.suggestions-section{margin-top:48px;}
.section-title{
  font-family:'Syne',sans-serif;font-size:24px;font-weight:800;
  letter-spacing:-0.02em;color:var(--ink);margin-bottom:8px;
}
.section-sub{font-size:14px;color:var(--muted);margin-bottom:28px;}
.sug-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:18px;}

.sug-card{
  background:#fff;border-radius:16px;padding:20px;
  border:1.5px solid var(--border);
  box-shadow:0 2px 12px rgba(0,0,0,.04);
  cursor:pointer;text-decoration:none;color:inherit;
  display:flex;flex-direction:column;gap:12px;
  transition:all .3s cubic-bezier(.34,1.56,.64,1);
}
.sug-card:hover{
  border-color:var(--teal);
  box-shadow:0 12px 32px rgba(0,180,198,.14);
  transform:translateY(-5px);
  text-decoration:none;color:inherit;
}
.sug-header{display:flex;align-items:flex-start;gap:12px;}
.sug-logo{
  width:44px;height:44px;background:#f3f4f6;border-radius:10px;
  display:flex;align-items:center;justify-content:center;overflow:hidden;padding:5px;flex-shrink:0;
}
.sug-logo img{width:100%;height:100%;object-fit:contain;}
.sug-nom{font-weight:800;font-size:15px;color:var(--ink);margin-bottom:2px;}
.sug-cat{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;font-weight:700;}
.sug-desc{font-size:13px;color:var(--muted);line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}
.sug-footer{display:flex;align-items:center;justify-content:space-between;padding-top:10px;border-top:1px solid var(--border);}
.sug-price{font-family:'Syne',sans-serif;font-size:18px;font-weight:900;color:var(--teal-deep);}
.sug-freq{font-size:11px;color:var(--muted);}
.sug-tier{
  font-size:10px;font-weight:800;padding:3px 10px;border-radius:999px;
  background:rgba(0,127,140,.08);color:var(--teal-deep);
  border:1px solid rgba(0,127,140,.2);
}
.sug-btn{
  width:100%;padding:10px;border-radius:8px;
  background:var(--navy);color:#fff;border:none;
  font-family:'Plus Jakarta Sans',sans-serif;font-size:13px;font-weight:700;
  cursor:pointer;transition:all .2s;
  display:flex;align-items:center;justify-content:center;gap:6px;
}
.sug-card:hover .sug-btn{background:var(--teal-deep);}

/* ══ SECTION AVIS — avec bouton scroll ══ */
.avis-trigger-wrap{
  margin-top:56px;
  background:linear-gradient(135deg,var(--navy2),var(--navy));
  border-radius:20px;padding:40px;
  display:flex;align-items:center;justify-content:space-between;gap:24px;
  flex-wrap:wrap;
}
.avis-trigger-text h2{
  font-family:'Syne',sans-serif;font-size:24px;font-weight:800;
  color:#fff;margin-bottom:8px;
}
.avis-trigger-text p{font-size:14px;color:rgba(255,255,255,.6);line-height:1.6;}

/* Bouton animé style page accueil */
.animated-button{
  position:relative;display:flex;align-items:center;gap:4px;
  padding:16px 36px;border:4px solid transparent;
  font-size:15px;background-color:inherit;border-radius:100px;
  font-weight:700;color:var(--lime);
  box-shadow:0 0 0 2px var(--lime);cursor:pointer;overflow:hidden;
  transition:all .6s cubic-bezier(.23,1,.32,1);
  font-family:'Plus Jakarta Sans',sans-serif;white-space:nowrap;
  flex-shrink:0;
}
.animated-button svg{position:absolute;width:24px;fill:none;stroke:var(--lime);z-index:9;transition:all .8s cubic-bezier(.23,1,.32,1);}
.animated-button .arr-1{right:16px;}
.animated-button .arr-2{left:-25%;}
.animated-button .circle{
  position:absolute;top:50%;left:50%;
  transform:translate(-50%,-50%);
  width:20px;height:20px;background:var(--lime);
  border-radius:50%;opacity:0;
  transition:all .8s cubic-bezier(.23,1,.32,1);z-index:0;
}
.animated-button .text{position:relative;z-index:1;transform:translateX(-12px);transition:all .8s cubic-bezier(.23,1,.32,1);}
.animated-button:hover{box-shadow:0 0 0 12px transparent;color:#fff;border-radius:12px;}
.animated-button:hover .arr-1{right:-25%;}
.animated-button:hover .arr-2{left:16px;}
.animated-button:hover .text{transform:translateX(12px);}
.animated-button:hover svg{stroke:#fff;}
.animated-button:hover .circle{width:220px;height:220px;opacity:1;}

/* ══ FORMULAIRE AVIS ══ */
.avis-section{
  margin-top:0;padding:0 32px 80px;
  max-width:980px;margin-left:auto;margin-right:auto;
}
.avis-form-wrap{
  background:linear-gradient(135deg,#f0f7fa,#f8fbfc);
  border-radius:20px;border:1.5px solid rgba(0,180,198,.15);
  padding:48px 44px;
  box-shadow:0 8px 32px rgba(0,127,140,.07);
}
.avis-form-header{text-align:center;margin-bottom:36px;}
.avis-form-header h3{
  font-family:'Syne',sans-serif;font-size:28px;font-weight:800;
  color:var(--ink);margin-bottom:10px;letter-spacing:-.02em;
}
.avis-form-header p{font-size:14px;color:var(--muted);line-height:1.6;}

.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
.form-field{display:flex;flex-direction:column;gap:7px;}
.form-field.full{grid-column:1/-1;}
.form-label{
  font-size:11px;font-weight:800;color:var(--ink);
  text-transform:uppercase;letter-spacing:.06em;
}
.form-input{
  padding:12px 14px;border:1.5px solid var(--border);border-radius:10px;
  font-size:14px;font-family:'Plus Jakarta Sans',sans-serif;color:var(--ink);
  background:#fff;transition:all .2s;outline:none;
}
.form-input:focus{border-color:var(--teal);box-shadow:0 0 0 3px rgba(0,180,198,.1);}
.form-input::placeholder{color:#94a3b8;}
textarea.form-input{min-height:120px;resize:vertical;}

.form-submit{
  width:100%;padding:15px;border-radius:10px;
  background:linear-gradient(135deg,var(--teal-deep),var(--teal));
  color:#fff;border:none;font-family:'Plus Jakarta Sans',sans-serif;
  font-size:15px;font-weight:800;cursor:pointer;
  transition:all .3s cubic-bezier(.34,1.56,.64,1);
  box-shadow:0 8px 24px rgba(0,180,198,.3);
  letter-spacing:.02em;margin-top:8px;
}
.form-submit:hover{transform:translateY(-2px);box-shadow:0 14px 32px rgba(0,180,198,.4);}

/* Star rating interactif */
.star-rating{display:flex;gap:6px;margin-top:2px;}
.star-btn{
  font-size:26px;background:none;border:none;cursor:pointer;
  transition:transform .2s;padding:0;line-height:1;color:#ddd;
}
.star-btn.active,.star-btn:hover{transform:scale(1.2);}
.star-btn.active{color:#f59e0b;}

/* ══ MODAL ANNULATION ══ */
.modal-overlay{
  display:none;position:fixed;inset:0;
  background:rgba(0,0,0,.35);backdrop-filter:blur(6px);
  z-index:9999;align-items:center;justify-content:center;padding:20px;
}
.modal-overlay.open{display:flex;}
.modal-box{
  background:#fff;border-radius:20px;max-width:420px;width:100%;
  padding:36px;box-shadow:0 24px 64px rgba(0,0,0,.15);
}
.modal-box h3{
  font-family:'Syne',sans-serif;font-size:20px;font-weight:800;
  color:var(--ink);text-align:center;margin-bottom:12px;
}
.modal-box p{font-size:14px;color:var(--muted);text-align:center;line-height:1.65;margin-bottom:28px;}
.modal-actions{display:flex;gap:10px;}

/* Animations reveal */
.reveal{opacity:0;transform:translateY(24px);transition:opacity .6s ease,transform .6s ease;}
.reveal.visible{opacity:1;transform:translateY(0);}

/* ── RESPONSIVE ── */
@media(max-width:780px){
  .content-grid{grid-template-columns:1fr;}
  .form-grid{grid-template-columns:1fr;}
  .page-wrap,.avis-section{padding-left:16px;padding-right:16px;}
  .confirm-hero{padding:56px 20px 80px;}
  .avis-form-wrap{padding:32px 24px;}
  .avis-trigger-wrap{flex-direction:column;text-align:center;}
}
</style>
{% endblock %}

{% block body %}

{# ══ HERO CONFIRMATION ══ #}
<div class="confirm-hero">
  <div class="badge-actif"><div class="badge-actif-dot"></div> Abonnement actif</div>
  <div class="check-ring">
    <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
      <path d="M10 25L19 34L38 13" stroke="#fff" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </div>
  <h1>Abonnement activé !</h1>
  <p>Votre abonnement <strong>{{ paiement.abonnementId.nom }}</strong> est maintenant actif et prêt à l'emploi.</p>
</div>

{# ══ CONTENU PRINCIPAL ══ #}
<div class="page-wrap">
  <div class="content-grid">

    {# ── COLONNE GAUCHE ── #}
    <div style="display:flex;flex-direction:column;gap:22px;">

      {# Carte détails #}
      <div class="card reveal" style="animation-delay:.05s;">
        <div class="card-header">
          <div class="card-logo">
            {% if paiement.abonnementId.logoDomain %}
              <img src="https://logo.clearbit.com/{{ paiement.abonnementId.logoDomain }}"
                   alt="{{ paiement.abonnementId.nom }}"
                   onerror="this.style.display='none';document.getElementById('logo-fb-c').style.display='flex';"/>
            {% endif %}
            <div id="logo-fb-c" class="card-logo-fb"
                 style="{% if paiement.abonnementId.logoDomain %}display:none;{% else %}display:flex;{% endif %}
                        width:100%;height:100%;align-items:center;justify-content:center;">
              {{ paiement.abonnementId.nom|slice(0,2)|upper }}
            </div>
          </div>
          <div>
            <div class="card-title">{{ paiement.abonnementId.nom }}</div>
            <div class="card-meta">{{ paiement.abonnementId.categorie|capitalize }} · {{ paiement.abonnementId.tier }}</div>
          </div>
          <div class="card-price-block">
            <div class="card-price">{{ paiement.montant|number_format(2) }} DT</div>
            <div class="card-freq">/ {{ paiement.abonnementId.frequence }}</div>
          </div>
        </div>
        <div class="detail-body">
          <div class="detail-row">
            <span class="detail-label">📋 Référence</span>
            <span class="detail-value" style="font-family:monospace;">#{{ '%06d'|format(paiement.id) }}</span>
          </div>
          <div class="detail-row">
            <span class="detail-label">📅 Souscription</span>
            <span class="detail-value">{{ paiement.datePaiement|date('d/m/Y') }}</span>
          </div>
          <div class="detail-row">
            <span class="detail-label">⏱ Expiration</span>
            <span class="detail-value" style="color:var(--teal-deep);">{{ dateFin|date('d/m/Y') }}</span>
          </div>
          <div class="detail-row">
            <span class="detail-label">💳 Paiement</span>
            <span class="detail-value">{{ paiement.modePaiement ?? '—' }}</span>
          </div>
          {% if paiement.nomTitulaire %}
          <div class="detail-row">
            <span class="detail-label">👤 Titulaire</span>
            <span class="detail-value">{{ paiement.prenomTitulaire }} {{ paiement.nomTitulaire }}</span>
          </div>
          {% endif %}
        </div>
      </div>

      {# Timeline statut #}
      <div class="timeline reveal" style="animation-delay:.1s;">
        <div class="timeline-title">Suivi de votre abonnement</div>
        <div class="timeline-steps">
          <div class="t-step">
            <div class="t-dot done">✓</div>
            <div class="t-content">
              <div class="t-label">Paiement confirmé</div>
              <div class="t-date">{{ paiement.datePaiement|date('d/m/Y à H:i') }}</div>
            </div>
          </div>
          <div class="t-step">
            <div class="t-dot done">✓</div>
            <div class="t-content">
              <div class="t-label">Abonnement activé</div>
              <div class="t-date">Accès immédiat</div>
            </div>
          </div>
          <div class="t-step">
            <div class="t-dot active">↻</div>
            <div class="t-content">
              <div class="t-label">Renouvellement automatique</div>
              <div class="t-date">Le {{ dateFin|date('d/m/Y') }}</div>
            </div>
          </div>
          <div class="t-step">
            <div class="t-dot pending">—</div>
            <div class="t-content">
              <div class="t-label">Annulation possible</div>
              <div class="t-date">À tout moment depuis votre espace</div>
            </div>
          </div>
        </div>
      </div>

    </div>

    {# ── COLONNE DROITE ── #}
    <div style="display:flex;flex-direction:column;gap:16px;">

      <div class="actions-card reveal" style="animation-delay:.08s;">
        <div class="actions-label">Actions rapides</div>

        <a href="{{ path('app_client_abonnements') }}" class="btn-primary">
          <span class="material-symbols-outlined" style="font-size:18px;">grid_view</span>
          Voir les offres
        </a>

        <a href="{{ path('facture_telecharger', {id: paiement.id}) }}" target="_blank" class="btn-secondary">
          <span class="material-symbols-outlined" style="font-size:17px;">download</span>
          Télécharger la facture PDF
        </a>

        {# Bouton scroll vers le formulaire d'avis #}
        <button type="button" onclick="scrollToAvis()" class="btn-secondary" style="border-color:rgba(0,180,198,.3);color:var(--teal-deep);">
          <span class="material-symbols-outlined" style="font-size:17px;">rate_review</span>
          Laisser un avis
        </button>

        <button type="button" onclick="document.getElementById('cancelModal').classList.add('open')" class="btn-danger">
          <span class="material-symbols-outlined" style="font-size:17px;">cancel</span>
          Annuler l'abonnement
        </button>
      </div>

      {# Mini récap prix #}
      <div class="card reveal" style="padding:20px;animation-delay:.12s;">
        <div style="font-size:11px;font-weight:800;color:var(--muted);text-transform:uppercase;letter-spacing:.08em;margin-bottom:14px;">Récapitulatif</div>
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
          <span style="font-size:13px;color:var(--muted);">Abonnement</span>
          <span style="font-size:13px;font-weight:600;">{{ paiement.montant|number_format(2) }} DT</span>
        </div>
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;">
          <span style="font-size:13px;color:var(--muted);">Frais de service</span>
          <span style="font-size:13px;font-weight:700;color:var(--green);">Gratuit</span>
        </div>
        <div style="border-top:1.5px solid var(--border);padding-top:12px;display:flex;justify-content:space-between;align-items:center;">
          <span style="font-family:'Syne',sans-serif;font-size:15px;font-weight:800;">Total</span>
          <span style="font-family:'Syne',sans-serif;font-size:20px;font-weight:900;color:var(--teal-deep);">{{ paiement.montant|number_format(2) }} DT</span>
        </div>
      </div>

    </div>
  </div>

  {# ══ SUGGESTIONS ══ #}
  {% if suggestions|length > 0 %}
  <div class="suggestions-section reveal" style="animation-delay:.15s;">
    <div class="section-title">Vous pourriez aussi aimer</div>
    <div class="section-sub">Des services complémentaires choisis pour vous</div>
    <div class="sug-grid">
      {% for sug in suggestions %}
      <a href="{{ path('app_client_abonnement_show', {id: sug.id}) }}" class="sug-card">
        <div class="sug-header">
          <div class="sug-logo">
            {% if sug.logoDomain %}
              <img src="https://logo.clearbit.com/{{ sug.logoDomain }}" alt="{{ sug.nom }}"
                   onerror="this.style.display='none';this.parentElement.innerHTML='<span style=font-size:14px;font-weight:800;color:#64748b>{{ sug.nom|slice(0,2)|upper }}</span>';"/>
            {% else %}
              <span style="font-size:14px;font-weight:800;color:#64748b;">{{ sug.nom|slice(0,2)|upper }}</span>
            {% endif %}
          </div>
          <div>
            <div class="sug-nom">{{ sug.nom }}</div>
            <div class="sug-cat">{{ sug.categorie|capitalize }}</div>
          </div>
        </div>
        {% if sug.description %}
          <div class="sug-desc">{{ sug.description }}</div>
        {% endif %}
        <div class="sug-footer">
          <div>
            <div class="sug-price">{{ sug.prix|number_format(2) }} DT</div>
            <div class="sug-freq">/ {{ sug.frequence }}</div>
          </div>
          <span class="sug-tier">{{ sug.tier }}</span>
        </div>
        <div class="sug-btn">Découvrir →</div>
      </a>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {# ══ BLOC CTA AVIS ══ #}
  <div class="avis-trigger-wrap reveal" id="avis-trigger" style="animation-delay:.2s;">
    <div class="avis-trigger-text">
      <h2>✨ Votre avis compte !</h2>
      <p>Partagez votre expérience pour aider la communauté Dinari et améliorer nos services.</p>
    </div>
    <button class="animated-button" onclick="scrollToAvis()">
      <svg class="arr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <polyline points="5 12 19 12 12 19"></polyline>
      </svg>
      <span class="circle"></span>
      <span class="text">Laisser mon avis</span>
      <svg class="arr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <polyline points="5 12 19 12 12 19"></polyline>
      </svg>
    </button>
  </div>

</div>

{# ══ FORMULAIRE AVIS ══ #}
<div class="avis-section" id="avis-form-section">
  <div class="avis-form-wrap reveal">
    <div class="avis-form-header">
      <h3>Partagez votre avis</h3>
      <p>Votre retour nous aide à améliorer Dinari et guide les autres utilisateurs dans leurs choix.</p>
    </div>

    {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}

    <div class="form-grid">

      <div class="form-field">
        {{ form_label(form.nom_client, 'Votre nom', {label_attr: {class: 'form-label'}}) }}
        {{ form_widget(form.nom_client, {attr: {class: 'form-input', placeholder: 'Jean Dupont'}}) }}
      </div>

      <div class="form-field">
        {{ form_label(form.email_client, 'Email (optionnel)', {label_attr: {class: 'form-label'}}) }}
        {{ form_widget(form.email_client, {attr: {class: 'form-input', placeholder: 'nom@exemple.com'}}) }}
      </div>

      {# Note avec étoiles interactives #}
      <div class="form-field full">
        <label class="form-label">Note</label>
        <div class="star-rating" id="star-rating">
          {% for i in 1..5 %}
            <button type="button" class="star-btn" data-value="{{ i }}" onclick="setRating({{ i }})">★</button>
          {% endfor %}
        </div>
        {# Champ caché pour la note #}
        <div style="display:none;">{{ form_widget(form.note, {attr: {id: 'note-hidden'}}) }}</div>
      </div>

      <div class="form-field full">
        {{ form_label(form.commentaire, 'Votre avis', {label_attr: {class: 'form-label'}}) }}
        {{ form_widget(form.commentaire, {attr: {class: 'form-input', placeholder: 'Partagez votre expérience avec cet abonnement...', rows: 5}}) }}
      </div>

    </div>

    {% if form.vars.errors|length > 0 %}
      <div style="margin-top:16px;padding:12px 16px;background:#fee2e2;border:1px solid #fca5a5;border-radius:10px;color:#991b1b;font-size:13px;">
        {{ form_errors(form) }}
      </div>
    {% endif %}

    <button type="submit" class="form-submit">✓ Soumettre mon avis</button>

    <p style="font-size:12px;color:var(--muted);text-align:center;margin-top:12px;">
      Votre avis sera publié après modération
    </p>

    {{ form_end(form) }}

  </div>
</div>

{# ══ MODAL ANNULATION ══ #}
<div class="modal-overlay" id="cancelModal">
  <div class="modal-box">
    <h3>Annuler l'abonnement ?</h3>
    <p>Vous êtes sur le point d'annuler <strong>{{ paiement.abonnementId.nom }}</strong>. Cette action est irréversible.</p>
    <div class="modal-actions">
      <button type="button"
              onclick="document.getElementById('cancelModal').classList.remove('open')"
              class="btn-secondary" style="flex:1;margin-bottom:0;">
        Non, garder
      </button>
      <form method="POST" action="{{ path('app_client_paiement_annuler', {id: paiement.id}) }}" style="flex:1;">
        <button type="submit"
                style="width:100%;padding:12px;border-radius:10px;background:#ef4444;border:none;color:#fff;font-family:'Plus Jakarta Sans',sans-serif;font-size:14px;font-weight:700;cursor:pointer;transition:background .2s;"
                onmouseover="this.style.background='#dc2626'" onmouseout="this.style.background='#ef4444'">
          Oui, annuler
        </button>
      </form>
    </div>
  </div>
</div>

<script>
/* ── Scroll vers formulaire avis ── */
function scrollToAvis() {
  const target = document.getElementById('avis-form-section');
  if (!target) return;
  const start = window.pageYOffset;
  const end   = target.getBoundingClientRect().top + start - 80;
  const dist  = end - start;
  const dur   = 800;
  let startTime = null;
  function ease(t){ return t < .5 ? 4*t*t*t : 1 - Math.pow(-2*t+2,3)/2; }
  function step(ts){
    if (!startTime) startTime = ts;
    const p = Math.min((ts - startTime) / dur, 1);
    window.scrollTo(0, start + dist * ease(p));
    if (p < 1) requestAnimationFrame(step);
  }
  requestAnimationFrame(step);

  /* Highlight du formulaire */
  setTimeout(() => {
    const wrap = document.querySelector('.avis-form-wrap');
    if (wrap) {
      wrap.style.transition = 'box-shadow .4s ease';
      wrap.style.boxShadow  = '0 0 0 3px rgba(0,180,198,.35), 0 8px 32px rgba(0,127,140,.12)';
      setTimeout(() => { wrap.style.boxShadow = '0 8px 32px rgba(0,127,140,.07)'; }, 1800);
    }
  }, 900);
}

/* ── Star rating interactif ── */
function setRating(val) {
  const btns = document.querySelectorAll('.star-btn');
  btns.forEach((b, i) => b.classList.toggle('active', i < val));
  const hidden = document.getElementById('note-hidden');
  if (hidden) hidden.value = val;
}
document.querySelectorAll('.star-btn').forEach((btn, i) => {
  btn.addEventListener('mouseenter', () => {
    document.querySelectorAll('.star-btn').forEach((b, j) => {
      b.style.color = j <= i ? '#f59e0b' : '#ddd';
    });
  });
  btn.addEventListener('mouseleave', () => {
    const active = document.querySelectorAll('.star-btn.active').length;
    document.querySelectorAll('.star-btn').forEach((b, j) => {
      b.style.color = j < active ? '#f59e0b' : '#ddd';
    });
  });
});

/* ── Fermeture modal au clic extérieur ── */
document.getElementById('cancelModal').addEventListener('click', function(e) {
  if (e.target === this) this.classList.remove('open');
});

/* ── Scroll reveal ── */
const io = new IntersectionObserver((entries) => {
  entries.forEach(e => {
    if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); }
  });
}, { threshold: 0.1 });
document.querySelectorAll('.reveal').forEach(el => io.observe(el));
</script>
{% endblock %}
