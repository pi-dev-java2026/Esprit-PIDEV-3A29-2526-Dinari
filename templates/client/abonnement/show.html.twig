{% block javascripts %}
{{ parent() }}

<script src="https://js.stripe.com/v3/"></script>
<script src="https://api.mapbox.com/mapbox-gl-js/v3.3.0/mapbox-gl.js"></script>

<script>
var abonnementId = {{ abo.id }};

// ══ STRIPE ══
const stripe = Stripe('{{ publishableKey }}');
const elements = stripe.elements({
  clientSecret: '{{ clientSecret }}',
  appearance: { theme: 'stripe', variables: { colorPrimary: '#007f8c', colorBackground: '#ffffff', colorText: '#0d1b2a', colorDanger: '#ef4444', fontFamily: 'Inter, sans-serif', borderRadius: '10px' } }
});
const paymentElement = elements.create('payment', { wallets: { applePay: 'never', googlePay: 'never' } });
paymentElement.mount('#payment-element');

function openCheckout(){ document.getElementById('checkoutModal').style.display='flex'; document.body.style.overflow='hidden'; }
function closeCheckout(){ document.getElementById('checkoutModal').style.display='none'; document.body.style.overflow=''; }
document.getElementById('checkoutModal').addEventListener('click', function(e){ if(e.target===this) closeCheckout(); });

// Formulaire Stripe SANS fraude
document.getElementById('stripe-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  
  // Récupérer les informations client depuis le formulaire
  const nom = document.getElementById('client_nom')?.value || '';
  const prenom = document.getElementById('client_prenom')?.value || '';
  const email = document.getElementById('client_email')?.value || '';
  const cin = document.getElementById('client_cin')?.value || '';
  
  // Sauvegarder les infos client en session
  try {
    await fetch('{{ path("app_client_paiement_session") }}', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ nom, prenom, email, cin })
    });
  } catch(e) {
    console.error('Erreur sauvegarde session:', e);
  }
  
  setLoading(true);
  const { error } = await stripe.confirmPayment({
    elements,
    confirmParams: { return_url: '{{ url("app_client_stripe_return") }}' }
  });
  if (error) {
    showMessage('❌ ' + error.message);
    setLoading(false);
  }
});

function setLoading(b) {
  document.getElementById('submit-stripe').disabled = b;
  document.getElementById('btn-text').style.display = b ? 'none' : 'flex';
  document.getElementById('btn-spinner').style.display = b ? 'inline' : 'none';
}
function showMessage(msg) { const el = document.getElementById('payment-message'); el.textContent = msg; el.style.display = 'block'; }
// ══ MAPBOX ══
mapboxgl.accessToken = '{{ mapboxToken }}';
const agencesData = [
  { id: 0, nom: 'Dinari Tunis Centre', ville: 'Tunis', adresse: 'Av. Habib Bourguiba, Tunis 1001', horaire: 'Lun–Sam : 08h–18h', emoji: '🏢', coords: [10.1657, 36.8190] },
  { id: 1, nom: 'Dinari Sousse',       ville: 'Sousse', adresse: 'Av. Mohamed V, Sousse 4000',     horaire: 'Lun–Sam : 08h30–17h30', emoji: '🏪', coords: [10.6346, 35.8245] },
  { id: 2, nom: 'Dinari Nabeul',       ville: 'Nabeul', adresse: 'Av. Habib Thameur, Nabeul 8000', horaire: 'Lun–Sam : 08h–17h',    emoji: '🏬', coords: [10.7352, 36.4537] },
];
let agencyMap = null, agencyMarkers = [];

function openAgencyModal() {
  document.getElementById('agencyModal').style.display = 'flex';
  document.body.style.overflow = 'hidden';
  if (!agencyMap) {
    setTimeout(() => {
      agencyMap = new mapboxgl.Map({ container: 'agency-map', style: 'mapbox://styles/mapbox/light-v11', center: [10.4, 36.3], zoom: 7, attributionControl: false });
      agencyMap.addControl(new mapboxgl.NavigationControl({ showCompass: false }), 'top-right');
      agencesData.forEach((a, i) => {
        const el = document.createElement('div');
        el.className = 'custom-marker' + (i === 0 ? ' active' : '');
        el.innerHTML = a.emoji;
        el.onclick = () => focusAgency(i);
        const popup = new mapboxgl.Popup({ offset: 25, closeButton: true, maxWidth: '220px' })
          .setHTML(`<div style="font-family:'Plus Jakarta Sans',sans-serif;">
            <div style="font-weight:800;font-size:14px;color:#0d1b2a;margin-bottom:4px;">${a.emoji} ${a.nom}</div>
            <div style="font-size:11px;color:#007f8c;font-weight:700;text-transform:uppercase;margin-bottom:8px;">${a.ville}</div>
            <div style="font-size:12px;color:#64748b;margin-bottom:4px;">📍 ${a.adresse}</div>
            <div style="font-size:12px;color:#64748b;margin-bottom:8px;">🕐 ${a.horaire}</div>
            <button onclick="openRdv(${i})" class="btn-rdv-agence">📅 Prendre un RDV</button>
            <a href="https://www.google.com/maps/dir/?api=1&destination=${a.coords[1]},${a.coords[0]}" target="_blank" class="btn-itineraire">🧭 Itinéraire</a>
          </div>`);
        const marker = new mapboxgl.Marker(el).setLngLat(a.coords).setPopup(popup).addTo(agencyMap);
        agencyMarkers.push({ marker, el, popup });
      });
      setTimeout(() => agencyMarkers[0]?.marker.togglePopup(), 600);
    }, 100);
  }
}
function closeAgencyModal() { document.getElementById('agencyModal').style.display = 'none'; document.body.style.overflow = ''; }
function focusAgency(index) {
  if (!agencyMap) return;
  agencyMarkers.forEach((m, i) => { m.el.classList.toggle('active', i === index); m.popup.remove(); });
  document.querySelectorAll('.agency-card').forEach((c, i) => c.classList.toggle('active', i === index));
  agencyMap.flyTo({ center: agencesData[index].coords, zoom: 13, duration: 1000 });
  setTimeout(() => agencyMarkers[index].marker.togglePopup(), 800);
}
document.getElementById('agencyModal').addEventListener('click', function(e){ if(e.target === this) closeAgencyModal(); });

// ══ RDV FLOW ══
let rdvState = { agencyIndex: 0, date: '', slot: '', prenom: '', nom: '', email: '', tel: '', message: '' };
let currentRdvStep = 0;
const ALL_SLOTS = ['08:30','09:00','09:30','10:00','10:30','11:00','11:30','14:00','14:30','15:00','15:30','16:00','16:30','17:00'];
const UNAVAILABLE = ['09:00','10:30','14:30'];

function openRdv(agencyIndex) {
  rdvState = { agencyIndex, date: '', slot: '', prenom: '', nom: '', email: '', tel: '', message: '' };
  currentRdvStep = 0;
  const ag = agencesData[agencyIndex];
  document.getElementById('rdv-header-agency-name').textContent = ag.nom + ' — ' + ag.ville;
  document.getElementById('rdv-agency-name-display').textContent = ag.nom;
  document.getElementById('rdv-agency-addr-display').textContent = ag.adresse;
  document.getElementById('rdv-agency-emoji').textContent = ag.emoji;
  const tomorrow = new Date(); tomorrow.setDate(tomorrow.getDate() + 1);
  document.getElementById('rdv-date').min = tomorrow.toISOString().split('T')[0];
  document.getElementById('rdv-date').value = '';
  document.getElementById('slots-grid').innerHTML = '<div style="grid-column:1/-1;text-align:center;color:var(--muted);font-size:13px;padding:20px 0;">Sélectionnez une date pour voir les créneaux disponibles</div>';
  document.getElementById('rdv-next-1').disabled = true;
  showRdvStep(0);
  document.getElementById('rdvModal').style.display = 'flex';
  document.body.style.overflow = 'hidden';
}
function closeRdv() { document.getElementById('rdvModal').style.display = 'none'; document.body.style.overflow = ''; }
function closeRdvAndAgency() { closeRdv(); closeAgencyModal(); }
function showRdvStep(step) {
  currentRdvStep = step;
  document.querySelectorAll('.rdv-panel').forEach((p, i) => p.classList.toggle('active', i === step));
  document.querySelectorAll('.rdv-step').forEach((s, i) => {
    s.classList.remove('active', 'done');
    if (i < step) s.classList.add('done');
    if (i === step) s.classList.add('active');
    if (i < step) document.getElementById('step-num-' + i).textContent = '✓';
    else document.getElementById('step-num-' + i).textContent = i + 1;
  });
}
function goToStep(step) { showRdvStep(step); }
function loadSlots() {
  const dateVal = document.getElementById('rdv-date').value;
  if (!dateVal) return;
  rdvState.date = dateVal; rdvState.slot = '';
  document.getElementById('rdv-next-1').disabled = true;
  const d = new Date(dateVal); const day = d.getDay();
  const grid = document.getElementById('slots-grid');
  if (day === 0) { grid.innerHTML = '<div style="grid-column:1/-1;text-align:center;color:#ef4444;font-size:13px;padding:16px 0;">❌ Fermé le dimanche.</div>'; return; }
  const slots = ALL_SLOTS.filter(s => { if (rdvState.agencyIndex === 1) return s >= '08:30'; return true; });
  grid.innerHTML = slots.map(s => `<button class="slot-btn${UNAVAILABLE.includes(s) ? ' unavailable' : ''}" onclick="selectSlot('${s}', this)">${s}</button>`).join('');
}
function selectSlot(slot, btn) {
  document.querySelectorAll('.slot-btn').forEach(b => b.classList.remove('selected'));
  btn.classList.add('selected'); rdvState.slot = slot;
  document.getElementById('rdv-next-1').disabled = false;
}
function validateStep2() {
  const ok = document.getElementById('rdv-prenom').value.trim() && document.getElementById('rdv-nom').value.trim() && document.getElementById('rdv-cin').value.trim() && document.getElementById('rdv-email').value.includes('@') && document.getElementById('rdv-tel').value.trim().length >= 8;
  document.getElementById('rdv-next-2').disabled = !ok;
  const dateObj = new Date(rdvState.date);
  document.getElementById('rdv-recap-date-slot').textContent = dateObj.toLocaleDateString('fr-FR', { weekday:'long', day:'numeric', month:'long', year:'numeric' }) + ' à ' + rdvState.slot;
  document.getElementById('rdv-recap-agency').textContent = agencesData[rdvState.agencyIndex].nom;
}
async function submitRdv() {
  rdvState.prenom = document.getElementById('rdv-prenom').value.trim();
  rdvState.nom = document.getElementById('rdv-nom').value.trim();
  rdvState.cin = document.getElementById('rdv-cin').value.trim();
  rdvState.email = document.getElementById('rdv-email').value.trim();
  rdvState.tel = document.getElementById('rdv-tel').value.trim();
  rdvState.message = document.getElementById('rdv-message').value.trim();
  const btn = document.getElementById('rdv-next-2');
  btn.textContent = '⏳ Envoi…'; btn.disabled = true;
  try {
    const payload = { agence: agencesData[rdvState.agencyIndex].nom, agenceVille: agencesData[rdvState.agencyIndex].ville, date: rdvState.date, slot: rdvState.slot, prenom: rdvState.prenom, nom: rdvState.nom, cin: rdvState.cin, email: rdvState.email, tel: rdvState.tel, message: rdvState.message, planNom: '{{ abo.nom|e('js') }}', planPrix: '{{ ((promo_active is defined and promo_active and promo_prix) ? promo_prix : abo.prix)|number_format(2) }} DT / {{ abo.frequence }}' };
    const res = await fetch('/client/rdv/confirmer', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
    const data = await res.json();
    if (data.success) {
      const dateStr = new Date(rdvState.date).toLocaleDateString('fr-FR', { weekday:'long', day:'numeric', month:'long', year:'numeric' });
      document.getElementById('confirm-email-display').textContent = rdvState.email;
      document.getElementById('confirm-agency').textContent = agencesData[rdvState.agencyIndex].nom + ' — ' + agencesData[rdvState.agencyIndex].ville;
      document.getElementById('confirm-date').textContent = dateStr;
      document.getElementById('confirm-slot').textContent = rdvState.slot;
      showRdvStep(2);
    } else { alert('❌ ' + (data.error || 'Erreur')); btn.textContent = 'Confirmer le RDV →'; btn.disabled = false; }
  } catch(err) { alert('❌ Erreur réseau'); btn.textContent = 'Confirmer le RDV →'; btn.disabled = false; }
}
document.getElementById('rdvModal')?.addEventListener('click', function(e){ if(e.target === this) closeRdv(); });

function toggleFaq(id){
  const item = document.getElementById(id);
  const open = item.classList.contains('open');
  document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
  if(!open) item.classList.add('open');
}

(function(){
  const io = new IntersectionObserver(entries => {
    entries.forEach(e => { if(e.isIntersecting){ e.target.classList.add('visible'); io.unobserve(e.target); } });
  }, {threshold: 0.1});
  document.querySelectorAll('.reveal,.feat-item').forEach(el => io.observe(el));
})();

// ══ SMART POPUP IA FUNCTIONS ══
function closeSmartPopup() {
    document.getElementById('promoPopup').style.display = 'none';
}

function acceptSmartRecommendation() {
    var popup = document.getElementById('promoPopup');
    var service = popup.getAttribute('data-service');
    if (service) {
        alert('🎉 Découvrez ' + service + ' !\n\nUne excellente alternative pour vous.');
    }
    closeSmartPopup();
}

function showSmartRecommendation(data) {
    var popup = document.getElementById('promoPopup');
    var comparisonDiv = document.getElementById('smartComparison');
    var savingsDiv = document.getElementById('smartSavings');
    var confidenceSpan = document.getElementById('confidenceScore');
    var confidenceBar = document.getElementById('confidenceBar');
    
    if (!popup) return;
    
    // CAS 1: Félicitations (déjà le meilleur prix)
    if (data.type === 'congratulation') {
        comparisonDiv.innerHTML = `
            <div style="text-align:center; padding:20px;">
                <div style="font-size:64px; margin-bottom:15px;">🏆</div>
                <div style="font-size:16px; font-weight:800; color:#6ee7b7; margin-bottom:10px;">${data.message}</div>
                <div style="font-size:13px; color:rgba(255,255,255,0.7);">${data.current?.nom} à ${data.current?.prix} DT/mois</div>
            </div>
        `;
        savingsDiv.innerHTML = `
            <div style="background:linear-gradient(135deg,#1a7a47,#2e7d52); border-radius:12px; padding:12px;">
                <div style="font-size:11px; color:rgba(255,255,255,0.7);">⭐ VOUS AVEZ FAIT LE BON CHOIX ⭐</div>
                <div style="font-size:14px; color:#6ee7b7; margin-top:5px;">Vous bénéficiez déjà du meilleur tarif !</div>
            </div>
        `;
        popup.style.display = 'block';
        return;
    }
    
    // CAS 2: Recommandation
    if (data.recommendation) {
        popup.setAttribute('data-service', data.recommendation);
        popup.setAttribute('data-price', data.recommendation_price);
        popup.setAttribute('data-reduction', data.recommendation_reduction);
        
        var ancienPrix = data.current?.prix || 15.99;
        var nouveauPrix = data.recommendation_price || 9.99;
        var economies = (ancienPrix - nouveauPrix).toFixed(2);
        var economiesAnnuelles = (economies * 12).toFixed(0);
        var pourcentage = data.recommendation_reduction || Math.round((economies / ancienPrix) * 100);
        var scoreConfiance = Math.min(99, Math.round((data.score || 0.85) * 100));
        
        confidenceSpan.textContent = scoreConfiance + '%';
        confidenceBar.style.width = scoreConfiance + '%';
        
        comparisonDiv.innerHTML = `
            <div style="display:flex; justify-content:space-between; gap:12px;">
                <div style="flex:1; text-align:center;">
                    <div style="font-size:12px; color:rgba(255,255,255,0.5); margin-bottom:5px;">Votre abonnement</div>
                    <div style="font-size:11px; color:rgba(255,255,255,0.7);">${data.current?.nom}</div>
                    <div style="font-size:24px; font-weight:800; color:rgba(255,255,255,0.5); text-decoration:line-through;">${ancienPrix} DT</div>
                </div>
                <div style="flex:0; color:#00b4c6; font-size:20px;">→</div>
                <div style="flex:1; text-align:center; background:linear-gradient(135deg,rgba(0,180,198,0.2),rgba(110,231,183,0.1)); border-radius:12px; padding:8px;">
                    <div style="font-size:12px; color:#6ee7b7; margin-bottom:5px;">✨ Recommandé</div>
                    <div style="font-size:13px; font-weight:700; color:white;">${data.recommendation}</div>
                    <div style="font-size:28px; font-weight:900; color:#6ee7b7;">${nouveauPrix} DT</div>
                    <div style="font-size:10px; color:rgba(255,255,255,0.5);">au lieu de ${ancienPrix} DT</div>
                </div>
            </div>
            <div style="margin-top:12px; padding:8px; background:rgba(0,180,198,0.15); border-radius:10px;">
                <div style="font-size:11px; color:#6ee7b7; text-align:center;">💡 ${data.recommendation_reason || 'Meilleur rapport qualité/prix'}</div>
            </div>
        `;
        
        savingsDiv.innerHTML = `
            <div style="background:linear-gradient(135deg,#1a7a47,#2e7d52); border-radius:12px; padding:12px;">
                <div style="font-size:11px; color:rgba(255,255,255,0.7);">💰 VOUS ÉCONOMISEZ</div>
                <div style="font-size:32px; font-weight:900; color:#6ee7b7;">${economies} DT</div>
                <div style="font-size:12px; color:rgba(255,255,255,0.7);">par mois | ${economiesAnnuelles} DT/an</div>
                <div style="margin-top:8px; display:flex; gap:6px; justify-content:center; flex-wrap:wrap;">
                    <span style="background:rgba(255,255,255,0.2); padding:2px 8px; border-radius:20px; font-size:10px;">📉 -${pourcentage}%</span>
                    <span style="background:rgba(255,255,255,0.2); padding:2px 8px; border-radius:20px; font-size:10px;">⭐ Top recommandé</span>
                    <span style="background:rgba(255,255,255,0.2); padding:2px 8px; border-radius:20px; font-size:10px;">🧠 IA certifiée</span>
                </div>
            </div>
        `;
        
        popup.style.display = 'block';
        console.log('✅ SMART POPUP IA AFFICHÉ !');
    }
}

// ══ RECOMMANDATION ML ══
(function() {
    console.log('🚀 Système de recommandation IA chargé - Abo ID:', abonnementId);

    setTimeout(function() {
        var url = '/client/check-promo/' + abonnementId + '?categorie={{ abo.categorie|e('js') }}';
        console.log('📡 Appel API:', url);

        fetch(url)
            .then(function(r) {
                if (!r.ok) throw new Error('HTTP ' + r.status);
                return r.json();
            })
            .then(function(data) {
                console.log('📨 Réponse API:', data);
                if (data.afficher === true) {
                    showSmartRecommendation(data);
                } else {
                    console.log('ℹ️ Pas de recommandation - score:', data.score);
                }
            })
            .catch(function(err) {
                console.error('❌ Erreur fetch:', err);
            });
    }, 2000);
})();
</script>
