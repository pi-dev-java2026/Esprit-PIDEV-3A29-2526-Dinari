{% extends 'base.html.twig' %}

{% block title %}Offres de l'expert — Dinari{% endblock %}

{% block stylesheets %}
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
    --blue-50: #E6F1FB;
    --blue-100: #B5D4F4;
    --blue-200: #85B7EB;
    --blue-400: #378ADD;
    --blue-600: #185FA5;
    --blue-800: #0C447C;
    --blue-900: #042C53;
    --teal-50: #E1F5EE;
    --teal-100: #9FE1CB;
    --teal-400: #1D9E75;
    --teal-800: #085041;
    --green-50: #EAF3DE;
    --green-100: #C0DD97;
    --green-400: #639922;
    --green-800: #27500A;
    --amber-50: #FAEEDA;
    --amber-100: #FAC775;
    --amber-800: #633806;
    --gray-50: #F1EFE8;
    --gray-100: #D3D1C7;
    --gray-400: #888780;
    --gray-800: #444441;
    --text: #0f172a;
    --muted: #475569;
    --border: rgba(15,23,42,.09);
    --surface: #ffffff;
    --page-bg: #f5f7fa;
}

body { background: var(--page-bg); color: var(--text); font-family: system-ui, -apple-system, sans-serif; }

.page { max-width: 1200px; margin: 0 auto; padding: 28px 20px 80px; }

@keyframes up   { from { opacity:0; transform:translateY(14px); } to { opacity:1; transform:translateY(0); } }
@keyframes pulse { 0%,100%{transform:scale(1);opacity:1} 50%{transform:scale(1.5);opacity:.6} }

/* ── HERO ── */
.hero {
    border-radius: 20px;
    padding: 36px 40px;
    margin-bottom: 22px;
    background: var(--blue-900);
    color: #fff;
    position: relative;
    overflow: hidden;
    animation: up .5s ease both;
}
.hero::before {
    content: '';
    position: absolute;
    right: -70px; top: -90px;
    width: 280px; height: 280px;
    border-radius: 50%;
    background: rgba(255,255,255,.04);
    pointer-events: none;
}
.hero::after {
    content: '';
    position: absolute;
    left: -50px; bottom: -80px;
    width: 200px; height: 200px;
    border-radius: 50%;
    background: rgba(255,255,255,.03);
    pointer-events: none;
}
.hero-inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 32px;
    align-items: center;
}
.hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border-radius: 999px;
    background: rgba(255,255,255,.1);
    border: 1px solid rgba(255,255,255,.15);
    font-size: 11px;
    font-weight: 600;
    color: rgba(255,255,255,.8);
    margin-bottom: 14px;
    letter-spacing: .04em;
}
.hero-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--teal-400);
    animation: pulse 2s infinite;
}
.hero h1 {
    font-size: 30px;
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -.5px;
    margin-bottom: 10px;
    color: #fff;
}
.hero-sub {
    font-size: 14px;
    color: rgba(255,255,255,.7);
    line-height: 1.65;
    max-width: 520px;
    margin-bottom: 18px;
}
.expert-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 999px;
    background: rgba(255,255,255,.1);
    border: 1px solid rgba(255,255,255,.18);
    font-size: 13px;
    font-weight: 600;
    color: rgba(255,255,255,.9);
}
.expert-chip-avatar {
    width: 28px; height: 28px;
    border-radius: 50%;
    background: var(--blue-400);
    display: flex; align-items: center; justify-content: center;
    font-size: 11px; font-weight: 700;
    color: #fff;
    flex-shrink: 0;
}
.hero-stats {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 150px;
}
.hero-stat {
    padding: 13px 16px;
    border-radius: 14px;
    background: rgba(255,255,255,.07);
    border: 1px solid rgba(255,255,255,.1);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
}
.hero-stat-val { font-size: 20px; font-weight: 700; color: #fff; }
.hero-stat-lbl { font-size: 11px; color: rgba(255,255,255,.6); text-align: right; line-height: 1.35; }

/* ── TOP BAR ── */
.top-bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 16px;
}
.top-bar h2 { font-size: 22px; font-weight: 700; }
.top-bar p  { font-size: 13px; color: var(--muted); margin-top: 3px; }
.btn-back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 16px;
    border-radius: 12px;
    background: var(--surface);
    color: var(--blue-800);
    border: 1px solid var(--blue-100);
    text-decoration: none;
    font-size: 13px;
    font-weight: 700;
    transition: background .2s;
    white-space: nowrap;
    flex-shrink: 0;
}
.btn-back:hover { background: var(--blue-50); color: var(--blue-800); }

/* ── FILTERS ── */
.filters {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 14px 16px;
    margin-bottom: 22px;
    position: sticky;
    top: 80px;
    z-index: 10;
}
.filters-form {
    display: grid;
    grid-template-columns: 1.6fr .7fr .7fr 1fr auto auto;
    gap: 10px;
    align-items: center;
}
.fgroup { position: relative; }
.fgroup-icon {
    position: absolute;
    left: 12px; top: 50%;
    transform: translateY(-50%);
    font-size: 13px;
    color: var(--muted);
    pointer-events: none;
}
.finput, .fselect {
    height: 42px;
    border: 1px solid var(--gray-100);
    border-radius: 10px;
    background: var(--page-bg);
    color: var(--text);
    font-size: 13px;
    font-weight: 500;
    outline: none;
    width: 100%;
    transition: border-color .2s;
}
.finput:focus, .fselect:focus { border-color: var(--blue-400); background: #fff; }
.finput { padding: 0 12px 0 34px; }
.fselect { padding: 0 12px; }
.finput-plain { padding: 0 12px; }
.fbtn {
    height: 42px;
    padding: 0 16px;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    border: none;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    transition: .2s;
}
.fbtn-primary { background: var(--blue-900); color: #fff; }
.fbtn-primary:hover { background: var(--blue-800); }
.fbtn-light { background: var(--page-bg); color: var(--gray-800); border: 1px solid var(--gray-100); }
.fbtn-light:hover { background: var(--gray-50); color: var(--gray-800); }

/* ── OFFRES GRID ── */
.grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
}

/* ── OFFRE CARD ── */
.card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 18px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform .22s, box-shadow .22s, border-color .22s;
    animation: up .45s ease both;
}
.card:hover {
    transform: translateY(-5px);
    box-shadow: 0 18px 44px rgba(4,44,83,.11);
    border-color: var(--blue-200);
}

/* card accent strip */
.card-accent {
    height: 4px;
    background: var(--blue-900);
}
.card:nth-child(3n+2) .card-accent { background: var(--teal-400); }
.card:nth-child(3n+3) .card-accent { background: var(--green-400); }

.card-head {
    padding: 18px 18px 14px;
    border-bottom: 1px solid var(--border);
    position: relative;
}
.card-num {
    position: absolute;
    top: 16px; right: 16px;
    width: 28px; height: 28px;
    border-radius: 8px;
    background: var(--blue-50);
    color: var(--blue-800);
    border: 1px solid var(--blue-100);
    display: flex; align-items: center; justify-content: center;
    font-size: 11px; font-weight: 700;
}
.card-icon {
    width: 52px; height: 52px;
    border-radius: 14px;
    background: var(--blue-50);
    color: var(--blue-800);
    display: flex; align-items: center; justify-content: center;
    font-size: 24px;
    margin-bottom: 12px;
    border: 1px solid var(--blue-100);
}
.card:nth-child(3n+2) .card-icon { background: var(--teal-50); color: var(--teal-800); border-color: var(--teal-100); }
.card:nth-child(3n+3) .card-icon { background: var(--green-50); color: var(--green-800); border-color: var(--green-100); }

.card-title {
    font-size: 16px;
    font-weight: 700;
    line-height: 1.35;
    color: var(--text);
    padding-right: 34px;
}

/* card body */
.card-body { padding: 16px 18px 18px; flex: 1; display: flex; flex-direction: column; }

.badges {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 14px;
}
.badge-price {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--green-50);
    color: var(--green-800);
    border: 1px solid var(--green-100);
    font-size: 13px;
    font-weight: 700;
}
.badge-duration {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--blue-50);
    color: var(--blue-800);
    border: 1px solid var(--blue-100);
    font-size: 13px;
    font-weight: 700;
}

.card-desc {
    flex: 1;
    padding: 12px 14px;
    border-radius: 12px;
    background: var(--page-bg);
    border: 1px solid var(--border);
    font-size: 13px;
    color: var(--muted);
    line-height: 1.65;
    margin-bottom: 14px;
    min-height: 90px;
}

.btn-reserve {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 100%;
    padding: 12px;
    border-radius: 12px;
    background: var(--blue-900);
    color: #fff;
    text-decoration: none;
    font-size: 13px;
    font-weight: 700;
    transition: background .2s;
}
.btn-reserve:hover { background: var(--blue-800); color: #fff; }

.trust-note {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    margin-top: 10px;
    font-size: 11px;
    color: var(--muted);
}

/* ── EMPTY ── */
.empty {
    text-align: center;
    padding: 64px 24px;
    border-radius: 18px;
    background: var(--surface);
    border: 1px dashed var(--blue-200);
}
.empty-icon {
    width: 72px; height: 72px;
    margin: 0 auto 16px;
    border-radius: 20px;
    background: var(--blue-50);
    display: flex; align-items: center; justify-content: center;
    font-size: 28px;
}
.empty h3 { font-size: 18px; font-weight: 700; margin-bottom: 8px; }
.empty p  { font-size: 14px; color: var(--muted); max-width: 380px; margin: 0 auto; line-height: 1.6; }

/* ── BACK ZONE ── */
.back-zone {
    display: flex;
    justify-content: center;
    margin-top: 32px;
}
.btn-back-lg {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    border-radius: 14px;
    background: var(--surface);
    color: var(--blue-800);
    border: 1px solid var(--blue-100);
    text-decoration: none;
    font-size: 14px;
    font-weight: 700;
    transition: background .2s;
}
.btn-back-lg:hover { background: var(--blue-50); color: var(--blue-800); }

/* ── RESPONSIVE ── */
@media (max-width: 1000px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .hero-inner { grid-template-columns: 1fr; }
    .hero-stats { flex-direction: row; }
    .hero-stat { flex: 1; }
    .filters-form { grid-template-columns: 1fr 1fr; }
    .filters { position: static; }
}
@media (max-width: 600px) {
    .page { padding: 16px 12px 60px; }
    .hero { padding: 22px 18px; }
    .hero h1 { font-size: 24px; }
    .hero-stats { flex-direction: column; }
    .filters-form { grid-template-columns: 1fr; }
    .grid { grid-template-columns: 1fr; }
    .fbtn { justify-content: center; }
}
</style>
{% endblock %}

{% block body %}
<div class="page">

    {# ── HERO ── #}
    <div class="hero">
        <div class="hero-inner">
            <div>
                <div class="hero-eyebrow">
                    <span class="hero-dot"></span>
                    Catalogue de services · Dinari
                </div>
                <h1>Choisissez l'offre adaptée à votre besoin</h1>
                <p class="hero-sub">
                    Comparez les services proposés, vérifiez le prix et la durée,
                    puis réservez votre consultation en quelques clics.
                </p>
                <div class="expert-chip">
                    <div class="expert-chip-avatar">
                        {{ expert.nom|first|upper }}{{ expert.prenom|first|upper }}
                    </div>
                    {{ expert.nom }} {{ expert.prenom }} &mdash;
                    {{ expert.specialite|replace({
                        'comptabilite_generale': 'Comptabilité générale',
                        'fiscalite': 'Fiscalité',
                        'audit': 'Audit',
                        'gestion_financiere': 'Gestion financière',
                        'conseil_juridique': 'Conseil juridique',
                        'paie_rh': 'Paie et RH',
                        "creation_entreprise": "Création d'entreprise"
                    }) }}
                </div>
            </div>
            <div class="hero-stats">
                <div class="hero-stat">
                    <span class="hero-stat-val">{{ offres|length }}</span>
                    <span class="hero-stat-lbl">Offres<br>disponibles</span>
                </div>
                <div class="hero-stat">
                    <span class="hero-stat-val">✓</span>
                    <span class="hero-stat-lbl">Réservation<br>rapide</span>
                </div>
                <div class="hero-stat">
                    <span class="hero-stat-val">24/7</span>
                    <span class="hero-stat-lbl">En ligne</span>
                </div>
            </div>
        </div>
    </div>

    {# ── TOP BAR ── #}
    <div class="top-bar">
        <div>
            <h2>Offres disponibles</h2>
            <p>Filtrez par prix, durée ou ordre de tri pour trouver rapidement la meilleure offre.</p>
        </div>
        <a href="{{ path('app_client_experts') }}" class="btn-back">← Retour aux experts</a>
    </div>

    {# ── FILTERS ── #}
    <div class="filters">
        <form method="get" action="{{ path('app_client_offres_expert', {'id': expert.id}) }}" class="filters-form">
            <div class="fgroup">
                <span class="fgroup-icon">🔍</span>
                <input type="text" name="search" placeholder="Rechercher une offre…"
                       value="{{ search ?? '' }}" class="finput">
            </div>
            <input type="number" name="prixMax" placeholder="Prix max (TND)"
                   value="{{ prixMax ?? '' }}" class="finput finput-plain">
            <input type="number" name="dureeMax" placeholder="Durée max (min)"
                   value="{{ dureeMax ?? '' }}" class="finput finput-plain">
            <select name="tri" class="fselect">
                <option value="">Trier par</option>
                <option value="prix_asc"   {{ tri is defined and tri == 'prix_asc'   ? 'selected' }}>Prix croissant</option>
                <option value="prix_desc"  {{ tri is defined and tri == 'prix_desc'  ? 'selected' }}>Prix décroissant</option>
                <option value="duree_asc"  {{ tri is defined and tri == 'duree_asc'  ? 'selected' }}>Durée croissante</option>
                <option value="duree_desc" {{ tri is defined and tri == 'duree_desc' ? 'selected' }}>Durée décroissante</option>
            </select>
            <button type="submit" class="fbtn fbtn-primary">Filtrer</button>
            <a href="{{ path('app_client_offres_expert', {'id': expert.id}) }}" class="fbtn fbtn-light">Réinitialiser</a>
        </form>
    </div>

    {# ── CARDS ── #}
    {% if offres|length > 0 %}
    <div class="grid">
        {% for offre in offres %}
        <div class="card">
            <div class="card-accent"></div>
            <div class="card-head">
                <div class="card-num">#{{ loop.index }}</div>
                <div class="card-icon">
                    {% if 'fiscal' in offre.titre|lower or 'impot' in offre.titre|lower or 'tax' in offre.titre|lower %}
                        🧾
                    {% elseif 'audit' in offre.titre|lower %}
                        📊
                    {% elseif 'budget' in offre.titre|lower or 'depense' in offre.titre|lower %}
                        💰
                    {% elseif 'juridique' in offre.titre|lower or 'conseil' in offre.titre|lower %}
                        ⚖️
                    {% elseif 'plan' in offre.titre|lower or 'financier' in offre.titre|lower %}
                        📈
                    {% else %}
                        💼
                    {% endif %}
                </div>
                <div class="card-title">{{ offre.titre }}</div>
            </div>
            <div class="card-body">
                <div class="badges">
                    <span class="badge-price">{{ offre.prix }} TND</span>
                    <span class="badge-duration">⏱ {{ offre.duree }} min</span>
                </div>
                <div class="card-desc">
                    {{ offre.description ?: 'Aucune description disponible pour cette offre.' }}
                </div>
                <a href="{{ path('app_reservation_calendar', {'id': offre.id}) }}" class="btn-reserve">
                    Réserver cette offre →
                </a>
                <div class="trust-note">🔒 Réservation sécurisée</div>
            </div>
        </div>
        {% endfor %}
    </div>

    {% else %}
    <div class="empty">
        <div class="empty-icon">📭</div>
        <h3>Aucune offre trouvée</h3>
        <p>Essayez de modifier les filtres ou cet expert n'a pas encore publié d'offres.</p>
    </div>
    {% endif %}

    <div class="back-zone">
        <a href="{{ path('app_client_experts') }}" class="btn-back-lg">← Retour aux experts</a>
    </div>

</div>
{% endblock %}
