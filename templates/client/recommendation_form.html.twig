{% extends 'base.html.twig' %}

{% block title %}IA Recommandation — Dinari{% endblock %}

{% block stylesheets %}
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --teal:#00b4c6;--teal-deep:#007f8c;--teal-light:#e0f7fa;
  --navy:#0d1b2a;--navy2:#112240;
  --lime:#8cc63f;--lime-dark:#6a9a2e;
  --ink:#0d1b2a;--muted:#64748b;--border:#e2eaf0;
  --glass:rgba(255,255,255,0.85);
}

html{scroll-behavior:smooth}
body{background:#f0f7fa;font-family:'Plus Jakarta Sans',sans-serif;color:var(--ink);overflow-x:hidden;min-height:100vh}

#particles-bg{
  position:fixed;top:0;left:0;width:100%;height:100%;
  pointer-events:none;z-index:0;overflow:hidden;
}
.particle{
  position:absolute;border-radius:50%;
  background:var(--teal);opacity:0;
  animation:particleFloat linear infinite;
}
@keyframes particleFloat{
  0%{transform:translateY(100vh) scale(0);opacity:0}
  10%{opacity:.15}
  90%{opacity:.08}
  100%{transform:translateY(-100px) scale(1.2);opacity:0}
}

.mesh-bg{
  position:fixed;top:0;left:0;width:100%;height:100%;
  background:
    radial-gradient(ellipse 80% 60% at 20% 20%,rgba(0,180,198,.12) 0%,transparent 60%),
    radial-gradient(ellipse 60% 80% at 80% 80%,rgba(0,127,140,.08) 0%,transparent 60%),
    radial-gradient(ellipse 40% 40% at 60% 30%,rgba(140,198,63,.06) 0%,transparent 50%);
  animation:meshShift 8s ease-in-out infinite alternate;
  pointer-events:none;z-index:0;
}
@keyframes meshShift{
  0%{filter:hue-rotate(0deg) brightness(1)}
  100%{filter:hue-rotate(15deg) brightness(1.05)}
}

.page-wrap{position:relative;z-index:1;min-height:100vh;padding:0 0 80px;}

.rec-hero{
  text-align:center;padding:70px 40px 50px;
  position:relative;overflow:hidden;
}
.hero-badge{
  display:inline-flex;align-items:center;gap:10px;
  background:var(--glass);backdrop-filter:blur(12px);
  border:1.5px solid rgba(0,180,198,.25);
  border-radius:100px;padding:10px 24px;
  font-size:12px;font-weight:800;letter-spacing:.15em;
  text-transform:uppercase;color:var(--teal-deep);
  margin-bottom:32px;
  box-shadow:0 8px 32px rgba(0,180,198,.12);
  animation:badgePop .6s cubic-bezier(.34,1.56,.64,1) both;
}
@keyframes badgePop{from{opacity:0;transform:scale(.8) translateY(10px)}to{opacity:1;transform:scale(1) translateY(0)}}

.hero-badge .badge-dot{
  width:8px;height:8px;border-radius:50%;background:var(--teal);
  animation:blink 1.5s ease-in-out infinite;
}
@keyframes blink{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.4;transform:scale(.7)}}

.rec-hero h1{
  font-family:'Syne',sans-serif;
  font-size:clamp(36px,6vw,72px);
  font-weight:900;line-height:1.05;
  letter-spacing:-.04em;color:var(--navy);
  margin-bottom:20px;
  animation:heroSlide .7s cubic-bezier(.34,1.56,.64,1) .1s both;
}
@keyframes heroSlide{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:translateY(0)}}

.rec-hero h1 .word-ai{
  color:transparent;
  -webkit-text-stroke:2.5px var(--teal);
  position:relative;display:inline-block;
}
.rec-hero h1 .word-ai::after{
  content:'';position:absolute;bottom:-4px;left:0;width:100%;height:3px;
  background:linear-gradient(90deg,var(--teal),var(--lime));
  border-radius:2px;transform:scaleX(0);transform-origin:left;
  animation:underlineGrow .6s ease .8s both;
}
@keyframes underlineGrow{to{transform:scaleX(1)}}

.rec-hero p{
  font-size:17px;color:var(--muted);max-width:560px;
  margin:0 auto 0;line-height:1.7;font-weight:500;
  animation:heroSlide .7s cubic-bezier(.34,1.56,.64,1) .2s both;
}

.steps-wrap{
  display:flex;justify-content:center;align-items:center;
  gap:0;margin:40px auto 48px;max-width:480px;padding:0 40px;
  animation:heroSlide .7s ease .3s both;
}
.step-item{
  display:flex;flex-direction:column;align-items:center;gap:8px;flex:1;
}
.step-circle{
  width:44px;height:44px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  font-family:'Syne',sans-serif;font-weight:800;font-size:16px;
  background:#fff;border:2.5px solid var(--border);color:var(--muted);
  transition:all .4s cubic-bezier(.34,1.56,.64,1);
  position:relative;
}
.step-circle.active{
  background:var(--teal);border-color:var(--teal);color:#fff;
  box-shadow:0 8px 24px rgba(0,180,198,.4);
  transform:scale(1.1);
}
.step-circle.done{
  background:var(--lime);border-color:var(--lime);color:#fff;
}
.step-label{font-size:11px;font-weight:700;color:var(--muted);letter-spacing:.04em;text-transform:uppercase;}
.step-label.active{color:var(--teal);}
.step-line{flex:1;height:2px;background:var(--border);margin:0 4px;margin-bottom:22px;transition:background .4s ease;}
.step-line.done{background:var(--lime);}

.rec-card{
  max-width:900px;margin:0 auto;padding:0 24px;
}
.question-panel{
  background:var(--glass);backdrop-filter:blur(20px);
  border:1.5px solid rgba(255,255,255,.6);
  border-radius:28px;padding:52px 48px;
  box-shadow:0 24px 80px rgba(0,0,0,.08),0 0 0 1px rgba(255,255,255,.5) inset;
  position:relative;overflow:hidden;
  animation:panelIn .6s cubic-bezier(.34,1.56,.64,1) .4s both;
}
@keyframes panelIn{from{opacity:0;transform:translateY(40px) scale(.97)}to{opacity:1;transform:translateY(0) scale(1)}}

.question-panel::before{
  content:'';position:absolute;top:-1px;left:48px;right:48px;height:3px;
  background:linear-gradient(90deg,var(--teal),var(--lime));
  border-radius:0 0 4px 4px;
}

.q-block{
  margin-bottom:52px;
  opacity:0;transform:translateX(30px);
  transition:opacity .5s ease,transform .5s cubic-bezier(.34,1.56,.64,1);
}
.q-block.visible{opacity:1;transform:translateX(0);}

.q-header{
  display:flex;align-items:center;gap:16px;margin-bottom:28px;
}
.q-num{
  width:48px;height:48px;flex-shrink:0;
  border-radius:14px;
  background:linear-gradient(135deg,var(--teal),var(--teal-deep));
  display:flex;align-items:center;justify-content:center;
  font-family:'Syne',sans-serif;font-size:20px;font-weight:900;color:#fff;
  box-shadow:0 8px 20px rgba(0,180,198,.3);
}
.q-title{font-family:'Syne',sans-serif;font-size:22px;font-weight:800;color:var(--navy);letter-spacing:-.02em;}

.options-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}

.opt-card{
  background:#fff;border:2px solid var(--border);border-radius:18px;
  padding:24px 16px;text-align:center;cursor:pointer;
  transition:all .3s cubic-bezier(.34,1.56,.64,1);
  position:relative;overflow:hidden;
  user-select:none;
}
.opt-card::before{
  content:'';position:absolute;inset:0;
  background:linear-gradient(135deg,var(--teal),var(--teal-deep));
  opacity:0;transition:opacity .3s ease;border-radius:16px;
}
.opt-card:hover{
  border-color:var(--teal);transform:translateY(-6px) scale(1.02);
  box-shadow:0 16px 40px rgba(0,180,198,.2);
}
.opt-card.selected{
  border-color:var(--teal);
  transform:translateY(-6px) scale(1.04);
  box-shadow:0 20px 48px rgba(0,180,198,.3);
}
.opt-card.selected::before{opacity:1;}
.opt-card.selected .opt-emoji,
.opt-card.selected .opt-title,
.opt-card.selected .opt-desc{color:#fff !important;position:relative;z-index:1;}

.opt-emoji{
  font-size:42px;margin-bottom:14px;display:block;
  transition:transform .3s cubic-bezier(.34,1.56,.64,1);
  position:relative;z-index:1;
}
.opt-card:hover .opt-emoji{transform:scale(1.15) rotate(-5deg);}
.opt-card.selected .opt-emoji{transform:scale(1.2) rotate(5deg);}

.opt-title{
  font-family:'Syne',sans-serif;font-weight:800;font-size:15px;
  color:var(--navy);margin-bottom:6px;
  position:relative;z-index:1;transition:color .2s;
}
.opt-desc{
  font-size:12px;color:var(--muted);font-weight:500;
  position:relative;z-index:1;transition:color .2s;line-height:1.5;
}

.opt-check{
  position:absolute;top:12px;right:12px;
  width:24px;height:24px;border-radius:50%;
  background:rgba(255,255,255,.9);
  display:flex;align-items:center;justify-content:center;
  opacity:0;transform:scale(0);
  transition:all .3s cubic-bezier(.34,1.56,.64,1);z-index:2;
}
.opt-check svg{width:14px;height:14px;stroke:var(--teal);stroke-width:2.5;}
.opt-card.selected .opt-check{opacity:1;transform:scale(1);}

.q-divider{
  height:1px;background:linear-gradient(90deg,transparent,var(--border),transparent);
  margin:0 -48px 52px;
}

.submit-wrap{text-align:center;margin-top:8px;}
.btn-submit{
  display:inline-flex;align-items:center;gap:14px;
  padding:20px 52px;
  background:linear-gradient(135deg,var(--lime),var(--lime-dark));
  color:#fff;border:none;border-radius:16px;
  font-family:'Syne',sans-serif;font-size:18px;font-weight:800;
  cursor:pointer;letter-spacing:-.01em;
  transition:all .4s cubic-bezier(.34,1.56,.64,1);
  box-shadow:0 12px 36px rgba(140,198,63,.4);
  position:relative;overflow:hidden;
}
.btn-submit::before{
  content:'';position:absolute;inset:0;
  background:linear-gradient(135deg,rgba(255,255,255,.2),transparent);
  opacity:0;transition:opacity .3s;
}
.btn-submit:hover:not(:disabled){
  transform:translateY(-4px) scale(1.02);
  box-shadow:0 20px 50px rgba(140,198,63,.5);
}
.btn-submit:hover::before{opacity:1;}
.btn-submit:disabled{opacity:.4;cursor:not-allowed;transform:none;box-shadow:none;}
.btn-submit svg{width:22px;height:22px;transition:transform .3s;}
.btn-submit:hover:not(:disabled) svg{transform:translateX(4px);}

.btn-hint{
  margin-top:16px;font-size:13px;color:var(--muted);font-weight:500;
}
.btn-hint span{color:var(--teal);font-weight:700;}

#loading{display:none;text-align:center;padding:60px 20px;}
.loading-inner{
  display:inline-flex;flex-direction:column;align-items:center;gap:24px;
}
.loading-orb{
  width:80px;height:80px;border-radius:50%;
  background:conic-gradient(var(--teal) 0deg,transparent 270deg);
  animation:orbSpin 1s linear infinite;
  position:relative;
}
.loading-orb::after{
  content:'';position:absolute;inset:6px;
  background:#f0f7fa;border-radius:50%;
}
@keyframes orbSpin{to{transform:rotate(360deg)}}
.loading-text{font-family:'Syne',sans-serif;font-size:20px;font-weight:800;color:var(--navy);}
.loading-sub{font-size:14px;color:var(--muted);font-weight:500;}
.loading-dots span{
  display:inline-block;width:8px;height:8px;border-radius:50%;
  background:var(--teal);margin:0 3px;
  animation:dotBounce .8s ease-in-out infinite;
}
.loading-dots span:nth-child(2){animation-delay:.15s;}
.loading-dots span:nth-child(3){animation-delay:.3s;}
@keyframes dotBounce{0%,80%,100%{transform:scale(.6);opacity:.4}40%{transform:scale(1);opacity:1}}

#results{display:none;}
.results-header{
  text-align:center;padding:60px 24px 40px;
}
.results-header h2{
  font-family:'Syne',sans-serif;font-size:clamp(28px,4vw,48px);
  font-weight:900;color:var(--navy);letter-spacing:-.03em;
  margin-bottom:12px;
}
.results-header h2 em{font-style:normal;color:var(--teal);}
.results-header p{font-size:15px;color:var(--muted);font-weight:500;}

.results-grid{
  max-width:1000px;margin:0 auto;padding:0 24px;
  display:grid;gap:20px;
}

.res-card{
  background:var(--glass);backdrop-filter:blur(20px);
  border:1.5px solid rgba(255,255,255,.7);border-radius:24px;
  padding:0;overflow:hidden;
  box-shadow:0 12px 40px rgba(0,0,0,.07);
  transform:translateY(40px);opacity:0;
  transition:all .5s cubic-bezier(.34,1.56,.64,1);
}
.res-card.visible{transform:translateY(0);opacity:1;}
.res-card:hover{
  transform:translateY(-6px) scale(1.01);
  box-shadow:0 24px 60px rgba(0,180,198,.15);
  border-color:rgba(0,180,198,.4);
}

.res-card-top{
  padding:28px 32px 24px;
  display:flex;align-items:center;gap:24px;
  border-bottom:1px solid var(--border);
  position:relative;
}
.rank-badge{
  width:56px;height:56px;flex-shrink:0;border-radius:16px;
  display:flex;align-items:center;justify-content:center;
  font-size:28px;position:relative;
}
.rank-1{background:linear-gradient(135deg,#FFD700,#FFA500);}
.rank-2{background:linear-gradient(135deg,#C0C0C0,#909090);}
.rank-3{background:linear-gradient(135deg,#CD7F32,#8B4513);}
.res-info{flex:1;}
.res-name{font-family:'Syne',sans-serif;font-size:22px;font-weight:900;color:var(--navy);margin-bottom:4px;}
.res-price-block{text-align:right;flex-shrink:0;}
.res-price{font-family:'Syne',sans-serif;font-size:32px;font-weight:900;color:var(--teal);letter-spacing:-.03em;}
.res-price sup{font-size:16px;}
.res-price-label{font-size:12px;color:var(--muted);margin-top:4px;}

.res-card-mid{padding:20px 32px;}
.score-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;}
.score-label{font-size:13px;font-weight:700;color:var(--muted);}
.score-pct{font-family:'Syne',sans-serif;font-size:18px;font-weight:900;color:var(--teal);}
.score-track{height:10px;background:rgba(0,0,0,.06);border-radius:8px;overflow:hidden;}
.score-fill{
  height:100%;border-radius:8px;width:0%;
  background:linear-gradient(90deg,var(--teal),var(--lime));
  transition:width 1.2s cubic-bezier(.22,1,.36,1);
}

.res-card-bot{
  padding:20px 32px 28px;
  background:linear-gradient(135deg,rgba(0,180,198,.04),rgba(140,198,63,.04));
}
.res-reason{
  display:flex;gap:12px;align-items:flex-start;
}
.reason-icon{
  width:36px;height:36px;border-radius:10px;
  background:rgba(0,180,198,.1);
  display:flex;align-items:center;justify-content:center;font-size:18px;
}
.reason-text{font-size:14px;color:var(--muted);line-height:1.65;}

.res-btn{
  display:inline-flex;align-items:center;gap:8px;
  padding:12px 28px;border-radius:10px;
  background:var(--navy);color:#fff;
  font-family:'Syne',sans-serif;font-size:14px;font-weight:800;
  text-decoration:none;margin-top:16px;
  transition:all .3s;
  cursor:pointer;
}
.res-btn:hover{background:var(--teal);transform:translateX(4px);}

.reset-wrap{text-align:center;padding:40px 24px 0;}
.btn-reset{
  display:inline-flex;align-items:center;gap:10px;
  padding:14px 32px;border-radius:12px;
  background:#fff;border:2px solid var(--border);
  font-family:'Syne',sans-serif;font-size:15px;font-weight:800;
  color:var(--navy);cursor:pointer;
  transition:all .3s;
}
.btn-reset:hover{border-color:var(--teal);color:var(--teal);transform:translateY(-2px);}

.floating-tags{
  display:flex;justify-content:center;flex-wrap:wrap;gap:10px;
  padding:0 24px;margin:32px 0 0;
  animation:heroSlide .7s ease .5s both;
}
.ftag{
  padding:8px 18px;border-radius:100px;
  background:rgba(255,255,255,.8);backdrop-filter:blur(8px);
  border:1.5px solid rgba(0,180,198,.2);
  font-size:13px;font-weight:600;color:var(--teal-deep);
  animation:tagFloat ease-in-out infinite;
}
.ftag:nth-child(1){animation-duration:4s;}
.ftag:nth-child(2){animation-duration:5s;animation-delay:.5s;}
.ftag:nth-child(3){animation-duration:4.5s;animation-delay:1s;}
@keyframes tagFloat{
  0%,100%{transform:translateY(0)}
  50%{transform:translateY(-6px)}
}

@media(max-width:700px){
  .rec-hero{padding:50px 20px 32px;}
  .question-panel{padding:32px 24px;}
  .q-divider{margin:0 -24px 40px;}
  .options-grid{grid-template-columns:1fr 1fr;}
  .res-card-top{flex-direction:column;align-items:flex-start;gap:16px;}
  .res-price-block{text-align:left;}
  .res-card-mid,.res-card-bot,.res-card-top{padding-left:20px;padding-right:20px;}
}
@media(max-width:480px){
  .options-grid{grid-template-columns:1fr;}
  .steps-wrap{padding:0 20px;}
  .btn-submit{padding:16px 32px;font-size:16px;}
}
</style>
{% endblock %}

{% block body %}

<div class="mesh-bg"></div>
<div id="particles-bg"></div>

<div class="page-wrap">

  <div class="rec-hero">
    <div class="hero-badge">
      <div class="badge-dot"></div>
      Intelligence Artificielle · Recommandation Personnalisée
    </div>
    <h1>Votre abonnement <br><span class="word-ai">idéal</span> en 3 questions</h1>
    <p>Notre IA analyse votre profil et vous propose les offres les plus adaptées à vos besoins et à votre budget.</p>
    <div class="floating-tags">
      <span class="ftag">🎬 Streaming</span>
      <span class="ftag">🎵 Musique</span>
      <span class="ftag">💼 Productivité</span>
    </div>
  </div>

  <div class="steps-wrap" id="steps-wrap">
    <div class="step-item">
      <div class="step-circle active" id="step1">1</div>
      <div class="step-label active">Budget</div>
    </div>
    <div class="step-line" id="line1"></div>
    <div class="step-item">
      <div class="step-circle" id="step2">2</div>
      <div class="step-label">Intérêt</div>
    </div>
    <div class="step-line" id="line2"></div>
    <div class="step-item">
      <div class="step-circle" id="step3">3</div>
      <div class="step-label">Usage</div>
    </div>
  </div>

  <div class="rec-card" id="form-section">
    <div class="question-panel">
      <!-- Q1 BUDGET -->
      <div class="q-block" id="q1">
        <div class="q-header">
          <div class="q-num">1</div>
          <div class="q-title">Quel est votre budget mensuel ?</div>
        </div>
        <div class="options-grid">
          <div class="opt-card" data-budget="low"><div class="opt-check"><svg viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"/></svg></div><span class="opt-emoji">💰</span><div class="opt-title">Petit budget</div><div class="opt-desc">Moins de 10 DT</div></div>
          <div class="opt-card" data-budget="medium"><div class="opt-check"><svg viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"/></svg></div><span class="opt-emoji">💳</span><div class="opt-title">Budget moyen</div><div class="opt-desc">10-20 DT</div></div>
          <div class="opt-card" data-budget="high"><div class="opt-check"><svg viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"/></svg></div><span class="opt-emoji">💎</span><div class="opt-title">Grand budget</div><div class="opt-desc">20+ DT</div></div>
        </div>
      </div>
      <div class="q-divider"></div>
      <!-- Q2 INTÉRÊT -->
      <div class="q-block" id="q2">
        <div class="q-header">
          <div class="q-num">2</div>
          <div class="q-title">Que recherchez-vous ?</div>
        </div>
        <div class="options-grid">
          <div class="opt-card" data-interest="streaming"><div class="opt-check"><svg viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"/></svg></div><span class="opt-emoji">🎬</span><div class="opt-title">Films & Séries</div><div class="opt-desc">Netflix, Disney+</div></div>
          <div class="opt-card" data-interest="music"><div class="opt-check"><svg viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"/></svg></div><span class="opt-emoji">🎵</span><div class="opt-title">Musique</div><div class="opt-desc">Spotify, Deezer</div></div>
          <div class="opt-card" data-interest="productivity"><div class="opt-check"><svg viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"/></svg></div><span class="opt-emoji">💼</span><div class="opt-title">Productivité</div><div class="opt-desc">Canva, Adobe</div></div>
        </div>
      </div>
      <div class="q-divider"></div>
      <!-- Q3 USAGE -->
      <div class="q-block" id="q3">
        <div class="q-header">
          <div class="q-num">3</div>
          <div class="q-title">Comment allez-vous l'utiliser ?</div>
        </div>
        <div class="options-grid">
          <div class="opt-card" data-usage="personal"><div class="opt-check"><svg viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"/></svg></div><span class="opt-emoji">👤</span><div class="opt-title">Personnel</div><div class="opt-desc">Pour moi seul</div></div>
          <div class="opt-card" data-usage="family"><div class="opt-check"><svg viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"/></svg></div><span class="opt-emoji">👨‍👩‍👧‍👦</span><div class="opt-title">Famille</div><div class="opt-desc">Partagé</div></div>
          <div class="opt-card" data-usage="student"><div class="opt-check"><svg viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"/></svg></div><span class="opt-emoji">🎓</span><div class="opt-title">Étudiant</div><div class="opt-desc">Tarif étudiant</div></div>
        </div>
      </div>
      <div class="submit-wrap">
        <button id="submitBtn" class="btn-submit" disabled>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/></svg>
          Analyser mon profil
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </button>
        <div class="btn-hint" id="btn-hint"><span>0/3</span> questions répondues</div>
      </div>
    </div>
  </div>

  <div id="loading">
    <div class="loading-inner">
      <div class="loading-orb"></div>
      <div class="loading-text">Analyse en cours…</div>
      <div class="loading-sub">Notre IA évalue votre profil</div>
      <div class="loading-dots"><span></span><span></span><span></span></div>
    </div>
  </div>

  <div id="results">
    <div class="results-header">
      <h2>Vos meilleures <em>recommandations</em></h2>
      <p>Résultats personnalisés basés sur votre profil · Triés par score de compatibilité</p>
    </div>
    <div class="results-grid" id="results-grid"></div>
    <div class="reset-wrap">
      <button class="btn-reset" onclick="resetForm()">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
        Recommencer l'analyse
      </button>
    </div>
  </div>

</div>

<script>
// PARTICULES
(function(){
  var bg=document.getElementById('particles-bg');
  for(var i=0;i<18;i++){
    var p=document.createElement('div');
    p.className='particle';
    var size=Math.random()*6+3;
    p.style.cssText='width:'+size+'px;height:'+size+'px;left:'+Math.random()*100+'%;animation-duration:'+(Math.random()*15+8)+'s;animation-delay:'+(Math.random()*10)+'s;';
    bg.appendChild(p);
  }
})();

// SCROLL REVEAL
(function(){
  var obs=new IntersectionObserver(function(entries){
    entries.forEach(function(e){if(e.isIntersecting)e.target.classList.add('visible');});
  },{threshold:.15});
  document.querySelectorAll('.q-block').forEach(function(el){obs.observe(el);});
})();

// SÉLECTIONS
var selectedBudget=null,selectedInterest=null,selectedUsage=null;

function setupOptions(attr){
  document.querySelectorAll('[data-'+attr+']').forEach(function(el){
    el.addEventListener('click',function(){
      document.querySelectorAll('[data-'+attr+']').forEach(function(o){o.classList.remove('selected');});
      el.classList.add('selected');
      if(attr==='budget'){ selectedBudget=el.dataset.budget; updateStep(1,'done');updateStep(2,'active'); }
      if(attr==='interest'){ selectedInterest=el.dataset.interest; updateStep(2,'done');updateStep(3,'active'); }
      if(attr==='usage'){ selectedUsage=el.dataset.usage; updateStep(3,'done'); }
      checkSubmit();
    });
  });
}

setupOptions('budget');
setupOptions('interest');
setupOptions('usage');

function updateStep(n,state){
  var circle=document.getElementById('step'+n);
  circle.className='step-circle '+(state==='done'?'done':'active');
  var label=circle.nextElementSibling;
  label.className='step-label '+(state==='active'?'active':'');
  if(n<3){
    var line=document.getElementById('line'+n);
    if(state==='done')line.classList.add('done');
  }
}

function checkSubmit(){
  var btn=document.getElementById('submitBtn');
  var count=[selectedBudget,selectedInterest,selectedUsage].filter(Boolean).length;
  btn.disabled=count<3;
  document.getElementById('btn-hint').innerHTML='<span>'+count+'/3</span> questions répondues'+(count===3?' ✓':'');
}

// SOUMISSION
document.getElementById('submitBtn').addEventListener('click',async function(){
  var formSection=document.getElementById('form-section');
  var stepsWrap=document.getElementById('steps-wrap');
  var loading=document.getElementById('loading');
  var results=document.getElementById('results');

  formSection.style.transition='opacity .4s ease,transform .4s ease';
  formSection.style.opacity='0';formSection.style.transform='translateY(-20px)';
  stepsWrap.style.transition='opacity .3s ease';stepsWrap.style.opacity='0';

  setTimeout(function(){
    formSection.style.display='none';stepsWrap.style.display='none';
    loading.style.display='block';
  },400);

  try{
    var response=await fetch('/api/recommendations',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({budget:selectedBudget,interest:selectedInterest,usage:selectedUsage})
    });
    var data=await response.json();
    loading.style.display='none';
    results.style.display='block';
    displayResults(data);
  }catch(err){
    console.error(err);
    loading.style.display='none';
    formSection.style.display='block';formSection.style.opacity='1';formSection.style.transform='none';
    stepsWrap.style.display='flex';stepsWrap.style.opacity='1';
    alert('Une erreur est survenue. Veuillez réessayer.');
  }
});

// AFFICHAGE DES RÉSULTATS (UNIQUEMENT DEPUIS L'API)
function displayResults(data){
  var grid=document.getElementById('results-grid');
  grid.innerHTML='';
  var medals=['🥇','🥈','🥉'];
  var rankClass=['rank-1','rank-2','rank-3'];

  data.recommendations.forEach(function(rec,i){
    var pct=Math.round(rec.score*100);
    var card=document.createElement('div');
    card.className='res-card';
    card.innerHTML=
      '<div class="res-card-top">'+
        '<div class="rank-badge '+rankClass[i]+'">'+medals[i]+'</div>'+
        '<div class="res-info">'+
          '<div class="res-name">'+rec.nom+'</div>'+
        '</div>'+
        '<div class="res-price-block">'+
          '<div class="res-price">'+rec.prix+'<sup>DT</sup></div>'+
          '<div class="res-price-label">/mois</div>'+
        '</div>'+
      '</div>'+
      '<div class="res-card-mid">'+
        '<div class="score-row">'+
          '<span class="score-label">Compatibilité IA</span>'+
          '<span class="score-pct">'+pct+'%</span>'+
        '</div>'+
        '<div class="score-track"><div class="score-fill" data-pct="'+pct+'"></div></div>'+
      '</div>'+
      '<div class="res-card-bot">'+
        '<div class="res-reason">'+
          '<div class="reason-icon">💡</div>'+
          '<div class="reason-text">'+rec.reason+'</div>'+
        '</div>'+
        '<a href="/client/abonnement/'+rec.id+'" class="res-btn">Découvrir →</a>'+
      '</div>';
    grid.appendChild(card);
    setTimeout(function(){
      card.classList.add('visible');
      setTimeout(function(){card.querySelector('.score-fill').style.width=pct+'%';},200);
    },i*180);
  });
}

// RESET
function resetForm(){
  var formSection=document.getElementById('form-section');
  var stepsWrap=document.getElementById('steps-wrap');
  var results=document.getElementById('results');
  results.style.display='none';
  formSection.style.display='block';
  stepsWrap.style.display='flex';
  requestAnimationFrame(function(){
    formSection.style.opacity='1';formSection.style.transform='none';
    stepsWrap.style.opacity='1';
  });
  selectedBudget=null;selectedInterest=null;selectedUsage=null;
  document.querySelectorAll('.opt-card').forEach(function(c){c.classList.remove('selected');});
  ['step1','step2','step3'].forEach(function(id,i){
    document.getElementById(id).className='step-circle'+(i===0?' active':'');
  });
  ['line1','line2'].forEach(function(id){document.getElementById(id).classList.remove('done');});
  document.getElementById('btn-hint').innerHTML='<span>0/3</span> questions répondues';
  document.getElementById('submitBtn').disabled=true;
  window.scrollTo({top:0,behavior:'smooth'});
}
</script>

{% endblock %}