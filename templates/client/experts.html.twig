{% extends 'base.html.twig' %}

{% block title %}Experts et Offres{% endblock %}

{% block stylesheets %}
<style>
    .client-page {
        max-width: 1280px;
        margin: 40px auto 80px;
        padding: 0 24px;
    }

    .hero-client {
        position: relative;
        overflow: hidden;
        background: linear-gradient(135deg, #f8fbff 0%, #eef5ff 100%);
        border: 1px solid #dbe8f7;
        border-radius: 28px;
        padding: 44px 42px;
        margin-bottom: 34px;
        box-shadow: 0 20px 45px rgba(27, 63, 104, 0.07);
    }

    .hero-client::before {
        content: "";
        position: absolute;
        width: 260px;
        height: 260px;
        border-radius: 50%;
        background: rgba(26, 111, 196, 0.08);
        top: -80px;
        right: -60px;
    }

    .hero-client::after {
        content: "";
        position: absolute;
        width: 180px;
        height: 180px;
        border-radius: 50%;
        background: rgba(26, 111, 196, 0.05);
        bottom: -60px;
        right: 120px;
    }

    .hero-content {
        position: relative;
        z-index: 2;
        max-width: 760px;
    }

    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(26, 111, 196, 0.10);
        color: #1a6fc4;
        border: 1px solid rgba(26, 111, 196, 0.14);
        padding: 8px 14px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 18px;
    }

    .hero-client h1 {
        margin: 0 0 14px;
        font-size: 2.7rem;
        line-height: 1.15;
        font-weight: 800;
        color: #1b2f46;
        letter-spacing: -0.5px;
    }

    .hero-client p {
        margin: 0;
        font-size: 1.05rem;
        line-height: 1.8;
        color: #61758a;
    }

    .section-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 22px;
        flex-wrap: wrap;
        gap: 12px;
    }

    .section-title {
        margin: 0;
        font-size: 1.6rem;
        font-weight: 800;
        color: #1f3147;
    }

    .section-subtitle {
        color: #7b8da1;
        font-size: 14px;
    }

    .filters-bar {
        background: #ffffff;
        border: 1px solid #e8eef6;
        border-radius: 22px;
        padding: 20px;
        margin-bottom: 28px;
        box-shadow: 0 10px 24px rgba(17, 38, 63, 0.05);
    }

    .filters-form {
        display: grid;
        grid-template-columns: 1.6fr 1fr 1fr auto auto;
        gap: 14px;
        align-items: center;
    }

    .filter-group {
        position: relative;
        display: flex;
        align-items: center;
    }

    .filter-icon {
        position: absolute;
        left: 14px;
        font-size: 15px;
        color: #7a8ea5;
        pointer-events: none;
    }

    .filters-input,
    .filters-select {
        width: 100%;
        height: 50px;
        border: 1px solid #d9e5f1;
        border-radius: 14px;
        background: #fbfdff;
        font-size: 14px;
        color: #22374d;
        outline: none;
        transition: all 0.2s ease;
    }

    .filters-input {
        padding: 0 14px 0 42px;
    }

    .filters-select {
        padding: 0 14px;
    }

    .filters-input:focus,
    .filters-select:focus {
        border-color: #1a6fc4;
        box-shadow: 0 0 0 4px rgba(26, 111, 196, 0.08);
        background: #fff;
    }

    .btn-filter {
        height: 50px;
        padding: 0 18px;
        border: none;
        border-radius: 14px;
        font-weight: 700;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: 0.2s ease;
    }

    .btn-filter-primary {
        background: #1f6fbe;
        color: #fff;
        box-shadow: 0 8px 18px rgba(26, 111, 196, 0.14);
    }

    .btn-filter-primary:hover {
        background: #175fa5;
        color: #fff;
        transform: translateY(-1px);
    }

    .btn-filter-light {
        background: #eef3f8;
        color: #415466;
    }

    .btn-filter-light:hover {
        background: #dfe8f1;
        color: #22374d;
    }

    .experts-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
        gap: 24px;
    }

    .expert-card-client {
        background: linear-gradient(180deg, #ffffff 0%, #fcfdff 100%);
        border: 1px solid #e7edf5;
        border-radius: 26px;
        padding: 26px;
        box-shadow: 0 14px 30px rgba(17, 38, 63, 0.06);
        transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
        position: relative;
        overflow: hidden;
    }

    .expert-card-client::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 4px;
        background: linear-gradient(90deg, #1f6fbe, #6aa9e9);
    }

    .expert-card-client:hover {
        transform: translateY(-4px);
        box-shadow: 0 16px 34px rgba(17, 38, 63, 0.10);
        border-color: #dbe6f2;
    }

    .expert-top-client {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 22px;
    }

    .expert-avatar-client {
        width: 72px;
        height: 72px;
        border-radius: 22px;
        background: linear-gradient(135deg, #eaf3ff, #d8e8fb);
        color: #1f6fbe;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 26px;
        flex-shrink: 0;
        border: 1px solid #d4e3f4;
        box-shadow: inset 0 1px 0 rgba(255,255,255,0.8);
    }

    .expert-name-client {
        margin: 0;
        font-size: 1.35rem;
        font-weight: 800;
        color: #1f3147;
        line-height: 1.2;
    }

    .expert-badge-client {
        display: inline-flex;
        align-items: center;
        margin-top: 9px;
        padding: 7px 12px;
        border-radius: 999px;
        background: #f7f9fc;
        color: #4c6f94;
        border: 1px solid #e3ebf5;
        font-size: 12px;
        font-weight: 700;
    }

    .expert-info-client {
        display: grid;
        gap: 12px;
        margin-top: 8px;
    }

    .expert-info-item {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #607387;
        font-size: 15px;
    }

    .expert-info-item strong {
        color: #23384d;
        min-width: 95px;
    }

    .exp-badge {
        display: inline-flex;
        align-items: center;
        padding: 6px 12px;
        border-radius: 999px;
        background: #eef6ff;
        color: #1f6fbe;
        font-weight: 700;
        font-size: 13px;
        border: 1px solid #d6e7fb;
    }

    .expert-divider {
        height: 1px;
        background: #edf2f7;
        margin: 22px 0 18px;
    }

    .expert-footer-client {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .expert-mini {
        font-size: 13px;
        color: #8a99aa;
    }

    .btn-client-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #1f6fbe;
        color: #fff;
        text-decoration: none;
        padding: 11px 17px;
        border-radius: 12px;
        font-weight: 700;
        transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
        box-shadow: 0 8px 18px rgba(26, 111, 196, 0.12);
    }

    .btn-client-primary:hover {
        transform: translateY(-2px);
        color: #fff;
        background: #175fa5;
        box-shadow: 0 12px 24px rgba(26, 111, 196, 0.18);
    }

    .empty-client {
        background: #fff;
        border: 1px dashed #ccd8e6;
        border-radius: 24px;
        padding: 60px 22px;
        text-align: center;
        color: #708090;
        box-shadow: 0 10px 24px rgba(17, 38, 63, 0.04);
    }

    .empty-client h3 {
        margin-bottom: 10px;
        color: #22364c;
        font-size: 1.5rem;
        font-weight: 800;
    }

    @media (max-width: 900px) {
        .filters-form {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 768px) {
        .hero-client {
            padding: 30px 24px;
        }

        .hero-client h1 {
            font-size: 2rem;
        }

        .experts-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
{% endblock %}

{% block body %}
<div class="client-page">

    <div class="hero-client">
        <div class="hero-content">
            <div class="hero-badge">Experts certifiés • Services financiers</div>
            <h1>Trouvez l’expert adapté à votre besoin</h1>
            <p>
                Consultez une sélection d’experts comptables spécialisés en comptabilité, fiscalité,
                budget, planification financière et gestion des dépenses. Comparez leurs profils et
                découvrez les offres disponibles en quelques clics.
            </p>
        </div>
    </div>
    
    

    <div class="section-head">
        <div>
            <h2 class="section-title">Nos experts disponibles</h2>
            <div class="section-subtitle">Choisissez un expert puis consultez ses offres de service.</div>
        </div>
    </div>
<div class="filters-bar">
    <form method="get" action="{{ path('app_client_experts') }}" class="filters-form">

        <div class="filter-group search-group">
            <span class="filter-icon">🔍</span>
            <input
                type="text"
                name="search"
                placeholder="Rechercher un expert..."
                value="{{ search ?? '' }}"
                class="filters-input"
            >
        </div>

        <select name="specialite" class="filters-select">
            <option value="">Toutes les spécialités</option>
            <option value="comptabilite_generale" {{ specialite == 'comptabilite_generale' ? 'selected' : '' }}>
                Comptabilité générale
            </option>
            <option value="gestion_financiere" {{ specialite == 'gestion_financiere' ? 'selected' : '' }}>
                Gestion financière
            </option>
            <option value="fiscalite" {{ specialite == 'fiscalite' ? 'selected' : '' }}>
                Fiscalité
            </option>
        </select>

        <select name="tri" class="filters-select">
            <option value="">Trier par</option>
            <option value="experience_desc" {{ tri == 'experience_desc' ? 'selected' : '' }}>
                Expérience : plus élevée
            </option>
            <option value="experience_asc" {{ tri == 'experience_asc' ? 'selected' : '' }}>
                Expérience : plus faible
            </option>
        </select>

        <button type="submit" class="btn-filter btn-filter-primary">
            Rechercher
        </button>

        <a href="{{ path('app_client_experts') }}" class="btn-filter btn-filter-light">
            Reset
        </a>

    </form>
    </div>

    {% if experts|length > 0 %}
        <div class="experts-grid">
            {% for expert in experts %}
                <div class="expert-card-client">
                    <div class="expert-top-client">
                <div class="expert-avatar-client">
                    {% if expert.imageName %}
                        <img
                            src="{{ vich_uploader_asset(expert, 'imageFile') }}"
                            alt="{{ expert.nom }} {{ expert.prenom }}"
                            style="width: 72px; height: 72px; object-fit: cover; border-radius: 22px;"
                        >
                    {% else %}
                        {{ expert.nom|first|upper }}{{ expert.prenom|first|upper }}
                    {% endif %}
                </div>

                        <div>
                            <h3 class="expert-name-client">{{ expert.nom }} {{ expert.prenom }}</h3>
                            <span class="expert-badge-client">
                                {{ expert.specialite|replace({
                                    'comptabilite_generale': 'Comptabilité générale',
                                    'fiscalite': 'Fiscalité',
                                    'audit': 'Audit',
                                    'gestion_financiere': 'Gestion financière',
                                    'conseil_juridique': 'Conseil juridique',
                                    'paie_rh': 'Paie et RH',
                                    'creation_entreprise': 'Création d’entreprise'
                                }) }}
                            </span>
                        </div>
                    </div>

                    <div class="expert-info-client">
                        <div class="expert-info-item">
                            <strong>Email :</strong>
                            <span>{{ expert.email }}</span>
                        </div>
                        <div class="expert-info-item">
                            <strong>Téléphone :</strong>
                            <span>{{ expert.telephone }}</span>
                        </div>
                        <div class="expert-info-item">
                            <strong>Expérience :</strong>
                            <span class="exp-badge">{{ expert.experience }} ans</span>
                        </div>
                    </div>

                    <div class="expert-divider"></div>

                    <div class="expert-footer-client">
                        <span class="expert-mini">Expert disponible pour consultation</span>
                        <a href="{{ path('app_client_offres_expert', {'id': expert.id}) }}" class="btn-client-primary">
                            Voir les offres
                        </a>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="empty-client">
            <h3>Aucun expert disponible</h3>
            <p>Les experts seront affichés ici dès qu’ils seront ajoutés.</p>
        </div>
    {% endif %}

</div>
{% endblock %}