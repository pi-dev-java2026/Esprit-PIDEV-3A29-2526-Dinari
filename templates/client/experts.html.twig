{% extends 'base.html.twig' %}

{% block title %}Experts et Offres{% endblock %}

{% block stylesheets %}
<style>
    .client-page {
        max-width: 1380px;
        margin: 34px auto 80px;
        padding: 0 22px;
    }

    .hero-client {
        position: relative;
        overflow: hidden;
        border-radius: 32px;
        padding: 50px 46px;
        margin-bottom: 30px;
        background:
            radial-gradient(circle at top right, rgba(88, 160, 255, 0.20), transparent 28%),
            radial-gradient(circle at bottom left, rgba(40, 120, 220, 0.10), transparent 30%),
            linear-gradient(135deg, #f8fbff 0%, #edf4ff 100%);
        border: 1px solid #dce8f7;
        box-shadow: 0 24px 50px rgba(19, 52, 90, 0.08);
    }

    .hero-client::before {
        content: "";
        position: absolute;
        width: 280px;
        height: 280px;
        right: -80px;
        top: -100px;
        border-radius: 50%;
        background: rgba(31, 111, 190, 0.08);
    }

    .hero-client::after {
        content: "";
        position: absolute;
        width: 170px;
        height: 170px;
        left: 10%;
        bottom: -70px;
        border-radius: 50%;
        background: rgba(31, 111, 190, 0.05);
    }

    .hero-content {
        position: relative;
        z-index: 2;
        max-width: 820px;
    }

    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        border-radius: 999px;
        background: rgba(31, 111, 190, 0.10);
        border: 1px solid rgba(31, 111, 190, 0.14);
        color: #1f6fbe;
        font-size: 13px;
        font-weight: 800;
        margin-bottom: 16px;
    }

    .hero-client h1 {
        margin: 0 0 14px;
        font-size: 2.8rem;
        line-height: 1.12;
        font-weight: 900;
        color: #1b2f46;
        letter-spacing: -0.5px;
    }

    .hero-client p {
        margin: 0;
        font-size: 1.04rem;
        line-height: 1.85;
        color: #61758a;
    }

    /* ===== IA SECTION ===== */
    .ai-smart-section {
        position: relative;
        overflow: hidden;
        border-radius: 30px;
        margin-bottom: 32px;
        background:
            linear-gradient(135deg, #0f4f92 0%, #1f6fbe 45%, #4a97e2 100%);
        color: #fff;
        box-shadow: 0 24px 50px rgba(17, 55, 99, 0.16);
    }

    .ai-smart-section::before {
        content: "";
        position: absolute;
        width: 260px;
        height: 260px;
        border-radius: 50%;
        top: -70px;
        right: -70px;
        background: rgba(255, 255, 255, 0.10);
    }

    .ai-smart-section::after {
        content: "";
        position: absolute;
        width: 190px;
        height: 190px;
        border-radius: 50%;
        bottom: -70px;
        left: -40px;
        background: rgba(255, 255, 255, 0.08);
    }

    .ai-smart-inner {
        position: relative;
        z-index: 2;
        padding: 30px;
        display: grid;
        grid-template-columns: 1.35fr 0.9fr;
        gap: 24px;
        align-items: stretch;
    }

    .ai-smart-left {
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .ai-label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        width: fit-content;
        padding: 8px 14px;
        border-radius: 999px;
        background: rgba(255,255,255,0.12);
        border: 1px solid rgba(255,255,255,0.18);
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.2px;
        margin-bottom: 16px;
    }

    .ai-smart-title {
        margin: 0 0 12px;
        font-size: 2rem;
        line-height: 1.2;
        font-weight: 900;
        color: #ffffff;
    }

    .ai-smart-text {
        margin: 0 0 22px;
        font-size: 15px;
        line-height: 1.8;
        color: rgba(255,255,255,0.88);
        max-width: 720px;
    }

    .ai-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 24px;
    }

    .ai-tag {
        padding: 8px 13px;
        border-radius: 999px;
        background: rgba(255,255,255,0.10);
        border: 1px solid rgba(255,255,255,0.16);
        font-size: 12px;
        font-weight: 700;
        color: #fff;
    }

    .ai-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .ai-main-btn,
    .ai-secondary-btn {
        border: none;
        text-decoration: none;
        border-radius: 16px;
        height: 52px;
        padding: 0 20px;
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: 0.22s ease;
    }

    .ai-main-btn {
        background: #ffffff;
        color: #155ca6;
        box-shadow: 0 12px 25px rgba(0,0,0,0.14);
    }

    .ai-main-btn:hover {
        transform: translateY(-2px);
        background: #f3f8ff;
    }

    .ai-secondary-btn {
        background: rgba(255,255,255,0.10);
        color: #fff;
        border: 1px solid rgba(255,255,255,0.18);
    }

    .ai-secondary-btn:hover {
        transform: translateY(-2px);
        background: rgba(255,255,255,0.16);
        color: #fff;
    }

    .ai-smart-right {
        display: flex;
        align-items: center;
    }

    .ai-preview-card {
        width: 100%;
        border-radius: 24px;
        padding: 22px;
        background: rgba(255,255,255,0.12);
        border: 1px solid rgba(255,255,255,0.18);
        backdrop-filter: blur(10px);
        box-shadow: inset 0 1px 0 rgba(255,255,255,0.08);
    }

    .ai-preview-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 18px;
    }

    .ai-preview-head h3 {
        margin: 0;
        font-size: 1rem;
        font-weight: 800;
        color: #fff;
    }

    .ai-pulse {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: #7dffb2;
        box-shadow: 0 0 0 0 rgba(125,255,178,0.7);
        animation: pulse 1.8s infinite;
    }

    @keyframes pulse {
        0% { box-shadow: 0 0 0 0 rgba(125,255,178,0.7); }
        70% { box-shadow: 0 0 0 10px rgba(125,255,178,0); }
        100% { box-shadow: 0 0 0 0 rgba(125,255,178,0); }
    }

    .ai-preview-list {
        display: grid;
        gap: 12px;
    }

    .ai-preview-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 12px;
        border-radius: 16px;
        background: rgba(255,255,255,0.10);
    }

    .ai-preview-icon {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        background: rgba(255,255,255,0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        flex-shrink: 0;
    }

    .ai-preview-item strong {
        display: block;
        font-size: 13px;
        margin-bottom: 4px;
        color: #fff;
    }

    .ai-preview-item span {
        display: block;
        font-size: 13px;
        line-height: 1.6;
        color: rgba(255,255,255,0.84);
    }

    /* Result card */
    .ai-prediction-result {
        margin-top: 22px;
        border-radius: 24px;
        padding: 22px;
        background: linear-gradient(135deg, #ffffff 0%, #f7fbff 100%);
        border: 1px solid #dbe8f7;
        color: #1f3147;
        box-shadow: 0 16px 32px rgba(10, 34, 58, 0.06);
    }

    .ai-prediction-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 16px;
    }

    .ai-prediction-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 14px;
        border-radius: 999px;
        background: #eaf4ff;
        color: #165ea8;
        border: 1px solid #d4e6fa;
        font-size: 12px;
        font-weight: 800;
    }

    .ai-prediction-title {
        margin: 0;
        font-size: 1.2rem;
        font-weight: 900;
        color: #17324e;
    }

    .ai-prediction-speciality {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin-top: 8px;
        padding: 13px 18px;
        border-radius: 16px;
        background: linear-gradient(135deg, #1f6fbe, #4e98e0);
        color: #fff;
        font-weight: 800;
        font-size: 15px;
        box-shadow: 0 14px 28px rgba(31, 111, 190, 0.18);
    }

    .ai-prediction-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
        margin-top: 16px;
    }

    .ai-prediction-box {
        border-radius: 18px;
        padding: 14px;
        background: #fbfdff;
        border: 1px solid #e6eef7;
    }

    .ai-prediction-box strong {
        display: block;
        font-size: 13px;
        color: #183450;
        margin-bottom: 6px;
    }

    .ai-prediction-box span {
        display: block;
        font-size: 13px;
        color: #6a7f94;
        line-height: 1.6;
    }

    .ai-note {
        margin-top: 15px;
        font-size: 13px;
        line-height: 1.7;
        color: #6e8195;
    }

    /* Modal */
    .custom-modal {
        position: fixed;
        inset: 0;
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        padding: 22px;
    }

    .custom-modal.show-modal {
        display: flex;
    }

    .custom-modal-backdrop {
        position: absolute;
        inset: 0;
        background: rgba(15, 23, 42, 0.60);
        backdrop-filter: blur(4px);
    }

    .custom-modal-content {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 760px;
        background: #ffffff;
        border-radius: 28px;
        padding: 30px;
        border: 1px solid #e4edf7;
        box-shadow: 0 28px 65px rgba(15, 23, 42, 0.22);
        animation: modalFadeIn 0.25s ease;
    }

    @keyframes modalFadeIn {
        from {
            opacity: 0;
            transform: translateY(16px) scale(0.98);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .custom-modal-close {
        position: absolute;
        top: 14px;
        right: 16px;
        width: 42px;
        height: 42px;
        border: none;
        border-radius: 50%;
        background: #eef4fb;
        color: #33506d;
        font-size: 24px;
        cursor: pointer;
        transition: 0.2s ease;
    }

    .custom-modal-close:hover {
        background: #dfeaf6;
    }

    .custom-modal-header {
        margin-bottom: 20px;
        padding-right: 36px;
    }

    .custom-modal-header h3 {
        margin: 0 0 8px;
        font-size: 1.5rem;
        font-weight: 900;
        color: #1f3147;
    }

    .custom-modal-header p {
        margin: 0;
        color: #6f8296;
        font-size: 14px;
        line-height: 1.8;
    }

    .modal-ai-form {
        display: grid;
        gap: 15px;
    }

    .ai-field-label {
        font-size: 13px;
        font-weight: 800;
        color: #26435f;
        margin-bottom: 4px;
    }

    .ai-textarea {
        width: 100%;
        min-height: 140px;
        border: 1px solid #d9e5f1;
        border-radius: 18px;
        background: #fbfdff;
        font-size: 14px;
        color: #22374d;
        outline: none;
        transition: all 0.2s ease;
        padding: 16px;
        resize: vertical;
        line-height: 1.7;
    }

    .ai-textarea:focus {
        border-color: #1a6fc4;
        box-shadow: 0 0 0 4px rgba(26, 111, 196, 0.08);
        background: #fff;
    }

    .ai-submit {
        min-height: 54px;
        border: none;
        border-radius: 16px;
        padding: 0 20px;
        background: linear-gradient(135deg, #1f6fbe, #3e8de0);
        color: #fff;
        font-weight: 800;
        cursor: pointer;
        transition: 0.2s ease;
        box-shadow: 0 10px 22px rgba(26, 111, 196, 0.14);
    }

    .ai-submit:hover {
        background: linear-gradient(135deg, #175fa5, #327dcb);
        transform: translateY(-1px);
    }

    .ai-help-text {
        margin-top: -4px;
        font-size: 13px;
        color: #7a8ea5;
        line-height: 1.6;
    }

    /* Section header */
    .section-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 22px;
        gap: 16px;
        flex-wrap: wrap;
    }

    .section-title {
        margin: 0;
        font-size: 1.8rem;
        font-weight: 900;
        color: #1f3147;
    }

    .section-subtitle {
        color: #7b8da1;
        font-size: 14px;
        margin-top: 6px;
        line-height: 1.7;
    }

    .btn-client-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #1f6fbe, #3a89dc);
        color: #fff;
        text-decoration: none;
        padding: 12px 18px;
        border-radius: 14px;
        font-weight: 800;
        transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
        box-shadow: 0 10px 22px rgba(26, 111, 196, 0.14);
    }

    .btn-client-primary:hover {
        transform: translateY(-2px);
        color: #fff;
        background: linear-gradient(135deg, #175fa5, #327dcb);
        box-shadow: 0 14px 28px rgba(26, 111, 196, 0.18);
    }

    /* Filters */
    .filters-bar {
        background: #ffffff;
        border: 1px solid #e8eef6;
        border-radius: 24px;
        padding: 20px;
        margin-bottom: 28px;
        box-shadow: 0 12px 28px rgba(17, 38, 63, 0.05);
    }

    .filters-form {
        display: grid;
        grid-template-columns: 1.6fr 1fr 1fr auto auto;
        gap: 14px;
        align-items: center;
    }

    .filter-group {
        position: relative;
        display: flex;
        align-items: center;
    }

    .filter-icon {
        position: absolute;
        left: 14px;
        font-size: 15px;
        color: #7a8ea5;
        pointer-events: none;
    }

    .filters-input,
    .filters-select {
        width: 100%;
        height: 52px;
        border: 1px solid #d9e5f1;
        border-radius: 15px;
        background: #fbfdff;
        font-size: 14px;
        color: #22374d;
        outline: none;
        transition: all 0.2s ease;
    }

    .filters-input {
        padding: 0 14px 0 42px;
    }

    .filters-select {
        padding: 0 14px;
    }

    .filters-input:focus,
    .filters-select:focus {
        border-color: #1a6fc4;
        box-shadow: 0 0 0 4px rgba(26, 111, 196, 0.08);
        background: #fff;
    }

    .btn-filter {
        height: 52px;
        padding: 0 18px;
        border: none;
        border-radius: 14px;
        font-weight: 800;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: 0.2s ease;
    }

    .btn-filter-primary {
        background: linear-gradient(135deg, #1f6fbe, #3a89dc);
        color: #fff;
        box-shadow: 0 10px 20px rgba(26, 111, 196, 0.14);
    }

    .btn-filter-primary:hover {
        background: linear-gradient(135deg, #175fa5, #327dcb);
        color: #fff;
        transform: translateY(-1px);
    }

    .btn-filter-light {
        background: #eef3f8;
        color: #415466;
    }

    .btn-filter-light:hover {
        background: #dfe8f1;
        color: #22374d;
    }

    /* Experts */
    .experts-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(365px, 1fr));
        gap: 26px;
    }

    .expert-card-client {
        position: relative;
        overflow: hidden;
        border-radius: 28px;
        background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
        border: 1px solid #e6edf6;
        box-shadow: 0 16px 34px rgba(17, 38, 63, 0.06);
        transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    }

    .expert-card-client:hover {
        transform: translateY(-6px);
        box-shadow: 0 24px 42px rgba(17, 38, 63, 0.11);
        border-color: #d8e4f1;
    }

    .expert-card-client::before {
        content: "";
        position: absolute;
        inset: 0 auto auto 0;
        width: 100%;
        height: 5px;
        background: linear-gradient(90deg, #1f6fbe, #6aa9e9);
    }

    .expert-card-inner {
        padding: 24px;
    }

    .expert-cover {
        position: relative;
        background: linear-gradient(135deg, #eff6ff 0%, #dcecff 100%);
        border: 1px solid #d9e8f8;
        border-radius: 22px;
        padding: 20px;
        margin-bottom: 18px;
        overflow: hidden;
    }

    .expert-cover::before {
        content: "";
        position: absolute;
        width: 120px;
        height: 120px;
        background: rgba(31, 111, 190, 0.08);
        border-radius: 50%;
        top: -30px;
        right: -20px;
    }

    .expert-head-row {
        position: relative;
        z-index: 2;
        display: flex;
        gap: 16px;
        align-items: center;
    }

    .expert-avatar-client {
        width: 82px;
        height: 82px;
        border-radius: 24px;
        background: linear-gradient(135deg, #ffffff, #edf5ff);
        color: #1f6fbe;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 900;
        font-size: 28px;
        flex-shrink: 0;
        border: 1px solid #cfe0f3;
        box-shadow: 0 10px 20px rgba(17, 38, 63, 0.08);
        overflow: hidden;
    }

    .expert-meta {
        min-width: 0;
    }

    .expert-name-client {
        margin: 0 0 10px;
        font-size: 1.36rem;
        font-weight: 900;
        color: #1f3147;
        line-height: 1.2;
    }

    .expert-badge-client {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 13px;
        border-radius: 999px;
        background: rgba(255,255,255,0.76);
        color: #265784;
        border: 1px solid #d5e4f3;
        font-size: 12px;
        font-weight: 800;
        backdrop-filter: blur(4px);
    }

    .expert-description {
        color: #63778b;
        font-size: 14px;
        line-height: 1.75;
        margin: 0 0 18px;
        min-height: 72px;
    }

    .expert-highlights {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
        margin-bottom: 18px;
    }

    .highlight-box {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        background: #f8fbff;
        border: 1px solid #e4edf7;
        border-radius: 16px;
        padding: 13px 12px;
    }

    .highlight-icon {
        width: 38px;
        height: 38px;
        border-radius: 12px;
        background: linear-gradient(135deg, #e7f1ff, #d6e8fc);
        color: #1f6fbe;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        flex-shrink: 0;
        border: 1px solid #d1e1f4;
    }

    .highlight-content strong {
        display: block;
        font-size: 13px;
        color: #1f3147;
        margin-bottom: 3px;
    }

    .highlight-content span {
        font-size: 13px;
        color: #6e8195;
        line-height: 1.5;
        word-break: break-word;
    }

    .expert-footer-client {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
        padding-top: 16px;
        border-top: 1px solid #edf2f7;
    }

    .expert-mini-stack {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .expert-mini {
        font-size: 13px;
        color: #8a99aa;
    }

    .expert-experience {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        width: fit-content;
        padding: 7px 12px;
        border-radius: 999px;
        background: #eef6ff;
        color: #1f6fbe;
        font-weight: 800;
        font-size: 13px;
        border: 1px solid #d6e7fb;
    }

    .btn-client-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 12px 18px;
        border-radius: 14px;
        text-decoration: none;
        font-weight: 800;
        color: #fff;
        background: linear-gradient(135deg, #1f6fbe, #3a89dc);
        box-shadow: 0 10px 20px rgba(26, 111, 196, 0.15);
        transition: 0.2s ease;
    }

    .btn-client-secondary:hover {
        transform: translateY(-2px);
        background: linear-gradient(135deg, #175fa5, #327dcb);
        color: #fff;
    }

    .empty-client {
        background: linear-gradient(180deg, #ffffff 0%, #fcfdff 100%);
        border: 1px dashed #ccd8e6;
        border-radius: 26px;
        padding: 70px 24px;
        text-align: center;
        color: #708090;
        box-shadow: 0 12px 28px rgba(17, 38, 63, 0.05);
    }

    .empty-icon {
        width: 82px;
        height: 82px;
        border-radius: 24px;
        margin: 0 auto 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #eaf3ff, #d8e8fb);
        color: #1f6fbe;
        font-size: 34px;
        border: 1px solid #d4e3f4;
    }

    .empty-client h3 {
        margin: 0 0 10px;
        color: #22364c;
        font-size: 1.6rem;
        font-weight: 900;
    }

    .empty-client p {
        margin: 0 auto;
        max-width: 560px;
        line-height: 1.8;
        font-size: 15px;
    }

    @media (max-width: 1100px) {
        .ai-smart-inner {
            grid-template-columns: 1fr;
        }

        .ai-prediction-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 950px) {
        .filters-form {
            grid-template-columns: 1fr;
        }

        .experts-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 768px) {
        .client-page {
            padding: 0 16px;
        }

        .hero-client {
            padding: 30px 24px;
        }

        .hero-client h1 {
            font-size: 2rem;
        }

        .custom-modal-content {
            padding: 24px 18px;
        }

        .expert-head-row {
            align-items: flex-start;
        }

        .expert-highlights {
            grid-template-columns: 1fr;
        }

        .expert-footer-client {
            flex-direction: column;
            align-items: flex-start;
        }

        .ai-smart-title {
            font-size: 1.55rem;
        }
    }
</style>
{% endblock %}

{% block body %}
<div class="client-page">

    <div class="hero-client">
        <div class="hero-content">
            <div class="hero-badge">Experts certifiés • Services financiers</div>
            <h1>Trouvez l’expert adapté à votre besoin</h1>
            <p>
                Consultez une sélection d’experts comptables spécialisés en comptabilité, fiscalité,
                audit, conseil juridique et gestion financière. Comparez leurs profils et découvrez
                les offres disponibles en quelques clics.
            </p>
        </div>
    </div>

    <div class="ai-smart-section">
        <div class="ai-smart-inner">
            <div class="ai-smart-left">
                <span class="ai-label">✨ Assistant intelligent</span>
                <h2 class="ai-smart-title">Prédiction intelligente de spécialité</h2>
                <p class="ai-smart-text">
                    Décrivez votre besoin en quelques mots et l’application vous recommande
                    automatiquement la spécialité d’expert la plus adaptée. Cela vous aide
                    à trouver plus rapidement le bon professionnel.
                </p>

                <div class="ai-tags">
                    <span class="ai-tag">Fiscalité</span>
                    <span class="ai-tag">Audit</span>
                    <span class="ai-tag">Gestion financière</span>
                    <span class="ai-tag">Conseil juridique</span>
                </div>

                <div class="ai-actions">
                    <button type="button" class="ai-main-btn" onclick="openPredictionModal()">
                        Lancer la prédiction
                    </button>


                </div>
            </div>

            <div class="ai-smart-right">
                <div class="ai-preview-card">
                    <div class="ai-preview-head">
                        <h3>Comment ça fonctionne ?</h3>
                        <span class="ai-pulse"></span>
                    </div>

                    <div class="ai-preview-list">
                        <div class="ai-preview-item">
                            <div class="ai-preview-icon">📝</div>
                            <div>
                                <strong>1. Décrivez votre besoin</strong>
                                <span>Expliquez brièvement votre situation ou votre objectif.</span>
                            </div>
                        </div>

                        <div class="ai-preview-item">
                            <div class="ai-preview-icon">🧠</div>
                            <div>
                                <strong>2. Analyse intelligente</strong>
                                <span>Le système identifie la spécialité la plus pertinente.</span>
                            </div>
                        </div>

                        <div class="ai-preview-item">
                            <div class="ai-preview-icon">🎯</div>
                            <div>
                                <strong>3. Résultat ciblé</strong>
                                <span>Les experts affichés sont orientés selon la prédiction obtenue.</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {% if specialitePredite is not null %}
            <div style="padding: 0 30px 30px;">
                <div class="ai-prediction-result">
                    <div class="ai-prediction-top">
                        <div>
                            <span class="ai-prediction-badge">Résultat de la prédiction</span>
                            <h3 class="ai-prediction-title">La spécialité recommandée pour votre besoin est :</h3>
                            <div class="ai-prediction-speciality">
                                ✅
                                {{ specialitePredite|replace({
                                    'comptabilite_generale': 'Comptabilité générale',
                                    'fiscalite': 'Fiscalité',
                                    'audit': 'Audit',
                                    'gestion_financiere': 'Gestion financière',
                                    'conseil_juridique': 'Conseil juridique',
                                    'paie_rh': 'Paie et RH',
                                    'creation_entreprise': 'Création d’entreprise'
                                }) }}
                            </div>
                        </div>
                    </div>

                    <div class="ai-prediction-grid">
                        <div class="ai-prediction-box">
                            <strong>Votre besoin analysé</strong>
                            <span>{{ besoin|default('Aucune description fournie') }}</span>
                        </div>

                        <div class="ai-prediction-box">
                            <strong>Action effectuée</strong>
                            <span>Les experts affichés sur cette page peuvent être filtrés selon cette recommandation.</span>
                        </div>

                        <div class="ai-prediction-box">
                            <strong>Conseil</strong>
                            <span>Consultez ensuite les profils et les offres pour choisir l’expert le plus adapté.</span>
                        </div>
                    </div>

                    <div class="ai-note">
                        Cette recommandation est une aide à l’orientation. Vous pouvez toujours utiliser
                        les filtres de recherche pour explorer toutes les spécialités.
                    </div>
                </div>
            </div>
        {% endif %}
    </div>

    <div id="predictionModal" class="custom-modal">
        <div class="custom-modal-backdrop" onclick="closePredictionModal()"></div>

        <div class="custom-modal-content">
            <button type="button" class="custom-modal-close" onclick="closePredictionModal()">
                &times;
            </button>

            <div class="custom-modal-header">
                <h3>Prédire la spécialité de l’expert</h3>
                <p>
                    Écrivez votre besoin en une phrase ou deux. Le système analysera votre texte
                    pour vous recommander la spécialité la plus adaptée.
                </p>
            </div>

            <form method="post" action="{{ path('app_client_experts') }}" class="modal-ai-form">
                <div>
                    <div class="ai-field-label">Décrivez votre besoin</div>
                    <textarea
                        name="besoin"
                        class="ai-textarea"
                        placeholder="Exemple : je veux optimiser mes impôts pour mon entreprise ou préparer un audit financier"
                    >{{ besoin|default('') }}</textarea>
                </div>

                <div class="ai-help-text">
                    Exemple : fiscalité, création d’entreprise, audit, paie, gestion comptable...
                </div>

                <button type="submit" class="ai-submit">
                    Faire la prédiction
                </button>
            </form>
        </div>
    </div>

    <div class="section-head">
        <div>
            <h2 class="section-title">Nos experts disponibles</h2>
            <div class="section-subtitle">
                Choisissez un expert, consultez son profil et découvrez ses offres de service.
            </div>
        </div>

        <a href="{{ path('app_mes_reservations') }}" class="btn-client-primary">
            Mes réservations
        </a>
    </div>

    <div class="filters-bar">
        <form method="get" action="{{ path('app_client_experts') }}" class="filters-form">

            <div class="filter-group search-group">
                <span class="filter-icon">🔍</span>
                <input
                    type="text"
                    name="search"
                    placeholder="Rechercher un expert..."
                    value="{{ search ?? '' }}"
                    class="filters-input"
                >
            </div>

            <select name="specialite" class="filters-select">
                <option value="">Toutes les spécialités</option>
                <option value="comptabilite_generale" {{ specialite is defined and specialite == 'comptabilite_generale' ? 'selected' : '' }}>
                    Comptabilité générale
                </option>
                <option value="gestion_financiere" {{ specialite is defined and specialite == 'gestion_financiere' ? 'selected' : '' }}>
                    Gestion financière
                </option>
                <option value="fiscalite" {{ specialite is defined and specialite == 'fiscalite' ? 'selected' : '' }}>
                    Fiscalité
                </option>
                <option value="audit" {{ specialite is defined and specialite == 'audit' ? 'selected' : '' }}>
                    Audit
                </option>
                <option value="conseil_juridique" {{ specialite is defined and specialite == 'conseil_juridique' ? 'selected' : '' }}>
                    Conseil juridique
                </option>
            </select>

            <select name="tri" class="filters-select">
                <option value="">Trier par</option>
                <option value="experience_desc" {{ tri is defined and tri == 'experience_desc' ? 'selected' : '' }}>
                    Expérience : plus élevée
                </option>
                <option value="experience_asc" {{ tri is defined and tri == 'experience_asc' ? 'selected' : '' }}>
                    Expérience : plus faible
                </option>
            </select>

            <button type="submit" class="btn-filter btn-filter-primary">
                Rechercher
            </button>

            <a href="{{ path('app_client_experts') }}" class="btn-filter btn-filter-light">
                Reset
            </a>

        </form>
    </div>

    {% if experts|length > 0 %}
        <div class="experts-grid">
            {% for expert in experts %}
                <div class="expert-card-client">
                    <div class="expert-card-inner">

                        <div class="expert-cover">
                            <div class="expert-head-row">
                                <div class="expert-avatar-client">
                                    {% if expert.imageName %}
                                        <img
                                            src="{{ vich_uploader_asset(expert, 'imageFile') }}"
                                            alt="{{ expert.nom }} {{ expert.prenom }}"
                                            style="width: 82px; height: 82px; object-fit: cover; border-radius: 24px;"
                                        >
                                    {% else %}
                                        {{ expert.nom|first|upper }}{{ expert.prenom|first|upper }}
                                    {% endif %}
                                </div>

                                <div class="expert-meta">
                                    <h3 class="expert-name-client">{{ expert.nom }} {{ expert.prenom }}</h3>
                                    <span class="expert-badge-client">
                                        {{ expert.specialite|replace({
                                            'comptabilite_generale': 'Comptabilité générale',
                                            'fiscalite': 'Fiscalité',
                                            'audit': 'Audit',
                                            'gestion_financiere': 'Gestion financière',
                                            'conseil_juridique': 'Conseil juridique',
                                            'paie_rh': 'Paie et RH',
                                            'creation_entreprise': 'Création d’entreprise'
                                        }) }}
                                    </span>
                                </div>
                            </div>
                        </div>

                        <p class="expert-description">
                            {{ expert.description ? expert.description|slice(0, 140) ~ (expert.description|length > 140 ? '...' : '') : 'Expert comptable disponible pour vous accompagner dans vos besoins administratifs, financiers et fiscaux.' }}
                        </p>

                        <div class="expert-highlights">
                            <div class="highlight-box">
                                <div class="highlight-icon">📧</div>
                                <div class="highlight-content">
                                    <strong>Email</strong>
                                    <span>{{ expert.email }}</span>
                                </div>
                            </div>

                            <div class="highlight-box">
                                <div class="highlight-icon">📞</div>
                                <div class="highlight-content">
                                    <strong>Téléphone</strong>
                                    <span>{{ expert.telephone }}</span>
                                </div>
                            </div>

                            <div class="highlight-box">
                                <div class="highlight-icon">⭐</div>
                                <div class="highlight-content">
                                    <strong>Expérience</strong>
                                    <span>{{ expert.experience }} ans d’expérience</span>
                                </div>
                            </div>

                            <div class="highlight-box">
                                <div class="highlight-icon">🧾</div>
                                <div class="highlight-content">
                                    <strong>Domaine</strong>
                                    <span>
                                        {{ expert.specialite|replace({
                                            'comptabilite_generale': 'Comptabilité générale',
                                            'fiscalite': 'Fiscalité',
                                            'audit': 'Audit',
                                            'gestion_financiere': 'Gestion financière',
                                            'conseil_juridique': 'Conseil juridique',
                                            'paie_rh': 'Paie et RH',
                                            'creation_entreprise': 'Création d’entreprise'
                                        }) }}
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="expert-footer-client">
                            <div class="expert-mini-stack">
                                <span class="expert-experience">✔ {{ expert.experience }} ans d’expérience</span>
                                <span class="expert-mini">Expert disponible pour consultation</span>
                            </div>

                            <a href="{{ path('app_client_offres_expert', {'id': expert.id}) }}" class="btn-client-secondary">
                                Voir les offres
                            </a>
                        </div>

                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="empty-client">
            <div class="empty-icon">👨‍💼</div>
            <h3>Aucun expert disponible</h3>
            <p>
                Aucun expert ne correspond actuellement à votre recherche.
                Essayez de modifier les filtres ou utilisez la prédiction intelligente.
            </p>
        </div>
    {% endif %}

</div>
{% endblock %}

{% block javascripts %}
<script>
    function openPredictionModal() {
        const modal = document.getElementById('predictionModal');
        if (modal) {
            modal.classList.add('show-modal');
            document.body.style.overflow = 'hidden';
        }
    }

    function closePredictionModal() {
        const modal = document.getElementById('predictionModal');
        if (modal) {
            modal.classList.remove('show-modal');
            document.body.style.overflow = 'auto';
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        const modal = document.getElementById('predictionModal');


        document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape' && modal && modal.classList.contains('show-modal')) {
                closePredictionModal();
            }
        });
    });
</script>
{% endblock %}