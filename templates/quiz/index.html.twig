{% extends 'base.html.twig' %}

{% block title %}Quiz index{% endblock %}

{% block body %}
    <h1>Quiz index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Titre</th>
                <th>ListeReponse</th>
                <th>ReponseCorrect</th>
                <th>ScoreQuiz</th>
                <th>DateCreation</th>
                <th>IsExamMode</th>
                <th>TimeLimit</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for quiz in quizzes %}
            <tr>
                <td>{{ quiz.id }}</td>
                <td>{{ quiz.titre }}</td>
                <td>{{ quiz.listeReponse }}</td>
                <td>{{ quiz.reponseCorrect }}</td>
                <td>{{ quiz.scoreQuiz }}</td>
                <td>{{ quiz.dateCreation ? quiz.dateCreation|date('Y-m-d') : '' }}</td>
                <td>{{ quiz.isExamMode ? 'Yes' : 'No' }}</td>
                <td>{{ quiz.timeLimit }}</td>
                <td>
                    <a href="{{ path('app_quiz_show', {'id': quiz.id}) }}">show</a>
                    <a href="{{ path('app_quiz_edit', {'id': quiz.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="9">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_quiz_new') }}">Create new</a>
{% endblock %}
