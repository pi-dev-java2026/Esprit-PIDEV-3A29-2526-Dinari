{% extends 'base.html.twig' %}

{% block title %}Quiz{% endblock %}

{% block body %}
    <h1>Quiz</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ quiz.id }}</td>
            </tr>
            <tr>
                <th>Titre</th>
                <td>{{ quiz.titre }}</td>
            </tr>
            <tr>
                <th>ListeReponse</th>
                <td>{{ quiz.listeReponse }}</td>
            </tr>
            <tr>
                <th>ReponseCorrect</th>
                <td>{{ quiz.reponseCorrect }}</td>
            </tr>
            <tr>
                <th>ScoreQuiz</th>
                <td>{{ quiz.scoreQuiz }}</td>
            </tr>
            <tr>
                <th>DateCreation</th>
                <td>{{ quiz.dateCreation ? quiz.dateCreation|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>IsExamMode</th>
                <td>{{ quiz.isExamMode ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>TimeLimit</th>
                <td>{{ quiz.timeLimit }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_quiz_index') }}">back to list</a>

    <a href="{{ path('app_quiz_edit', {'id': quiz.id}) }}">edit</a>

    {{ include('quiz/_delete_form.html.twig') }}
{% endblock %}
