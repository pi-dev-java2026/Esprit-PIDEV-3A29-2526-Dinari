{% extends 'admin/base.html.twig' %}

{% block title %}Tester la rentabilité{% endblock %}

{% block body %}
<div style="max-width: 900px; margin: 40px auto; padding: 0 20px;">

    <div style="
        background: linear-gradient(135deg, #f8fbff 0%, #eef5ff 100%);
        border: 1px solid #dbe8f7;
        border-radius: 24px;
        padding: 30px;
        margin-bottom: 30px;
        box-shadow: 0 12px 28px rgba(27, 63, 104, 0.07);
    ">
        <h1 style="margin: 0 0 10px; color: #1f3147;">Tester la rentabilité d’un expert</h1>
        <p style="margin: 0; color: #61758a; line-height: 1.7;">
            Remplissez les caractéristiques de l’expert et d’une offre proposée, puis lancez le test IA
            pour estimer la rentabilité potentielle.
        </p>
    </div>

    {% if error %}
        <div style="
            background: #fff3f3;
            border: 1px solid #f2c7c7;
            color: #b42318;
            border-radius: 16px;
            padding: 16px;
            margin-bottom: 20px;
            font-weight: 600;
        ">
            {{ error }}
        </div>
    {% endif %}

    <form method="post" style="
        background: #ffffff;
        border: 1px solid #e8eef6;
        border-radius: 22px;
        padding: 28px;
        box-shadow: 0 10px 24px rgba(17, 38, 63, 0.05);
    ">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 18px;">

            <div>
                <label style="display:block; margin-bottom:8px; font-weight:700; color:#22374d;">Titre de l’offre</label>
                <input
                    type="text"
                    name="titre"
                    value="{{ data.titre }}"
                    required
                    style="width:100%; height:48px; border:1px solid #d9e5f1; border-radius:12px; padding:0 14px;"
                >
            </div>

            <div>
                <label style="display:block; margin-bottom:8px; font-weight:700; color:#22374d;">Spécialité</label>
                <select
                    name="specialite"
                    required
                    style="width:100%; height:48px; border:1px solid #d9e5f1; border-radius:12px; padding:0 14px;"
                >
                    <option value="">Choisir une spécialité</option>
                    <option value="comptabilite_generale" {{ data.specialite == 'comptabilite_generale' ? 'selected' : '' }}>Comptabilité générale</option>
                    <option value="fiscalite" {{ data.specialite == 'fiscalite' ? 'selected' : '' }}>Fiscalité</option>
                    <option value="audit" {{ data.specialite == 'audit' ? 'selected' : '' }}>Audit</option>
                    <option value="gestion_financiere" {{ data.specialite == 'gestion_financiere' ? 'selected' : '' }}>Gestion financière</option>
                    <option value="conseil_juridique" {{ data.specialite == 'conseil_juridique' ? 'selected' : '' }}>Conseil juridique</option>
                </select>
            </div>

            <div>
                <label style="display:block; margin-bottom:8px; font-weight:700; color:#22374d;">Expérience (années)</label>
                <input
                    type="number"
                    name="experience"
                    min="1"
                    value="{{ data.experience }}"
                    required
                    style="width:100%; height:48px; border:1px solid #d9e5f1; border-radius:12px; padding:0 14px;"
                >
            </div>

            <div>
                <label style="display:block; margin-bottom:8px; font-weight:700; color:#22374d;">Prix</label>
                <input
                    type="number"
                    name="prix"
                    min="0"
                    step="0.01"
                    value="{{ data.prix }}"
                    required
                    style="width:100%; height:48px; border:1px solid #d9e5f1; border-radius:12px; padding:0 14px;"
                >
            </div>

            <div>
                <label style="display:block; margin-bottom:8px; font-weight:700; color:#22374d;">Durée</label>
                <input
                    type="number"
                    name="duree"
                    min="1"
                    value="{{ data.duree }}"
                    required
                    style="width:100%; height:48px; border:1px solid #d9e5f1; border-radius:12px; padding:0 14px;"
                >
            </div>
        </div>

        <div style="margin-top: 24px; display:flex; gap:12px; flex-wrap:wrap;">
            <button type="submit" style="
                background:#1f6fbe;
                color:#fff;
                border:none;
                border-radius:12px;
                padding:12px 20px;
                font-weight:700;
                cursor:pointer;
                box-shadow: 0 8px 18px rgba(26, 111, 196, 0.14);
            ">
                Tester la rentabilité
            </button>

            <a href="{{ path('app_expert_comptable_index') }}" style="
                background:#eef3f8;
                color:#415466;
                text-decoration:none;
                border-radius:12px;
                padding:12px 20px;
                font-weight:700;
            ">
                Retour à la liste
            </a>
        </div>
    </form>

    
{% if result %}
    {% set pourcentage = (result.probabilite * 100)|round %}

    <div id="resultModal" style="
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.55);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
    ">
        <div style="
            width: 100%;
            max-width: 500px;
            background: #fff;
            border-radius: 22px;
            padding: 28px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.18);
            position: relative;
            text-align: center;
        ">
            <button type="button" onclick="closeResultModal()" style="
                position:absolute;
                top:14px;
                right:14px;
                border:none;
                background:#eef3f8;
                width:36px;
                height:36px;
                border-radius:50%;
                cursor:pointer;
                font-weight:bold;
            ">
                ×
            </button>

            <h2 style="margin-top:0; color:#1f3147;">Résultat de l’analyse IA</h2>

            {% if result.prediction == 1 %}
                <div style="
                    background:#edf8ed;
                    border:1px solid #cce8cc;
                    color:#2f5f35;
                    border-radius:16px;
                    padding:18px;
                    font-weight:700;
                    font-size:20px;
                    margin-top:20px;
                ">
                    ✔ Expert potentiellement rentable à {{ pourcentage }}%
                </div>
            {% else %}
                <div style="
                    background:#fff3f3;
                    border:1px solid #f2c7c7;
                    color:#b42318;
                    border-radius:16px;
                    padding:18px;
                    font-weight:700;
                    font-size:20px;
                    margin-top:20px;
                ">
                    ✖ Expert potentiellement non rentable à {{ pourcentage }}%
                </div>
            {% endif %}

            <p style="margin-top:18px; color:#66788a; line-height:1.7;">
                Cette estimation est basée sur ton modèle de machine learning entraîné
                sur les données des experts, des offres et des réservations.
            </p>
        </div>
    </div>

    <script>
        function closeResultModal() {
            const modal = document.getElementById('resultModal');
            if (modal) {
                modal.style.display = 'none';
            }
        }
    </script>
{% endif %}

</div>
{% endblock %}