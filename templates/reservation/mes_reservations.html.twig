{% extends 'base.html.twig' %}

{% block title %}Mes réservations{% endblock %}

{% block stylesheets %}
<style>
    .reservations-page {
        max-width: 1180px;
        margin: 40px auto 80px;
        padding: 0 24px;
    }

    .reservations-hero {
        position: relative;
        overflow: hidden;
        background: linear-gradient(135deg, #f8fbff 0%, #eef5ff 100%);
        border: 1px solid #dbe8f7;
        border-radius: 28px;
        padding: 42px 38px;
        margin-bottom: 32px;
        box-shadow: 0 18px 40px rgba(27, 63, 104, 0.07);
    }

    .reservations-hero::before {
        content: "";
        position: absolute;
        width: 280px;
        height: 280px;
        border-radius: 50%;
        background: rgba(26, 111, 196, 0.08);
        top: -90px;
        right: -70px;
    }

    .reservations-hero::after {
        content: "";
        position: absolute;
        width: 180px;
        height: 180px;
        border-radius: 50%;
        background: rgba(26, 111, 196, 0.05);
        bottom: -70px;
        right: 110px;
    }

    .reservations-hero-content {
        position: relative;
        z-index: 2;
    }

    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(26, 111, 196, 0.10);
        color: #1a6fc4;
        border: 1px solid rgba(26, 111, 196, 0.14);
        padding: 8px 14px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 18px;
    }

    .reservations-hero h1 {
        margin: 0 0 12px;
        font-size: 2.4rem;
        line-height: 1.15;
        font-weight: 800;
        color: #1b2f46;
        letter-spacing: -0.5px;
    }

    .reservations-hero p {
        margin: 0;
        font-size: 1rem;
        line-height: 1.8;
        color: #61758a;
        max-width: 760px;
    }

    .reservations-topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
        margin-bottom: 22px;
    }

    .reservations-count {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #ffffff;
        border: 1px solid #e2ebf5;
        color: #29425b;
        padding: 10px 16px;
        border-radius: 14px;
        font-size: 14px;
        font-weight: 700;
        box-shadow: 0 8px 18px rgba(17, 38, 63, 0.05);
    }

    .btn-return {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #1f6fbe;
        color: #fff;
        text-decoration: none;
        padding: 11px 18px;
        border-radius: 12px;
        font-weight: 700;
        transition: 0.2s ease;
        box-shadow: 0 8px 18px rgba(26, 111, 196, 0.14);
    }

    .btn-return:hover {
        background: #175fa5;
        color: #fff;
        transform: translateY(-1px);
    }

    .reservations-grid {
        display: grid;
        gap: 22px;
    }

    .reservation-card {
        background: linear-gradient(180deg, #ffffff 0%, #fcfdff 100%);
        border: 1px solid #e7edf5;
        border-radius: 24px;
        padding: 26px;
        box-shadow: 0 14px 32px rgba(17, 38, 63, 0.06);
        position: relative;
        overflow: hidden;
        transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    }

    .reservation-card::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        height: 4px;
        background: linear-gradient(90deg, #1f6fbe, #6aa9e9);
    }

    .reservation-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 18px 38px rgba(17, 38, 63, 0.10);
        border-color: #d7e4f2;
    }

    .reservation-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 18px;
        flex-wrap: wrap;
        margin-bottom: 18px;
    }

    .reservation-title {
        margin: 0 0 8px;
        font-size: 1.4rem;
        font-weight: 800;
        color: #1f3147;
        line-height: 1.2;
    }

    .reservation-subtitle {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #6f8296;
        font-size: 14px;
        font-weight: 500;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 9px 14px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 800;
        white-space: nowrap;
        border: 1px solid transparent;
    }

    .status-confirmed {
        background: #edf9f0;
        color: #1f7a35;
        border-color: #cde9d3;
    }

    .status-refused {
        background: #fff1f2;
        color: #c62839;
        border-color: #f3c7ce;
    }

    .status-pending {
        background: #fff7e8;
        color: #c67b07;
        border-color: #f0ddb5;
    }

    .status-cancelled {
        background: #f1f3f5;
        color: #5f6b76;
        border-color: #d9dee3;
    }

    .reservation-body {
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        gap: 20px;
        margin-top: 10px;
    }

    .reservation-main,
    .reservation-side {
        background: #fbfdff;
        border: 1px solid #edf2f7;
        border-radius: 18px;
        padding: 18px;
    }

    .info-list {
        display: grid;
        gap: 14px;
    }

    .info-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

    .info-icon {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #eaf3ff, #d9e9fb);
        color: #1f6fbe;
        font-size: 18px;
        flex-shrink: 0;
        border: 1px solid #d4e3f4;
    }

    .info-content strong {
        display: block;
        margin-bottom: 4px;
        color: #23384d;
        font-size: 14px;
    }

    .info-content span {
        color: #61758a;
        font-size: 14px;
        line-height: 1.6;
    }

    .expert-box {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 16px;
    }

    .expert-avatar {
        width: 56px;
        height: 56px;
        border-radius: 18px;
        background: linear-gradient(135deg, #eaf3ff, #d8e8fb);
        color: #1f6fbe;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 20px;
        border: 1px solid #d4e3f4;
        flex-shrink: 0;
    }

    .expert-name {
        margin: 0 0 4px;
        font-size: 1rem;
        font-weight: 800;
        color: #1f3147;
    }

    .expert-role {
        color: #74879b;
        font-size: 13px;
    }

    .mode-badge {
        display: inline-flex;
        align-items: center;
        padding: 8px 12px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 700;
        margin-top: 8px;
        border: 1px solid #d9e7f6;
        background: #f5f9fe;
        color: #1f6fbe;
    }

    .meeting-box {
        margin-top: 18px;
        border-radius: 18px;
        padding: 18px;
        border: 1px solid #e6edf6;
    }

    .meeting-confirmed {
        background: linear-gradient(135deg, #f0fff4, #f7fffa);
        border-color: #cde9d3;
    }

    .meeting-pending {
        background: linear-gradient(135deg, #fffaf0, #fffdf8);
        border-color: #f0ddb5;
    }

    .meeting-refused {
        background: linear-gradient(135deg, #fff5f5, #fffafb);
        border-color: #f3c7ce;
    }

    .meeting-cancelled {
        background: linear-gradient(135deg, #f7f7f8, #fcfcfd);
        border-color: #d9dee3;
    }

    .meeting-title {
        margin: 0 0 8px;
        font-size: 1rem;
        font-weight: 800;
        color: #23384d;
    }

    .meeting-text {
        margin: 0;
        color: #607387;
        font-size: 14px;
        line-height: 1.7;
    }

    .btn-meet {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-top: 14px;
        padding: 11px 18px;
        background: #28a745;
        color: white;
        border-radius: 12px;
        text-decoration: none;
        font-weight: 700;
        transition: 0.2s ease;
        box-shadow: 0 10px 20px rgba(40, 167, 69, 0.18);
    }

    .btn-meet:hover {
        background: #218838;
        color: #fff;
        transform: translateY(-1px);
    }

    .reservation-actions {
        margin-top: 18px;
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }

    .btn-cancel {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 11px 18px;
        background: #dc3545;
        color: #fff;
        border: none;
        border-radius: 12px;
        font-weight: 700;
        cursor: pointer;
        transition: 0.2s ease;
        box-shadow: 0 10px 20px rgba(220, 53, 69, 0.18);
    }

    .btn-cancel:hover {
        background: #bb2d3b;
        transform: translateY(-1px);
    }

    .empty-state {
        background: linear-gradient(180deg, #ffffff 0%, #fcfdff 100%);
        border: 1px dashed #ccd8e6;
        border-radius: 26px;
        padding: 70px 24px;
        text-align: center;
        color: #708090;
        box-shadow: 0 12px 28px rgba(17, 38, 63, 0.05);
    }

    .empty-icon {
        width: 82px;
        height: 82px;
        border-radius: 24px;
        margin: 0 auto 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #eaf3ff, #d8e8fb);
        color: #1f6fbe;
        font-size: 34px;
        border: 1px solid #d4e3f4;
    }

    .empty-state h2 {
        margin: 0 0 10px;
        color: #22364c;
        font-size: 1.6rem;
        font-weight: 800;
    }

    .empty-state p {
        margin: 0 auto 18px;
        max-width: 560px;
        color: #708090;
        line-height: 1.8;
        font-size: 15px;
    }

    @media (max-width: 900px) {
        .reservation-body {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 768px) {
        .reservations-page {
            padding: 0 16px;
        }

        .reservations-hero {
            padding: 28px 22px;
        }

        .reservations-hero h1 {
            font-size: 2rem;
        }

        .reservation-card {
            padding: 20px;
        }

        .reservation-head {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>
{% endblock %}

{% block body %}
<div class="reservations-page">

    <div class="reservations-hero">
        <div class="reservations-hero-content">
            <div class="hero-badge">Suivi client • Réservations & rendez-vous</div>
            <h1>Mes réservations</h1>
            <p>
                Consultez l’historique de vos réservations, suivez leur statut
                et rejoignez rapidement vos réunions en ligne lorsqu’elles sont confirmées.
            </p>
        </div>
    </div>

    {% if reservations is not empty %}

        <div class="reservations-topbar">
            <div class="reservations-count">
                {{ reservations|length }} réservation{{ reservations|length > 1 ? 's' : '' }}
            </div>

            <a href="{{ path('app_client_experts') }}" class="btn-return">
                Retour aux experts
            </a>
        </div>

        <div class="reservations-grid">
            {% for reservation in reservations %}
                <div class="reservation-card">

                    <div class="reservation-head">
                        <div>
                            <h2 class="reservation-title">{{ reservation.offre.titre }}</h2>
                            <div class="reservation-subtitle">
                                Réservation liée à une offre d’expertise comptable
                            </div>
                        </div>

                        {% if reservation.statut == 'confirmee' %}
                            <span class="status-badge status-confirmed">Confirmée</span>
                        {% elseif reservation.statut == 'refusee' %}
                            <span class="status-badge status-refused">Refusée</span>
                        {% elseif reservation.statut == 'annulee' %}
                            <span class="status-badge status-cancelled">Annulée</span>
                        {% else %}
                            <span class="status-badge status-pending">En attente</span>
                        {% endif %}
                    </div>

                    <div class="reservation-body">

                        <div class="reservation-main">
                            <div class="info-list">

                                <div class="info-item">
                                    <div class="info-icon">📅</div>
                                    <div class="info-content">
                                        <strong>Date de réservation</strong>
                                        <span>{{ reservation.dateReservation|date('d/m/Y à H:i') }}</span>
                                    </div>
                                </div>

                                <div class="info-item">
                                    <div class="info-icon">💼</div>
                                    <div class="info-content">
                                        <strong>Offre réservée</strong>
                                        <span>{{ reservation.offre.titre }}</span>
                                    </div>
                                </div>

                                <div class="info-item">
                                    <div class="info-icon">📍</div>
                                    <div class="info-content">
                                        <strong>Mode de consultation</strong>
                                        <span>
                                            {{ reservation.mode == 'en_ligne' ? 'En ligne' : 'Présentiel' }}
                                        </span>
                                    </div>
                                </div>

                            </div>

                            {% if reservation.mode == 'en_ligne' and reservation.roomName and reservation.statut == 'confirmee' %}
                                <div class="meeting-box meeting-confirmed">
                                    <h3 class="meeting-title">Réunion en ligne disponible</h3>
                                    <p class="meeting-text">
                                        Votre réservation a été confirmée. Vous pouvez maintenant rejoindre
                                        votre salle de réunion en ligne.
                                    </p>

                                    <a href="{{ path('app_reservation_meet', {'token': reservation.token}) }}" class="btn-meet">
                                        Rejoindre la réunion
                                    </a>
                                </div>

                            {% elseif reservation.mode == 'en_ligne' and reservation.statut == 'en_attente' %}
                                <div class="meeting-box meeting-pending">
                                    <h3 class="meeting-title">Réunion en attente</h3>
                                    <p class="meeting-text">
                                        Votre demande de réservation en ligne est en attente de confirmation par l’expert.
                                    </p>
                                </div>

                            {% elseif reservation.mode == 'en_ligne' and reservation.statut == 'refusee' %}
                                <div class="meeting-box meeting-refused">
                                    <h3 class="meeting-title">Réservation refusée</h3>
                                    <p class="meeting-text">
                                        Cette réservation en ligne a été refusée par l’expert concerné.
                                    </p>
                                </div>

                            {% elseif reservation.statut == 'annulee' %}
                                <div class="meeting-box meeting-cancelled">
                                    <h3 class="meeting-title">Réservation annulée</h3>
                                    <p class="meeting-text">
                                        Vous avez annulé cette réservation. L’expert a été informé par email.
                                    </p>
                                </div>
                            {% endif %}

                            {% if reservation.statut in ['en_attente', 'confirmee'] %}
                                <div class="reservation-actions">
                                    <form method="post"
                                          action="{{ path('app_reservation_cancel', {'id': reservation.id}) }}"
                                          onsubmit="return confirm('Voulez-vous vraiment annuler cette réservation ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('cancel_reservation_' ~ reservation.id) }}">
                                        <button type="submit" class="btn-cancel">
                                            Annuler la réservation
                                        </button>
                                    </form>
                                </div>
                            {% endif %}
                        </div>

                        <div class="reservation-side">
                            <div class="expert-box">
                                <div class="expert-avatar">
                                    {{ reservation.offre.expertComptable.nom|first|upper }}{{ reservation.offre.expertComptable.prenom|first|upper }}
                                </div>

                                <div>
                                    <h3 class="expert-name">
                                        {{ reservation.offre.expertComptable.nom }}
                                        {{ reservation.offre.expertComptable.prenom }}
                                    </h3>
                                    <div class="expert-role">Expert comptable</div>
                                </div>
                            </div>

                            <div class="info-list">
                                <div class="info-item">
                                    <div class="info-icon">👤</div>
                                    <div class="info-content">
                                        <strong>Expert assigné</strong>
                                        <span>
                                            {{ reservation.offre.expertComptable.nom }}
                                            {{ reservation.offre.expertComptable.prenom }}
                                        </span>
                                    </div>
                                </div>

                                <div class="info-item">
                                    <div class="info-icon">✅</div>
                                    <div class="info-content">
                                        <strong>Statut actuel</strong>
                                        <span>
                                            {% if reservation.statut == 'confirmee' %}
                                                Confirmée
                                            {% elseif reservation.statut == 'refusee' %}
                                                Refusée
                                            {% elseif reservation.statut == 'annulee' %}
                                                Annulée
                                            {% else %}
                                                En attente
                                            {% endif %}
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div class="mode-badge">
                                {{ reservation.mode == 'en_ligne' ? 'Consultation en ligne' : 'Consultation présentielle' }}
                            </div>
                        </div>

                    </div>
                </div>
            {% endfor %}
        </div>

    {% else %}

        <div class="empty-state">
            <div class="empty-icon">📖</div>
            <h2>Aucune réservation pour le moment</h2>
            <p>
                Vous n’avez encore effectué aucune réservation. Parcourez la liste des experts
                et choisissez l’offre qui correspond le mieux à votre besoin.
            </p>

            <a href="{{ path('app_client_experts') }}" class="btn-return">
                Découvrir les experts
            </a>
        </div>

    {% endif %}

</div>
{% endblock %}