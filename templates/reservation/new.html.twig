{% extends 'base.html.twig' %}

{% block title %}Réserver une offre{% endblock %}

{% block stylesheets %}
<style>
    .form-page {
        max-width: 900px;
        margin: 40px auto 70px;
        padding: 0 20px;
    }

    .form-card {
        background: #fff;
        border: 1px solid #e7edf5;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(22, 34, 51, 0.06);
        overflow: hidden;
    }

    .form-card-header {
        padding: 24px 28px;
        border-bottom: 1px solid #eef3f8;
        background: linear-gradient(135deg, #f8fbff, #eef5fc);
    }

    .form-card-title {
        margin: 0;
        font-size: 1.9rem;
        font-weight: 800;
        color: #24364b;
    }

    .form-card-subtitle {
        margin-top: 8px;
        color: #7a8a9a;
        font-size: 14px;
        line-height: 1.6;
    }

    .expert-summary {
        margin-top: 14px;
        display: inline-block;
        padding: 8px 14px;
        border-radius: 999px;
        background: rgba(26, 111, 196, 0.10);
        color: #1a6fc4;
        font-weight: 700;
        font-size: 13px;
        border: 1px solid rgba(26, 111, 196, 0.12);
    }

    .offre-summary {
        margin-top: 14px;
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .offre-badge {
        display: inline-flex;
        align-items: center;
        padding: 7px 12px;
        border-radius: 999px;
        background: #eef6ff;
        color: #1f6fbe;
        font-size: 12px;
        font-weight: 700;
        border: 1px solid #d6e7fb;
    }

    .form-card-body {
        padding: 28px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    .form-group-custom {
        display: flex;
        flex-direction: column;
    }

    .form-group-custom.full {
        grid-column: 1 / -1;
    }

    .form-group-custom label {
        font-size: 14px;
        font-weight: 700;
        color: #304256;
        margin-bottom: 8px;
    }

    .form-group-custom input,
    .form-group-custom textarea,
    .form-group-custom select {
        width: 100%;
        padding: 12px 14px;
        border: 1px solid #dbe5f0;
        border-radius: 12px;
        background: #fff;
        font-size: 14px;
        color: #304256;
        outline: none;
        transition: all 0.2s ease;
        box-sizing: border-box;
    }

    .form-group-custom input:focus,
    .form-group-custom textarea:focus,
    .form-group-custom select:focus {
        border-color: #1a6fc4;
        box-shadow: 0 0 0 4px rgba(26, 111, 196, 0.10);
    }

    .form-group-custom textarea {
        min-height: 130px;
        resize: vertical;
    }

    .form-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 26px;
    }

    .btn-form {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 12px 18px;
        border-radius: 12px;
        text-decoration: none;
        font-size: 14px;
        font-weight: 700;
        border: none;
        cursor: pointer;
        transition: 0.2s ease;
    }

    .btn-save {
        background: #1a6fc4;
        color: #fff;
    }

    .btn-save:hover {
        background: #155ca5;
        color: #fff;
    }

    .btn-back {
        background: #eef3f8;
        color: #425466;
    }

    .btn-back:hover {
        background: #dfe8f1;
        color: #24364b;
    }

    .form-errors {
        color: #d63031;
        font-size: 13px;
        margin-top: 6px;
    }

    @media (max-width: 768px) {
        .form-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
{% endblock %}

{% block body %}
<div class="form-page">
    <div class="form-card">

        <div class="form-card-header">
            <h1 class="form-card-title">Réserver une offre</h1>
            <div class="form-card-subtitle">
                Remplissez ce formulaire pour envoyer votre demande de réservation.
            </div>

            <div class="expert-summary">
                {{ expert.nom }} {{ expert.prenom }} —
                {{ expert.specialite|replace({
                    'comptabilite_generale': 'Comptabilité générale',
                    'fiscalite': 'Fiscalité',
                    'audit': 'Audit',
                    'gestion_financiere': 'Gestion financière',
                    'conseil_juridique': 'Conseil juridique',
                    'paie_rh': 'Paie et RH',
                    'creation_entreprise': 'Création d’entreprise'
                }) }}
            </div>

            <div class="offre-summary">
                <span class="offre-badge">
                    {{ offre.titre|replace({
                        'budget_personnel': 'Gestion de budget personnel',
                        'planification_financiere': 'Planification financière',
                        'suivi_depenses': 'Suivi des dépenses',
                        'audit_depenses': 'Audit des dépenses',
                        'optimisation_fiscale': 'Optimisation fiscale',
                        'conseil_investissement': 'Conseil en investissement',
                        'analyse_financiere': 'Analyse financière',
                        'plan_financier': 'Création de plan financier'
                    }) }}
                </span>

                <span class="offre-badge">Prix : {{ offre.prix }} TND</span>
                <span class="offre-badge">Durée : {{ offre.duree }}</span>
            </div>
        </div>

        <div class="form-card-body">
            {{ form_start(form) }}

            <div class="form-grid">
                <div class="form-group-custom">
                    {{ form_label(form.nomClient) }}
                    {{ form_widget(form.nomClient) }}
                    <div class="form-errors">{{ form_errors(form.nomClient) }}</div>
                </div>

                <div class="form-group-custom">
                    {{ form_label(form.prenomClient) }}
                    {{ form_widget(form.prenomClient) }}
                    <div class="form-errors">{{ form_errors(form.prenomClient) }}</div>
                </div>

                <div class="form-group-custom">
                    {{ form_label(form.emailClient) }}
                    {{ form_widget(form.emailClient) }}
                    <div class="form-errors">{{ form_errors(form.emailClient) }}</div>
                </div>

                <div class="form-group-custom">
                    {{ form_label(form.telephoneClient) }}
                    {{ form_widget(form.telephoneClient) }}
                    <div class="form-errors">{{ form_errors(form.telephoneClient) }}</div>
                </div>

                <div class="form-group-custom full">
                    {{ form_label(form.message) }}
                    {{ form_widget(form.message) }}
                    <div class="form-errors">{{ form_errors(form.message) }}</div>
                </div>
            </div>

            <div class="form-actions">
                <button class="btn-form btn-save">Envoyer la réservation</button>

                <a href="{{ path('app_client_offres_expert', {'id': expert.id}) }}" class="btn-form btn-back">
                    Retour
                </a>
            </div>

            {{ form_end(form) }}
        </div>

    </div>
</div>
{% endblock %}