{% extends is_granted('ROLE_ADMIN') ? 'base_admin.html.twig' : 'base.html.twig' %}

{% block title %}Gestion des Réclamations — DINARI{% endblock %}

{% block stylesheets %}
{% if is_granted('ROLE_ADMIN') %}
<style>
/* ── Page wrapper ─────────────────────────── */
.rl-page { max-width: 1100px; margin: 0 auto; padding-bottom: 52px; }

/* ── Page header ─────────────────────────── */
.rl-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 28px;
    flex-wrap: wrap;
}

.rl-title-block h1 {
    font-size: 28px;
    font-weight: 800;
    color: #111827;
    letter-spacing: -.4px;
    line-height: 1.2;
}

.rl-title-block p {
    font-size: 14px;
    color: #6b7280;
    margin-top: 5px;
}

.rl-header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
}

.btn-new-rec {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 10px 22px;
    background: linear-gradient(135deg, #0891b2, #6366f1);
    color: #fff;
    border: none;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(8,145,178,.28);
    transition: all .2s;
    white-space: nowrap;
}
.btn-new-rec:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(8,145,178,.38);
    color: #fff;
}

.btn-chat-ia {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 10px 20px;
    background: #fff;
    color: #374151;
    border: 1.5px solid #e5e7eb;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: all .2s;
    white-space: nowrap;
}
.btn-chat-ia:hover {
    border-color: #0891b2;
    color: #0891b2;
    background: #ecfeff;
}

/* ── Summary Chart Card ──────────────────── */
.summary-chart-card {
    background: #ffffff;
    border: 1px solid rgba(226, 232, 240, 0.8);
    border-radius: 20px;
    padding: 32px;
    margin-bottom: 24px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02);
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 40px;
}
.scc-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
}
.scc-info h3 {
    font-size: 13px;
    font-weight: 700;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0 0 16px 0;
    display: flex;
    align-items: center;
    gap: 8px;
}
.scc-total {
    font-size: 56px;
    font-weight: 800;
    color: #0f172a;
    line-height: 1;
    margin-bottom: 8px;
    letter-spacing: -1px;
}
.scc-info p {
    font-size: 14px;
    color: #94a3b8;
    margin: 0 0 24px 0;
    line-height: 1.5;
}
.scc-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}
.scc-badges span {
    padding: 8px 14px;
    border-radius: 12px;
    font-size: 13px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 8px;
}
.sbb-attente { background: rgba(245, 158, 11, 0.1); color: #d97706; }
.sbb-cours { background: rgba(59, 130, 246, 0.1); color: #2563eb; }
.sbb-traitee { background: rgba(16, 185, 129, 0.1); color: #059669; }

.scc-chart {
    position: relative;
    height: 240px;
    width: 100%;
}
@media (max-width: 900px) {
    .summary-chart-card { grid-template-columns: 1fr; gap: 24px; padding: 24px; }
    .scc-chart { height: 200px; }
}

/* ── Charts Grid ─────────────────────────── */
.rl-charts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-bottom: 24px;
}

.chart-card {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    padding: 20px;
    box-shadow: 0 1px 4px rgba(0,0,0,.04);
}

.chart-card-title {
    font-size: 15px;
    font-weight: 700;
    color: #111827;
    margin-bottom: 16px;
    padding-bottom: 10px;
    border-bottom: 1px solid #f3f4f6;
    display: flex;
    align-items: center;
    gap: 8px;
}

.chart-container {
    position: relative;
    height: 220px;
    width: 100%;
}

/* ── Toolbar ─────────────────────────────── */
.rl-toolbar {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    padding: 16px 20px;
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
    box-shadow: 0 1px 4px rgba(0,0,0,.04);
    flex-wrap: wrap;
}

.rl-search-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #f9fafb;
    border: 1.5px solid #e5e7eb;
    border-radius: 10px;
    padding: 0 14px;
    height: 40px;
    flex: 1;
    min-width: 180px;
    transition: border-color .2s, box-shadow .2s;
}
.rl-search-wrap:focus-within {
    border-color: #0891b2;
    box-shadow: 0 0 0 3px rgba(8,145,178,.10);
    background: #fff;
}
.rl-search-wrap input {
    border: none;
    outline: none;
    background: transparent;
    font-size: 14px;
    color: #111827;
    flex: 1;
    font-family: 'Inter', sans-serif;
}
.rl-search-wrap input::placeholder { color: #9ca3af; }

.rl-sort-select {
    height: 40px;
    padding: 0 14px;
    border: 1.5px solid #e5e7eb;
    border-radius: 10px;
    background: #f9fafb;
    color: #374151;
    font-size: 14px;
    font-family: 'Inter', sans-serif;
    font-weight: 500;
    outline: none;
    cursor: pointer;
    transition: border-color .2s;
    min-width: 170px;
}
.rl-sort-select:focus { border-color: #0891b2; }

.btn-rl-search {
    height: 40px;
    padding: 0 22px;
    background: #0891b2;
    color: #fff;
    border: none;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    font-family: 'Inter', sans-serif;
    transition: background .2s;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 6px;
}
.btn-rl-search:hover { background: #0e7490; }

.btn-rl-reset {
    height: 40px;
    padding: 0 18px;
    background: #fff;
    color: #6b7280;
    border: 1.5px solid #e5e7eb;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 500;
    font-family: 'Inter', sans-serif;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    transition: all .2s;
    white-space: nowrap;
}
.btn-rl-reset:hover { border-color: #9ca3af; color: #374151; }

/* ── Card container ──────────────────────── */
.rl-container {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 16px;
    box-shadow: 0 2px 8px rgba(0,0,0,.05);
    overflow: hidden;
}

.rl-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 24px;
    border-bottom: 1px solid #f3f4f6;
}

.rl-card-head-title {
    font-size: 15px;
    font-weight: 700;
    color: #111827;
    display: flex;
    align-items: center;
    gap: 10px;
}

.rl-count-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 26px;
    height: 22px;
    padding: 0 8px;
    background: #ecfeff;
    color: #0891b2;
    border-radius: 50px;
    font-size: 12px;
    font-weight: 700;
}

/* ── Reclamation item ────────────────────── */
.rl-item {
    padding: 20px 24px;
    border-bottom: 1px solid #f3f4f6;
    transition: background .15s;
    position: relative;
    animation: rlIn .3s ease both;
}
.rl-item:last-child { border-bottom: none; }
.rl-item:hover { background: #f8fbff; }

@keyframes rlIn {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: translateY(0); }
}
{% for i in 1..30 %}
.rl-item:nth-child({{ i }}) { animation-delay: {{ (i-1)*0.05 }}s; }
{% endfor %}

/* Left accent bar (status color) */
.rl-item::before {
    content: '';
    position: absolute;
    left: 0; top: 16px; bottom: 16px;
    width: 3px;
    border-radius: 0 3px 3px 0;
}
.rl-item.status-traitee::before  { background: #10b981; }
.rl-item.status-attente::before  { background: #f59e0b; }
.rl-item.status-cours::before    { background: #3b82f6; }
.rl-item.status-rejetee::before  { background: #ef4444; }

/* Top row: email + date */
.rl-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
    gap: 12px;
}

.rl-email {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: #6b7280;
}

.rl-date {
    font-size: 12px;
    color: #9ca3af;
    white-space: nowrap;
}

/* Subject */
.rl-subject {
    font-size: 16px;
    font-weight: 700;
    color: #111827;
    margin-bottom: 6px;
    line-height: 1.3;
}

/* Description */
.rl-desc {
    font-size: 13px;
    color: #4b5563;
    line-height: 1.6;
    margin-bottom: 14px;
}

/* Footer */
.rl-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
}

.rl-footer-left {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
}

/* Status badges */
.rl-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 13px;
    border-radius: 50px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .2px;
}
.rl-badge-traitee  { background: #d1fae5; color: #065f46; }
.rl-badge-attente  { background: #fef3c7; color: #92400e; }
.rl-badge-cours    { background: #dbeafe; color: #1d4ed8; }
.rl-badge-rejetee  { background: #fee2e2; color: #991b1b; }

/* Status dropdown */
.rl-status-form select {
    height: 34px;
    padding: 0 12px;
    border: 1.5px solid #e5e7eb;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
    font-family: 'Inter', sans-serif;
    background: #f9fafb;
    cursor: pointer;
    color: #374151;
    outline: none;
    transition: border-color .2s;
}
.rl-status-form select:focus { border-color: #0891b2; }

/* Action buttons */
.rl-footer-right { display: flex; align-items: center; gap: 8px; }

.btn-rl-edit {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 16px;
    background: #eff6ff;
    color: #1d4ed8;
    border: 1.5px solid #bfdbfe;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition: all .2s;
}
.btn-rl-edit:hover {
    background: #1d4ed8;
    color: #fff;
    border-color: #1d4ed8;
}

.btn-rl-delete {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 16px;
    background: #fff5f5;
    color: #ef4444;
    border: 1.5px solid #fecaca;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    transition: all .2s;
    font-family: 'Inter', sans-serif;
}
.btn-rl-delete:hover {
    background: #ef4444;
    color: #fff;
    border-color: #ef4444;
}

.btn-rl-show {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 16px;
    background: #f3f4f6;
    color: #374151;
    border: 1.5px solid #e5e7eb;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition: all .2s;
}
.btn-rl-show:hover {
    background: #e5e7eb;
    border-color: #d1d5db;
    color: #111827;
}

/* Empty state */
.rl-empty {
    text-align: center;
    padding: 80px 24px;
}
.rl-empty-icon { font-size: 56px; opacity: .25; margin-bottom: 18px; }
.rl-empty h3 { font-size: 17px; font-weight: 700; color: #374151; margin-bottom: 6px; }
.rl-empty p  { font-size: 14px; color: #9ca3af; }
</style>
{% else %}
<style>
/* ── Modern User Interface ─────────────────────────── */
.user-rl-page { max-width: 1000px; margin: 40px auto; padding: 0 20px; font-family: 'Inter', sans-serif; }
.user-rl-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 40px; background: linear-gradient(135deg, #f8fafc, #ffffff); padding: 30px; border-radius: 20px; box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.05); border: 1px solid #f1f5f9; flex-wrap: wrap; gap: 20px; }
.user-rl-title h1 { font-size: 32px; font-weight: 800; color: #0f172a; margin: 0 0 10px 0; letter-spacing: -0.02em; }
.user-rl-title p { font-size: 15px; color: #64748b; margin: 0; }
.user-btn-create { padding: 14px 28px; background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); color: white; border-radius: 14px; text-decoration: none; font-weight: 600; font-size: 15px; display: inline-flex; align-items: center; gap: 10px; box-shadow: 0 10px 20px -5px rgba(37, 99, 235, 0.4); transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
.user-btn-create:hover { transform: translateY(-2px); box-shadow: 0 15px 25px -5px rgba(37, 99, 235, 0.5); color: white; }
.user-btn-chat { padding: 14px 24px; background: white; color: #0f172a; border: 1.5px solid #e2e8f0; border-radius: 14px; text-decoration: none; font-weight: 600; font-size: 15px; display: inline-flex; align-items: center; gap: 10px; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
.user-btn-chat:hover { background: #f8fafc; border-color: #cbd5e1; transform: translateY(-2px); box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05); }
.user-rl-toolbar { margin-bottom: 30px; display: flex; gap: 15px; background: white; padding: 16px; border-radius: 16px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05); border: 1px solid #f1f5f9; flex-wrap: wrap; }
.user-search-input { flex: 1; padding: 12px 20px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; font-size: 15px; color: #334155; transition: all 0.2s ease; outline: none; min-width: 250px; }
.user-search-input:focus { background: white; border-color: #3b82f6; box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1); }
.user-sort-select { padding: 12px 20px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; font-size: 15px; color: #334155; outline: none; cursor: pointer; }
.user-btn-search, .user-btn-reset { padding: 12px 24px; border-radius: 12px; font-weight: 600; font-size: 14px; cursor: pointer; border: none; transition: all 0.2s ease; display: inline-flex; align-items: center; gap: 8px; text-decoration: none; }
.user-btn-search { background: #0f172a; color: white; }
.user-btn-search:hover { background: #1e293b; }
.user-btn-reset { background: #f1f5f9; color: #64748b; }
.user-btn-reset:hover { background: #e2e8f0; color: #334155; }
.user-rl-grid { display: grid; gap: 20px; }
.user-rl-card { background: white; border-radius: 20px; padding: 24px; border: 1px solid #f1f5f9; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03); transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); position: relative; overflow: hidden; }
.user-rl-card:hover { transform: translateY(-4px); box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04); }
.user-rl-card::before { content: ''; position: absolute; top: 0; left: 0; width: 6px; height: 100%; }
.user-rl-card.status-traitee::before { background: #22c55e; }
.user-rl-card.status-attente::before { background: #f59e0b; }
.user-rl-card.status-cours::before { background: #3b82f6; }
.user-rl-card.status-rejetee::before { background: #ef4444; }
.user-card-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px; flex-wrap: wrap; gap: 10px; }
.user-card-title { font-size: 18px; font-weight: 700; color: #0f172a; margin: 0 0 8px 0; }
.user-card-date { font-size: 13px; color: #94a3b8; display: flex; align-items: center; gap: 6px; }
.user-badge { padding: 6px 14px; border-radius: 9999px; font-size: 12px; font-weight: 700; letter-spacing: 0.02em; white-space: nowrap; }
.user-badge-traitee { background: #dcfce7; color: #15803d; }
.user-badge-attente { background: #fef3c7; color: #b45309; }
.user-badge-cours { background: #dbeafe; color: #1d4ed8; }
.user-badge-rejetee { background: #fee2e2; color: #b91c1c; }
.user-card-body { font-size: 15px; color: #475569; line-height: 1.6; margin-bottom: 24px; padding-bottom: 20px; border-bottom: 1px solid #f1f5f9; }
.user-card-footer { display: flex; justify-content: flex-end; gap: 12px; flex-wrap: wrap; }
.user-btn-action { padding: 8px 16px; border-radius: 10px; font-size: 13px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: all 0.2s; border: none; cursor: pointer; }
.btn-view { background: #f1f5f9; color: #334155; }
.btn-view:hover { background: #e2e8f0; }
.btn-edit { background: #eff6ff; color: #2563eb; }
.btn-edit:hover { background: #dbeafe; }
.btn-delete { background: #fef2f2; color: #dc2626; }
.btn-delete:hover { background: #fee2e2; }
.user-empty-state { text-align: center; padding: 80px 20px; background: white; border-radius: 20px; border: 1px dashed #cbd5e1; }
.user-empty-icon { font-size: 64px; margin-bottom: 24px; filter: drop-shadow(0 10px 10px rgba(0,0,0,0.05)); }
.user-empty-title { font-size: 20px; font-weight: 700; color: #1e293b; margin-bottom: 12px; }
.user-empty-text { color: #64748b; font-size: 15px; margin-bottom: 30px; }
</style>
{% endif %}
{% endblock %}

{% block body %}
{% if is_granted('ROLE_ADMIN') %}
<div class="rl-page">

    {# ── Page header ──────────────────────────── #}
    <div class="rl-header">
        <div class="rl-title-block">
            <h1>
                <span style="background:linear-gradient(135deg,#0891b2,#6366f1);-webkit-background-clip:text;-webkit-text-fill-color:transparent;">Gestion</span>
                des Réclamations
            </h1>
            <p>Visualisez et gérez l'ensemble des réclamations de la plateforme.</p>
        </div>
        <div class="rl-header-actions">
            <a href="{{ path('app_chat_index') }}" class="btn-chat-ia">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                Chat IA
            </a>
            <a href="{{ path('app_reclamation_new') }}" class="btn-new-rec">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Créer une réclamation
            </a>
        </div>
    </div>

    {# ── Stats Chart ──────────────────────────── #}
    {% set cntAttente  = reclamations|filter(r => r.statut == 'En attente')|length %}
    {% set cntCours    = reclamations|filter(r => r.statut == 'En cours')|length %}
    {% set cntTraitee  = reclamations|filter(r => r.statut == 'Traitée')|length %}
    {% set cntRejetee  = reclamations|filter(r => r.statut == 'Rejetée')|length %}

    <div class="summary-chart-card">
        <div class="scc-info">
            <h3>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                Vue d'ensemble
            </h3>
            <div class="scc-total">{{ total }}</div>
            <p>Réclamations enregistrées sur la plateforme. Suivi de l'état d'avancement des traitements.</p>
            <div class="scc-badges">
                <span class="sbb-attente">⏳ {{ cntAttente }} En attente</span>
                <span class="sbb-cours">🔄 {{ cntCours }} En cours</span>
                <span class="sbb-traitee">✅ {{ cntTraitee }} Traitées</span>
            </div>
        </div>
        <div class="scc-chart">
            <canvas id="barStatsChart"></canvas>
        </div>
    </div>

    {# ── Dashboard Charts ─────────────────────── #}
    {% if is_granted('ROLE_ADMIN') %}
    <div class="rl-charts">
        <div class="chart-card">
            <div class="chart-card-title">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0891b2" stroke-width="2"><path d="M21.21 15.89A10 10 0 1 1 8 2.83"/><path d="M22 12A10 10 0 0 0 12 2v10z"/></svg>
                Répartition par Statut
            </div>
            <div class="chart-container">
                <canvas id="statusChart"></canvas>
            </div>
        </div>
        <div class="chart-card">
            <div class="chart-card-title">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                Taux de Traitement Mails
            </div>
            <div class="chart-container">
                <canvas id="reponseChart"></canvas>
            </div>
        </div>
    </div>
    {% endif %}

    {# ── Search toolbar ───────────────────────── #}
    <form method="get" action="{{ path('app_reclamation_index') }}">
        <div class="rl-toolbar">
            <div class="rl-search-wrap">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <input type="text" name="search" placeholder="Sujet, email, description…" value="{{ search }}">
            </div>

            <select name="sort" class="rl-sort-select">
                <option value="recent"  {% if sort == 'recent'  %}selected{% endif %}>📅 Plus récent</option>
                <option value="oldest"  {% if sort == 'oldest'  %}selected{% endif %}>📅 Plus ancien</option>
                <option value="attente" {% if sort == 'attente' %}selected{% endif %}>⏳ Statut (A→Z)</option>
            </select>

            <button type="submit" class="btn-rl-search">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                Rechercher
            </button>
            <a href="{{ path('app_reclamation_index') }}" class="btn-rl-reset">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.5"/></svg>
                Réinitialiser
            </a>
        </div>
    </form>

    {# ── Reclamations card ────────────────────── #}
    <div class="rl-container">
        <div class="rl-card-head">
            <div class="rl-card-head-title">
                Liste des réclamations
                <span class="rl-count-badge">{{ total }}</span>
            </div>
        </div>

        {% if reclamations is empty %}
            <div class="rl-empty">
                <div class="rl-empty-icon">📭</div>
                <h3>Aucune réclamation trouvée</h3>
                <p>Modifiez vos filtres ou créez une nouvelle réclamation.</p>
            </div>
        {% else %}
            {% for rec in reclamations %}
            {% set statusClass = '' %}
            {% if rec.statut == 'Traitée' %}{% set statusClass = 'status-traitee' %}
            {% elseif rec.statut == 'En attente' %}{% set statusClass = 'status-attente' %}
            {% elseif rec.statut == 'En cours' %}{% set statusClass = 'status-cours' %}
            {% else %}{% set statusClass = 'status-rejetee' %}{% endif %}

            <div class="rl-item {{ statusClass }}">

                {# Meta: email + date #}
                <div class="rl-meta">
                    <div class="rl-email">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                        <span>{{ rec.email }}</span>
                    </div>
                    <div class="rl-date">
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:middle;margin-right:3px;"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        {% if rec.createdAt is defined and rec.createdAt is not null %}
                            {{ rec.createdAt|date('d/m/Y à H:i') }}
                        {% endif %}
                    </div>
                </div>

                {# Subject #}
                <div class="rl-subject">{{ rec.subject }}</div>

                {# Description #}
                <div class="rl-desc">
                    {{ rec.description|length > 140 ? rec.description|slice(0,140) ~ '…' : rec.description }}
                </div>

                {# Footer #}
                <div class="rl-footer">
                    <div class="rl-footer-left">

                        {# Status badge #}
                        {% if rec.statut == 'Traitée' %}
                            <span class="rl-badge rl-badge-traitee">✅ Traitée</span>
                        {% elseif rec.statut == 'En attente' %}
                            <span class="rl-badge rl-badge-attente">⏳ En attente</span>
                        {% elseif rec.statut == 'En cours' %}
                            <span class="rl-badge rl-badge-cours">🔄 En cours</span>
                        {% else %}
                            <span class="rl-badge rl-badge-rejetee">❌ Rejetée</span>
                        {% endif %}

                        {# Admin status changer #}
                        {% if is_granted('ROLE_ADMIN') %}
                        <form method="post" action="{{ path('app_reclamation_status', {id: rec.id_reclamation}) }}" class="rl-status-form">
                            <select name="statut" onchange="this.form.submit()">
                                <option value="En attente" {% if rec.statut == 'En attente' %}selected{% endif %}>⏳ En attente</option>
                                <option value="En cours"   {% if rec.statut == 'En cours'   %}selected{% endif %}>🔄 En cours</option>
                                <option value="Traitée"    {% if rec.statut == 'Traitée'    %}selected{% endif %}>✅ Traitée</option>
                                <option value="Rejetée"    {% if rec.statut == 'Rejetée'    %}selected{% endif %}>❌ Rejetée</option>
                            </select>
                        </form>
                        {% endif %}

                    </div>

                    <div class="rl-footer-right">
                        <a href="{{ path('app_reclamation_show', {id: rec.id_reclamation}) }}" class="btn-rl-show">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/></svg>
                            Détails
                        </a>
                        <a href="{{ path('app_reclamation_edit', {id: rec.id_reclamation}) }}" class="btn-rl-edit">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                            Modifier
                        </a>
                        <form method="post" action="{{ path('app_reclamation_delete', {id: rec.id_reclamation}) }}" onsubmit="return confirm('Supprimer cette réclamation ?')" style="margin:0;">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ rec.id_reclamation) }}">
                            <button type="submit" class="btn-rl-delete">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                                Supprimer
                            </button>
                        </form>
                    </div>
                </div>
            </div>
            {% endfor %}
        {% endif %}
    </div>

</div>
{% else %}
<div class="user-rl-page">
    <div class="user-rl-header">
        <div class="user-rl-title">
            <h1>Mes Réclamations</h1>
            <p>Suivez l'état d'avancement de vos demandes d'assistance.</p>
        </div>
        <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
            <a href="{{ path('app_chat_index') }}" class="user-btn-chat">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                Discuter avec l'IA
            </a>
            <a href="{{ path('app_reclamation_new') }}" class="user-btn-create">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                Nouvelle réclamation
            </a>
        </div>
    </div>

    <form method="get" action="{{ path('app_reclamation_index') }}" class="user-rl-toolbar">
        <input type="text" name="search" class="user-search-input" placeholder="Que cherchez-vous ?" value="{{ search }}">
        <select name="sort" class="user-sort-select">
            <option value="recent" {% if sort == 'recent' %}selected{% endif %}>📅 Les plus récentes</option>
            <option value="oldest" {% if sort == 'oldest' %}selected{% endif %}>📅 Les plus anciennes</option>
            <option value="attente" {% if sort == 'attente' %}selected{% endif %}>⏳ Par état</option>
        </select>
        <button type="submit" class="user-btn-search">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            Rechercher
        </button>
        <a href="{{ path('app_reclamation_index') }}" class="user-btn-reset">
            Réinitialiser
        </a>
    </form>

    {% if reclamations is empty %}
        <div class="user-empty-state">
            <div class="user-empty-icon">✨</div>
            <h3 class="user-empty-title">Tout fonctionne parfaitement !</h3>
            <p class="user-empty-text">Vous n'avez soumis aucune réclamation récemment.</p>
            <a href="{{ path('app_reclamation_new') }}" class="user-btn-create" style="box-shadow: none;">
                Besoin d'aide ? Créer une réclamation
            </a>
        </div>
    {% else %}
        <div class="user-rl-grid">
            {% for rec in reclamations %}
                {% set statusClass = '' %}
                {% set badgeClass = '' %}
                {% set badgeText = '' %}
                
                {% if rec.statut == 'Traitée' %}
                    {% set statusClass = 'status-traitee' %}
                    {% set badgeClass = 'user-badge-traitee' %}
                    {% set badgeText = 'Traitée' %}
                {% elseif rec.statut == 'En attente' %}
                    {% set statusClass = 'status-attente' %}
                    {% set badgeClass = 'user-badge-attente' %}
                    {% set badgeText = 'En attente' %}
                {% elseif rec.statut == 'En cours' %}
                    {% set statusClass = 'status-cours' %}
                    {% set badgeClass = 'user-badge-cours' %}
                    {% set badgeText = 'En cours' %}
                {% else %}
                    {% set statusClass = 'status-rejetee' %}
                    {% set badgeClass = 'user-badge-rejetee' %}
                    {% set badgeText = 'Rejetée' %}
                {% endif %}

                <div class="user-rl-card {{ statusClass }}">
                    <div class="user-card-header">
                        <div>
                            <h3 class="user-card-title">{{ rec.subject }}</h3>
                            <div class="user-card-date">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                {% if rec.createdAt is defined and rec.createdAt is not null %}
                                    Soumis le {{ rec.createdAt|date('d/m/Y à H:i') }}
                                {% else %}
                                    Date inconnue
                                {% endif %}
                            </div>
                        </div>
                        <span class="user-badge {{ badgeClass }}">{{ badgeText }}</span>
                    </div>

                    <div class="user-card-body">
                        {{ rec.description|length > 150 ? rec.description|slice(0, 150) ~ '...' : rec.description }}
                    </div>

                    <div class="user-card-footer">
                        <a href="{{ path('app_reclamation_show', {id: rec.id_reclamation}) }}" class="user-btn-action btn-view">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                            Consulter
                        </a>
                        <a href="{{ path('app_reclamation_edit', {id: rec.id_reclamation}) }}" class="user-btn-action btn-edit">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
                            Modifier
                        </a>
                        <form method="post" action="{{ path('app_reclamation_delete', {id: rec.id_reclamation}) }}" onsubmit="return confirm('Souhaitez-vous vraiment retirer cette réclamation ?');" style="margin: 0;">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ rec.id_reclamation) }}">
                            <button class="user-btn-action btn-delete">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                Retirer
                            </button>
                        </form>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endif %}
{% endblock %}

{% block javascripts %}
{% if is_granted('ROLE_ADMIN') %}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const statusCtx = document.getElementById('statusChart');
    if (statusCtx) {
        new Chart(statusCtx.getContext('2d'), {
            type: 'doughnut',
            data: {
                labels: ['En attente', 'En cours', 'Traitées', 'Rejetées'],
                datasets: [{
                    data: [
                        {{ reclamations|filter(r => r.statut == 'En attente')|length }}, 
                        {{ reclamations|filter(r => r.statut == 'En cours')|length }}, 
                        {{ reclamations|filter(r => r.statut == 'Traitée')|length }}, 
                        {{ reclamations|filter(r => r.statut == 'Rejetée')|length }}
                    ],
                    backgroundColor: ['#f59e0b', '#3b82f6', '#10b981', '#ef4444'],
                    borderWidth: 0,
                    hoverOffset: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'right', labels: { usePointStyle: true, boxWidth: 8, font: { family: 'Inter', size: 13 } } }
                },
                cutout: '70%'
            }
        });
    }

    const reponseCtx = document.getElementById('reponseChart');
    if (reponseCtx) {
        new Chart(reponseCtx.getContext('2d'), {
            type: 'doughnut',
            data: {
                labels: ['Avec réponse', 'Sans réponse'],
                datasets: [{
                    data: [
                        {{ reclamations|filter(r => r.reponse is not empty)|length }}, 
                        {{ reclamations|filter(r => r.reponse is empty)|length }}
                    ],
                    backgroundColor: ['#6366f1', '#e5e7eb'],
                    borderWidth: 0,
                    hoverOffset: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'right', labels: { usePointStyle: true, boxWidth: 8, font: { family: 'Inter', size: 13 } } }
                },
                cutout: '70%'
            }
        });
    }

    const barStatsCtx = document.getElementById('barStatsChart');
    if (barStatsCtx) {
        new Chart(barStatsCtx.getContext('2d'), {
            type: 'bar',
            data: {
                labels: ['Total', 'En attente', 'En cours', 'Traitées', 'Rejetées'],
                datasets: [{
                    label: 'Nombre',
                    data: [
                        {{ total }}, 
                        {{ reclamations|filter(r => r.statut == 'En attente')|length }}, 
                        {{ reclamations|filter(r => r.statut == 'En cours')|length }}, 
                        {{ reclamations|filter(r => r.statut == 'Traitée')|length }},
                        {{ reclamations|filter(r => r.statut == 'Rejetée')|length }}
                    ],
                    backgroundColor: [
                        '#0891b2', // Total
                        '#f59e0b', // Attente
                        '#3b82f6', // Cours
                        '#10b981', // Traitee
                        '#ef4444'  // Rejetee
                    ],
                    borderRadius: 8,
                    barThickness: 'flex',
                    maxBarThickness: 40
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#111827',
                        titleFont: { size: 14, weight: '600', family: 'Inter' },
                        bodyFont: { size: 14, family: 'Inter' },
                        padding: 12,
                        cornerRadius: 8,
                        displayColors: false,
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: { borderDash: [4, 4], color: '#f3f4f6', drawBorder: false },
                        ticks: { stepSize: 1, font: {family: 'Inter', size:12} }
                    },
                    x: {
                        grid: { display: false, drawBorder: false },
                        ticks: { font: {family: 'Inter', size:13, weight:'600'} }
                    }
                },
                animation: {
                    duration: 1500,
                    easing: 'easeOutQuart'
                }
            }
        });
    }
});
</script>
{% endif %}
{% endblock %}
