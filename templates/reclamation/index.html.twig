{% extends 'base_admin.html.twig' %}

{% block title %}Gestion des Réclamations — DINARI{% endblock %}

{% block body %}
<div class="topbar">
    <div class="topbar-left">
        <h1>Gestion des Réclamations</h1>
        <p>Visualisez et gérez l'ensemble des réclamations de la plateforme.</p>
    </div>
    <div class="topbar-right">
        <form method="get" action="{{ path('app_reclamation_index') }}" style="display:flex; align-items:center; gap:8px; margin:0;">
            <div class="search-box" style="margin:0; width:auto; border-radius:8px; height:40px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <input type="text" name="search" placeholder="Rechercher..." value="{{ search }}" style="width:130px;">
            </div>
            
            <select name="sort" style="padding:0 14px; border:1px solid #e5e7eb; border-radius:8px; background:#fff; color:#4b5563; font-size:14px; outline:none; height:40px; cursor:pointer; min-width:140px;">
                <option value="recent" {% if sort == 'recent' %}selected{% endif %}>Trier par (Récent)</option>
                <option value="oldest" {% if sort == 'oldest' %}selected{% endif %}>Plus ancien</option>
                <option value="attente" {% if sort == 'attente' %}selected{% endif %}>Statut (A-Z)</option>
            </select>

            <button type="submit" style="padding:0 20px; height:40px; background-color:#2563eb; color:white; border:none; border-radius:8px; font-size:14px; font-weight:600; cursor:pointer;">
                Rechercher
            </button>
            <a href="{{ path('app_reclamation_index') }}" style="display:inline-flex; align-items:center; justify-content:center; padding:0 20px; height:40px; background-color:#f8fafc; color:#475569; border:1px solid #e2e8f0; border-radius:8px; font-size:14px; font-weight:500; text-decoration:none; cursor:pointer;">
                Reset
            </a>
        </form>
        {% if app.user %}
        <div class="admin-badge">
            <div class="admin-info">
                <div class="admin-name">{{ app.user.getUserIdentifier() }}</div>
                <div class="admin-role">
                    {% if is_granted('ROLE_ADMIN') %}Admin{% else %}Utilisateur{% endif %}
                </div>
            </div>
            <div class="avatar-circle" style="background:#3b82f6;">M</div>
        </div>
        {% endif %}
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h2>Liste des Réclamations <span class="count">{{ total }} Total</span></h2>
        <div class="card-actions">
            <a href="#" class="btn btn-outline" style="gap:6px;">
                💬 Chat IA
            </a>
            <a href="{{ path('app_reclamation_new') }}" class="btn btn-primary">+ Créer une réclamation</a>
        </div>
    </div>

    {% if reclamations is empty %}
        <div class="empty-state">
            <div class="empty-icon">📋</div>
            <p>Aucune réclamation trouvée.</p>
        </div>
    {% else %}
        {% for rec in reclamations %}
        <div class="reclamation-card">
            <div class="reclamation-header">
                <span>✉</span>
                <span>{{ rec.email }}</span>
            </div>
            <div class="reclamation-subject">{{ rec.subject }}</div>
            <div class="reclamation-desc">{{ rec.description|length > 120 ? rec.description|slice(0,120) ~ '...' : rec.description }}</div>

            <div class="reclamation-footer">
                <div style="display:flex;align-items:center;gap:10px;">
                    {% set statut = rec.statut %}
                    {% if statut == 'Traitée' %}
                        <span class="badge badge-traitee">Traitée</span>
                    {% elseif statut == 'En attente' %}
                        <span class="badge badge-en_attente">En attente</span>
                    {% elseif statut == 'En cours' %}
                        <span class="badge badge-en_cours">En cours</span>
                    {% else %}
                        <span class="badge badge-rejetee">Rejetée</span>
                    {% endif %}

                    {% if is_granted('ROLE_ADMIN') %}
                    <form method="post" action="{{ path('app_reclamation_status', {id: rec.id_reclamation}) }}" class="status-form">
                        <select name="statut" onchange="this.form.submit()">
                            <option value="En attente" {% if rec.statut == 'En attente' %}selected{% endif %}>En attente</option>
                            <option value="En cours"   {% if rec.statut == 'En cours'   %}selected{% endif %}>En cours</option>
                            <option value="Traitée"    {% if rec.statut == 'Traitée'    %}selected{% endif %}>Traitée</option>
                            <option value="Rejetée"    {% if rec.statut == 'Rejetée'    %}selected{% endif %}>Rejetée</option>
                        </select>
                    </form>
                    {% endif %}
                </div>

                <div class="reclamation-actions">
                    <a href="{{ path('app_reclamation_edit', {id: rec.id_reclamation}) }}" class="btn btn-success">
                        ✏ Modifier
                    </a>
                    <form method="post" action="{{ path('app_reclamation_delete', {id: rec.id_reclamation}) }}" onsubmit="return confirm('Supprimer cette réclamation ?')">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ rec.id_reclamation) }}">
                        <button type="submit" class="btn btn-danger">🗑 Supprimer</button>
                    </form>
                </div>
            </div>
        </div>
        {% endfor %}
    {% endif %}
</div>
{% endblock %}
