{% extends 'base_admin.html.twig' %}

{% block title %}Réponse Groupée IA — Dinari Admin{% endblock %}
{% block page_title %}🤖 Réponse Groupée par IA{% endblock %}

{% block stylesheets %}
<style>
/* ══ PAGE VARS ══════════════════════════════════════════════════════════════ */
:root {
    --ml-purple: #7C3AED;
    --ml-violet: #6D28D9;
    --ml-pink:   #EC4899;
    --ml-cyan:   #06B6D4;
}

/* ══ PAGE HEADER ════════════════════════════════════════════════════════════ */
.page-header {
    display: flex; align-items: flex-start; justify-content: space-between;
    margin-bottom: 28px; gap: 20px; flex-wrap: wrap;
}
.page-header-left .page-title {
    font-size: 22px; font-weight: 800; color: var(--text);
    display: flex; align-items: center; gap: 10px;
}
.page-header-left .page-subtitle {
    font-size: 13px; color: var(--muted); margin-top: 4px;
}

/* ══ ML BADGE ═══════════════════════════════════════════════════════════════ */
.ml-badge {
    display: inline-flex; align-items: center; gap: 6px;
    background: linear-gradient(135deg, var(--ml-purple), var(--ml-pink));
    color: #fff; padding: 5px 14px; border-radius: 20px; font-size: 11px;
    font-weight: 700; letter-spacing: 0.5px; animation: glow 3s ease-in-out infinite;
}
@keyframes glow {
    0%,100% { box-shadow: 0 0 12px rgba(124,58,237,0.4); }
    50%      { box-shadow: 0 0 24px rgba(124,58,237,0.7); }
}

/* ══ CARD BASE ══════════════════════════════════════════════════════════════ */
.dk-card {
    background: #fff; border-radius: 14px;
    border: 1px solid var(--border); margin-bottom: 22px;
    overflow: hidden;
}
.dk-card-header {
    padding: 18px 22px; border-bottom: 1px solid var(--border);
    display: flex; align-items: center; gap: 11px;
}
.dk-card-header-icon {
    width: 38px; height: 38px; border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-size: 19px; flex-shrink: 0;
}
.icon-purple { background: rgba(124,58,237,0.1); color: var(--ml-purple); }
.icon-blue   { background: rgba(37,99,235,0.1);  color: var(--blue); }
.icon-green  { background: rgba(16,185,129,0.1); color: #059669; }
.icon-amber  { background: rgba(245,158,11,0.1); color: #D97706; }

.dk-card-title { font-size: 14px; font-weight: 700; color: var(--text); }
.dk-card-subtitle { font-size: 11px; color: var(--muted); margin-top: 1px; }
.dk-card-body { padding: 22px; }

/* ══ SEARCH FORM ════════════════════════════════════════════════════════════ */
.search-textarea {
    width: 100%; padding: 14px 16px; border: 1.5px solid var(--border);
    border-radius: 10px; font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 14px; color: var(--text); resize: vertical; min-height: 100px;
    transition: border-color 0.2s, box-shadow 0.2s; background: var(--surface);
}
.search-textarea:focus {
    outline: none; border-color: var(--ml-purple);
    box-shadow: 0 0 0 3px rgba(124,58,237,0.1);
}
.search-hint {
    font-size: 11.5px; color: var(--muted); margin-top: 7px;
    display: flex; align-items: center; gap: 5px;
}

/* ══ ML RESULT BANNER ═══════════════════════════════════════════════════════ */
.ml-result-banner {
    background: linear-gradient(135deg, rgba(124,58,237,0.06), rgba(236,72,153,0.06));
    border: 1.5px solid rgba(124,58,237,0.2); border-radius: 12px;
    padding: 18px 22px; margin-bottom: 22px;
    animation: slideDown 0.4s ease;
}
@keyframes slideDown { from { opacity:0; transform:translateY(-10px); } to { opacity:1; transform:translateY(0); } }

.ml-result-header {
    display: flex; align-items: center; gap: 12px; margin-bottom: 14px;
}
.ml-type-chip {
    background: linear-gradient(135deg, var(--ml-purple), var(--ml-pink));
    color: #fff; padding: 6px 16px; border-radius: 20px;
    font-size: 13px; font-weight: 700; letter-spacing: 0.3px;
}
.ml-confidence-text {
    font-size: 12px; color: var(--muted); font-weight: 500;
}
.ml-confidence-text strong { color: var(--ml-purple); }

/* Barre de confiance */
.confidence-bar-wrap { margin-top: 4px; }
.confidence-label { display: flex; justify-content: space-between; margin-bottom: 5px; }
.confidence-label span { font-size: 11px; color: var(--muted); font-weight: 600; }
.confidence-bar {
    height: 7px; background: rgba(124,58,237,0.12);
    border-radius: 10px; overflow: hidden;
}
.confidence-fill {
    height: 100%; border-radius: 10px;
    background: linear-gradient(90deg, var(--ml-purple), var(--ml-pink));
    transition: width 0.8s cubic-bezier(0.4,0,0.2,1);
}

/* Scores complets */
.all-scores-grid {
    display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px;
}
.score-pill {
    display: flex; align-items: center; gap: 6px;
    padding: 5px 12px; border-radius: 20px; font-size: 11px;
    border: 1px solid var(--border); background: #fff;
}
.score-pill.top { background: rgba(124,58,237,0.08); border-color: rgba(124,58,237,0.3); }
.score-dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }
.score-name { font-weight: 600; color: var(--text); }
.score-value { color: var(--muted); }

/* ══ RECLAMATIONS TABLE ══════════════════════════════════════════════════════ */
.rec-count-bar {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 14px;
}
.rec-count-label {
    font-size: 13px; font-weight: 600; color: var(--text);
    display: flex; align-items: center; gap: 8px;
}
.count-badge {
    background: linear-gradient(135deg, var(--blue), var(--indigo));
    color: #fff; padding: 2px 10px; border-radius: 20px; font-size: 11px;
    font-weight: 700;
}

.rec-table { width: 100%; border-collapse: collapse; font-size: 13px; }
.rec-table th {
    background: var(--surface); color: var(--muted); font-size: 10.5px;
    font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px;
    padding: 10px 14px; border-bottom: 1px solid var(--border); text-align: left;
}
.rec-table td {
    padding: 12px 14px; border-bottom: 1px solid #F1F5F9;
    vertical-align: middle;
}
.rec-table tr:last-child td { border-bottom: none; }
.rec-table tr:hover td { background: #FAFBFF; }

.email-cell { font-weight: 600; color: var(--text); }
.desc-cell  { color: var(--muted); max-width: 260px; }
.desc-cell span { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

.status-badge {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 3px 9px; border-radius: 20px; font-size: 10px; font-weight: 700;
}
.s-attente  { background: rgba(245,158,11,0.1); color: #92400E; }
.s-cours    { background: rgba(37,99,235,0.1);  color: #1E40AF; }
.s-traitee  { background: rgba(16,185,129,0.1); color: #065F46; }
.s-rejetee  { background: rgba(239,68,68,0.1);  color: #991B1B; }

.empty-state {
    text-align: center; padding: 48px 20px;
}
.empty-state-icon {
    font-size: 44px; color: rgba(100,116,139,0.3); margin-bottom: 12px;
}
.empty-state-title { font-size: 15px; font-weight: 700; color: var(--muted); }
.empty-state-sub   { font-size: 12px; color: var(--muted2); margin-top: 4px; }

/* ══ RESPONSE FORM ══════════════════════════════════════════════════════════ */
.response-textarea {
    width: 100%; padding: 14px 16px; border: 1.5px solid var(--border);
    border-radius: 10px; font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 14px; color: var(--text); resize: vertical; min-height: 130px;
    transition: border-color 0.2s, box-shadow 0.2s; background: var(--surface);
}
.response-textarea:focus {
    outline: none; border-color: #059669;
    box-shadow: 0 0 0 3px rgba(5,150,105,0.1);
}
.send-all-btn {
    display: inline-flex; align-items: center; gap: 8px;
    background: linear-gradient(135deg, #059669, #047857);
    color: #fff; padding: 12px 26px; border-radius: 10px; border: none;
    font-size: 14px; font-weight: 700; cursor: pointer;
    font-family: 'Plus Jakarta Sans', sans-serif;
    box-shadow: 0 4px 14px rgba(5,150,105,0.35);
    transition: all 0.18s;
}
.send-all-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(5,150,105,0.45);
}
.send-all-btn:disabled {
    opacity: 0.55; cursor: not-allowed; transform: none;
}
.send-all-btn i { font-size: 17px; }

.warning-banner {
    background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.3);
    border-radius: 10px; padding: 12px 16px; font-size: 12.5px; color: #92400E;
    display: flex; align-items: flex-start; gap: 9px; margin-bottom: 16px;
}
.warning-banner i { font-size: 17px; flex-shrink: 0; margin-top: 1px; }

/* ══ GRID LAYOUT ════════════════════════════════════════════════════════════ */
.bulk-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
@media (max-width: 900px) { .bulk-grid { grid-template-columns: 1fr; } }

/* ══ STEPS GUIDE ════════════════════════════════════════════════════════════ */
.steps-row {
    display: flex; gap: 0; margin-bottom: 26px;
    background: #fff; border: 1px solid var(--border);
    border-radius: 12px; overflow: hidden;
}
.step {
    flex: 1; padding: 14px 16px; display: flex; align-items: center; gap: 10px;
    border-right: 1px solid var(--border); position: relative;
}
.step:last-child { border-right: none; }
.step-num {
    width: 28px; height: 28px; border-radius: 50%; display: flex;
    align-items: center; justify-content: center; font-size: 12px;
    font-weight: 800; flex-shrink: 0;
}
.step-num.done { background: rgba(5,150,105,0.15); color: #059669; }
.step-num.active { background: linear-gradient(135deg, var(--ml-purple), var(--ml-pink)); color: #fff; }
.step-num.pending { background: var(--surface); color: var(--muted2); border: 1.5px solid var(--border); }
.step-text { font-size: 12px; color: var(--muted); font-weight: 500; }
.step-text strong { color: var(--text); display: block; font-size: 12.5px; }

/* ══ NO-RESULTS CARD ════════════════════════════════════════════════════════ */
.ml-error-banner {
    background: rgba(239,68,68,0.06); border: 1px solid rgba(239,68,68,0.2);
    border-radius: 12px; padding: 16px 20px; display: flex; align-items: center; gap: 12px;
    margin-bottom: 22px; animation: slideDown 0.4s ease;
}
.ml-error-banner i { font-size: 22px; color: #EF4444; flex-shrink: 0; }
.ml-error-banner .err-title { font-size: 13px; font-weight: 700; color: #991B1B; }
.ml-error-banner .err-sub   { font-size: 11.5px; color: #B91C1C; margin-top: 2px; }
</style>
{% endblock %}

{% block body %}

{# ── Page header ──────────────────────────────────────────────────────────── #}
<div class="page-header">
    <div class="page-header-left">
        <div class="page-title">
            <i class="ri-ai-generate" style="color:var(--ml-purple)"></i>
            Réponse Groupée par IA
        </div>
        <div class="page-subtitle">
            Classifiez les réclamations avec un modèle ML et envoyez une réponse unique à toutes.
        </div>
    </div>
    <div style="display:flex;gap:10px;align-items:center;">
        <span class="ml-badge"><i class="ri-robot-line"></i> TF-IDF · LogisticRegression</span>
        <a href="{{ path('app_reclamation_index') }}" class="btn-d btn-secondary-d">
            <i class="ri-arrow-left-line"></i> Retour
        </a>
    </div>
</div>

{# ── Étapes ────────────────────────────────────────────────────────────────── #}
<div class="steps-row">
    <div class="step">
        <div class="step-num {{ search_text ? 'done' : 'active' }}">
            {{ search_text ? '✓' : '1' }}
        </div>
        <div class="step-text">
            <strong>Décrire le problème</strong>
            Saisir un texte libre
        </div>
    </div>
    <div class="step">
        <div class="step-num {{ predicted_type ? 'done' : (search_text ? 'active' : 'pending') }}">
            {{ predicted_type ? '✓' : '2' }}
        </div>
        <div class="step-text">
            <strong>Classification ML</strong>
            Prédire le type automatiquement
        </div>
    </div>
    <div class="step">
        <div class="step-num {{ reclamations|length > 0 ? 'done' : 'pending' }}">
            {{ reclamations|length > 0 ? '✓' : '3' }}
        </div>
        <div class="step-text">
            <strong>Voir les réclamations</strong>
            {{ reclamations|length }} trouvée(s)
        </div>
    </div>
    <div class="step">
        <div class="step-num pending">4</div>
        <div class="step-text">
            <strong>Envoyer la réponse</strong>
            Mise à jour groupée
        </div>
    </div>
</div>

{# ── Erreur ML ─────────────────────────────────────────────────────────────── #}
{% if ml_error %}
<div class="ml-error-banner">
    <i class="ri-error-warning-line"></i>
    <div>
        <div class="err-title">Erreur du modèle ML</div>
        <div class="err-sub">{{ ml_error }}</div>
    </div>
</div>
{% endif %}

{# ── Grille principale ─────────────────────────────────────────────────────── #}
<div class="bulk-grid">

    {# ══ Colonne gauche : Recherche ML ══ #}
    <div>
        {# Formulaire de recherche #}
        <div class="dk-card">
            <div class="dk-card-header">
                <div class="dk-card-header-icon icon-purple">
                    <i class="ri-search-eye-line"></i>
                </div>
                <div>
                    <div class="dk-card-title">Classification intelligente</div>
                    <div class="dk-card-subtitle">Le modèle ML prédit le type à partir de votre description</div>
                </div>
            </div>
            <div class="dk-card-body">
                <form method="POST" action="{{ path('app_reclamation_admin_bulk_search') }}" id="ml-search-form">
                    <label style="font-size:12.5px;font-weight:700;color:var(--text);display:block;margin-bottom:8px;">
                        Décrivez le type de problème
                    </label>
                    <textarea
                        id="search_text"
                        name="search_text"
                        class="search-textarea"
                        placeholder="Ex : problème de virement bancaire, paiement refusé, erreur de débit..."
                        required
                    >{{ search_text }}</textarea>
                    <div class="search-hint">
                        <i class="ri-information-line" style="color:var(--accent)"></i>
                        Plus votre description est précise, plus la prédiction sera fiable.
                    </div>
                    <div style="margin-top:16px;">
                        <button type="submit" class="btn-d btn-primary-d" id="classify-btn">
                            <i class="ri-brain-line"></i> Classifier avec ML
                        </button>
                    </div>
                </form>
            </div>
        </div>

        {# Résultat ML #}
        {% if predicted_type and not ml_error %}
        <div class="ml-result-banner">
            <div class="ml-result-header">
                <span class="ml-type-chip">{{ predicted_type }}</span>
                <span class="ml-confidence-text">
                    Confiance : <strong>{{ (confidence * 100)|number_format(1) }}%</strong>
                </span>
            </div>

            <div class="confidence-bar-wrap">
                <div class="confidence-label">
                    <span>Score de confiance</span>
                    <span>{{ (confidence * 100)|number_format(1) }}%</span>
                </div>
                <div class="confidence-bar">
                    <div class="confidence-fill" style="width: {{ (confidence * 100)|round }}%"></div>
                </div>
            </div>

            {% if all_scores %}
            <div class="all-scores-grid" style="margin-top:14px;">
                {% set colors = {
                    'Paiement':  '#7C3AED',
                    'Technique': '#2563EB',
                    'Compte':    '#059669',
                    'Service':   '#D97706',
                    'Livraison': '#EC4899'
                } %}
                {% for typeName, score in all_scores|keys|map(k => {k: k})|reduce((acc, v) => acc) %}
                {# Use a simpler loop #}
                {% endfor %}
                {% for typeName, score in all_scores %}
                <div class="score-pill {{ typeName == predicted_type ? 'top' : '' }}">
                    <div class="score-dot" style="background:{{ colors[typeName] ?? '#94A3B8' }}"></div>
                    <span class="score-name">{{ typeName }}</span>
                    <span class="score-value">{{ (score * 100)|number_format(0) }}%</span>
                </div>
                {% endfor %}
            </div>
            {% endif %}
        </div>
        {% endif %}
    </div>

    {# ══ Colonne droite : Formulaire de réponse ══ #}
    <div>
        {% if predicted_type and reclamations|length > 0 %}
        <div class="dk-card">
            <div class="dk-card-header">
                <div class="dk-card-header-icon icon-green">
                    <i class="ri-send-plane-line"></i>
                </div>
                <div>
                    <div class="dk-card-title">Envoyer une réponse groupée</div>
                    <div class="dk-card-subtitle">
                        Cette réponse sera envoyée à toutes les <strong>{{ reclamations|length }}</strong>
                        réclamation(s) de type « {{ predicted_type }} »
                    </div>
                </div>
            </div>
            <div class="dk-card-body">
                <div class="warning-banner">
                    <i class="ri-alert-line"></i>
                    <div>
                        <strong>Action irréversible :</strong> la réponse sera appliquée à
                        <strong>{{ reclamations|length }}</strong> réclamation(s) et leur statut
                        passera automatiquement à <strong>« Traitée »</strong>.
                    </div>
                </div>

                <form method="POST" action="{{ path('app_reclamation_admin_bulk_send') }}" id="send-form">
                    <input type="hidden" name="type" value="{{ predicted_type }}">

                    <label style="font-size:12.5px;font-weight:700;color:var(--text);display:block;margin-bottom:8px;">
                        Votre réponse
                    </label>
                    <textarea
                        id="reponse"
                        name="reponse"
                        class="response-textarea"
                        placeholder="Rédigez votre réponse officielle ici...&#10;Ex : Nous avons bien pris note de votre réclamation concernant un problème de paiement..."
                        required
                    ></textarea>

                    <div style="display:flex;align-items:center;justify-content:space-between;margin-top:16px;flex-wrap:wrap;gap:10px;">
                        <div style="font-size:12px;color:var(--muted);">
                            <i class="ri-checkbox-circle-line" style="color:#059669"></i>
                            Statut → <strong>Traitée</strong> pour toutes les réclamations
                        </div>
                        <button type="submit" class="send-all-btn" id="send-btn" onclick="return confirmSend()">
                            <i class="ri-send-plane-fill"></i>
                            Envoyer à {{ reclamations|length }} réclamation(s)
                        </button>
                    </div>
                </form>
            </div>
        </div>
        {% elseif predicted_type and reclamations|length == 0 %}
        <div class="dk-card">
            <div class="dk-card-body">
                <div class="empty-state">
                    <div class="empty-state-icon"><i class="ri-inbox-line"></i></div>
                    <div class="empty-state-title">Aucune réclamation trouvée</div>
                    <div class="empty-state-sub">
                        Aucune réclamation de type « {{ predicted_type }} » n'est actuellement en base.
                    </div>
                </div>
            </div>
        </div>
        {% else %}
        <div class="dk-card">
            <div class="dk-card-body">
                <div class="empty-state">
                    <div class="empty-state-icon"><i class="ri-robot-line" style="color:rgba(124,58,237,0.3)"></i></div>
                    <div class="empty-state-title">En attente de classification</div>
                    <div class="empty-state-sub">
                        Décrivez le problème à gauche pour que le modèle ML<br>
                        classe automatiquement les réclamations concernées.
                    </div>
                </div>
            </div>
        </div>
        {% endif %}
    </div>
</div>

{# ── Tableau des réclamations trouvées ─────────────────────────────────────── #}
{% if reclamations|length > 0 %}
<div class="dk-card">
    <div class="dk-card-header">
        <div class="dk-card-header-icon icon-blue">
            <i class="ri-list-check-3"></i>
        </div>
        <div style="flex:1">
            <div class="dk-card-title">Réclamations identifiées</div>
            <div class="dk-card-subtitle">Type « {{ predicted_type }} » — classifiées par le modèle ML</div>
        </div>
        <div class="rec-count-label">
            <span class="count-badge">{{ reclamations|length }}</span>
        </div>
    </div>
    <div class="dk-card-body" style="padding:0">
        <div style="overflow-x:auto;">
            <table class="rec-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Email</th>
                        <th>Sujet</th>
                        <th>Description</th>
                        <th>Statut</th>
                        <th>Réponse</th>
                    </tr>
                </thead>
                <tbody>
                    {% for rec in reclamations %}
                    <tr>
                        <td style="color:var(--muted2);font-size:12px;font-weight:600;">
                            #{{ rec.id_reclamation }}
                        </td>
                        <td class="email-cell">{{ rec.email }}</td>
                        <td style="font-size:12px;color:var(--muted);font-weight:500;max-width:160px;">
                            <span style="display:-webkit-box;-webkit-line-clamp:1;-webkit-box-orient:vertical;overflow:hidden;">
                                {{ rec.subject }}
                            </span>
                        </td>
                        <td class="desc-cell">
                            <span>{{ rec.description }}</span>
                        </td>
                        <td>
                            {% set s = rec.statut %}
                            <span class="status-badge
                                {{ s == 'En attente' ? 's-attente' :
                                   (s == 'En cours'  ? 's-cours' :
                                   (s == 'Traitée'   ? 's-traitee' : 's-rejetee')) }}">
                                {{ s }}
                            </span>
                        </td>
                        <td style="font-size:11px;color:var(--muted);">
                            {% if rec.reponse %}
                                <span style="display:-webkit-box;-webkit-line-clamp:1;-webkit-box-orient:vertical;overflow:hidden;max-width:140px;">
                                    {{ rec.reponse }}
                                </span>
                            {% else %}
                                <span style="color:var(--muted2);font-style:italic;">Aucune</span>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endif %}

{% endblock %}

{% block javascripts %}
<script>
// Animation du bouton classify
document.getElementById('ml-search-form')?.addEventListener('submit', function() {
    const btn = document.getElementById('classify-btn');
    if (btn) {
        btn.innerHTML = '<i class="ri-loader-4-line" style="animation:spin 1s linear infinite"></i> Classification en cours...';
        btn.disabled = true;
    }
});

// Confirmation avant envoi groupé
function confirmSend() {
    const textarea = document.getElementById('reponse');
    if (!textarea?.value.trim()) {
        alert('Veuillez saisir une réponse avant d\'envoyer.');
        return false;
    }
    const count = {{ reclamations|length }};
    const type  = '{{ predicted_type|escape('js') }}';
    return confirm(
        `⚠️ Vous allez envoyer une réponse à ${count} réclamation(s) de type « ${type} ».\n\n` +
        `Leur statut va passer à "Traitée".\n\nConfirmez-vous cette action ?`
    );
}

// Spinner animation
const style = document.createElement('style');
style.textContent = '@keyframes spin { from{transform:rotate(0deg)} to{transform:rotate(360deg)} }';
document.head.appendChild(style);
</script>
{% endblock %}
