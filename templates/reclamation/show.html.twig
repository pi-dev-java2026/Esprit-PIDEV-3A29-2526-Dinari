{% extends is_granted('ROLE_ADMIN') ? 'base_admin.html.twig' : 'base.html.twig' %}

{% block title %}Détails de la réclamation — DINARI{% endblock %}
{% block page_title %}Détails de la réclamation{% endblock %}

{% block stylesheets %}
<link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
<style>
    :root {
        --p:  #2563EB; --p2: #4F46E5;
        --pg: linear-gradient(135deg, #2563EB, #4F46E5);
        --grn: #10B981; --amb: #F59E0B; --red: #EF4444; --sky: #0EA5E9;
        --bg: #F8FAFC; --bd: #E2E8F0;
        --tx: #0F172A; --tm: #64748B; --tl: #94A3B8;
        --wh: #fff;
        --sh: 0 1px 3px rgba(0,0,0,.05), 0 4px 16px rgba(0,0,0,.06);
    }

    .rv-wrap { max-width: 820px; margin: 0 auto; font-family: 'Plus Jakarta Sans', sans-serif; padding-bottom: 50px; }

    /* ── Back button ── */
    .back-btn {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 9px 20px; border-radius: 50px;
        background: var(--wh); border: 1.5px solid var(--bd);
        color: var(--tm); font-size: 13px; font-weight: 600;
        text-decoration: none; margin-bottom: 28px;
        box-shadow: var(--sh); transition: all .22s;
    }
    .back-btn:hover { border-color: var(--p); color: var(--p); transform: translateX(-3px); }
    .back-btn i { font-size: 17px; }

    /* ── Hero header ── */
    .rv-hero {
        background: var(--wh); border: 1px solid var(--bd);
        border-radius: 20px; overflow: hidden;
        box-shadow: var(--sh); margin-bottom: 20px;
    }
    .rv-hero-banner {
        height: 110px;
        background: linear-gradient(135deg, #1D4ED8 0%, #7C3AED 60%, #0EA5E9 100%);
        position: relative; overflow: hidden;
    }
    .rv-hero-banner::before {
        content: ''; position: absolute;
        width: 260px; height: 260px; border-radius: 50%;
        background: rgba(255,255,255,.06); top: -100px; right: -60px;
    }
    .rv-hero-banner::after {
        content: ''; position: absolute;
        width: 140px; height: 140px; border-radius: 50%;
        background: rgba(255,255,255,.04); bottom: -70px; left: 50px;
    }
    .rv-icon-float {
        position: absolute; right: 36px; top: 50%;
        transform: translateY(-50%);
        font-size: 64px; opacity: .10; color: #fff;
    }

    .rv-hero-body { padding: 24px 32px 28px; }
    .rv-hero-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
    .rv-id { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.4px; color: var(--tl); margin-bottom: 6px; }
    .rv-subject { font-size: 20px; font-weight: 800; color: var(--tx); letter-spacing: -.3px; }

    /* Status badge */
    .status-badge {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 7px 18px; border-radius: 50px;
        font-size: 12.5px; font-weight: 700; white-space: nowrap;
        flex-shrink: 0; margin-top: 4px;
    }
    .status-badge i { font-size: 14px; }
    .s-attente  { background: #FEF3C7; color: #92400E; }
    .s-cours    { background: #DBEAFE; color: #1D4ED8; }
    .s-traitee  { background: #D1FAE5; color: #065F46; }
    .s-rejetee  { background: #FEE2E2; color: #991B1B; }

    /* Meta pills */
    .rv-meta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }
    .meta-pill {
        display: inline-flex; align-items: center; gap: 7px;
        padding: 6px 14px; border-radius: 9px; border: 1px solid var(--bd);
        background: var(--bg); font-size: 12.5px; color: var(--tm); font-weight: 600;
    }
    .meta-pill i { font-size: 14px; color: var(--p); }

    /* ── Section title ── */
    .section-title {
        font-size: 11px; font-weight: 700; text-transform: uppercase;
        letter-spacing: 1.4px; color: var(--tl); margin: 24px 0 12px;
        display: flex; align-items: center; gap: 8px;
    }
    .section-title::after { content: ''; flex: 1; height: 1px; background: var(--bd); }

    /* ── Content cards ── */
    .content-card {
        background: var(--wh); border: 1px solid var(--bd);
        border-radius: 16px; padding: 24px 28px;
        box-shadow: var(--sh); margin-bottom: 16px;
        position: relative; overflow: hidden;
    }
    .content-card-label {
        display: flex; align-items: center; gap: 8px;
        font-size: 11px; font-weight: 700; text-transform: uppercase;
        letter-spacing: .9px; color: var(--tl); margin-bottom: 12px;
    }
    .content-card-label i { font-size: 15px; }
    .content-card-text {
        font-size: 14.5px; color: var(--tx); line-height: 1.75;
        white-space: pre-wrap; word-break: break-word;
    }
    .content-card-text.muted { color: var(--tl); font-style: italic; }

    /* Description special style */
    .desc-card { border-left: 4px solid #C7D2FE; }
    .desc-card .content-card-label i { color: #4F46E5; }

    /* Response card */
    .resp-card {
        border-left: 4px solid #6EE7B7;
        background: linear-gradient(135deg, #F0FDF4, #ECFDF5);
    }
    .resp-card .content-card-label { color: #065F46; }
    .resp-card .content-card-label i { color: #10B981; }
    .resp-card .content-card-text { color: #065F46; }

    /* No response state */
    .no-response {
        background: var(--bg); border: 2px dashed var(--bd);
        border-radius: 16px; padding: 32px; text-align: center;
        color: var(--tl); font-size: 13.5px;
    }
    .no-response i { font-size: 36px; display: block; margin-bottom: 10px; opacity: .4; }

    /* ── Action buttons ── */
    .actions-bar {
        display: flex; gap: 12px; margin-top: 24px; flex-wrap: wrap;
    }
    .btn-act {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 10px 22px; border-radius: 11px;
        font-size: 13px; font-weight: 700;
        text-decoration: none; cursor: pointer;
        transition: all .2s; border: none;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .btn-act i { font-size: 16px; }
    .btn-primary { background: var(--pg); color: #fff; box-shadow: 0 4px 14px rgba(37,99,235,.28); }
    .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 22px rgba(37,99,235,.35); color: #fff; }
    .btn-danger { background: #fff; color: var(--red); border: 1.5px solid #FECACA; }
    .btn-danger:hover { background: #FEF2F2; border-color: var(--red); transform: translateY(-2px); }
</style>
{% endblock %}

{% block body %}
<div class="rv-wrap">

    {# ── Back ── #}
    <a href="{{ path('app_reclamation_index') }}" class="back-btn">
        <i class="ri-arrow-left-s-line"></i> Retour à la liste
    </a>

    {# ── Hero ── #}
    <div class="rv-hero">
        <div class="rv-hero-banner">
            <i class="ri-chat-3-fill rv-icon-float"></i>
        </div>
        <div class="rv-hero-body">
            <div class="rv-hero-top">
                <div>
                    <div class="rv-id"><i class="ri-hashtag" style="font-size:10px;"></i> Réclamation #{{ reclamation.id_reclamation }}</div>
                    <div class="rv-subject">{{ reclamation.subject }}</div>
                </div>

                {# Status badge #}
                {% if reclamation.statut == 'Traitée' %}
                    <span class="status-badge s-traitee"><i class="ri-checkbox-circle-fill"></i> Traitée</span>
                {% elseif reclamation.statut == 'En cours' %}
                    <span class="status-badge s-cours"><i class="ri-loader-3-line"></i> En cours</span>
                {% elseif reclamation.statut == 'Rejetée' %}
                    <span class="status-badge s-rejetee"><i class="ri-close-circle-fill"></i> Rejetée</span>
                {% else %}
                    <span class="status-badge s-attente"><i class="ri-time-fill"></i> En attente</span>
                {% endif %}
            </div>

            {# Meta info pills #}
            <div class="rv-meta">
                <span class="meta-pill">
                    <i class="ri-mail-line"></i> {{ reclamation.email }}
                </span>
                {% if reclamation.createdAt is defined and reclamation.createdAt %}
                <span class="meta-pill">
                    <i class="ri-calendar-event-line"></i>
                    {{ reclamation.createdAt|date('d/m/Y à H:i') }}
                </span>
                {% else %}
                <span class="meta-pill" style="color:var(--tl);">
                    <i class="ri-calendar-line"></i> Date non spécifiée
                </span>
                {% endif %}
                {% if reclamation.type is defined and reclamation.type %}
                <span class="meta-pill">
                    <i class="ri-price-tag-3-line"></i> {{ reclamation.type }}
                </span>
                {% endif %}
            </div>
        </div>
    </div>

    {# ── Description ── #}
    <div class="section-title"><i class="ri-file-text-line"></i> Description</div>

    <div class="content-card desc-card">
        <div class="content-card-label">
            <i class="ri-align-left"></i> Description complète
        </div>
        {% if reclamation.description %}
            <div class="content-card-text">{{ reclamation.description|nl2br }}</div>
        {% else %}
            <div class="content-card-text muted">Aucune description fournie.</div>
        {% endif %}
    </div>

    {# ── Response ── #}
    <div class="section-title"><i class="ri-reply-line"></i> Réponse de l'administration</div>

    {% if reclamation.reponse %}
        <div class="content-card resp-card">
            <div class="content-card-label">
                <i class="ri-shield-check-fill"></i> Réponse officielle
            </div>
            <div class="content-card-text">{{ reclamation.reponse|nl2br }}</div>
        </div>
    {% else %}
        <div class="no-response">
            <i class="ri-chat-off-line"></i>
            Aucune réponse n'a encore été apportée à cette réclamation.
        </div>
    {% endif %}

    {# ── Actions ── #}
    {% if is_granted('ROLE_ADMIN') or reclamation.email == app.user.email %}
    <div class="actions-bar">
        <a href="{{ path('app_reclamation_edit', {id: reclamation.id_reclamation}) }}" class="btn-act btn-primary">
            <i class="ri-edit-line"></i> Modifier
        </a>
        <form method="post" action="{{ path('app_reclamation_delete', {id: reclamation.id_reclamation}) }}"
              onsubmit="return confirm('Supprimer cette réclamation ?')" style="margin:0">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ reclamation.id_reclamation) }}">
            <button type="submit" class="btn-act btn-danger">
                <i class="ri-delete-bin-6-line"></i> Supprimer
            </button>
        </form>
    </div>
    {% endif %}

</div>
{% endblock %}
