{% extends is_granted('ROLE_ADMIN') ? 'base_admin.html.twig' : 'base.html.twig' %}

{% block title %}DINARI — Assistant IA{% endblock %}

{% block stylesheets %}
<style>
    /* ═══════════════════════════════════════════════════════════
       CHATBOT — STYLES REDESIGN PREMIUM
    ═══════════════════════════════════════════════════════════ */

    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');

    :root {
        --c-bg:          #080c18;
        --c-surface:     rgba(17, 25, 50, 0.85);
        --c-surface-2:   rgba(26, 37, 68, 0.9);
        --c-border:      rgba(99, 130, 220, 0.18);
        --c-border-glow: rgba(99, 130, 220, 0.4);
        --c-accent:      #4f8ef7;
        --c-accent-2:    #8b5cf6;
        --c-accent-3:    #06b6d4;
        --c-user-bg:     linear-gradient(135deg, #3b6fd4 0%, #6c40d9 100%);
        --c-bot-bg:      rgba(26, 37, 68, 0.7);
        --c-text:        #dde6f5;
        --c-muted:       #7a90b8;
        --c-success:     #10d98a;
        --c-warning:     #f59e0b;
        --c-error:       #ef4444;
        --c-radius:      20px;
        --c-radius-sm:   10px;
        --c-shadow:      0 32px 80px rgba(0, 0, 0, 0.75);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    /* ── Animated background ── */
    .chat-page {
        min-height: calc(100vh - 60px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px 20px 20px 20px;
        padding-top: 70px;
        font-family: 'Inter', sans-serif;
        position: relative;
        overflow: hidden;
        background: var(--c-bg);
    }

    .chat-page::before {
        content: '';
        position: fixed;
        inset: 0;
        background:
            radial-gradient(ellipse 80% 60% at 20% 10%, rgba(79, 142, 247, 0.18) 0%, transparent 60%),
            radial-gradient(ellipse 70% 50% at 80% 80%, rgba(139, 92, 246, 0.18) 0%, transparent 60%),
            radial-gradient(ellipse 60% 40% at 60% 20%, rgba(6, 182, 212, 0.10) 0%, transparent 50%);
        pointer-events: none;
        z-index: 0;
        animation: bgShift 12s ease-in-out infinite alternate;
    }

    @keyframes bgShift {
        0%   { opacity: 0.8; filter: hue-rotate(0deg); }
        100% { opacity: 1;   filter: hue-rotate(20deg); }
    }

    /* Floating orbs */
    .chat-orb {
        position: fixed;
        border-radius: 50%;
        pointer-events: none;
        z-index: 0;
        filter: blur(70px);
        animation: orbFloat 15s ease-in-out infinite;
    }
    .chat-orb-1 { width: 350px; height: 350px; top: -80px; left: -80px; background: rgba(79, 142, 247, 0.12); animation-delay: 0s; }
    .chat-orb-2 { width: 300px; height: 300px; bottom: -60px; right: -60px; background: rgba(139, 92, 246, 0.12); animation-delay: -5s; }
    .chat-orb-3 { width: 200px; height: 200px; top: 50%; right: 10%; background: rgba(6, 182, 212, 0.08); animation-delay: -10s; }

    @keyframes orbFloat {
        0%, 100% { transform: translate(0, 0) scale(1); }
        33%       { transform: translate(20px, -30px) scale(1.05); }
        66%       { transform: translate(-15px, 20px) scale(0.95); }
    }

    /* ── Chat wrapper ── */
    .chat-wrapper {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        width: 100%;
        max-width: 880px;
        height: calc(100vh - 140px);
        min-height: 520px;
        max-height: 820px;
        border-radius: var(--c-radius);
        background: var(--c-surface);
        border: 1px solid var(--c-border);
        box-shadow: var(--c-shadow),
                    0 0 0 1px rgba(255,255,255,0.04) inset,
                    0 1px 0 rgba(255,255,255,0.06) inset;
        overflow: hidden;
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
    }

    /* ── Header ── */
    .chat-header {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 16px 22px;
        background: linear-gradient(135deg, rgba(18, 34, 80, 0.95) 0%, rgba(35, 18, 90, 0.95) 100%);
        border-bottom: 1px solid var(--c-border);
        flex-shrink: 0;
        position: relative;
        overflow: hidden;
    }

    .chat-header::after {
        content: '';
        position: absolute;
        bottom: 0; left: 0; right: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(79,142,247,0.6), rgba(139,92,246,0.6), transparent);
    }

    .chat-back-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255,255,255,0.12);
        color: white;
        text-decoration: none;
        transition: all 0.25s ease;
        margin-right: 2px;
        flex-shrink: 0;
    }
    .chat-back-btn:hover {
        background: rgba(255, 255, 255, 0.2);
        border-color: rgba(255,255,255,0.25);
        transform: translateX(-3px);
        box-shadow: 0 4px 14px rgba(0,0,0,0.3);
    }

    .chat-header-avatar {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        background: linear-gradient(135deg, #4f8ef7, #8b5cf6);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        flex-shrink: 0;
        box-shadow: 0 0 0 3px rgba(79, 142, 247, 0.25),
                    0 0 20px rgba(79, 142, 247, 0.3);
        animation: avatarPulse 3s ease infinite;
    }

    @keyframes avatarPulse {
        0%, 100% { box-shadow: 0 0 0 3px rgba(79,142,247,0.25), 0 0 20px rgba(79,142,247,0.3); }
        50%       { box-shadow: 0 0 0 5px rgba(79,142,247,0.15), 0 0 30px rgba(79,142,247,0.5); }
    }

    .chat-header-info { flex: 1; }

    .chat-header-name {
        font-size: 15px;
        font-weight: 700;
        color: white;
        letter-spacing: 0.2px;
    }

    .chat-header-status {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        color: var(--c-muted);
        margin-top: 3px;
    }

    .status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--c-success);
        animation: pulseDot 2s ease infinite;
    }

    @keyframes pulseDot {
        0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(16,217,138,0.5); }
        50%       { opacity: 0.8; box-shadow: 0 0 0 4px rgba(16,217,138,0); }
    }

    .chat-header-badge {
        font-size: 11px;
        font-weight: 600;
        color: white;
        background: linear-gradient(135deg, #4f8ef7, #8b5cf6);
        padding: 4px 12px;
        border-radius: 20px;
        box-shadow: 0 2px 12px rgba(79,142,247,0.4);
        letter-spacing: 0.3px;
    }

    /* ── User Info Banner (New) ── */
    .chat-user-banner {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 22px;
        background: rgba(79, 142, 247, 0.06);
        border-bottom: 1px solid var(--c-border);
        flex-shrink: 0;
    }

    .chat-user-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: linear-gradient(135deg, #0f766e, #0369a1);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 700;
        color: white;
        letter-spacing: 0.5px;
        flex-shrink: 0;
    }

    .chat-user-info {
        flex: 1;
        font-size: 12.5px;
        color: var(--c-text);
    }

    .chat-user-info strong {
        font-weight: 600;
        color: #a5c3ff;
    }

    .chat-user-role {
        display: inline-block;
        font-size: 10px;
        font-weight: 600;
        color: var(--c-accent);
        background: rgba(79,142,247,0.12);
        border: 1px solid rgba(79,142,247,0.25);
        padding: 2px 8px;
        border-radius: 20px;
        margin-left: 6px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* ── Messages zone ── */
    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 24px 22px;
        display: flex;
        flex-direction: column;
        gap: 18px;
        scroll-behavior: smooth;
    }

    .chat-messages::-webkit-scrollbar { width: 4px; }
    .chat-messages::-webkit-scrollbar-track { background: transparent; }
    .chat-messages::-webkit-scrollbar-thumb {
        background: rgba(99,130,220,0.25);
        border-radius: 10px;
    }
    .chat-messages::-webkit-scrollbar-thumb:hover {
        background: rgba(99,130,220,0.45);
    }

    /* ── Message row ── */
    .msg-row {
        display: flex;
        gap: 12px;
        animation: fadeUp 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    }

    @keyframes fadeUp {
        from { opacity: 0; transform: translateY(16px) scale(0.97); }
        to   { opacity: 1; transform: translateY(0) scale(1); }
    }

    .msg-row.user-row { flex-direction: row-reverse; }

    .msg-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        flex-shrink: 0;
        font-weight: 700;
        letter-spacing: 0.5px;
        align-self: flex-end;
    }

    .avatar-bot {
        background: linear-gradient(135deg, #1d4ed8, #7c3aed);
        color: white;
        font-size: 18px;
        box-shadow: 0 0 12px rgba(79,142,247,0.4);
    }
    .avatar-user {
        background: linear-gradient(135deg, #0f766e, #0369a1);
        color: white;
        box-shadow: 0 0 12px rgba(6,182,212,0.3);
    }

    .msg-content {
        max-width: 72%;
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .msg-bubble {
        padding: 13px 18px;
        border-radius: var(--c-radius);
        font-size: 13.5px;
        line-height: 1.65;
        white-space: pre-wrap;
        word-break: break-word;
        transition: box-shadow 0.2s;
    }

    /* Bot bubble */
    .msg-row:not(.user-row) .msg-bubble {
        background: var(--c-bot-bg);
        color: var(--c-text);
        border: 1px solid var(--c-border);
        border-top-left-radius: var(--c-radius-sm);
        backdrop-filter: blur(10px);
    }

    /* User bubble */
    .msg-row.user-row .msg-bubble {
        background: var(--c-user-bg);
        color: white;
        border-top-right-radius: var(--c-radius-sm);
        box-shadow: 0 4px 20px rgba(79,142,247,0.35);
    }

    .msg-time {
        font-size: 10.5px;
        color: var(--c-muted);
        padding: 0 6px;
    }

    .user-row .msg-time { text-align: right; }

    /* ── Reclamation card ── */
    .reclamation-card {
        margin-top: 10px;
        background: rgba(16, 217, 138, 0.06);
        border: 1px solid rgba(16, 217, 138, 0.22);
        border-radius: var(--c-radius-sm);
        padding: 14px 16px;
        font-size: 12.5px;
        color: var(--c-text);
        backdrop-filter: blur(8px);
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .reclamation-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.25);
    }

    .reclamation-card .rc-title {
        font-weight: 700;
        color: var(--c-success);
        margin-bottom: 10px;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .rc-row { display: flex; gap: 10px; margin-bottom: 4px; align-items: center; }
    .rc-label { color: var(--c-muted); min-width: 72px; font-size: 11.5px; }
    .rc-val { font-weight: 600; font-size: 12.5px; }

    .badge-type {
        display: inline-block;
        padding: 2px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.3px;
    }
    .badge-Paiement  { background: rgba(59,130,246,0.18); color: #60a5fa; border: 1px solid rgba(59,130,246,0.3); }
    .badge-Technique { background: rgba(139,92,246,0.18); color: #a78bfa; border: 1px solid rgba(139,92,246,0.3); }
    .badge-Compte    { background: rgba(245,158,11,0.18); color: #fbbf24; border: 1px solid rgba(245,158,11,0.3); }

    .badge-priorite {
        display: inline-block;
        padding: 2px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
    }
    .badge-Élevée  { background: rgba(239,68,68,0.18);  color: #f87171; border: 1px solid rgba(239,68,68,0.3); }
    .badge-Moyenne { background: rgba(245,158,11,0.18); color: #fbbf24; border: 1px solid rgba(245,158,11,0.3); }
    .badge-Faible  { background: rgba(16,185,129,0.18); color: #34d399; border: 1px solid rgba(16,185,129,0.3); }

    /* ── Typing indicator ── */
    .typing-indicator {
        display: none;
        align-items: center;
        gap: 12px;
        padding: 4px 0;
    }

    .typing-bubbles {
        display: flex;
        align-items: center;
        gap: 5px;
        background: var(--c-bot-bg);
        border: 1px solid var(--c-border);
        padding: 12px 18px;
        border-radius: var(--c-radius);
        border-top-left-radius: var(--c-radius-sm);
        backdrop-filter: blur(10px);
    }

    .typing-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--c-accent);
        animation: typingBounce 1.3s ease infinite;
    }
    .typing-dot:nth-child(2) { animation-delay: 0.2s; background: var(--c-accent-2); }
    .typing-dot:nth-child(3) { animation-delay: 0.4s; background: var(--c-accent-3); }

    @keyframes typingBounce {
        0%, 80%, 100% { transform: translateY(0); opacity: 0.4; }
        40%            { transform: translateY(-7px); opacity: 1; }
    }

    .typing-text {
        font-size: 12px;
        color: var(--c-muted);
        font-style: italic;
        margin-top: 5px;
    }

    /* ── Input area ── */
    .chat-input-area {
        padding: 14px 22px 20px;
        background: rgba(12, 20, 44, 0.8);
        border-top: 1px solid var(--c-border);
        flex-shrink: 0;
        backdrop-filter: blur(10px);
        position: relative;
    }

    .chat-input-area::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(79,142,247,0.4), rgba(139,92,246,0.4), transparent);
    }

    .chat-input-form {
        display: flex;
        align-items: flex-end;
        gap: 10px;
    }

    .input-wrapper {
        flex: 1;
        position: relative;
    }

    .chat-textarea {
        width: 100%;
        background: rgba(8, 14, 35, 0.8);
        border: 1.5px solid var(--c-border);
        border-radius: var(--c-radius);
        color: var(--c-text);
        font-size: 13.5px;
        font-family: 'Inter', sans-serif;
        line-height: 1.55;
        padding: 13px 70px 13px 18px;
        resize: none;
        min-height: 50px;
        max-height: 150px;
        overflow-y: auto;
        transition: border-color 0.25s, box-shadow 0.25s;
        outline: none;
        box-sizing: border-box;
        backdrop-filter: blur(10px);
    }

    .chat-textarea::placeholder { color: var(--c-muted); }

    .chat-textarea:focus {
        border-color: var(--c-accent);
        box-shadow: 0 0 0 3px rgba(79, 142, 247, 0.15),
                    0 0 20px rgba(79,142,247,0.1);
    }

    .char-count {
        position: absolute;
        bottom: 10px;
        right: 56px;
        font-size: 10.5px;
        color: var(--c-muted);
        line-height: 1;
        pointer-events: none;
    }

    .char-count.warn   { color: var(--c-warning); }
    .char-count.danger { color: var(--c-error); }

    /* ── Send button ── */
    .btn-send {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--c-accent), var(--c-accent-2));
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.2s cubic-bezier(0.34,1.6,0.64,1), box-shadow 0.2s, opacity 0.2s;
        flex-shrink: 0;
        box-shadow: 0 4px 18px rgba(79, 142, 247, 0.45);
    }

    .btn-send:hover:not(:disabled) {
        transform: translateY(-3px) scale(1.08);
        box-shadow: 0 8px 24px rgba(79, 142, 247, 0.65);
    }

    .btn-send:active:not(:disabled) { transform: scale(0.93); }
    .btn-send:disabled { opacity: 0.4; cursor: not-allowed; box-shadow: none; }

    .btn-send svg { stroke: white; }

    /* ── Welcome screen ── */
    .welcome-msg {
        text-align: center;
        padding: 36px 24px 20px;
        color: var(--c-muted);
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .welcome-avatar-ring {
        position: relative;
        display: inline-block;
        margin-bottom: 20px;
    }

    .welcome-avatar-ring::before {
        content: '';
        position: absolute;
        inset: -6px;
        border-radius: 50%;
        background: conic-gradient(#4f8ef7, #8b5cf6, #06b6d4, #4f8ef7);
        animation: spinRing 4s linear infinite;
        z-index: -1;
        filter: blur(0px);
    }

    .welcome-avatar-ring::after {
        content: '';
        position: absolute;
        inset: -4px;
        border-radius: 50%;
        background: var(--c-surface);
        z-index: -1;
    }

    @keyframes spinRing {
        to { transform: rotate(360deg); }
    }

    .welcome-icon-wrapper {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        background: linear-gradient(135deg, #1d3a8a, #5b21b6);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 32px;
        box-shadow: 0 8px 30px rgba(79,142,247,0.4);
    }

    .welcome-msg h3 {
        color: var(--c-text);
        font-size: 20px;
        font-weight: 800;
        margin-bottom: 10px;
        background: linear-gradient(135deg, #dde6f5, #a5c3ff);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .welcome-msg p {
        font-size: 13.5px;
        line-height: 1.7;
        max-width: 420px;
        color: var(--c-muted);
    }

    /* ── Hint chips ── */
    .hint-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
        justify-content: center;
        margin-top: 22px;
    }

    .hint-chip {
        background: rgba(79, 142, 247, 0.08);
        border: 1px solid rgba(79, 142, 247, 0.25);
        color: #7eb3ff;
        border-radius: 22px;
        padding: 7px 16px;
        font-size: 12.5px;
        font-family: 'Inter', sans-serif;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.34,1.5,0.64,1);
        letter-spacing: 0.2px;
    }

    .hint-chip:hover {
        background: rgba(79, 142, 247, 0.18);
        border-color: rgba(79, 142, 247, 0.5);
        transform: translateY(-2px) scale(1.04);
        box-shadow: 0 4px 16px rgba(79,142,247,0.25);
        color: #b3d3ff;
    }

    /* ── Divider line hints ── */
    .welcome-divider {
        width: 40px;
        height: 2px;
        background: linear-gradient(90deg, transparent, rgba(79,142,247,0.5), transparent);
        margin: 18px auto 0;
        border-radius: 2px;
    }

    /* ── Responsive ── */
    @media (max-width: 600px) {
        .chat-page { padding: 0; align-items: stretch; }
        .chat-wrapper { height: 100vh; min-height: unset; border-radius: 0; }
        .msg-content { max-width: 88%; }
        .welcome-msg h3 { font-size: 17px; }
    }
</style>
{% endblock %}

{% block body %}
<!-- Decorative orbs -->
<div class="chat-orb chat-orb-1"></div>
<div class="chat-orb chat-orb-2"></div>
<div class="chat-orb chat-orb-3"></div>

<div class="chat-page">
    <div class="chat-wrapper" id="chatWrapper">

        {# ── Header ─────────────────────────────────────────────────── #}
        <div class="chat-header">
            <a href="{{ path('app_reclamation_index') }}" class="chat-back-btn" title="Retour aux réclamations">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
            </a>
            <div class="chat-header-avatar">🤖</div>
            <div class="chat-header-info">
                <div class="chat-header-name">Assistant DINARI</div>
                <div class="chat-header-status">
                    <span class="status-dot"></span>
                    En ligne · Analyse vos réclamations par IA
                </div>
            </div>
            <span class="chat-header-badge">Groq LLM</span>
        </div>

        {# ── User Info Banner ──────────────────────────────────────── #}
        <div class="chat-user-banner">
            <div class="chat-user-avatar">{{ app.user.initials }}</div>
            <div class="chat-user-info">
                Connecté en tant que <strong>{{ app.user.name }}</strong>
                {% if is_granted('ROLE_ADMIN') %}
                    <span class="chat-user-role">Admin</span>
                {% else %}
                    <span class="chat-user-role">Utilisateur</span>
                {% endif %}
            </div>
        </div>

        {# ── Messages ──────────────────────────────────────────────── #}
        <div class="chat-messages" id="chatMessages">

            {# Message de bienvenue #}
            <div class="welcome-msg" id="welcomeMsg">
                <div class="welcome-avatar-ring">
                    <div class="welcome-icon-wrapper">💬</div>
                </div>
                <h3>Bonjour, {{ app.user.name }} !</h3>
                <p>
                    Je suis votre assistant IA DINARI.<br>
                    Décrivez votre problème et je créerai automatiquement une réclamation classifiée.
                </p>
                <div class="welcome-divider"></div>
                <div class="hint-chips">
                    <button class="hint-chip" onclick="useHint(this)">💳 Problème de paiement</button>
                    <button class="hint-chip" onclick="useHint(this)">🔧 Bug de l'application</button>
                    <button class="hint-chip" onclick="useHint(this)">👤 Accès à mon compte</button>
                    <button class="hint-chip" onclick="useHint(this)">📊 Erreur de transaction</button>
                </div>
            </div>

            {# Indicateur de frappe du bot #}
            <div class="typing-indicator" id="typingIndicator">
                <div class="msg-avatar avatar-bot">🤖</div>
                <div>
                    <div class="typing-bubbles">
                        <div class="typing-dot"></div>
                        <div class="typing-dot"></div>
                        <div class="typing-dot"></div>
                    </div>
                    <div class="typing-text">L'IA analyse votre réclamation…</div>
                </div>
            </div>

        </div>

        {# ── Zone de saisie ──────────────────────────────────────────── #}
        <div class="chat-input-area">
            <form class="chat-input-form" id="chatForm" onsubmit="return false;">
                <div class="input-wrapper">
                    <textarea
                        id="userInput"
                        class="chat-textarea"
                        placeholder="Décrivez votre problème ici…"
                        maxlength="2000"
                        rows="1"
                        autofocus
                    ></textarea>
                    <span class="char-count" id="charCount">0 / 2000</span>
                </div>
                <button type="submit" class="btn-send" id="sendBtn" aria-label="Envoyer" disabled>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                         stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="22" y1="2" x2="11" y2="13"/>
                        <polygon points="22 2 15 22 11 13 2 9 22 2"/>
                    </svg>
                </button>
            </form>
        </div>

    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
    window.CHAT_SEND_URL = "{{ path('app_chat_send') }}";
    window.USER_INITIALS = "{{ app.user.initials }}";
</script>
<script src="{{ asset('js/chat.js') }}?v={{ 'now'|date('U') }}"></script>
{% endblock %}
