{% extends 'base_admin.html.twig' %}

{% block title %}DINARI — Assistant IA{% endblock %}

{% block stylesheets %}
<style>
    /* ═══════════════════════════════════════════════════════════
       CHATBOT — STYLES SPÉCIFIQUES
    ═══════════════════════════════════════════════════════════ */

    :root {
        --chat-bg:         #0f172a;
        --chat-surface:    #1e293b;
        --chat-border:     #334155;
        --chat-accent:     #3b82f6;
        --chat-accent-2:   #8b5cf6;
        --chat-user-bg:    linear-gradient(135deg, #3b82f6, #6366f1);
        --chat-bot-bg:     #1e293b;
        --chat-text:       #e2e8f0;
        --chat-muted:      #94a3b8;
        --chat-success:    #10b981;
        --chat-warning:    #f59e0b;
        --chat-error:      #ef4444;
        --chat-radius:     16px;
        --chat-radius-sm:  8px;
        --chat-shadow:     0 25px 50px rgba(0, 0, 0, 0.5);
    }

    /* ── Page layout ── */
    .chat-page {
        min-height: calc(100vh - 60px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        background: radial-gradient(ellipse at top left, #1e3a5f22, transparent 60%),
                    radial-gradient(ellipse at bottom right, #5b21b622, transparent 60%);
    }

    /* ── Chat container ── */
    .chat-wrapper {
        display: flex;
        flex-direction: column;
        width: 100%;
        max-width: 860px;
        height: 82vh;
        min-height: 560px;
        border-radius: var(--chat-radius);
        background: var(--chat-surface);
        border: 1px solid var(--chat-border);
        box-shadow: var(--chat-shadow);
        overflow: hidden;
    }

    /* ── Header ── */
    .chat-header {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 18px 24px;
        background: linear-gradient(135deg, #1d3461, #2d1b69);
        border-bottom: 1px solid var(--chat-border);
        flex-shrink: 0;
    }

    .chat-back-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.15);
        color: white;
        text-decoration: none;
        transition: all 0.2s ease;
        margin-right: 4px;
        flex-shrink: 0;
    }
    .chat-back-btn:hover {
        background: rgba(255, 255, 255, 0.25);
        transform: translateX(-2px);
    }

    .chat-header-avatar {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--chat-accent), var(--chat-accent-2));
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.3);
    }

    .chat-header-info { flex: 1; }

    .chat-header-name {
        font-size: 15px;
        font-weight: 700;
        color: white;
        letter-spacing: 0.3px;
    }

    .chat-header-status {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        color: var(--chat-muted);
        margin-top: 2px;
    }

    .status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--chat-success);
        animation: pulse-dot 2s ease infinite;
    }

    @keyframes pulse-dot {
        0%, 100% { opacity: 1; transform: scale(1); }
        50%       { opacity: 0.6; transform: scale(1.2); }
    }

    .chat-header-badge {
        font-size: 11px;
        font-weight: 600;
        color: white;
        background: linear-gradient(135deg, var(--chat-accent), var(--chat-accent-2));
        padding: 3px 10px;
        border-radius: 20px;
    }

    /* ── Messages zone ── */
    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 24px;
        display: flex;
        flex-direction: column;
        gap: 16px;
        scroll-behavior: smooth;
    }

    .chat-messages::-webkit-scrollbar { width: 5px; }
    .chat-messages::-webkit-scrollbar-track { background: transparent; }
    .chat-messages::-webkit-scrollbar-thumb {
        background: var(--chat-border);
        border-radius: 10px;
    }

    /* ── Single message bubble ── */
    .msg-row {
        display: flex;
        gap: 10px;
        animation: fadeUp 0.3s ease;
    }

    @keyframes fadeUp {
        from { opacity: 0; transform: translateY(12px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .msg-row.user-row { flex-direction: row-reverse; }

    .msg-avatar {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        flex-shrink: 0;
        font-weight: 600;
    }

    .avatar-bot  { background: linear-gradient(135deg, #1d4ed8, #7c3aed); color: white; }
    .avatar-user { background: linear-gradient(135deg, #0f766e, #0369a1); color: white; }

    .msg-content {
        max-width: 72%;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .msg-bubble {
        padding: 12px 16px;
        border-radius: var(--chat-radius);
        font-size: 14px;
        line-height: 1.6;
        white-space: pre-wrap;
        word-break: break-word;
    }

    /* Bot bubble */
    .msg-row:not(.user-row) .msg-bubble {
        background: var(--chat-bot-bg);
        color: var(--chat-text);
        border: 1px solid var(--chat-border);
        border-top-left-radius: var(--chat-radius-sm);
    }

    /* User bubble */
    .msg-row.user-row .msg-bubble {
        background: var(--chat-user-bg);
        color: white;
        border-top-right-radius: var(--chat-radius-sm);
    }

    .msg-time {
        font-size: 11px;
        color: var(--chat-muted);
        padding: 0 4px;
    }

    .user-row .msg-time { text-align: right; }

    /* ── Reclamation card ── */
    .reclamation-card {
        margin-top: 8px;
        background: rgba(16, 185, 129, 0.08);
        border: 1px solid rgba(16, 185, 129, 0.3);
        border-radius: var(--chat-radius-sm);
        padding: 10px 14px;
        font-size: 12px;
        color: var(--chat-text);
    }

    .reclamation-card .rc-title {
        font-weight: 700;
        color: var(--chat-success);
        margin-bottom: 6px;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.6px;
    }

    .rc-row { display: flex; gap: 8px; margin-bottom: 2px; }
    .rc-label { color: var(--chat-muted); min-width: 80px; }
    .rc-val { font-weight: 600; }

    .badge-type {
        display: inline-block;
        padding: 1px 8px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
    }
    .badge-Paiement  { background: rgba(59, 130, 246, 0.2); color: #60a5fa; }
    .badge-Technique { background: rgba(139, 92, 246, 0.2); color: #a78bfa; }
    .badge-Compte    { background: rgba(245, 158, 11, 0.2); color: #fbbf24; }

    .badge-priorite {
        display: inline-block;
        padding: 1px 8px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
    }
    .badge-Élevée  { background: rgba(239, 68, 68, 0.2);  color: #f87171; }
    .badge-Moyenne { background: rgba(245, 158, 11, 0.2); color: #fbbf24; }
    .badge-Faible  { background: rgba(16, 185, 129, 0.2); color: #34d399; }

    /* ── Typing indicator ── */
    .typing-indicator {
        display: none;
        align-items: center;
        gap: 10px;
        padding: 4px 0;
    }

    .typing-bubbles {
        display: flex;
        align-items: center;
        gap: 5px;
        background: var(--chat-bot-bg);
        border: 1px solid var(--chat-border);
        padding: 10px 16px;
        border-radius: var(--chat-radius);
        border-top-left-radius: var(--chat-radius-sm);
    }

    .typing-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--chat-accent);
        animation: typing-bounce 1.2s ease infinite;
    }
    .typing-dot:nth-child(2) { animation-delay: 0.2s; background: var(--chat-accent-2); }
    .typing-dot:nth-child(3) { animation-delay: 0.4s; }

    @keyframes typing-bounce {
        0%, 80%, 100% { transform: translateY(0);    opacity: 0.5; }
        40%            { transform: translateY(-6px); opacity: 1;   }
    }

    .typing-text {
        font-size: 12px;
        color: var(--chat-muted);
        font-style: italic;
    }

    /* ── Input area ── */
    .chat-input-area {
        padding: 16px 24px 20px;
        background: var(--chat-surface);
        border-top: 1px solid var(--chat-border);
        flex-shrink: 0;
    }

    .chat-input-form {
        display: flex;
        align-items: flex-end;
        gap: 10px;
    }

    .input-wrapper {
        flex: 1;
        position: relative;
    }

    .chat-textarea {
        width: 100%;
        background: #0f172a;
        border: 1.5px solid var(--chat-border);
        border-radius: var(--chat-radius);
        color: var(--chat-text);
        font-size: 14px;
        font-family: inherit;
        line-height: 1.5;
        padding: 12px 16px;
        resize: none;
        min-height: 48px;
        max-height: 150px;
        overflow-y: auto;
        transition: border-color 0.2s, box-shadow 0.2s;
        outline: none;
        box-sizing: border-box;
    }

    .chat-textarea::placeholder { color: var(--chat-muted); }

    .chat-textarea:focus {
        border-color: var(--chat-accent);
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
    }

    .char-count {
        position: absolute;
        bottom: 8px;
        right: 12px;
        font-size: 11px;
        color: var(--chat-muted);
    }

    .char-count.warn { color: var(--chat-warning); }
    .char-count.danger { color: var(--chat-error); }

    /* ── Send button ── */
    .btn-send {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--chat-accent), var(--chat-accent-2));
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.2s, box-shadow 0.2s, opacity 0.2s;
        flex-shrink: 0;
        box-shadow: 0 4px 15px rgba(59, 130, 246, 0.4);
    }

    .btn-send:hover:not(:disabled) {
        transform: translateY(-2px) scale(1.05);
        box-shadow: 0 6px 20px rgba(59, 130, 246, 0.55);
    }

    .btn-send:active:not(:disabled) { transform: scale(0.95); }
    .btn-send:disabled { opacity: 0.45; cursor: not-allowed; }

    .btn-send svg { stroke: white; }

    /* ── Welcome message ── */
    .welcome-msg {
        text-align: center;
        padding: 32px 16px;
        color: var(--chat-muted);
    }
    .welcome-msg .welcome-icon {
        font-size: 42px;
        margin-bottom: 12px;
        display: block;
    }
    .welcome-msg h3 {
        color: var(--chat-text);
        font-size: 17px;
        font-weight: 700;
        margin-bottom: 8px;
    }
    .welcome-msg p { font-size: 13px; line-height: 1.6; }

    /* ── Hint chips ── */
    .hint-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        justify-content: center;
        margin-top: 16px;
    }

    .hint-chip {
        background: rgba(59, 130, 246, 0.1);
        border: 1px solid rgba(59, 130, 246, 0.3);
        color: #60a5fa;
        border-radius: 20px;
        padding: 6px 14px;
        font-size: 12px;
        cursor: pointer;
        transition: background 0.2s, transform 0.15s;
    }

    .hint-chip:hover {
        background: rgba(59, 130, 246, 0.2);
        transform: translateY(-1px);
    }

    /* ── Responsive ── */
    @media (max-width: 600px) {
        .chat-page { padding: 0; }
        .chat-wrapper { height: 100vh; border-radius: 0; }
        .msg-content { max-width: 88%; }
    }
</style>
{% endblock %}

{% block body %}
<div class="chat-page">
    <div class="chat-wrapper" id="chatWrapper">

        {# ── Header ───────────────────────────────────────────────── #}
        <div class="chat-header">
            <a href="{{ path('app_reclamation_index') }}" class="chat-back-btn" title="Retour aux réclamations">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
            </a>
            <div class="chat-header-avatar">🤖</div>
            <div class="chat-header-info">
                <div class="chat-header-name">Assistant DINARI</div>
                <div class="chat-header-status">
                    <span class="status-dot"></span>
                    En ligne · Analyse vos réclamations par IA
                </div>
            </div>
            <span class="chat-header-badge">Groq LLM</span>
        </div>

        {# ── Messages ─────────────────────────────────────────────── #}
        <div class="chat-messages" id="chatMessages">

            {# Message de bienvenue #}
            <div class="welcome-msg" id="welcomeMsg">
                <span class="welcome-icon">💬</span>
                <h3>Bonjour, {{ app.user.name }} !</h3>
                <p>
                    Je suis votre assistant IA DINARI.<br>
                    Décrivez votre problème et je créerai automatiquement une réclamation classifiée.
                </p>
                <div class="hint-chips">
                    <button class="hint-chip" onclick="useHint(this)">💳 Problème de paiement</button>
                    <button class="hint-chip" onclick="useHint(this)">🔧 Bug de l'application</button>
                    <button class="hint-chip" onclick="useHint(this)">👤 Accès à mon compte</button>
                    <button class="hint-chip" onclick="useHint(this)">📊 Erreur de transaction</button>
                </div>
            </div>

            {# Indicateur de frappe du bot #}
            <div class="typing-indicator" id="typingIndicator">
                <div class="msg-avatar avatar-bot">🤖</div>
                <div>
                    <div class="typing-bubbles">
                        <div class="typing-dot"></div>
                        <div class="typing-dot"></div>
                        <div class="typing-dot"></div>
                    </div>
                    <div class="typing-text">L'IA analyse votre réclamation…</div>
                </div>
            </div>

        </div>

        {# ── Zone de saisie ────────────────────────────────────────── #}
        <div class="chat-input-area">
            <form class="chat-input-form" id="chatForm" onsubmit="return false;">
                <div class="input-wrapper">
                    <textarea
                        id="userInput"
                        class="chat-textarea"
                        placeholder="Décrivez votre problème ici…"
                        maxlength="2000"
                        rows="1"
                        autofocus
                    ></textarea>
                    <span class="char-count" id="charCount">0 / 2000</span>
                </div>
                <button type="submit" class="btn-send" id="sendBtn" aria-label="Envoyer" disabled>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                         stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="22" y1="2" x2="11" y2="13"/>
                        <polygon points="22 2 15 22 11 13 2 9 22 2"/>
                    </svg>
                </button>
            </form>
        </div>

    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
    // Injecter l'URL de l'endpoint Symfony dans le JS de façon sécurisée
    window.CHAT_SEND_URL = "{{ path('app_chat_send') }}";
    window.USER_INITIALS = "{{ app.user.initials }}";
</script>
<script src="{{ asset('js/chat.js') }}?v={{ 'now'|date('U') }}"></script>
{% endblock %}
