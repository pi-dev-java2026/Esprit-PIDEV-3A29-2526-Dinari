{% extends 'base.html.twig' %}

{% block title %}Connexion — DINARI{% endblock %}

{% block stylesheets %}
<style>
.login-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f8fafc;
    font-family: 'Inter', 'Segoe UI', sans-serif;
    padding: 20px;
}
.login-box {
    background: #ffffff;
    width: 100%;
    max-width: 440px;
    border-radius: 16px;
    padding: 40px 48px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 24px 48px -12px rgba(0, 0, 0, 0.05);
}
.login-logo {
    text-align: center;
    margin-bottom: 24px;
}
.logo-text {
    font-size: 28px;
    font-weight: 600;
    color: #1e293b;
    letter-spacing: 0.5px;
}
.logo-text span {
    color: #1d4ed8;
    font-weight: 700;
}
.login-title {
    text-align: center;
    margin-bottom: 32px;
}
.login-title h1 {
    font-size: 28px;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 8px 0;
}
.login-title p {
    font-size: 15px;
    color: #64748b;
    margin: 0;
}
.login-error {
    background: #fef2f2;
    color: #dc2626;
    padding: 12px;
    border-radius: 8px;
    font-size: 14px;
    margin-bottom: 20px;
    text-align: center;
    border: 1px solid #fca5a5;
}
.login-field {
    margin-bottom: 20px;
}
.login-field-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}
.login-field label {
    font-size: 14px;
    font-weight: 500;
    color: #64748b;
    margin-bottom: 8px;
    display: block;
}
.login-field-header label {
    margin-bottom: 0;
}
.login-field-header a {
    font-size: 14px;
    color: #64748b;
    text-decoration: none;
}
.login-field-header a:hover {
    color: #1d4ed8;
}
.input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    background-color: #f3f4f6;
    border-radius: 10px;
    padding: 0 16px;
    transition: all 0.2s ease;
    border: 1px solid transparent;
}
.input-wrapper:focus-within {
    background-color: #ffffff;
    box-shadow: 0 0 0 3px #bfdbfe;
    border-color: #93c5fd;
}
.input-icon {
    display: flex;
    align-items: center;
    color: #94a3b8;
    margin-right: 12px;
}
.input-wrapper input {
    flex: 1;
    border: none;
    background: transparent;
    padding: 14px 0;
    font-size: 15px;
    color: #334155;
    outline: none;
}
.input-wrapper input::placeholder {
    color: #94a3b8;
}
.input-toggle {
    background: none;
    border: none;
    color: #94a3b8;
    cursor: pointer;
    display: flex;
    align-items: center;
    padding: 0;
}
.input-toggle:hover {
    color: #64748b;
}
.btn-login {
    width: 100%;
    background-color: #1d4ed8;
    color: white;
    font-weight: 600;
    font-size: 15px;
    padding: 14px;
    border: none;
    border-radius: 10px;
    cursor: pointer;
    transition: background-color 0.2s;
    margin-top: 8px;
    box-shadow: 0 4px 12px rgba(29, 78, 216, 0.2);
}
.btn-login:hover {
    background-color: #1e40af;
}
.login-divider {
    display: flex;
    align-items: center;
    text-align: center;
    color: #475569;
    font-size: 13px;
    margin: 28px 0;
}
.login-divider::before, .login-divider::after {
    content: '';
    flex: 1;
    border-bottom: 1px solid #e2e8f0;
}
.login-divider::before {
    margin-right: 12px;
}
.login-divider::after {
    margin-left: 12px;
}
.btn-google {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    background-color: #ffffff;
    color: #334155;
    font-weight: 500;
    font-size: 15px;
    padding: 12px;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s;
    gap: 10px;
}
.btn-google:hover {
    background-color: #f8fafc;
    border-color: #94a3b8;
}
.login-footer {
    text-align: center;
    font-size: 14px;
    color: #64748b;
    margin-top: 32px;
}
.login-footer a {
    color: #1d4ed8;
    font-weight: 600;
    text-decoration: none;
}
.login-footer a:hover {
    text-decoration: underline;
}
.login-tagline {
    text-align: center;
    font-size: 10px;
    letter-spacing: 0.5px;
    color: #94a3b8;
    text-transform: uppercase;
    margin-top: 32px;
}
.recaptcha-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 18px;
}
.recaptcha-error {
    background: #fef2f2;
    color: #dc2626;
    padding: 10px 14px;
    border-radius: 8px;
    font-size: 13px;
    margin-bottom: 16px;
    text-align: center;
    border: 1px solid #fca5a5;
    display: flex;
    align-items: center;
    gap: 8px;
    justify-content: center;
}
</style>
{% endblock %}

{% block body %}
<div class="login-page">
    <div class="login-box">
        <div class="login-logo">
            <div class="logo-text"><span>ID</span>INARI</div>
        </div>

        <div class="login-title">
            <h1>Bienvenue</h1>
            <p>Connectez-vous pour gérer vos finances</p>
        </div>

        {% if error %}
            <div class="login-error">
                ⚠️ {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        {% if google_error is defined and google_error %}
            <div class="login-error">
                ⚠️ {{ google_error }}
            </div>
        {% endif %}

        <form method="post" action="{{ path('app_login') }}">
            
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <div class="login-field">
                <label for="email">Email</label>
                <div class="input-wrapper">
                    <span class="input-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                    </span>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        value="{{ last_username }}"
                        placeholder="nom@exemple.com"
                        autocomplete="email"
                        required
                    >
                </div>
            </div>

            <div class="login-field">
                <div class="login-field-header">
                    <label for="password">Mot de passe</label>
                    <a href="{{ path('app_forgot_password_email') }}">Oublié ?</a>
                </div>
                <div class="input-wrapper">
                    <span class="input-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                    </span>
                    <input
                        type="password"
                        id="password"
                        name="password"
                        placeholder="••••••••"
                        autocomplete="current-password"
                        required
                    >
                    <button type="button" class="input-toggle" onclick="togglePassword()">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                    </button>
                </div>
            </div>

            <div class="recaptcha-wrap">
                <div class="g-recaptcha" data-sitekey="{{ recaptcha_site_key }}"></div>
            </div>

            <button type="submit" class="btn-login">Se connecter</button>
        </form>

        <div class="login-divider">OU CONTINUER AVEC</div>

        <a href="{{ path('connect_google_start') }}" class="btn-google">
            <svg width="18" height="18" viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.31-8.16 2.31-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
            Google
        </a>

        <div class="login-footer">
            Pas encore de compte ? <a href="{{ path('app_register') }}">Créer un compte</a>
        </div>

        <div class="login-tagline">UNE FINTECH 100% TUNISIENNE POUR SIMPLIFIER VOS FINANCES</div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script src="https://www.google.com/recaptcha/api.js" async defer></script>
<script>
function togglePassword() {
    const input = document.getElementById('password');
    input.type = input.type === 'password' ? 'text' : 'password';
}
</script>
{% endblock %}
