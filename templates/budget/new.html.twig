{% extends 'base.html.twig' %}

{% block title %}Nouveau budget — Dinari{% endblock %}

{% block stylesheets %}
<style>
.page-wrapper { max-width: 560px; margin: 0 auto; padding: 100px 30px 60px; }
.page-header  { margin-bottom: 32px; }
.breadcrumb   { font-size: 13px; color: var(--d-muted); margin-bottom: 8px; }
.breadcrumb a { color: var(--d-blue); text-decoration: none; }
.breadcrumb a:hover { text-decoration: underline; }
.page-title   { font-family: 'Syne', sans-serif; font-size: 26px; font-weight: 700; color: var(--d-text); }
.page-title span { color: var(--d-blue); }

.flash { padding: 12px 18px; border-radius: 6px; margin-bottom: 20px; font-size: 14px; font-weight: 500; }
.flash-error { background: rgba(231,76,60,0.1); border: 1px solid rgba(231,76,60,0.3); color: #c0392b; }

.form-card { background: #fff; border: 1px solid var(--d-border); border-radius: 8px; padding: 36px; }
.form-group   { margin-bottom: 20px; }
.form-group label { display: block; font-size: 13px; font-weight: 600; color: var(--d-text); margin-bottom: 6px; }
.form-group label .required { color: #e74c3c; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
.form-control {
    width: 100%;
    border: 1.5px solid var(--d-border); border-radius: 6px;
    font-size: 14px; font-family: 'DM Sans', sans-serif;
    color: var(--d-text); outline: none; transition: border-color 0.2s;
}
.form-control:focus { border-color: var(--d-blue); }
.form-hint { font-size: 12px; color: var(--d-muted); margin-top: 5px; }

/* Preview montant */
.montant-preview {
    background: var(--d-blue);
    border-radius: 8px; padding: 20px; text-align: center;
    margin-bottom: 24px; display: none;
}
.montant-preview.show { display: block; }
.montant-preview .label { font-size: 11px; letter-spacing: 2px; text-transform: uppercase; opacity: 0.7; margin-bottom: 6px; }
.montant-preview .value { font-family: 'Syne', sans-serif; font-size: 32px; font-weight: 800; }

.form-actions { display: flex; gap: 12px; justify-content: flex-end; margin-top: 28px; padding-top: 24px; border-top: 1px solid var(--d-border); }
.btn-submit {
    padding: 12px 28px; background: var(--d-blue); color: #fff;
    border: none; border-radius: 4px;
    font-family: 'Syne', sans-serif; font-weight: 700; font-size: 15px;
    cursor: pointer; transition: all 0.25s;
}
.btn-submit:hover { background: var(--d-blue2); transform: translateY(-2px); }
.btn-cancel {
    padding: 12px 24px; background: var(--d-light); color: var(--d-text);
    border: 1.5px solid var(--d-border); border-radius: 4px;
    font-size: 15px; font-weight: 500; text-decoration: none;
    transition: all 0.2s; display: inline-flex; align-items: center;
}
.btn-cancel:hover { background: var(--d-border); color: var(--d-text); text-decoration: none; }

@media(max-width: 500px) { .form-row { grid-template-columns: 1fr; } }

.btn-add {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 24px;
    background: #27ae60; /* vert */
    color: #fff;
    border-radius: 6px;
    font-weight: 600;
    font-size: 14px;
    text-decoration: none;
    transition: all 0.25s ease;
    box-shadow: 0 4px 12px rgba(39, 174, 96, 0.25);
}

.btn-add:hover {
    background: #219150;
    transform: translateY(-2px);
    color: #fff;
    text-decoration: none;
    box-shadow: 0 6px 16px rgba(39, 174, 96, 0.35);
}
</style>
{% endblock %}

{% block body %}
<div class="page-wrapper">

    {% for msg in app.flashes('error') %}
        <div class="flash flash-error"><i class="fa fa-exclamation-circle"></i> {{ msg }}</div>
    {% endfor %}

    <div class="page-header">
        <div class="breadcrumb">
            <a href="{{ path('budget_index') }}">Budgets</a> › Nouveau budget
        </div>
        <h1 class="page-title">Créer un <span>budget</span></h1>
    </div>

    {# Preview dynamique #}
    <div class="montant-preview" id="montant-preview">
        <div class="label">Budget défini</div>
        <div class="value" id="preview-value">0 DT</div>
    </div>

    <div class="form-card">
         {{ include('budget/_form.html.twig', {
        action: path('budget_new'),
        moisCourant: moisCourant,
        anneeCourante: anneeCourante,
        button_label: 'Créer le budget'
    }) }}
    </div>

</div>
{% endblock %}

{% block javascripts %}
<script>
function updatePreview(val) {
    const preview = document.getElementById('montant-preview');
    const value   = document.getElementById('preview-value');
    if (val && parseFloat(val) > 0) {
        preview.classList.add('show');
        value.textContent = parseFloat(val).toLocaleString('fr-FR', {minimumFractionDigits: 0}) + ' DT';
    } else {
        preview.classList.remove('show');
    }
}
</script>
{% endblock %}
