{% extends 'base.html.twig' %}

{% block title %}Modifier le budget — Dinari{% endblock %}

{% block stylesheets %}
<style>
.page-wrapper { max-width: 560px; margin: 0 auto; padding: 100px 30px 60px; }
.page-header  { margin-bottom: 32px; }
.breadcrumb   { font-size: 13px; color: var(--d-muted); margin-bottom: 8px; }
.breadcrumb a { color: var(--d-blue); text-decoration: none; }
.breadcrumb a:hover { text-decoration: underline; }
.page-title   { font-family: 'Syne', sans-serif; font-size: 26px; font-weight: 700; color: var(--d-text); }
.page-title span { color: #e67e22; }

.flash { padding: 12px 18px; border-radius: 6px; margin-bottom: 20px; font-size: 14px; font-weight: 500; }
.flash-error { background: rgba(231,76,60,0.1); border: 1px solid rgba(231,76,60,0.3); color: #c0392b; }

.form-card { background: #fff; border: 1px solid var(--d-border); border-radius: 8px; padding: 36px; }
.form-group   { margin-bottom: 20px; }
.form-group label { display: block; font-size: 13px; font-weight: 600; color: var(--d-text); margin-bottom: 6px; }
.form-group label .required { color: #e74c3c; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
.form-control {
    width: 100%; padding:
    border: 1.5px solid var(--d-border); border-radius: 6px;
    font-size: 14px; font-family: 'DM Sans', sans-serif;
    color: var(--d-text); outline: none; transition: border-color 0.2s;
}
.form-control:focus { border-color: var(--d-blue); }

.current-info {
    background: #f5f7fa; border: 1px solid var(--d-border);
    border-radius: 8px; padding: 16px 20px; margin-bottom: 24px;
    display: flex; align-items: center; gap: 14px;
}
.current-info-icon {
    width: 42px; height: 42px; border-radius: 8px;
    background: #e67e22; color: #fff;
    display: flex; align-items: center; justify-content: center; font-size: 18px;
}
.current-info-label { font-size: 12px; color: var(--d-muted); margin-bottom: 3px; }
.current-info-value { font-family: 'Syne', sans-serif; font-size: 18px; font-weight: 800; color: var(--d-text); }

.form-actions { display: flex; gap: 12px; justify-content: flex-end; margin-top: 28px; padding-top: 24px; border-top: 1px solid var(--d-border); }
.btn-submit {
    padding: 12px 28px; background: #e67e22; color: #fff;
    border: none; border-radius: 4px;
    font-family: 'Syne', sans-serif; font-weight: 700; font-size: 15px;
    cursor: pointer; transition: all 0.25s;
}
.btn-submit:hover { background: #d35400; transform: translateY(-2px); }
.btn-cancel {
    padding: 12px 24px; background: var(--d-light); color: var(--d-text);
    border: 1.5px solid var(--d-border); border-radius: 4px;
    font-size: 15px; font-weight: 500; text-decoration: none;
    transition: all 0.2s; display: inline-flex; align-items: center;
}
.btn-cancel:hover { background: var(--d-border); color: var(--d-text); text-decoration: none; }

@media(max-width: 500px) { .form-row { grid-template-columns: 1fr; } }
</style>
{% endblock %}

{% block body %}
<div class="page-wrapper">

    {% for msg in app.flashes('error') %}
        <div class="flash flash-error"><i class="fa fa-exclamation-circle"></i> {{ msg }}</div>
    {% endfor %}

    <div class="page-header">
        <div class="breadcrumb">
            <a href="{{ path('budget_index') }}">Budgets</a> › Modifier
        </div>
        <h1 class="page-title">Modifier le <span>budget</span></h1>
    </div>

    {# Budget actuel #}
    <div class="current-info">
        <div class="current-info-icon"><i class="fa fa-pie-chart"></i></div>
        <div>
            <div class="current-info-label">Budget actuel</div>
            <div class="current-info-value">
                {{ budget.montantLimite|number_format(0, ',', ' ') }} DT
                — {{ budget.getNomMois() }} {{ budget.getAnnee() }}
            </div>
        </div>
    </div>

   <div class="form-card">
    {{ include('budget/_form.html.twig', {
        action: path('budget_edit', { id: budget.id }),
        budget: budget,
        moisCourant: moisCourant,
        anneeCourante: anneeCourante,
        button_label: 'Modifier le budget'
    }) }}
</div>

</div>
{% endblock %}
