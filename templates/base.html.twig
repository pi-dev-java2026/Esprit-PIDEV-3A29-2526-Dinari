<script src="{{ asset('js/main.js') }}"></script>

<script>
    const revealEls = document.querySelectorAll('.reveal');
    const obs = new IntersectionObserver((entries) => {
        entries.forEach((entry, i) => {
            if (entry.isIntersecting) setTimeout(() => entry.target.classList.add('visible'), i * 80);
        });
    }, { threshold: 0.08 });
    revealEls.forEach(el => obs.observe(el));

    document.querySelectorAll('.ripple-btn').forEach(btn => {
        btn.addEventListener('click', function(e) {
            const ripple = document.createElement('span');
            const rect = this.getBoundingClientRect();
            ripple.style.cssText = `position:absolute;border-radius:50%;pointer-events:none;background:rgba(255,255,255,0.3);width:10px;height:10px;left:${e.clientX-rect.left-5}px;top:${e.clientY-rect.top-5}px;animation:rippleAnim 0.6s linear;`;
            this.appendChild(ripple);
            setTimeout(() => ripple.remove(), 600);
        });
    });

    const DINARI_TRANSLATIONS = {
        fr: {
            nav_home: 'Accueil',
            nav_features: 'Fonctionnalités',
            nav_manage: 'Gestions',
            nav_subscriptions: 'Abonnements',
            nav_experts_offers: 'Experts et Offres',
            nav_expenses: 'Dépenses',
            nav_courses_quiz: 'Cours et Quiz',
            nav_claims: 'Réclamations',
            nav_users: 'Utilisateurs',
            nav_logout: 'Se Déconnecter',
            nav_login: 'Connexion',
            nav_start_free: 'Commencer gratuitement',
            footer_tagline: 'Votre plateforme de gestion financière personnelle.',
            footer_product: 'Produit',
            footer_register: "S'inscrire",
            footer_resources: 'Ressources',
            footer_docs: 'Documentation',
            footer_help: "Centre d'aide",
            footer_blog: 'Blog',
            footer_contact: 'Contact',
            footer_email: 'contact@dinari.tn',
            footer_phone: '+216 XX XXX XXX',
            footer_location: 'Tunis, Tunisie',
            footer_rights: 'Tous droits réservés.',
            footer_sub: 'Plateforme fintech tunisienne'
        },
        en: {
            nav_home: 'Home',
            nav_features: 'Features',
            nav_manage: 'Management',
            nav_subscriptions: 'Subscriptions',
            nav_experts_offers: 'Experts and Offers',
            nav_expenses: 'Expenses',
            nav_courses_quiz: 'Courses and Quizzes',
            nav_claims: 'Claims',
            nav_users: 'Users',
            nav_logout: 'Log Out',
            nav_login: 'Login',
            nav_start_free: 'Start for free',
            footer_tagline: 'Your personal financial management platform.',
            footer_product: 'Product',
            footer_register: 'Sign Up',
            footer_resources: 'Resources',
            footer_docs: 'Documentation',
            footer_help: 'Help Center',
            footer_blog: 'Blog',
            footer_contact: 'Contact',
            footer_email: 'contact@dinari.tn',
            footer_phone: '+216 XX XXX XXX',
            footer_location: 'Tunis, Tunisia',
            footer_rights: 'All rights reserved.',
            footer_sub: 'Tunisian fintech platform'
        },
        ar: {
            nav_home: 'الرئيسية',
            nav_features: 'الميزات',
            nav_manage: 'الإدارات',
            nav_subscriptions: 'الاشتراكات',
            nav_experts_offers: 'الخبراء والعروض',
            nav_expenses: 'المصاريف',
            nav_courses_quiz: 'الدورات والاختبارات',
            nav_claims: 'الشكاوى',
            nav_users: 'المستخدمون',
            nav_logout: 'تسجيل الخروج',
            nav_login: 'تسجيل الدخول',
            nav_start_free: 'ابدأ مجانًا',
            footer_tagline: 'منصتك لإدارة الشؤون المالية الشخصية.',
            footer_product: 'المنتج',
            footer_register: 'إنشاء حساب',
            footer_resources: 'الموارد',
            footer_docs: 'التوثيق',
            footer_help: 'مركز المساعدة',
            footer_blog: 'المدونة',
            footer_contact: 'التواصل',
            footer_email: 'contact@dinari.tn',
            footer_phone: '+216 XX XXX XXX',
            footer_location: 'تونس، تونس',
            footer_rights: 'جميع الحقوق محفوظة.',
            footer_sub: 'منصة فينتك تونسية'
        }
    };

    function setLang(lang) {
        localStorage.setItem('dinari_lang', lang);
        const t = DINARI_TRANSLATIONS[lang] || DINARI_TRANSLATIONS.fr;

        document.querySelectorAll('[data-i18n]').forEach(el => {
            const key = el.getAttribute('data-i18n');
            if (t[key] !== undefined) {
                el.textContent = t[key];
            }
        });

        if (typeof applyPageTranslations === 'function') {
            applyPageTranslations(lang);
        }

        const html = document.getElementById('html-root');
        if (html) {
            if (lang === 'ar') {
                html.setAttribute('dir', 'rtl');
                html.setAttribute('lang', 'ar');
            } else {
                html.setAttribute('dir', 'ltr');
                html.setAttribute('lang', lang);
            }
        }

        document.querySelectorAll('.lang-btn').forEach(btn => {
            btn.classList.toggle('active', btn.textContent.toLowerCase() === lang);
        });
    }

    window._dinariInitLang = function() {
        const saved = localStorage.getItem('dinari_lang') || 'fr';
        setLang(saved);
    };
</script>

{% block javascripts %}{% endblock %}
<script>window._dinariInitLang();</script>
</body>
</html>