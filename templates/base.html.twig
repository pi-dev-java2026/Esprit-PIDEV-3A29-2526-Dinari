    <!-- ═══════════════════════════════════════════════════════════
         DINARI CHATBOT WIDGET
    ═══════════════════════════════════════════════════════════ -->
    <style>
        /* ── FLOATING BUTTON ── */
        #dinari-chat-btn {
            position: fixed;
            bottom: 28px;
            right: 28px;
            z-index: 9999;
            width: 58px;
            height: 58px;
            border-radius: 50%;
            background: linear-gradient(135deg, #2563eb 0%, #1a6fc4 60%, #1558a0 100%);
            border: none;
            cursor: pointer;
            box-shadow: 0 8px 28px rgba(26,111,196,0.45);
            display: flex;
            align-items: center;
            justify-content: center;
            transition: transform 0.3s cubic-bezier(0.34,1.56,0.64,1),
                        box-shadow 0.3s ease;
            outline: none;
        }
        #dinari-chat-btn:hover {
            transform: scale(1.12) translateY(-2px);
            box-shadow: 0 14px 36px rgba(26,111,196,0.55);
        }
        #dinari-chat-btn .chat-icon,
        #dinari-chat-btn .close-icon {
            position: absolute;
            font-size: 22px;
            color: #fff;
            transition: opacity 0.25s ease, transform 0.3s ease;
        }
        #dinari-chat-btn .close-icon {
            opacity: 0;
            transform: rotate(-90deg) scale(0.6);
        }
        #dinari-chat-btn.open .chat-icon {
            opacity: 0;
            transform: rotate(90deg) scale(0.6);
        }
        #dinari-chat-btn.open .close-icon {
            opacity: 1;
            transform: rotate(0deg) scale(1);
        }

        /* Notification dot */
        #dinari-chat-btn .notif-dot {
            position: absolute;
            top: 4px; right: 4px;
            width: 12px; height: 12px;
            background: #10b981;
            border-radius: 50%;
            border: 2px solid #fff;
            animation: pulseDot 2s ease-in-out infinite;
        }
        @keyframes pulseDot {
            0%, 100% { transform: scale(1); opacity: 1; }
            50%       { transform: scale(1.3); opacity: 0.7; }
        }

        /* ── CHAT POPUP ── */
        #dinari-chat-popup {
            position: fixed;
            bottom: 100px;
            right: 28px;
            z-index: 9998;
            width: 360px;
            max-height: 520px;
            background: rgba(255,255,255,0.97);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255,255,255,0.9);
            border-radius: 22px;
            box-shadow: 0 24px 64px rgba(26,111,196,0.18), 0 4px 16px rgba(0,0,0,0.08);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            /* closed state */
            opacity: 0;
            transform: translateY(20px) scale(0.95);
            pointer-events: none;
            transition: opacity 0.32s cubic-bezier(0.22,1,0.36,1),
                        transform 0.32s cubic-bezier(0.22,1,0.36,1);
            transform-origin: bottom right;
        }
        #dinari-chat-popup.open {
            opacity: 1;
            transform: translateY(0) scale(1);
            pointer-events: all;
        }

        /* Header */
        .chat-header {
            background: linear-gradient(135deg, #1a6fc4 0%, #1558a0 100%);
            padding: 16px 20px;
            display: flex;
            align-items: center;
            gap: 12px;
            flex-shrink: 0;
        }
        .chat-header-avatar {
            width: 40px; height: 40px;
            background: rgba(255,255,255,0.2);
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: 20px;
            border: 2px solid rgba(255,255,255,0.35);
            flex-shrink: 0;
        }
        .chat-header-info { flex: 1; }
        .chat-header-name {
            font-family: 'Poppins', sans-serif;
            font-size: 14px;
            font-weight: 700;
            color: #fff;
            line-height: 1.2;
        }
        .chat-header-status {
            font-family: 'Poppins', sans-serif;
            font-size: 11px;
            color: rgba(255,255,255,0.7);
            display: flex;
            align-items: center;
            gap: 5px;
            margin-top: 2px;
        }
        .chat-header-status::before {
            content: '';
            width: 7px; height: 7px;
            background: #10b981;
            border-radius: 50%;
            display: inline-block;
        }

        /* Messages area */
        .chat-messages {
            flex: 1;
            overflow-y: auto;
            padding: 18px 16px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            scroll-behavior: smooth;
        }
        .chat-messages::-webkit-scrollbar { width: 4px; }
        .chat-messages::-webkit-scrollbar-track { background: transparent; }
        .chat-messages::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }

        /* Message bubbles */
        .chat-msg {
            display: flex;
            gap: 8px;
            align-items: flex-end;
            animation: msgFadeIn 0.28s cubic-bezier(0.22,1,0.36,1) both;
        }
        @keyframes msgFadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .chat-msg.bot  { justify-content: flex-start; }
        .chat-msg.user { justify-content: flex-end; }

        .chat-msg .bubble {
            max-width: 82%;
            padding: 10px 14px;
            border-radius: 16px;
            font-family: 'Poppins', sans-serif;
            font-size: 13px;
            line-height: 1.55;
        }
        .chat-msg.bot .bubble {
            background: #f1f5f9;
            color: #1e293b;
            border-bottom-left-radius: 4px;
        }
        .chat-msg.user .bubble {
            background: linear-gradient(135deg, #2563eb, #1a6fc4);
            color: #fff;
            border-bottom-right-radius: 4px;
        }

        /* Bot avatar in messages */
        .msg-avatar {
            width: 28px; height: 28px;
            background: linear-gradient(135deg, #1a6fc4, #2563eb);
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: 13px;
            color: #fff;
            flex-shrink: 0;
        }

        /* Typing indicator */
        .chat-typing .bubble {
            display: flex;
            align-items: center;
            gap: 4px;
            padding: 12px 16px;
        }
        .chat-typing .dot {
            width: 7px; height: 7px;
            background: #94a3b8;
            border-radius: 50%;
            animation: typingBounce 1.2s ease-in-out infinite;
        }
        .chat-typing .dot:nth-child(2) { animation-delay: 0.2s; }
        .chat-typing .dot:nth-child(3) { animation-delay: 0.4s; }
        @keyframes typingBounce {
            0%, 60%, 100% { transform: translateY(0); }
            30%            { transform: translateY(-6px); }
        }

        /* Quick suggestions */
        .chat-suggestions {
            padding: 0 16px 12px;
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            flex-shrink: 0;
        }
        .chat-suggestion {
            font-family: 'Poppins', sans-serif;
            font-size: 11.5px;
            font-weight: 500;
            padding: 5px 12px;
            background: rgba(26,111,196,0.07);
            color: #1a6fc4;
            border: 1px solid rgba(26,111,196,0.18);
            border-radius: 20px;
            cursor: pointer;
            transition: all 0.2s ease;
            white-space: nowrap;
        }
        .chat-suggestion:hover {
            background: #1a6fc4;
            color: #fff;
            border-color: #1a6fc4;
            transform: translateY(-1px);
        }

        /* Input area */
        .chat-input-area {
            padding: 12px 14px;
            border-top: 1px solid rgba(226,232,240,0.8);
            display: flex;
            gap: 8px;
            align-items: center;
            background: rgba(248,250,255,0.8);
            flex-shrink: 0;
        }
        #dinari-chat-input {
            flex: 1;
            padding: 10px 14px;
            border: 1.5px solid #e2e8f0;
            border-radius: 22px;
            font-family: 'Poppins', sans-serif;
            font-size: 13px;
            color: #1e293b;
            outline: none;
            background: #fff;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }
        #dinari-chat-input:focus {
            border-color: #1a6fc4;
            box-shadow: 0 0 0 3px rgba(26,111,196,0.1);
        }
        #dinari-chat-input::placeholder { color: #b0bec5; }

        #dinari-chat-send {
            width: 40px; height: 40px;
            border-radius: 50%;
            background: linear-gradient(135deg, #2563eb, #1a6fc4);
            border: none;
            cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            color: #fff;
            font-size: 15px;
            flex-shrink: 0;
            transition: transform 0.22s ease, box-shadow 0.22s ease;
            box-shadow: 0 4px 12px rgba(26,111,196,0.3);
        }
        #dinari-chat-send:hover {
            transform: scale(1.1);
            box-shadow: 0 6px 18px rgba(26,111,196,0.4);
        }
        #dinari-chat-send:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none;
        }

        /* Mobile */
        @media(max-width: 480px) {
            #dinari-chat-popup {
                width: calc(100vw - 24px);
                right: 12px;
                bottom: 90px;
            }
            #dinari-chat-btn { bottom: 18px; right: 18px; }
        }
    </style>

    <!-- Chatbot HTML -->
    <button id="dinari-chat-btn" aria-label="Ouvrir le chatbot Dinari" title="Dinari Assistant">
        <i class="fa fa-comments chat-icon"></i>
        <i class="fa fa-times close-icon"></i>
        <span class="notif-dot"></span>
    </button>

    <div id="dinari-chat-popup" role="dialog" aria-label="Dinari Assistant">
        <div class="chat-header">
            <div class="chat-header-avatar">🤖</div>
            <div class="chat-header-info">
                <div class="chat-header-name">Dinari Assistant</div>
                <div class="chat-header-status">En ligne</div>
            </div>
        </div>

        <div class="chat-messages" id="dinari-chat-messages">
            <!-- Welcome message injected by JS -->
        </div>

        <div class="chat-suggestions" id="dinari-suggestions">
            <span class="chat-suggestion">💰 Total dépenses</span>
            <span class="chat-suggestion">📅 Dépenses du mois</span>
            <span class="chat-suggestion">📊 Mon budget</span>
            <span class="chat-suggestion">🔴 Budget dépassé ?</span>
            <span class="chat-suggestion">💡 Conseils</span>
        </div>

        <div class="chat-input-area">
            <input type="text"
                   id="dinari-chat-input"
                   placeholder="Posez votre question..."
                   autocomplete="off"
                   maxlength="200">
            <button id="dinari-chat-send" aria-label="Envoyer">
                <i class="fa fa-paper-plane"></i>
            </button>
        </div>
    </div>

    <script>
    (function () {
        const btn        = document.getElementById('dinari-chat-btn');
        const popup      = document.getElementById('dinari-chat-popup');
        const messages   = document.getElementById('dinari-chat-messages');
        const input      = document.getElementById('dinari-chat-input');
        const sendBtn    = document.getElementById('dinari-chat-send');
        const suggestions = document.querySelectorAll('.chat-suggestion');
        const ENDPOINT   = '/chatbot/message';

        let isOpen = false;
        let welcomed = false;

        // ── Toggle open/close ──────────────────────────────────────
        btn.addEventListener('click', () => {
            isOpen = !isOpen;
            btn.classList.toggle('open', isOpen);
            popup.classList.toggle('open', isOpen);

            // Remove notification dot on first open
            const dot = btn.querySelector('.notif-dot');
            if (dot) dot.remove();

            if (isOpen) {
                if (!welcomed) {
                    welcomed = true;
                    setTimeout(() => {
                        appendBot("👋 Bonjour ! Je suis <strong>Dinari Assistant</strong>.<br>Je peux vous aider avec vos <strong>dépenses</strong> et <strong>budgets</strong>. Que souhaitez-vous savoir ?");
                    }, 300);
                }
                setTimeout(() => input.focus(), 350);
            }
        });

        // ── Quick suggestions ──────────────────────────────────────
        suggestions.forEach(s => {
            s.addEventListener('click', () => {
                const text = s.textContent.replace(/^[^\w]+/, '').trim();
                sendMessage(text);
            });
        });

        // ── Send on button click ───────────────────────────────────
        sendBtn.addEventListener('click', () => {
            const text = input.value.trim();
            if (text) sendMessage(text);
        });

        // ── Send on Enter ──────────────────────────────────────────
        input.addEventListener('keydown', e => {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                const text = input.value.trim();
                if (text) sendMessage(text);
            }
        });

        // ── Core send function ─────────────────────────────────────
        function sendMessage(text) {
            appendUser(text);
            input.value = '';
            sendBtn.disabled = true;

            const typingId = appendTyping();

            fetch(ENDPOINT, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: text })
            })
            .then(r => r.json())
            .then(data => {
                removeTyping(typingId);
                appendBot(data.reply || "Désolé, je n'ai pas pu traiter votre demande.");
            })
            .catch(() => {
                removeTyping(typingId);
                appendBot("⚠️ Erreur de connexion. Veuillez réessayer.");
            })
            .finally(() => {
                sendBtn.disabled = false;
                input.focus();
            });
        }

        // ── Append helpers ─────────────────────────────────────────
        function appendUser(text) {
            const div = document.createElement('div');
            div.className = 'chat-msg user';
            div.innerHTML = `<div class="bubble">${escapeHtml(text)}</div>`;
            messages.appendChild(div);
            scrollBottom();
        }

        function appendBot(html) {
            const div = document.createElement('div');
            div.className = 'chat-msg bot';
            div.innerHTML = `
                <div class="msg-avatar">D</div>
                <div class="bubble">${html}</div>`;
            messages.appendChild(div);
            scrollBottom();
        }

        function appendTyping() {
            const id  = 'typing-' + Date.now();
            const div = document.createElement('div');
            div.className = 'chat-msg bot chat-typing';
            div.id = id;
            div.innerHTML = `
                <div class="msg-avatar">D</div>
                <div class="bubble">
                    <span class="dot"></span>
                    <span class="dot"></span>
                    <span class="dot"></span>
                </div>`;
            messages.appendChild(div);
            scrollBottom();
            return id;
        }

        function removeTyping(id) {
            const el = document.getElementById(id);
            if (el) el.remove();
        }

        function scrollBottom() {
            messages.scrollTop = messages.scrollHeight;
        }

        function escapeHtml(str) {
            return str
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;');
        }
    })();
    </script>
</body>
</html>