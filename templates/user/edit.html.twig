{% extends 'base_admin.html.twig' %}

{% block title %}Modifier l'utilisateur — DINARI{% endblock %}

{% block body %}
{% if app.user and app.user.role != 'User' %}
    <a href="{{ path('app_user_index') }}" class="page-back">← Retour à la liste</a>
{% endif %}

<div class="form-card">
    <div class="card">
        <div class="card-header">
            <h2>Modifier l'utilisateur — {{ user.name }}</h2>
        </div>
        <div class="card-body" style="padding: 28px;">
            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

            <div class="form-group">
                {{ form_label(form.name) }}
                {{ form_widget(form.name) }}
                {{ form_errors(form.name) }}
            </div>

            <div class="form-group">
                {{ form_label(form.email) }}
                {{ form_widget(form.email) }}
                {{ form_errors(form.email) }}
            </div>

            <div class="form-group">
                {{ form_label(form.phone) }}
                {{ form_widget(form.phone) }}
                {{ form_errors(form.phone) }}
            </div>

            <div class="form-group">
                {{ form_label(form.role) }}
                {{ form_widget(form.role) }}
                {{ form_errors(form.role) }}
            </div>

            <div class="form-group">
                {{ form_label(form.plainPassword) }}
                {{ form_widget(form.plainPassword) }}
                {{ form_errors(form.plainPassword) }}
                <small style="color:#6b7280;font-size:12px;">Laisser vide pour conserver le mot de passe actuel.</small>
            </div>

            <div class="form-actions">
                <a href="{{ path('app_user_show', {id: user.id}) }}" class="btn btn-outline">Annuler</a>
                <button type="submit" class="btn btn-primary">Enregistrer les modifications</button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
