{% extends is_granted('ROLE_ADMIN') ? 'base_admin.html.twig' : 'base.html.twig' %}

{% block title %}Modifier le profil — DINARI{% endblock %}

{% block stylesheets %}
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style>
/* ── Reset & Base ── */
*, *::before, *::after { box-sizing: border-box; }

/* ── Page wrapper ── */
.edit-page-wrapper {
    min-height: 100vh;
    background: linear-gradient(135deg, #f0f4ff 0%, #faf5ff 50%, #f0fdff 100%);
    padding: 100px 24px 60px;
    font-family: 'Inter', sans-serif;
}

/* ── Main Layout ── */
.edit-layout {
    max-width: 920px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 28px;
    align-items: start;
}
@media (max-width: 768px) {
    .edit-layout { grid-template-columns: 1fr; }
}

/* ── LEFT: Avatar Card ── */
.avatar-card {
    background: #fff;
    border-radius: 24px;
    box-shadow: 0 4px 30px rgba(79, 70, 229, 0.08);
    overflow: hidden;
    position: sticky;
    top: 90px;
}
.avatar-card-header {
    background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 50%, #0ea5e9 100%);
    padding: 40px 24px 60px;
    text-align: center;
    position: relative;
}
.avatar-card-header::after {
    content: '';
    position: absolute;
    bottom: -1px; left: 0; right: 0;
    height: 40px;
    background: #fff;
    border-radius: 24px 24px 0 0;
}
.user-avatar-big {
    width: 112px;
    height: 112px;
    border-radius: 50%;
    border: 4px solid rgba(255,255,255,0.9);
    box-shadow: 0 8px 32px rgba(0,0,0,0.2);
    overflow: hidden;
    margin: 0 auto 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #c7d2fe, #e0e7ff);
    position: relative;
    z-index: 1;
    cursor: pointer;
    transition: transform 0.2s;
}
.user-avatar-big:hover { transform: scale(1.04); }
.user-avatar-big img { width: 100%; height: 100%; object-fit: cover; }
.avatar-initials { font-size: 36px; font-weight: 800; color: #4f46e5; }
.camera-overlay {
    position: absolute; inset: 0; border-radius: 50%;
    background: rgba(79, 70, 229, 0.7);
    display: flex; align-items: center; justify-content: center;
    opacity: 0; transition: opacity 0.2s;
}
.user-avatar-big:hover .camera-overlay { opacity: 1; }
.user-name-preview {
    font-size: 18px;
    font-weight: 700;
    color: rgba(255,255,255,0.95);
    margin-bottom: 4px;
    position: relative; z-index: 1;
}
.user-email-preview {
    font-size: 13px;
    color: rgba(255,255,255,0.65);
    position: relative; z-index: 1;
}

.avatar-card-body {
    padding: 20px 24px 28px;
}
.profile-stat {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid #f1f5f9;
}
.profile-stat:last-child { border-bottom: none; }
.profile-stat-icon {
    width: 36px; height: 36px;
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
}
.profile-stat-label { font-size: 12px; color: #94a3b8; font-weight: 500; }
.profile-stat-value { font-size: 13px; color: #1e293b; font-weight: 600; }

/* ── RIGHT: Form Card ── */
.form-card-modern {
    background: #fff;
    border-radius: 24px;
    box-shadow: 0 4px 30px rgba(79, 70, 229, 0.08);
    overflow: hidden;
}
.form-card-header {
    padding: 28px 32px 24px;
    border-bottom: 1px solid #f1f5f9;
    display: flex;
    align-items: center;
    gap: 16px;
}
.form-card-icon {
    width: 48px; height: 48px;
    background: linear-gradient(135deg, #eef2ff, #e0e7ff);
    border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
}
.form-card-header h2 {
    font-size: 20px;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 2px;
}
.form-card-header p {
    font-size: 13px;
    color: #64748b;
    margin: 0;
}
.form-card-body {
    padding: 32px;
}

/* ── Section titles ── */
.form-section-title {
    font-size: 11px;
    font-weight: 700;
    color: #94a3b8;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 16px;
    margin-top: 28px;
    display: flex;
    align-items: center;
    gap: 8px;
}
.form-section-title:first-child { margin-top: 0; }
.form-section-title::after {
    content: '';
    flex: 1;
    height: 1px;
    background: #f1f5f9;
}

/* ── Form fields ── */
.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
}
@media (max-width: 600px) { .form-row { grid-template-columns: 1fr; } }

.field-group {
    margin-bottom: 4px;
}
.field-group label {
    display: block;
    font-size: 12px;
    font-weight: 600;
    color: #475569;
    margin-bottom: 6px;
    letter-spacing: 0.01em;
}
.field-group input,
.field-group select {
    width: 100%;
    padding: 11px 14px;
    border: 1.5px solid #e2e8f0;
    border-radius: 12px;
    font-size: 14px;
    font-family: 'Inter', sans-serif;
    color: #1e293b;
    background: #f8fafc;
    outline: none;
    transition: all 0.2s;
}
.field-group input:focus,
.field-group select:focus {
    border-color: #6366f1;
    background: #fff;
    box-shadow: 0 0 0 4px rgba(99,102,241,0.1);
}
.field-group .help-text {
    font-size: 11.5px;
    color: #94a3b8;
    margin-top: 5px;
}
.field-group .has-prefix {
    position: relative;
}
.field-group .field-prefix {
    position: absolute;
    left: 12px; top: 50%;
    transform: translateY(-50%);
    color: #94a3b8;
    pointer-events: none;
}
.field-group .has-prefix input {
    padding-left: 36px;
}

/* ── Face capture widget ── */
.face-capture-wrap {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 18px;
    background: #f8fafc;
    border: 1.5px dashed #c7d2fe;
    border-radius: 16px;
    transition: all 0.2s;
    margin-bottom: 4px;
}
.face-capture-wrap.has-photo {
    border-style: solid;
    border-color: #6366f1;
    background: #f5f3ff;
}
.face-thumb {
    width: 60px; height: 60px;
    border-radius: 50%;
    background: linear-gradient(135deg, #e0e7ff, #c7d2fe);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
    border: 2px solid #fff;
    box-shadow: 0 4px 12px rgba(99,102,241,0.15);
}
.face-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }
.face-thumb-placeholder { font-size: 26px; }
.face-info { flex: 1; }
.face-status-text { font-size: 13px; font-weight: 600; color: #334155; margin-bottom: 3px; }
.face-status-text.ok { color: #059669; }
.face-hint-text { font-size: 12px; color: #94a3b8; }
.btn-open-cam {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 8px 16px;
    background: #fff;
    color: #4f46e5;
    border: 1.5px solid #c7d2fe;
    border-radius: 50px;
    font-size: 12px; font-weight: 600;
    cursor: pointer; transition: all 0.2s;
    box-shadow: 0 2px 8px rgba(99,102,241,0.08);
    white-space: nowrap;
    flex-shrink: 0;
}
.btn-open-cam:hover {
    background: #eef2ff;
    border-color: #818cf8;
    box-shadow: 0 4px 14px rgba(99,102,241,0.18);
    transform: translateY(-1px);
}

/* ── Form actions ── */
.form-actions-modern {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid #f1f5f9;
}
.btn-cancel-modern {
    padding: 11px 24px;
    background: #f8fafc;
    color: #64748b;
    border: 1.5px solid #e2e8f0;
    border-radius: 12px;
    font-size: 14px; font-weight: 600;
    font-family: 'Inter', sans-serif;
    cursor: pointer; text-decoration: none;
    transition: all 0.2s;
    display: inline-flex; align-items: center; gap: 8px;
}
.btn-cancel-modern:hover { background: #f1f5f9; border-color: #cbd5e1; color: #334155; text-decoration: none; }
.btn-save-modern {
    padding: 11px 28px;
    background: linear-gradient(135deg, #4f46e5, #7c3aed);
    color: #fff;
    border: none;
    border-radius: 12px;
    font-size: 14px; font-weight: 700;
    font-family: 'Inter', sans-serif;
    cursor: pointer;
    box-shadow: 0 8px 20px rgba(79,70,229,0.35);
    transition: all 0.25s;
    display: inline-flex; align-items: center; gap: 8px;
}
.btn-save-modern:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(79,70,229,0.45);
}
.btn-save-modern:active { transform: translateY(0); }

/* ── Flash messages ── */
.flash-success {
    display: flex; align-items: center; gap: 10px;
    padding: 14px 18px;
    background: #ecfdf5; color: #065f46;
    border: 1px solid #a7f3d0;
    border-radius: 12px; font-size: 14px; font-weight: 500;
    margin-bottom: 20px;
}

/* ── Back link ── */
.back-link-modern {
    display: inline-flex; align-items: center; gap: 8px;
    color: #64748b; font-size: 14px; font-weight: 500;
    text-decoration: none; margin-bottom: 24px;
    transition: color 0.2s;
}
.back-link-modern:hover { color: #4f46e5; text-decoration: none; }

/* ══ Camera Modal ══════════════════════════════════════════ */
.camera-modal-backdrop {
    display: none; position: fixed; inset: 0;
    background: rgba(15,23,42,.72); z-index: 9999;
    align-items: center; justify-content: center;
    backdrop-filter: blur(6px);
}
.camera-modal-backdrop.active { display: flex; }
.camera-modal {
    background: #fff; border-radius: 24px;
    width: 540px; max-width: 96vw;
    box-shadow: 0 32px 80px rgba(0,0,0,.28);
    overflow: hidden;
    animation: slideUpModal .3s cubic-bezier(.34,1.56,.64,1);
}
@keyframes slideUpModal {
    from { transform: translateY(40px) scale(.96); opacity: 0; }
    to   { transform: translateY(0) scale(1); opacity: 1; }
}
.camera-modal-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 20px 24px;
    border-bottom: 1px solid #f1f5f9;
}
.camera-modal-header h3 {
    font-size: 16px; font-weight: 800; color: #0f172a;
    display: flex; align-items: center; gap: 10px; margin: 0;
}
.cam-icon-badge {
    width: 36px; height: 36px;
    background: linear-gradient(135deg,#6366f1,#8b5cf6);
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
}
.btn-close-modal {
    width: 32px; height: 32px; border-radius: 8px;
    border: 1px solid #e5e7eb; background: #fff;
    cursor: pointer; display: flex; align-items: center; justify-content: center;
    transition: all .18s; color: #6b7280;
}
.btn-close-modal:hover { background: #f3f4f6; color: #111; }
.camera-body { padding: 20px 24px 24px; }
.camera-video-wrap {
    position: relative; border-radius: 16px; overflow: hidden;
    background: #0f172a; margin-bottom: 14px; aspect-ratio: 4/3;
}
#cameraVideo { width: 100%; height: 100%; object-fit: cover; display: block; transform: scaleX(-1); }
.face-guide-overlay { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; pointer-events: none; }
.face-guide-ellipse {
    width: 52%; aspect-ratio: 3/4;
    border: 2.5px dashed rgba(99,102,241,.6); border-radius: 50%;
    box-shadow: 0 0 0 2000px rgba(15,23,42,.2);
    animation: guidePulse 2.5s ease-in-out infinite;
}
@keyframes guidePulse { 0%, 100% { border-color: rgba(99,102,241,.6); } 50% { border-color: rgba(167,139,250,.9); } }
#capturedPreview { display: none; width: 100%; border-radius: 16px; margin-bottom: 14px; }
.camera-hint { text-align: center; font-size: 12.5px; color: #6b7280; margin-bottom: 14px; }
.camera-actions { display: flex; gap: 10px; }
.btn-cam-action {
    flex: 1; display: flex; align-items: center; justify-content: center;
    gap: 8px; padding: 11px 0; border-radius: 12px; font-size: 14px;
    font-weight: 600; font-family: 'Inter', sans-serif;
    cursor: pointer; transition: all .2s; border: none;
}
.btn-cam-capture {
    background: linear-gradient(135deg,#6366f1,#8b5cf6); color: #fff;
    box-shadow: 0 4px 14px rgba(99,102,241,.35);
}
.btn-cam-capture:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(99,102,241,.45); }
.btn-cam-capture:disabled { opacity: .5; cursor: not-allowed; transform: none; }
.btn-cam-retake { background: #f1f5f9; color: #374151; border: 1px solid #e2e8f0; }
.btn-cam-retake:hover { background: #e2e8f0; }
.btn-cam-confirm {
    background: linear-gradient(135deg,#059669,#0d9488); color: #fff;
    box-shadow: 0 4px 14px rgba(5,150,105,.3);
}
.btn-cam-confirm:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(5,150,105,.4); }
.cam-status-bar {
    display: flex; align-items: center; gap: 8px; padding: 10px 14px;
    border-radius: 10px; font-size: 12.5px; font-weight: 500;
    margin-bottom: 12px; transition: all .3s;
}
.cam-status-bar.info    { background: #eff6ff; color: #1d4ed8; }
.cam-status-bar.success { background: #ecfdf5; color: #065f46; }
.cam-status-bar.error   { background: #fef2f2; color: #dc2626; }
.cam-status-bar.loading { background: #f5f3ff; color: #5b21b6; }
.cam-spinner {
    width: 14px; height: 14px; border: 2px solid currentColor;
    border-top-color: transparent; border-radius: 50%;
    animation: spin .7s linear infinite; flex-shrink: 0;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* ── role badge color in stat ── */
.role-pill {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 4px 10px; border-radius: 50px;
    font-size: 12px; font-weight: 600;
}
.role-pill.admin   { background: rgba(139,92,246,.1); color: #7c3aed; }
.role-pill.manager { background: rgba(16,185,129,.1); color: #059669; }
.role-pill.user    { background: rgba(100,116,139,.1); color: #475569; }
</style>
{% endblock %}

{% block body %}
<div class="edit-page-wrapper">

    {# Back link #}
    {% if app.user and app.user.role != 'User' %}
    <a href="{{ path('app_user_index') }}" class="back-link-modern">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        Retour à la liste
    </a>
    {% else %}
    <a href="{{ path('app_user_show', {id: user.id}) }}" class="back-link-modern">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        Retour à mon profil
    </a>
    {% endif %}

    <div class="edit-layout">

        {# ─── LEFT: Avatar sidebar ─── #}
        <div class="avatar-card">
            <div class="avatar-card-header">
                <div class="user-avatar-big" onclick="openCameraModal()" title="Changer la photo">
                    <div id="sidebarAvatarContent">
                        {% if user.face_image %}
                            <img src="{{ asset(user.face_image) }}" alt="{{ user.name }}" id="sidebarFaceImg">
                        {% else %}
                            <span class="avatar-initials">{{ user.getInitials() }}</span>
                        {% endif %}
                    </div>
                    <div class="camera-overlay">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
                    </div>
                </div>
                <div class="user-name-preview">{{ user.name }}</div>
                <div class="user-email-preview">{{ user.email }}</div>
            </div>
            <div class="avatar-card-body">
                <div class="profile-stat">
                    <div class="profile-stat-icon" style="background:#eff6ff;color:#3b82f6;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    </div>
                    <div>
                        <div class="profile-stat-label">Rôle</div>
                        <div class="profile-stat-value">
                            <span class="role-pill {% if user.role == 'Admin' %}admin{% elseif user.role == 'Manager' %}manager{% else %}user{% endif %}">
                                {% if user.role == 'Admin' %}🛡️{% elseif user.role == 'Manager' %}📋{% else %}👤{% endif %}
                                {{ user.role }}
                            </span>
                        </div>
                    </div>
                </div>
                <div class="profile-stat">
                    <div class="profile-stat-icon" style="background:#fdf4ff;color:#9333ea;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                    </div>
                    <div>
                        <div class="profile-stat-label">Email</div>
                        <div class="profile-stat-value" style="word-break:break-all;font-size:12px;">{{ user.email }}</div>
                    </div>
                </div>
                <div class="profile-stat">
                    <div class="profile-stat-icon" style="background:#f0fdf4;color:#16a34a;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2.18h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.18 6.18l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                    </div>
                    <div>
                        <div class="profile-stat-label">Téléphone</div>
                        <div class="profile-stat-value">{{ user.phone ?? '—' }}</div>
                    </div>
                </div>
                {% if user.created_at %}
                <div class="profile-stat">
                    <div class="profile-stat-icon" style="background:#fff7ed;color:#ea580c;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    </div>
                    <div>
                        <div class="profile-stat-label">Membre depuis</div>
                        <div class="profile-stat-value">{{ user.created_at|date('d/m/Y') }}</div>
                    </div>
                </div>
                {% endif %}
            </div>
        </div>

        {# ─── RIGHT: Edit form ─── #}
        <div class="form-card-modern">
            <div class="form-card-header">
                <div class="form-card-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#4f46e5" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                </div>
                <div>
                    <h2>Modifier le profil</h2>
                    <p>Mettez à jour les informations de <strong>{{ user.name }}</strong></p>
                </div>
            </div>
            <div class="form-card-body">

                {# Flash messages #}
                {% for msg in app.flashes('success') %}
                    <div class="flash-success">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                        {{ msg }}
                    </div>
                {% endfor %}

                {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'id': 'userEditForm'}}) }}

                {# ── Photo de visage ── #}
                <div class="form-section-title">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
                    Photo & Reconnaissance faciale
                </div>

                <div class="face-capture-wrap {% if user.face_image %}has-photo{% endif %}" id="faceCaptureWidget">
                    <div class="face-thumb" id="faceThumb">
                        {% if user.face_image %}
                            <img src="{{ asset(user.face_image) }}" alt="Visage" id="existingFaceImg">
                        {% else %}
                            <span class="face-thumb-placeholder">👤</span>
                        {% endif %}
                    </div>
                    <div class="face-info">
                        <div class="face-status-text {% if user.face_image %}ok{% endif %}" id="faceStatusText">
                            {% if user.face_image %}✅ Photo enregistrée{% else %}Aucune photo{% endif %}
                        </div>
                        <div class="face-hint-text">
                            {% if user.face_image %}Cliquez pour mettre à jour{% else %}Capturez votre visage face à la caméra{% endif %}
                        </div>
                    </div>
                    <button type="button" class="btn-open-cam" onclick="openCameraModal()">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
                        {% if user.face_image %}Mettre à jour{% else %}Prendre photo{% endif %}
                    </button>
                </div>
                <input type="hidden" name="face_image_path" id="faceImagePath" value="{{ user.face_image ?? '' }}">

                {# ── Informations personnelles ── #}
                <div class="form-section-title" style="margin-top:24px;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    Informations personnelles
                </div>

                <div class="form-row">
                    <div class="field-group">
                        {{ form_label(form.name, 'Nom complet') }}
                        {{ form_widget(form.name) }}
                        {{ form_errors(form.name) }}
                    </div>
                    <div class="field-group">
                        {{ form_label(form.phone, 'Téléphone') }}
                        {{ form_widget(form.phone) }}
                        {{ form_errors(form.phone) }}
                    </div>
                </div>

                <div class="field-group" style="margin-top:12px;">
                    {{ form_label(form.email, 'Adresse e-mail') }}
                    {{ form_widget(form.email) }}
                    {{ form_errors(form.email) }}
                </div>

                {% if form.role is defined %}
                <div class="field-group" style="margin-top:12px;">
                    {{ form_label(form.role, 'Rôle') }}
                    {{ form_widget(form.role) }}
                    {{ form_errors(form.role) }}
                </div>
                {% endif %}

                {# ── Sécurité ── #}
                <div class="form-section-title" style="margin-top:24px;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    Sécurité
                </div>
                <div class="field-group">
                    {{ form_label(form.plainPassword, 'Nouveau mot de passe') }}
                    {{ form_widget(form.plainPassword) }}
                    {{ form_errors(form.plainPassword) }}
                    <div class="help-text">Laisser vide pour conserver le mot de passe actuel.</div>
                </div>

                {# ── Actions ── #}
                <div class="form-actions-modern">
                    <a href="{{ path('app_user_show', {id: user.id}) }}" class="btn-cancel-modern">
                        Annuler
                    </a>
                    <button type="submit" class="btn-save-modern">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                        Enregistrer les modifications
                    </button>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>

{# ══ Camera Modal ═══════════════════════════════════════════════ #}
<div class="camera-modal-backdrop" id="cameraModalBackdrop">
    <div class="camera-modal">
        <div class="camera-modal-header">
            <h3>
                <span class="cam-icon-badge">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
                </span>
                Capture du visage
            </h3>
            <button type="button" class="btn-close-modal" onclick="closeCameraModal()">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        <div class="camera-body">
            <div class="cam-status-bar info" id="camStatusBar">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                Placez votre visage dans le cadre, puis cliquez sur "Capturer"
            </div>
            <div class="camera-video-wrap" id="cameraVideoWrap">
                <video id="cameraVideo" autoplay playsinline></video>
                <div class="face-guide-overlay">
                    <div class="face-guide-ellipse" id="faceGuideEllipse"></div>
                </div>
            </div>
            <canvas id="captureCanvas" style="display:none;"></canvas>
            <img id="capturedPreview" alt="Photo capturée" />
            <div class="camera-hint" id="cameraHint">
                🔴 Assurez-vous d'être seul face à la caméra dans un environnement bien éclairé
            </div>
            <div class="camera-actions" id="cameraActions">
                <button type="button" class="btn-cam-action btn-cam-capture" id="btnCapture" onclick="capturePhoto()">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r="10" stroke-dasharray="4 2"/></svg>
                    Capturer
                </button>
            </div>
            <div class="camera-actions" id="cameraActionsConfirm" style="display:none;">
                <button type="button" class="btn-cam-action btn-cam-retake" onclick="retakePhoto()">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.5"/></svg>
                    Reprendre
                </button>
                <button type="button" class="btn-cam-action btn-cam-confirm" id="btnConfirmPhoto" onclick="confirmPhoto()">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                    Confirmer
                </button>
            </div>
        </div>
    </div>
</div>

<script>
let mediaStream    = null;
let capturedBase64 = null;

async function openCameraModal() {
    document.getElementById('cameraModalBackdrop').classList.add('active');
    resetCameraUI();
    try {
        setCamStatus('info', 'Démarrage de la caméra…');
        mediaStream = await navigator.mediaDevices.getUserMedia({
            video: { width: { ideal: 1280 }, height: { ideal: 720 }, facingMode: 'user' },
            audio: false
        });
        const video = document.getElementById('cameraVideo');
        video.srcObject = mediaStream;
        await video.play();
        document.getElementById('cameraVideoWrap').style.display = 'block';
        document.getElementById('capturedPreview').style.display = 'none';
        setCamStatus('info', 'Placez votre visage dans le cadre, puis cliquez sur "Capturer"');
        document.getElementById('cameraActions').style.display = 'flex';
        document.getElementById('cameraActionsConfirm').style.display = 'none';
    } catch (err) {
        setCamStatus('error', 'Impossible d\'accéder à la caméra : ' + err.message);
    }
}

function closeCameraModal() {
    stopStream();
    document.getElementById('cameraModalBackdrop').classList.remove('active');
}

function stopStream() {
    if (mediaStream) { mediaStream.getTracks().forEach(t => t.stop()); mediaStream = null; }
}

function capturePhoto() {
    const video  = document.getElementById('cameraVideo');
    const canvas = document.getElementById('captureCanvas');
    canvas.width  = video.videoWidth  || 640;
    canvas.height = video.videoHeight || 480;
    const ctx = canvas.getContext('2d');
    ctx.translate(canvas.width, 0);
    ctx.scale(-1, 1);
    ctx.drawImage(video, 0, 0);
    ctx.setTransform(1,0,0,1,0,0);
    capturedBase64 = canvas.toDataURL('image/png', 0.92);

    const preview = document.getElementById('capturedPreview');
    preview.src = capturedBase64;
    preview.style.display = 'block';
    document.getElementById('cameraVideoWrap').style.display = 'none';
    document.getElementById('cameraActions').style.display = 'none';
    document.getElementById('cameraActionsConfirm').style.display = 'flex';
    document.getElementById('cameraHint').textContent = '✅ Vérifiez que votre visage est bien visible avant de confirmer.';
    setCamStatus('info', 'Photo prise. Cliquez sur "Confirmer" pour valider.');
    stopStream();
}

function retakePhoto() { capturedBase64 = null; openCameraModal(); }

async function confirmPhoto() {
    if (!capturedBase64) return;
    setCamStatus('loading', 'Validation du visage en cours…', true);
    document.getElementById('btnConfirmPhoto').disabled = true;
    try {
        const response = await fetch('{{ path('app_face_capture') }}', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ image: capturedBase64 })
        });
        const result = await response.json();
        if (result.ok) {
            document.getElementById('faceImagePath').value = result.path;
            updateWidgetPreview(capturedBase64, true);
            setCamStatus('success', '✅ ' + (result.message || 'Visage validé !'));
            setTimeout(() => closeCameraModal(), 1200);
        } else {
            setCamStatus('error', '❌ ' + (result.error || 'Validation échouée.'));
            document.getElementById('btnConfirmPhoto').disabled = false;
        }
    } catch (err) {
        setCamStatus('error', '❌ Erreur réseau : ' + err.message);
        document.getElementById('btnConfirmPhoto').disabled = false;
    }
}

function updateWidgetPreview(imgSrc, success) {
    // Update thumb in widget
    const thumb = document.getElementById('faceThumb');
    thumb.innerHTML = `<img src="${imgSrc}" alt="Visage capturé" style="width:100%;height:100%;object-fit:cover;border-radius:50%;">`;
    document.getElementById('faceCaptureWidget').classList.add('has-photo');
    const status = document.getElementById('faceStatusText');
    status.textContent = success ? '✅ Photo enregistrée' : 'Photo capturée';
    status.className   = 'face-status-text' + (success ? ' ok' : '');

    // Update avatar in sidebar
    const sidebarContent = document.getElementById('sidebarAvatarContent');
    sidebarContent.innerHTML = `<img src="${imgSrc}" alt="Avatar" style="width:100%;height:100%;object-fit:cover;">`;
}

function setCamStatus(type, msg, showSpinner = false) {
    const bar = document.getElementById('camStatusBar');
    bar.className = 'cam-status-bar ' + type;
    bar.innerHTML = showSpinner
        ? `<div class="cam-spinner"></div>${msg}`
        : msg;
}

function resetCameraUI() {
    capturedBase64 = null;
    document.getElementById('cameraActions').style.display = 'flex';
    document.getElementById('cameraActionsConfirm').style.display = 'none';
    document.getElementById('capturedPreview').style.display = 'none';
    document.getElementById('cameraVideoWrap').style.display = 'block';
    document.getElementById('btnConfirmPhoto').disabled = false;
    document.getElementById('cameraHint').innerHTML = '🔴 Assurez-vous d\'être seul face à la caméra dans un environnement bien éclairé';
}

document.getElementById('cameraModalBackdrop').addEventListener('click', function(e) {
    if (e.target === this) closeCameraModal();
});
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeCameraModal();
});
</script>
{% endblock %}
