{% extends is_granted('ROLE_ADMIN') ? 'base_admin.html.twig' : 'base.html.twig' %}

{% block title %}{{ user.name }} — DINARI{% endblock %}
{% block page_title %}Profil Utilisateur{% endblock %}

{% block stylesheets %}
<link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
<style>
    /* ── Variables ── */
    :root {
        --p:   #2563EB;
        --p2:  #4F46E5;
        --pg:  linear-gradient(135deg,#2563EB 0%,#4F46E5 60%,#0EA5E9 100%);
        --red: #EF4444;
        --grn: #10B981;
        --bg:  #F8FAFC;
        --bd:  #E2E8F0;
        --tx:  #0F172A;
        --tm:  #64748B;
        --tl:  #94A3B8;
        --wh:  #FFFFFF;
        --r14: 14px;
        --r20: 20px;
        --sh:  0 1px 3px rgba(0,0,0,.06), 0 4px 16px rgba(0,0,0,.06);
        --sh2: 0 8px 32px rgba(37,99,235,.15);
    }

    .pv { max-width: 900px; margin: 0 auto; font-family: 'Plus Jakarta Sans', sans-serif; }

    /* ── Back button ── */
    .back-btn {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 8px 18px; border-radius: 50px;
        background: var(--wh); border: 1.5px solid var(--bd);
        color: var(--tm); font-size: 13px; font-weight: 600;
        text-decoration: none; margin-bottom: 28px;
        box-shadow: var(--sh); transition: all .2s;
    }
    .back-btn:hover { border-color: var(--p); color: var(--p); box-shadow: var(--sh2); transform: translateX(-2px); }
    .back-btn i { font-size: 16px; }

    /* ── Hero card ── */
    .hero-card {
        background: var(--wh); border-radius: var(--r20);
        border: 1px solid var(--bd); box-shadow: var(--sh);
        overflow: hidden; margin-bottom: 20px;
    }

    .hero-banner {
        height: 150px;
        background: var(--pg);
        position: relative; overflow: hidden;
    }
    .hero-banner::before {
        content: ''; position: absolute;
        width: 300px; height: 300px; border-radius: 50%;
        background: rgba(255,255,255,.07);
        top: -100px; right: -80px;
    }
    .hero-banner::after {
        content: ''; position: absolute;
        width: 180px; height: 180px; border-radius: 50%;
        background: rgba(255,255,255,.05);
        bottom: -90px; left: 40px;
    }
    /* Animated circles */
    .hero-circle {
        position: absolute; border-radius: 50%;
        animation: floatcircle 6s ease-in-out infinite;
    }
    .hero-circle-1 { width: 60px; height: 60px; background: rgba(255,255,255,.06); top: 20px; left: 30%; animation-delay: 0s; }
    .hero-circle-2 { width: 40px; height: 40px; background: rgba(255,255,255,.1);  top: 60px; left: 55%; animation-delay: 1.5s; }
    .hero-circle-3 { width: 80px; height: 80px; background: rgba(255,255,255,.04); top: -20px; left: 70%; animation-delay: 3s; }
    @keyframes floatcircle { 0%,100%{ transform: translateY(0); } 50%{ transform: translateY(12px); } }

    .hero-body { padding: 0 36px 32px; position: relative; }

    /* Avatar row */
    .avatar-row {
        display: flex; align-items: flex-end;
        justify-content: space-between;
        margin-top: -52px; margin-bottom: 20px;
    }
    .avatar-box {
        width: 100px; height: 100px; border-radius: 50%;
        background: var(--pg); color: #fff;
        font-size: 34px; font-weight: 800; letter-spacing: -1px;
        display: flex; align-items: center; justify-content: center;
        border: 5px solid #fff;
        box-shadow: 0 6px 24px rgba(37,99,235,.3);
        flex-shrink: 0; overflow: hidden;
    }
    .avatar-box img { width: 100%; height: 100%; object-fit: cover; }

    /* Status dot on avatar */
    .avatar-wrap { position: relative; }
    .avatar-status {
        position: absolute; bottom: 6px; right: 2px;
        width: 16px; height: 16px; border-radius: 50%;
        background: var(--grn); border: 3px solid #fff;
        box-shadow: 0 2px 6px rgba(16,185,129,.4);
    }

    /* Action buttons */
    .actions-row { display: flex; gap: 10px; padding-top: 6px; flex-wrap: wrap; }
    .btn-edit {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 10px 22px; border-radius: 11px;
        background: var(--pg); color: #fff;
        font-size: 13px; font-weight: 700;
        text-decoration: none; transition: all .2s;
        box-shadow: 0 4px 16px rgba(37,99,235,.28);
        border: none; cursor: pointer;
    }
    .btn-edit:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(37,99,235,.38); color: #fff; }
    .btn-edit i { font-size: 16px; }
    .btn-del {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 10px 22px; border-radius: 11px;
        background: #fff; color: var(--red);
        font-size: 13px; font-weight: 700;
        border: 1.5px solid #FECACA; cursor: pointer;
        transition: all .2s; text-decoration: none;
    }
    .btn-del:hover { background: #FEF2F2; border-color: var(--red); transform: translateY(-2px); }
    .btn-del i { font-size: 16px; }

    /* Identity */
    .identity { margin-top: 4px; }
    .identity-name { font-size: 24px; font-weight: 800; color: var(--tx); letter-spacing: -.4px; margin-bottom: 6px; }
    .identity-email {
        display: inline-flex; align-items: center; gap: 7px;
        font-size: 13.5px; color: var(--tm); margin-bottom: 12px;
    }
    .identity-email i { font-size: 15px; color: var(--tl); }

    /* Role badge */
    .role-chip {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 5px 16px; border-radius: 50px;
        font-size: 12px; font-weight: 700; letter-spacing: .3px;
    }
    .role-chip i { font-size: 13px; }
    .chip-admin   { background: linear-gradient(135deg,#DBEAFE,#C7D2FE); color: #1D4ED8; }
    .chip-manager { background: linear-gradient(135deg,#D1FAE5,#A7F3D0); color: #065F46; }
    .chip-user    { background: linear-gradient(135deg,#F1F5F9,#E2E8F0); color: #475569; }

    /* ── Section title ── */
    .section-title {
        font-size: 11px; font-weight: 700; text-transform: uppercase;
        letter-spacing: 1.4px; color: var(--tl);
        margin: 28px 0 14px; display: flex; align-items: center; gap: 8px;
    }
    .section-title::after { content: ''; flex: 1; height: 1px; background: var(--bd); }

    /* ── Info grid ── */
    .info-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
    .info-card {
        background: var(--wh); border: 1px solid var(--bd);
        border-radius: var(--r14); padding: 18px 20px;
        display: flex; align-items: center; gap: 16px;
        box-shadow: var(--sh); transition: all .22s;
        position: relative; overflow: hidden;
    }
    .info-card::after {
        content: ''; position: absolute;
        top: 0; left: 0; right: 0; height: 2.5px;
        background: var(--pg); opacity: 0; transition: opacity .22s;
    }
    .info-card:hover { transform: translateY(-3px); box-shadow: 0 8px 28px rgba(37,99,235,.1); border-color: #C7D2FE; }
    .info-card:hover::after { opacity: 1; }
    .info-card.full { grid-column: 1 / -1; }

    .info-icon {
        width: 46px; height: 46px; border-radius: 13px;
        display: flex; align-items: center; justify-content: center;
        font-size: 20px; flex-shrink: 0;
    }
    .ic-blue   { background: #EFF6FF; }
    .ic-purple { background: #F5F3FF; }
    .ic-green  { background: #ECFDF5; }
    .ic-amber  { background: #FFFBEB; }
    .ic-rose   { background: #FFF1F2; }

    .info-text {}
    .info-label { font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .9px; color: var(--tl); margin-bottom: 4px; }
    .info-val { font-size: 15px; font-weight: 700; color: var(--tx); }
    .info-val.muted { color: var(--tl); font-weight: 500; font-style: italic; }

    /* Face card */
    .face-inner { display: flex; align-items: center; justify-content: space-between; flex: 1; }
    .face-thumb {
        width: 52px; height: 52px; border-radius: 50%;
        object-fit: cover; border: 3px solid #D1FAE5;
        box-shadow: 0 2px 10px rgba(16,185,129,.2);
        flex-shrink: 0;
    }
    .face-placeholder { width: 52px; height: 52px; background: #F1F5F9; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
    .face-placeholder i { font-size: 22px; color: var(--bd); }

    /* ── Timeline ── */
    .timeline-card {
        background: var(--wh); border: 1px solid var(--bd);
        border-radius: var(--r14); padding: 22px 24px;
        box-shadow: var(--sh);
    }
    .timeline-card-title {
        font-size: 11px; font-weight: 700; text-transform: uppercase;
        letter-spacing: 1.4px; color: var(--tl);
        display: flex; align-items: center; gap: 8px; margin-bottom: 18px;
    }
    .timeline-card-title i { font-size: 15px; }

    .tl-item {
        display: flex; align-items: flex-start; gap: 14px;
        padding: 14px 0; border-bottom: 1px solid #F1F5F9;
    }
    .tl-item:last-child { border-bottom: none; padding-bottom: 0; }
    .tl-dot {
        width: 38px; height: 38px; border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 17px; flex-shrink: 0;
    }
    .tl-info {}
    .tl-label { font-size: 13px; font-weight: 700; color: var(--tx); margin-bottom: 3px; }
    .tl-val { font-size: 12.5px; color: var(--tm); }
    .tl-val.ok { color: var(--grn); font-weight: 600; }
    .tl-val.na { color: var(--tl); font-style: italic; }
</style>
{% endblock %}

{% block body %}
<div class="pv">

    {# ── Back ── #}
    {% if is_granted('ROLE_ADMIN') %}
    <a href="{{ path('app_user_index') }}" class="back-btn">
        <i class="ri-arrow-left-s-line"></i> Retour à la liste
    </a>
    {% endif %}

    {# ── Hero card ── #}
    <div class="hero-card">
        <div class="hero-banner">
            <div class="hero-circle hero-circle-1"></div>
            <div class="hero-circle hero-circle-2"></div>
            <div class="hero-circle hero-circle-3"></div>
        </div>

        <div class="hero-body">
            <div class="avatar-row">
                {# Avatar #}
                <div class="avatar-wrap">
                    <div class="avatar-box">
                        {% if user.face_image %}
                            <img src="{{ asset(user.face_image) }}" alt="{{ user.name }}">
                        {% else %}
                            {{ user.getInitials() }}
                        {% endif %}
                    </div>
                    <div class="avatar-status"></div>
                </div>

                {# Action buttons #}
                <div class="actions-row">
                    {% if app.user and (is_granted('ROLE_ADMIN') or app.user.id == user.id) %}
                    <a href="{{ path('app_user_edit', {id: user.id}) }}" class="btn-edit">
                        <i class="ri-edit-line"></i> Modifier
                    </a>
                    <form method="post" action="{{ path('app_user_delete', {id: user.id}) }}"
                          onsubmit="return confirm('Supprimer ce compte ?')" style="margin:0">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                        <button type="submit" class="btn-del">
                            <i class="ri-delete-bin-6-line"></i> Supprimer
                        </button>
                    </form>
                    {% endif %}
                </div>
            </div>

            {# Identity #}
            <div class="identity">
                <div class="identity-name">{{ user.name }}</div>
                <div class="identity-email">
                    <i class="ri-mail-line"></i> {{ user.email }}
                </div>
                {% if user.role == 'Admin' %}
                    <span class="role-chip chip-admin"><i class="ri-shield-star-line"></i> Administrateur</span>
                {% elseif user.role == 'Manager' %}
                    <span class="role-chip chip-manager"><i class="ri-briefcase-line"></i> Manager</span>
                {% else %}
                    <span class="role-chip chip-user"><i class="ri-user-line"></i> Utilisateur</span>
                {% endif %}
            </div>
        </div>
    </div>

    {# ── Info grid ── #}
    <div class="section-title"><i class="ri-information-line"></i> Informations personnelles</div>

    <div class="info-grid">

        <div class="info-card">
            <div class="info-icon ic-blue"><i class="ri-user-fill" style="color:#2563EB;font-size:20px;"></i></div>
            <div class="info-text">
                <div class="info-label">Nom complet</div>
                <div class="info-val">{{ user.name }}</div>
            </div>
        </div>

        <div class="info-card">
            <div class="info-icon ic-purple"><i class="ri-mail-fill" style="color:#6366F1;font-size:20px;"></i></div>
            <div class="info-text">
                <div class="info-label">Adresse e-mail</div>
                <div class="info-val">{{ user.email }}</div>
            </div>
        </div>

        <div class="info-card">
            <div class="info-icon ic-green"><i class="ri-phone-fill" style="color:#10B981;font-size:20px;"></i></div>
            <div class="info-text">
                <div class="info-label">Téléphone</div>
                {% if user.phone %}
                    <div class="info-val">{{ user.phone }}</div>
                {% else %}
                    <div class="info-val muted">Non renseigné</div>
                {% endif %}
            </div>
        </div>

        <div class="info-card">
            <div class="info-icon ic-amber"><i class="ri-price-tag-3-fill" style="color:#F59E0B;font-size:20px;"></i></div>
            <div class="info-text">
                <div class="info-label">Rôle</div>
                <div class="info-val">{{ user.role }}</div>
            </div>
        </div>

        {# Facial recognition row #}
        <div class="info-card full">
            <div class="info-icon ic-rose"><i class="ri-scan-2-line" style="color:#F43F5E;font-size:20px;"></i></div>
            <div class="face-inner">
                <div class="info-text">
                    <div class="info-label">Reconnaissance faciale</div>
                    {% if user.face_image %}
                        <div class="info-val" style="color:var(--grn);">
                            <i class="ri-checkbox-circle-fill" style="font-size:15px;vertical-align:middle;margin-right:4px;"></i>
                            Visage enregistré — authentification biométrique active
                        </div>
                    {% else %}
                        <div class="info-val muted">Non configurée</div>
                    {% endif %}
                </div>
                {% if user.face_image %}
                    <img src="{{ asset(user.face_image) }}" alt="Visage" class="face-thumb">
                {% else %}
                    <div class="face-placeholder"><i class="ri-user-3-line"></i></div>
                {% endif %}
            </div>
        </div>

    </div>

    {# ── Activity timeline ── #}
    <div class="section-title" style="margin-top:28px;"><i class="ri-time-line"></i> Activité du compte</div>

    <div class="timeline-card">
        <div class="tl-item">
            <div class="tl-dot ic-blue"><i class="ri-calendar-event-fill" style="color:#2563EB;font-size:17px;"></i></div>
            <div class="tl-info">
                <div class="tl-label">Date d'inscription</div>
                <div class="tl-val">{{ user.created_at|date('d/m/Y à H:i') }}</div>
            </div>
        </div>

        <div class="tl-item">
            <div class="tl-dot ic-green"><i class="ri-login-box-line" style="color:#10B981;font-size:17px;"></i></div>
            <div class="tl-info">
                <div class="tl-label">Dernière connexion</div>
                {% if user.last_login %}
                    <div class="tl-val">{{ user.last_login|date('d/m/Y à H:i') }}</div>
                {% else %}
                    <div class="tl-val na">Aucune connexion enregistrée</div>
                {% endif %}
            </div>
        </div>

        <div class="tl-item">
            <div class="tl-dot" style="background:{% if user.face_image %}#ECFDF5{% else %}#F8FAFC{% endif %};">
                <i class="ri-scan-2-line" style="color:{% if user.face_image %}#10B981{% else %}#CBD5E1{% endif %};font-size:17px;"></i>
            </div>
            <div class="tl-info">
                <div class="tl-label">Authentification biométrique</div>
                {% if user.face_image %}
                    <div class="tl-val ok"><i class="ri-checkbox-circle-fill" style="vertical-align:middle;margin-right:4px;"></i> Activée</div>
                {% else %}
                    <div class="tl-val na">Non configurée</div>
                {% endif %}
            </div>
        </div>
    </div>

</div>
{% endblock %}
