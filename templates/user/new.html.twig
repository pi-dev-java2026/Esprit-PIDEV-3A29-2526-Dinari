{% extends 'base_admin.html.twig' %}

{% block title %}Nouvel Utilisateur — DINARI{% endblock %}

{% block stylesheets %}
<style>
/* ── Face Capture Widget ─────────────────────────────── */
.face-capture-section {
    margin-bottom: 24px;
}

.face-capture-label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: var(--text-muted);
    margin-bottom: 12px;
    text-transform: uppercase;
    letter-spacing: .5px;
}

.face-capture-widget {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 18px 20px;
    background: #f8faff;
    border: 1.5px dashed #c7d2fe;
    border-radius: 16px;
    transition: all .2s;
}

.face-capture-widget.has-photo {
    border-style: solid;
    border-color: #6366f1;
    background: #f5f3ff;
}

.face-preview-circle {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: linear-gradient(135deg, #e0e7ff, #c7d2fe);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
    border: 3px solid #fff;
    box-shadow: 0 4px 14px rgba(99,102,241,.18);
    transition: all .3s;
}

.face-preview-circle img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
}

.face-preview-placeholder {
    font-size: 30px;
    line-height: 1;
}

.face-capture-info {
    flex: 1;
}

.face-capture-info .face-status {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-muted);
    margin-bottom: 4px;
}

.face-capture-info .face-status.success {
    color: #059669;
}

.face-capture-info .face-hint {
    font-size: 12px;
    color: #9ca3af;
    margin-bottom: 10px;
}

.btn-take-photo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 18px;
    background: #fff;
    color: #4f46e5;
    border: 1.5px solid #c7d2fe;
    border-radius: 50px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all .2s;
    box-shadow: 0 2px 6px rgba(99,102,241,.08);
}

.btn-take-photo:hover {
    background: #eef2ff;
    border-color: #818cf8;
    box-shadow: 0 4px 14px rgba(99,102,241,.18);
    transform: translateY(-1px);
}

.btn-take-photo svg {
    flex-shrink: 0;
}

/* ── Camera Modal ─────────────────────────────────────── */
.camera-modal-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15,23,42,.72);
    z-index: 9999;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(4px);
    animation: fadeInBackdrop .2s ease;
}

.camera-modal-backdrop.active {
    display: flex;
}

@keyframes fadeInBackdrop {
    from { opacity: 0; }
    to   { opacity: 1; }
}

.camera-modal {
    background: #fff;
    border-radius: 24px;
    width: 540px;
    max-width: 96vw;
    box-shadow: 0 32px 80px rgba(0,0,0,.28);
    overflow: hidden;
    animation: slideUpModal .25s cubic-bezier(.34,1.56,.64,1);
}

@keyframes slideUpModal {
    from { transform: translateY(40px) scale(.97); opacity: 0; }
    to   { transform: translateY(0)    scale(1);   opacity: 1; }
}

.camera-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px 0;
}

.camera-modal-header h3 {
    font-size: 17px;
    font-weight: 800;
    color: #1e1b4b;
    display: flex;
    align-items: center;
    gap: 10px;
}

.camera-modal-header h3 span.cam-icon {
    width: 36px;
    height: 36px;
    background: linear-gradient(135deg, #6366f1, #8b5cf6);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.btn-close-modal {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    border: 1px solid #e5e7eb;
    background: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all .18s;
    color: #6b7280;
}

.btn-close-modal:hover {
    background: #f3f4f6;
    color: #111;
}

.camera-body {
    padding: 18px 24px 24px;
}

.camera-video-wrap {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    background: #0f172a;
    margin-bottom: 16px;
    aspect-ratio: 4/3;
}

#cameraVideo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scaleX(-1); /* mirror */
}

/* Face guide overlay */
.face-guide-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
}

.face-guide-ellipse {
    width: 52%;
    aspect-ratio: 3/4;
    border: 2.5px dashed rgba(99,102,241,.6);
    border-radius: 50%;
    box-shadow: 0 0 0 2000px rgba(15,23,42,.25);
    transition: border-color .4s;
    animation: guidePulse 2.5s ease-in-out infinite;
}

@keyframes guidePulse {
    0%, 100% { border-color: rgba(99,102,241,.6); }
    50%       { border-color: rgba(167,139,250,.9); }
}

.face-guide-ellipse.detected {
    border-color: rgba(16,185,129,.9) !important;
    animation: none;
}

/* Camera captured preview */
#capturedPreview {
    display: none;
    width: 100%;
    border-radius: 16px;
    margin-bottom: 16px;
}

.camera-hint {
    text-align: center;
    font-size: 12.5px;
    color: #6b7280;
    margin-bottom: 14px;
}

.camera-actions {
    display: flex;
    gap: 10px;
}

.btn-cam-action {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 11px 0;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all .2s;
    border: none;
}

.btn-cam-capture {
    background: linear-gradient(135deg, #6366f1, #8b5cf6);
    color: #fff;
    box-shadow: 0 4px 14px rgba(99,102,241,.35);
}

.btn-cam-capture:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(99,102,241,.45);
}

.btn-cam-capture:disabled {
    opacity: .5;
    cursor: not-allowed;
    transform: none;
}

.btn-cam-retake {
    background: #f3f4f6;
    color: #374151;
    border: 1px solid #e5e7eb;
}

.btn-cam-retake:hover {
    background: #e5e7eb;
}

.btn-cam-confirm {
    background: linear-gradient(135deg, #059669, #0d9488);
    color: #fff;
    box-shadow: 0 4px 14px rgba(5,150,105,.3);
}

.btn-cam-confirm:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(5,150,105,.4);
}

.cam-status-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    border-radius: 10px;
    font-size: 12.5px;
    font-weight: 500;
    margin-bottom: 12px;
    transition: all .3s;
}

.cam-status-bar.info    { background: #eff6ff; color: #1d4ed8; }
.cam-status-bar.success { background: #ecfdf5; color: #065f46; }
.cam-status-bar.error   { background: #fef2f2; color: #dc2626; }
.cam-status-bar.loading { background: #f5f3ff; color: #5b21b6; }

.cam-spinner {
    width: 14px;
    height: 14px;
    border: 2px solid currentColor;
    border-top-color: transparent;
    border-radius: 50%;
    animation: spin .7s linear infinite;
    flex-shrink: 0;
}

@keyframes spin {
    to { transform: rotate(360deg); }
}
</style>
{% endblock %}

{% block body %}
<a href="{{ path('app_user_index') }}" class="page-back">← Retour à la liste</a>

<div class="form-card">
    <div class="card">
        <div class="card-header">
            <h2>Ajouter un utilisateur</h2>
        </div>
        <div class="card-body" style="padding: 28px;">
            {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'id': 'userNewForm'}}) }}

            {# ── Face Photo Capture ─────────────────────────── #}
            <div class="face-capture-section">
                <label class="face-capture-label">Photo du visage (reconnaissance faciale)</label>
                <div class="face-capture-widget" id="faceCaptureWidget">
                    <div class="face-preview-circle" id="facePreviewCircle">
                        <span class="face-preview-placeholder">👤</span>
                    </div>
                    <div class="face-capture-info">
                        <div class="face-status" id="faceStatusText">Aucune photo</div>
                        <div class="face-hint">Veuillez capturer une photo de votre visage face à la caméra</div>
                        <button type="button" class="btn-take-photo" id="btnTakePhoto" onclick="openCameraModal()">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                                <circle cx="12" cy="13" r="4"/>
                            </svg>
                            Prendre une photo
                        </button>
                    </div>
                </div>
                {# Hidden input to carry the face path into the form submission #}
                <input type="hidden" name="face_image_path" id="faceImagePath" value="">
            </div>

            <div class="form-group">
                {{ form_label(form.name) }}
                {{ form_widget(form.name) }}
                {{ form_errors(form.name) }}
            </div>

            <div class="form-group">
                {{ form_label(form.email) }}
                {{ form_widget(form.email) }}
                {{ form_errors(form.email) }}
            </div>

            <div class="form-group">
                {{ form_label(form.phone) }}
                {{ form_widget(form.phone) }}
                {{ form_errors(form.phone) }}
            </div>

            <div class="form-group">
                {{ form_label(form.role) }}
                {{ form_widget(form.role) }}
                {{ form_errors(form.role) }}
            </div>

            <div class="form-group">
                {{ form_label(form.plainPassword) }}
                {{ form_widget(form.plainPassword) }}
                {{ form_errors(form.plainPassword) }}
            </div>

            <div class="form-actions">
                <a href="{{ path('app_user_index') }}" class="btn btn-outline">Annuler</a>
                <button type="submit" class="btn btn-primary" id="submitBtn">Créer l'utilisateur</button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>

{# ═══════════════════════════ Camera Modal ═══════════════════════════ #}
<div class="camera-modal-backdrop" id="cameraModalBackdrop">
    <div class="camera-modal">
        <div class="camera-modal-header">
            <h3>
                <span class="cam-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2">
                        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                        <circle cx="12" cy="13" r="4"/>
                    </svg>
                </span>
                Capture du visage
            </h3>
            <button type="button" class="btn-close-modal" onclick="closeCameraModal()">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>

        <div class="camera-body">
            {# Status bar #}
            <div class="cam-status-bar info" id="camStatusBar">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                Placez votre visage dans le cadre, puis cliquez sur "Capturer"
            </div>

            {# Live video stream #}
            <div class="camera-video-wrap" id="cameraVideoWrap">
                <video id="cameraVideo" autoplay playsinline></video>
                <div class="face-guide-overlay">
                    <div class="face-guide-ellipse" id="faceGuideEllipse"></div>
                </div>
            </div>

            {# Canvas (hidden) for capture #}
            <canvas id="captureCanvas" style="display:none;"></canvas>

            {# Preview after capture #}
            <img id="capturedPreview" alt="Photo capturée" />

            <div class="camera-hint" id="cameraHint">
                🔴 Assurez-vous d'être seul face à la caméra dans un environnement bien éclairé
            </div>

            <div class="camera-actions" id="cameraActions">
                <button type="button" class="btn-cam-action btn-cam-capture" id="btnCapture" onclick="capturePhoto()">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r="10" stroke-dasharray="4 2"/>
                    </svg>
                    Capturer
                </button>
            </div>

            {# Retake + Confirm buttons (shown after capture) #}
            <div class="camera-actions" id="cameraActionsConfirm" style="display:none;">
                <button type="button" class="btn-cam-action btn-cam-retake" onclick="retakePhoto()">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.5"/></svg>
                    Reprendre
                </button>
                <button type="button" class="btn-cam-action btn-cam-confirm" id="btnConfirmPhoto" onclick="confirmPhoto()">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                    Confirmer
                </button>
            </div>
        </div>
    </div>
</div>

<script>
/* ═══════════════════════════════════════════════════════
   Face Capture — JavaScript
═══════════════════════════════════════════════════════ */

let mediaStream    = null;
let capturedBase64 = null;
let confirmedPath  = null;

// ── Open modal & start camera ─────────────────────────
async function openCameraModal() {
    document.getElementById('cameraModalBackdrop').classList.add('active');
    resetCameraUI();

    try {
        setCamStatus('info', 'Démarrage de la caméra…');
        mediaStream = await navigator.mediaDevices.getUserMedia({
            video: { width: { ideal: 1280 }, height: { ideal: 720 }, facingMode: 'user' },
            audio: false
        });
        const video = document.getElementById('cameraVideo');
        video.srcObject = mediaStream;
        await video.play();
        document.getElementById('cameraVideoWrap').style.display = 'block';
        document.getElementById('capturedPreview').style.display = 'none';
        setCamStatus('info', 'Placez votre visage dans le cadre, puis cliquez sur "Capturer"');
        document.getElementById('cameraActions').style.display = 'flex';
        document.getElementById('cameraActionsConfirm').style.display = 'none';
    } catch (err) {
        setCamStatus('error', 'Impossible d\'accéder à la caméra : ' + err.message);
    }
}

// ── Close modal & stop camera ─────────────────────────
function closeCameraModal() {
    stopStream();
    document.getElementById('cameraModalBackdrop').classList.remove('active');
}

function stopStream() {
    if (mediaStream) {
        mediaStream.getTracks().forEach(t => t.stop());
        mediaStream = null;
    }
}

// ── Capture a frame ───────────────────────────────────
function capturePhoto() {
    const video  = document.getElementById('cameraVideo');
    const canvas = document.getElementById('captureCanvas');
    canvas.width  = video.videoWidth  || 640;
    canvas.height = video.videoHeight || 480;

    const ctx = canvas.getContext('2d');
    // Un-mirror for actual capture (mirror only for display)
    ctx.translate(canvas.width, 0);
    ctx.scale(-1, 1);
    ctx.drawImage(video, 0, 0);
    ctx.setTransform(1,0,0,1,0,0);

    capturedBase64 = canvas.toDataURL('image/png', 0.92);

    // Show preview
    const preview = document.getElementById('capturedPreview');
    preview.src = capturedBase64;
    preview.style.display = 'block';
    document.getElementById('cameraVideoWrap').style.display = 'none';
    document.getElementById('cameraActions').style.display = 'none';
    document.getElementById('cameraActionsConfirm').style.display = 'flex';
    document.getElementById('cameraHint').textContent = '✅ Vérifiez que votre visage est bien visible avant de confirmer.';
    setCamStatus('info', 'Photo prise. Cliquez sur "Confirmer" pour valider.');
    stopStream();
}

// ── Retake ────────────────────────────────────────────
function retakePhoto() {
    capturedBase64 = null;
    openCameraModal();
}

// ── Confirm: send to server for DeepFace validation ──
async function confirmPhoto() {
    if (!capturedBase64) return;
    setCamStatus('loading', 'Validation du visage en cours…', true);
    document.getElementById('btnConfirmPhoto').disabled = true;

    try {
        const response = await fetch('{{ path('app_face_capture') }}', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ image: capturedBase64 })
        });

        const result = await response.json();

        if (result.ok) {
            confirmedPath = result.path;
            setCamStatus('success', '✅ ' + (result.message || 'Visage validé avec succès !'));

            // Update the hidden input + widget preview
            document.getElementById('faceImagePath').value = confirmedPath;
            updateWidgetPreview(capturedBase64, true);

            setTimeout(() => closeCameraModal(), 1200);
        } else {
            setCamStatus('error', '❌ ' + (result.error || 'Validation échouée.'));
            document.getElementById('btnConfirmPhoto').disabled = false;
        }
    } catch (err) {
        setCamStatus('error', '❌ Erreur réseau : ' + err.message);
        document.getElementById('btnConfirmPhoto').disabled = false;
    }
}

// ── Update the capture widget in the form ────────────
function updateWidgetPreview(imgSrc, success) {
    const circle = document.getElementById('facePreviewCircle');
    circle.innerHTML = `<img src="${imgSrc}" alt="Visage capturé">`;

    const widget = document.getElementById('faceCaptureWidget');
    widget.classList.add('has-photo');

    const status = document.getElementById('faceStatusText');
    status.textContent = success ? '✅ Photo enregistrée' : 'Photo capturée';
    status.className = 'face-status' + (success ? ' success' : '');

    document.getElementById('btnTakePhoto').textContent = '🔄 Reprendre la photo';
}

// ── Helpers ───────────────────────────────────────────
function setCamStatus(type, msg, showSpinner = false) {
    const bar = document.getElementById('camStatusBar');
    bar.className = 'cam-status-bar ' + type;
    bar.innerHTML = showSpinner
        ? `<div class="cam-spinner"></div>${msg}`
        : msg;
}

function resetCameraUI() {
    capturedBase64 = null;
    document.getElementById('cameraActions').style.display = 'flex';
    document.getElementById('cameraActionsConfirm').style.display = 'none';
    document.getElementById('capturedPreview').style.display = 'none';
    document.getElementById('cameraVideoWrap').style.display = 'block';
    document.getElementById('btnConfirmPhoto').disabled = false;
    document.getElementById('cameraHint').innerHTML =
        '🔴 Assurez-vous d\'être seul face à la caméra dans un environnement bien éclairé';
    document.getElementById('faceGuideEllipse').classList.remove('detected');
}

// ── Form submission: inject face path into hidden field ─
document.getElementById('userNewForm').addEventListener('submit', function(e) {
    const pathInput = document.getElementById('faceImagePath');
    // If face captured, it's already in the hidden field — handled by controller
});

// Close on backdrop click
document.getElementById('cameraModalBackdrop').addEventListener('click', function(e) {
    if (e.target === this) closeCameraModal();
});

// Close on Escape key
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeCameraModal();
});
</script>
{% endblock %}
