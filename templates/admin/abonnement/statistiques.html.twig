{% extends 'base_admin.html.twig' %}

{% block title %}Statistiques — Admin Dinari{% endblock %}
{% block page_title %}Statistiques{% endblock %}

{% block stylesheets %}
<style>
@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

:root {
    --blue:   #4059aa;
    --blue-lt:#dce1ff;
    --blue-md:#8fa7fe;
    --green:  #16a34a;
    --amber:  #d97706;
    --red:    #ba1a1a;
    --bg:     #f7f9fb;
    --card:   #ffffff;
    --border: #e0e3e5;
    --text:   #191c1e;
    --muted:  #44474d;
    --faint:  #75777e;
}

*, *::before, *::after { box-sizing: border-box; }

.sp { font-family: 'Plus Jakarta Sans', sans-serif; background: var(--bg); }

/* ── PAGE HEADER ── */
.sp-header {
    display: flex; align-items: flex-start; justify-content: space-between;
    margin-bottom: 36px; gap: 16px;
}
.sp-header h1 {
    font-size: 32px; font-weight: 800; color: var(--text);
    letter-spacing: -0.5px; margin: 0 0 4px;
}
.sp-header p { font-size: 13px; color: var(--muted); margin: 0; font-weight: 500; }

.sp-header-right { display: flex; align-items: center; gap: 10px; }
.btn-back {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 9px 18px; border-radius: 10px; font-size: 13px; font-weight: 600;
    text-decoration: none; background: var(--card); color: var(--muted);
    border: 1px solid var(--border); transition: all 0.2s; white-space: nowrap;
    font-family: 'Plus Jakarta Sans', sans-serif;
}
.btn-back:hover { color: var(--blue); border-color: var(--blue-md); text-decoration: none; }



/* ── KPI STRIP ── */
.kpi-strip { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 32px; }

.kpi-card {
    background: var(--card); border-radius: 14px; padding: 24px;
    border: 1px solid var(--border);
    box-shadow: 0 2px 8px rgba(25,28,30,0.04);
    transition: box-shadow 0.2s, transform 0.2s;
    animation: fadeUp 0.4s ease both;
}
.kpi-card:hover { box-shadow: 0 8px 28px rgba(25,28,30,0.08); transform: translateY(-2px); }
.kpi-card:nth-child(1){animation-delay:0.05s}
.kpi-card:nth-child(2){animation-delay:0.10s}
.kpi-card:nth-child(3){animation-delay:0.15s}
.kpi-card:nth-child(4){animation-delay:0.20s}

.kpi-top {
    display: flex; justify-content: space-between; align-items: flex-start;
    margin-bottom: 16px;
}
.kpi-tag {
    font-size: 10px; font-weight: 800; letter-spacing: 1.5px;
    text-transform: uppercase; color: var(--faint);
}
.kpi-badge {
    font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 20px;
    display: inline-flex; align-items: center; gap: 3px;
}
.kpi-badge.up   { background: rgba(22,163,74,0.1);  color: #16a34a; }
.kpi-badge.down { background: rgba(186,26,26,0.1);  color: var(--red); }
.kpi-badge.flat { background: #eceef0; color: var(--muted); }

.kpi-value {
    font-size: 36px; font-weight: 800; color: var(--text);
    line-height: 1; letter-spacing: -1px;
    font-variant-numeric: tabular-nums;
}
.kpi-value.dt::after { content: ' DT'; font-size: 16px; font-weight: 600; color: var(--faint); }
.kpi-value.pct::after { content: '%'; font-size: 20px; font-weight: 600; color: var(--faint); }

.kpi-sub { font-size: 12px; color: var(--faint); margin-top: 8px; font-weight: 500; }

/* mini sparkline */
.kpi-spark { display: flex; align-items: flex-end; gap: 3px; height: 28px; margin-top: 14px; }
.spark-col { flex: 1; border-radius: 3px 3px 0 0; transition: opacity 0.2s; }
.kpi-card:hover .spark-col { opacity: 0.8; }

/* ── SECTION TITLE ── */
.sec-title {
    font-size: 10px; font-weight: 800; letter-spacing: 2px; text-transform: uppercase;
    color: var(--faint); margin: 0 0 16px; display: flex; align-items: center; gap: 12px;
}
.sec-title::after { content: ''; flex: 1; height: 1px; background: var(--border); }

/* ── GRID LAYOUTS ── */
.grid-3-2 { display: grid; grid-template-columns: 3fr 2fr; gap: 20px; margin-bottom: 20px; }
.grid-2   { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px; }
.grid-5-3 { display: grid; grid-template-columns: 5fr 3fr; gap: 20px; margin-bottom: 20px; }

/* ── CHART CARD ── */
.cc {
    background: var(--card); border-radius: 14px; overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: 0 2px 8px rgba(25,28,30,0.04);
    animation: fadeUp 0.4s ease both;
}
.cc-head {
    padding: 20px 24px 0;
    display: flex; align-items: flex-start; justify-content: space-between;
}
.cc-title { font-size: 15px; font-weight: 800; color: var(--text); margin: 0 0 3px; }
.cc-sub   { font-size: 12px; color: var(--faint); font-weight: 500; }
.cc-body  { padding: 16px 24px 24px; }

.cc-total {
    font-size: 28px; font-weight: 800; color: var(--text);
    letter-spacing: -0.5px; margin-bottom: 4px;
}
.cc-total-sub { font-size: 12px; color: var(--faint); margin-bottom: 20px; }

/* ── FAKE SVG LINE CHART ── */
.line-chart-wrap {
    position: relative; height: 160px; margin-bottom: 8px;
}
.line-chart-wrap svg { width: 100%; height: 100%; }
.chart-grid { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: space-between; pointer-events: none; }
.chart-grid-line { border-top: 1px dashed #e0e3e5; }
.chart-x-labels { display: flex; justify-content: space-between; font-size: 10px; font-weight: 700; color: var(--faint); text-transform: uppercase; letter-spacing: 0.5px; padding: 0 2px; }

/* ── BAR CHART ── */
.bar-row { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
.bar-row:last-child { margin-bottom: 0; }
.bar-lbl { font-size: 12px; font-weight: 700; color: var(--text); width: 100px; flex-shrink: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.bar-track { flex: 1; height: 8px; background: #eceef0; border-radius: 99px; overflow: hidden; }
.bar-fill  { height: 100%; border-radius: 99px; transition: width 0.9s cubic-bezier(.22,1,.36,1); }
.bar-num   { font-size: 12px; font-weight: 700; color: var(--text); width: 52px; text-align: right; font-variant-numeric: tabular-nums; }

/* ── TOP TABLE ── */
.top-table { width: 100%; border-collapse: collapse; }
.top-table thead th {
    font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px;
    color: var(--faint); padding-bottom: 12px; border-bottom: 1px solid var(--border);
    text-align: left;
}
.top-table thead th:last-child { text-align: right; }
.top-table tbody tr { border-bottom: 1px solid #f2f4f6; transition: background 0.15s; }
.top-table tbody tr:last-child { border-bottom: none; }
.top-table tbody tr:hover { background: #f7f9fb; }
.top-table td { padding: 12px 0; font-size: 13px; vertical-align: middle; }

.tbl-rank {
    width: 24px; height: 24px; border-radius: 6px;
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 11px; font-weight: 800;
}
.rank-1 { background: #fef3c7; color: #d97706; }
.rank-2 { background: #f1f5f9; color: #64748b; }
.rank-3 { background: #fee2e2; color: #dc2626; }
.rank-n { background: #eff6ff; color: var(--blue); }

.tbl-logo { width: 28px; height: 28px; border-radius: 7px; object-fit: contain; background: #f7f9fb; border: 1px solid var(--border); flex-shrink: 0; padding: 2px; }
.tbl-logo-fb { width: 28px; height: 28px; border-radius: 7px; background: linear-gradient(135deg, var(--blue), #264191); color: #fff; font-size: 10px; font-weight: 800; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }
.tbl-name { font-size: 13px; font-weight: 700; color: var(--text); }
.tbl-cat  { font-size: 11px; color: var(--faint); margin-top: 1px; }
.tbl-val  { font-size: 14px; font-weight: 800; color: var(--text); text-align: right; font-variant-numeric: tabular-nums; }
.tbl-sub  { font-size: 11px; color: var(--faint); text-align: right; }

.tbl-retention {
    display: inline-flex; align-items: center; gap: 5px; font-size: 12px; font-weight: 700;
}
.ret-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
.ret-high { color: #16a34a; } .ret-dot.high { background: #16a34a; }
.ret-mid  { color: var(--blue); } .ret-dot.mid { background: var(--blue); }
.ret-low  { color: var(--red); } .ret-dot.low  { background: var(--red); }

/* ── DONUT ── */
.donut-section { display: flex; align-items: center; gap: 20px; }
.donut-svg-wrap { position: relative; width: 100px; height: 100px; flex-shrink: 0; }
.donut-svg-wrap svg { transform: rotate(-90deg); }
.donut-center { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.donut-c-val  { font-size: 20px; font-weight: 800; color: var(--text); line-height: 1; }
.donut-c-lbl  { font-size: 10px; color: var(--faint); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }
.donut-legend { flex: 1; display: flex; flex-direction: column; gap: 9px; }
.leg-item { display: flex; align-items: center; gap: 8px; }
.leg-dot  { width: 8px; height: 8px; border-radius: 2px; flex-shrink: 0; }
.leg-lbl  { font-size: 12px; color: var(--muted); flex: 1; font-weight: 600; }
.leg-val  { font-size: 12px; font-weight: 800; color: var(--text); font-variant-numeric: tabular-nums; }

/* ── MINI METRICS ── */
.mini-metrics { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.mini-m {
    background: #f7f9fb; border: 1px solid var(--border);
    border-radius: 10px; padding: 14px 16px;
}
.mini-m-val { font-size: 22px; font-weight: 800; color: var(--text); font-variant-numeric: tabular-nums; letter-spacing: -0.5px; }
.mini-m-lbl { font-size: 10px; color: var(--faint); font-weight: 700; margin-top: 3px; text-transform: uppercase; letter-spacing: 0.5px; }

/* ── STAR BOX ── */
.star-box {
    margin-top: 16px;
    background: linear-gradient(135deg, #0d1c32, #4059aa);
    border-radius: 12px; padding: 18px 20px; color: #fff;
}
.star-tag { font-size: 9px; font-weight: 800; letter-spacing: 1.5px; text-transform: uppercase; color: rgba(255,255,255,0.5); margin-bottom: 6px; }
.star-name { font-size: 16px; font-weight: 800; margin-bottom: 3px; }
.star-cat  { font-size: 11px; color: rgba(255,255,255,0.55); font-weight: 600; }
.star-nums { display: flex; gap: 24px; margin-top: 14px; padding-top: 14px; border-top: 1px solid rgba(255,255,255,0.12); }
.star-n-val { font-size: 20px; font-weight: 800; font-variant-numeric: tabular-nums; }
.star-n-lbl { font-size: 10px; color: rgba(255,255,255,0.5); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 2px; }

/* ── PROGRESS BAR (activation) ── */
.progress-bar-wrap { margin-top: 12px; }
.progress-bar-track { height: 6px; background: #eceef0; border-radius: 99px; overflow: hidden; margin-top: 6px; }
.progress-bar-fill  { height: 100%; border-radius: 99px; background: linear-gradient(90deg, var(--blue), var(--blue-md)); transition: width 1s ease; }

@keyframes fadeUp { from{opacity:0;transform:translateY(10px)} to{opacity:1;transform:translateY(0)} }
</style>
{% endblock %}

{% block body %}
<div class="sp">

    {# ── HEADER ── #}
    <div class="sp-header">
        <div>
            <h1>Analytics &amp; Insights</h1>
            <p>Vue d'ensemble des performances — abonnements Dinari</p>
        </div>
        <div class="sp-header-right">

            <a href="{{ path('admin_abonnement_index') }}" class="btn-back">← Abonnements</a>
        </div>
    </div>

    {# ── KPI STRIP ── #}
    <div class="kpi-strip">
        {# Total revenus #}
        <div class="kpi-card">
            <div class="kpi-top">
                <span class="kpi-tag">Total Revenus</span>
                <span class="kpi-badge up">▲ +actif</span>
            </div>
            <div class="kpi-value dt">{{ stats.revenus|number_format(0) }}</div>
            <div class="kpi-sub">Moy. {{ stats.revenuMoyen|number_format(2) }} DT / client</div>
            <div class="kpi-spark">
                <div class="spark-col" style="height:35%;background:#b6c4ff;"></div>
                <div class="spark-col" style="height:55%;background:#8fa7fe;"></div>
                <div class="spark-col" style="height:40%;background:#8fa7fe;"></div>
                <div class="spark-col" style="height:70%;background:#6b8ef5;"></div>
                <div class="spark-col" style="height:100%;background:var(--blue);"></div>
            </div>
        </div>

        {# Abonnés actifs #}
        <div class="kpi-card">
            <div class="kpi-top">
                <span class="kpi-tag">Abonnés actifs</span>
                <span class="kpi-badge flat">{{ stats.totalPaiements }} total</span>
            </div>
            <div class="kpi-value">{{ stats.totalClients }}</div>
            <div class="kpi-sub">Paiements enregistrés</div>
            <div class="progress-bar-wrap">
                <div style="display:flex;justify-content:space-between;font-size:11px;font-weight:700;color:var(--faint);">
                    <span>Payés</span>
                    <span>{{ stats.totalPaiements > 0 ? ((stats.totalClients / stats.totalPaiements) * 100)|round : 0 }}%</span>
                </div>
                <div class="progress-bar-track">
                    <div class="progress-bar-fill" style="width:{{ stats.totalPaiements > 0 ? ((stats.totalClients / stats.totalPaiements) * 100)|round : 0 }}%;"></div>
                </div>
            </div>
        </div>

        {# Packs actifs #}
        <div class="kpi-card">
            <div class="kpi-top">
                <span class="kpi-tag">Packs configurés</span>
                <span class="kpi-badge {{ stats.actifs > 0 ? 'up' : 'flat' }}">{{ stats.actifs }} publiés</span>
            </div>
            <div class="kpi-value">{{ stats.total }}</div>
            <div class="kpi-sub">{{ stats.inactifs }} en attente · {{ stats.premium }} premium</div>
            <div class="kpi-spark">
                {% set catCount = stats.parCategorie|length %}
                <div class="spark-col" style="height:60%;background:#e50914;"></div>
                <div class="spark-col" style="height:45%;background:#1db954;"></div>
                <div class="spark-col" style="height:80%;background:var(--blue);"></div>
                <div class="spark-col" style="height:30%;background:#107c10;"></div>
                <div class="spark-col" style="height:50%;background:#0056d2;"></div>
            </div>
        </div>

        {# Taux d'activation #}
        <div class="kpi-card">
            <div class="kpi-top">
                <span class="kpi-tag">Taux d'activation</span>
                <span class="kpi-badge {{ stats.tauxActivation >= 80 ? 'up' : (stats.tauxActivation >= 50 ? 'flat' : 'down') }}">
                    {{ stats.tauxActivation >= 80 ? 'Excellent' : (stats.tauxActivation >= 50 ? 'Moyen' : 'Faible') }}
                </span>
            </div>
            <div class="kpi-value pct">{{ stats.tauxActivation }}</div>
            <div class="kpi-sub">Prix moyen : {{ stats.prixMoyen|number_format(2) }} DT</div>
            <div class="progress-bar-wrap" style="margin-top:14px;">
                <div class="progress-bar-track" style="height:8px;">
                    <div class="progress-bar-fill" style="width:{{ stats.tauxActivation }}%;"></div>
                </div>
            </div>
        </div>
    </div>

    {# ── PERFORMANCE : ligne chart + top abonnements ── #}
    <div class="sec-title">Performance</div>
    <div class="grid-5-3">

        {# Top Performing Services — table style #}
        <div class="cc">
            <div class="cc-head">
                <div>
                    <div class="cc-title">Top Performing Services</div>
                    <div class="cc-sub">Classement par clients et revenus générés</div>
                </div>
            </div>
            <div class="cc-body">
                {% if stats.topAbonnements is empty %}
                    <p style="text-align:center;color:var(--faint);padding:30px 0;font-size:13px;">Aucune donnée de paiement disponible</p>
                {% else %}
                <table class="top-table">
                    <thead>
                        <tr>
                            <th style="width:28px;"></th>
                            <th>Service</th>
                            <th>Catégorie</th>
                            <th style="text-align:center;">Clients</th>
                            <th>Revenus</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for item in stats.topAbonnements %}
                    <tr>
                        <td><span class="tbl-rank rank-{{ loop.index <= 3 ? loop.index : 'n' }}">{{ loop.index }}</span></td>
                        <td>
                            <div style="display:flex;align-items:center;gap:10px;">
                                {% if item.logoDomain %}
                                    <img class="tbl-logo" src="https://logo.clearbit.com/{{ item.logoDomain }}" alt="{{ item.nom }}"
                                         onerror="this.src='https://www.google.com/s2/favicons?domain={{ item.logoDomain }}&sz=28'; this.style.width='28px'; this.style.height='28px'; this.onerror=function(){ this.style.display='none'; document.getElementById('fallback-stat-{{ item.id }}').style.display='inline-flex'; };">
                                    <span id="fallback-stat-{{ item.id }}" class="tbl-logo-fb" style="display:none;">{{ item.nom|slice(0,2)|upper }}</span>
                                {% else %}
                                    <span class="tbl-logo-fb">{{ item.nom|slice(0,2)|upper }}</span>
                                {% endif %}
                                <div>
                                    <div class="tbl-name">{{ item.nom }}</div>
                                    <div class="tbl-cat">{{ item.frequence|capitalize }}</div>
                                </div>
                            </div>
                        </td>
                        <td style="font-size:12px;color:var(--muted);font-weight:600;">{{ item.categorie|capitalize }}</td>
                        <td style="text-align:center;">
                            <span style="font-size:15px;font-weight:800;color:var(--text);">{{ item.nbClients }}</span>
                        </td>
                        <td>
                            <div class="tbl-val">{{ item.revenus|number_format(2) }} DT</div>
                        </td>
                    </tr>
                    {% endfor %}
                    </tbody>
                </table>
                {% endif %}
            </div>
        </div>

        {# Subscribers by category — bar chart #}
        <div class="cc">
            <div class="cc-head">
                <div>
                    <div class="cc-title">Répartition par catégorie</div>
                    <div class="cc-sub">Distribution des packs</div>
                </div>
            </div>
            <div class="cc-body" style="padding-top:20px;">
                {% set catColors = {'streaming':'#e50914','musique':'#1db954','productivite':'var(--blue)','gaming':'#107c10','education':'#0056d2','securite':'#4687ff'} %}
                {% for cat, count in stats.parCategorie %}
                <div class="bar-row">
                    <div class="bar-lbl">{{ cat|capitalize }}</div>
                    <div class="bar-track">
                        <div class="bar-fill"
                             style="width:{{ stats.maxParCategorie > 0 ? (count / stats.maxParCategorie * 100)|round : 0 }}%;
                                    background:{{ catColors[cat]|default('var(--blue)') }};">
                        </div>
                    </div>
                    <div class="bar-num">{{ count }}</div>
                </div>
                {% else %}
                <p style="text-align:center;color:var(--faint);padding:20px 0;font-size:13px;">Aucune donnée</p>
                {% endfor %}
            </div>
        </div>
    </div>

    {# ── REVENUS + TIERS + MÉTRIQUES ── #}
    <div class="sec-title">Analyse financière &amp; opérationnelle</div>
    <div class="grid-3-2">

        {# Revenus par abonnement — barres horizontales #}
        <div class="cc">
            <div class="cc-head">
                <div>
                    <div class="cc-title">Revenue Contribution</div>
                    <div class="cc-sub">Top 8 abonnements par chiffre d'affaires</div>
                </div>
                <div style="font-size:24px;font-weight:800;color:var(--text);letter-spacing:-0.5px;">
                    {{ stats.revenus|number_format(0) }} <span style="font-size:13px;font-weight:600;color:var(--faint);">DT</span>
                </div>
            </div>
            <div class="cc-body" style="padding-top:20px;">
                {% if stats.topRevenus is empty %}
                <p style="text-align:center;color:var(--faint);padding:30px 0;font-size:13px;">Aucune donnée</p>
                {% else %}
                {% set revColors = ['#4059aa','#16a34a','#d97706','#8fa7fe','#94a3b8','#94a3b8','#94a3b8','#94a3b8'] %}
                {% for item in stats.topRevenus %}
                <div class="bar-row">
                    <div class="bar-lbl" title="{{ item.nom }}">{{ item.nom }}</div>
                    <div class="bar-track" style="height:10px;">
                        <div class="bar-fill"
                             style="width:{{ stats.maxTopRevenus > 0 ? (item.revenus / stats.maxTopRevenus * 100)|round : 0 }}%;
                                    background:{{ revColors[loop.index0]|default('#94a3b8') }};">
                        </div>
                    </div>
                    <div class="bar-num">{{ item.revenus|number_format(0) }} DT</div>
                </div>
                {% endfor %}
                {% endif %}
            </div>
        </div>

        {# Tiers donut + métriques + star #}
        <div style="display:flex;flex-direction:column;gap:16px;">

            {# Donut tiers #}
            <div class="cc">
                <div class="cc-head">
                    <div>
                        <div class="cc-title">Niveaux de packs</div>
                        <div class="cc-sub">Répartition par tier</div>
                    </div>
                </div>
                <div class="cc-body">
                    {% set tierColors = {'Normal':'#4059aa','Silver':'#94a3b8','Gold':'#f59e0b','Platinum':'#8b5cf6'} %}
                    {% set tierTotal  = stats.parTier|reduce((acc,v) => acc + v, 0) %}
                    <div class="donut-section">
                        <div class="donut-svg-wrap">
                            <svg width="100" height="100" viewBox="0 0 100 100">
                                {% set circ = 226.195 %}
                                {% set off  = 0 %}
                                {% for tier, count in stats.parTier %}
                                    {% set pct = tierTotal > 0 ? count / tierTotal : 0 %}
                                    {% set dl  = pct * circ %}
                                    <circle cx="50" cy="50" r="36" fill="none"
                                        stroke="{{ tierColors[tier]|default('#4059aa') }}"
                                        stroke-width="16"
                                        stroke-dasharray="{{ dl }} {{ circ - dl }}"
                                        stroke-dashoffset="{{ -off }}"
                                        stroke-linecap="butt"/>
                                    {% set off = off + dl %}
                                {% endfor %}
                            </svg>
                            <div class="donut-center">
                                <div class="donut-c-val">{{ stats.total }}</div>
                                <div class="donut-c-lbl">packs</div>
                            </div>
                        </div>
                        <div class="donut-legend">
                            {% for tier, count in stats.parTier %}
                            <div class="leg-item">
                                <div class="leg-dot" style="background:{{ tierColors[tier]|default('#4059aa') }};"></div>
                                <span class="leg-lbl">{{ tier }}</span>
                                <span class="leg-val">{{ count }}</span>
                            </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>

            {# Mini métriques #}
            <div class="cc">
                <div class="cc-head"><div class="cc-title">Indicateurs opérationnels</div></div>
                <div class="cc-body">
                    <div class="mini-metrics">
                        <div class="mini-m">
                            <div class="mini-m-val">{{ stats.prixMoyen|number_format(2) }}</div>
                            <div class="mini-m-lbl">Prix moyen DT</div>
                        </div>
                        <div class="mini-m">
                            <div class="mini-m-val">{{ stats.packsAvecPromo }}</div>
                            <div class="mini-m-lbl">Avec promo</div>
                        </div>
                        <div class="mini-m">
                            <div class="mini-m-val" style="color:{{ stats.expirantBientot > 0 ? 'var(--red)' : 'var(--green)' }};">{{ stats.expirantBientot }}</div>
                            <div class="mini-m-lbl">Expirent 30j</div>
                        </div>
                        <div class="mini-m">
                            <div class="mini-m-val">{{ stats.packsAvecEssai }}</div>
                            <div class="mini-m-lbl">Avec essai</div>
                        </div>
                    </div>

                    {% if stats.aboLePlusDemande %}
                    <div class="star-box">
                        <div class="star-tag">Abonnement le plus populaire</div>
                        <div class="star-name">{{ stats.aboLePlusDemande.nom }}</div>
                        <div class="star-cat">{{ stats.aboLePlusDemande.categorie|capitalize }} · {{ stats.aboLePlusDemande.frequence }}</div>
                        <div class="star-nums">
                            <div>
                                <div class="star-n-val">{{ stats.aboLePlusDemande.nbClients }}</div>
                                <div class="star-n-lbl">Clients</div>
                            </div>
                            <div>
                                <div class="star-n-val">{{ stats.aboLePlusDemande.revenus|number_format(0) }}</div>
                                <div class="star-n-lbl">DT générés</div>
                            </div>
                        </div>
                    </div>
                    {% endif %}
                </div>
            </div>

        </div>
    </div>

</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    // Animate bars
    document.querySelectorAll('.bar-fill, .progress-bar-fill').forEach(bar => {
        const w = bar.style.width;
        bar.style.width = '0';
        requestAnimationFrame(() => setTimeout(() => { bar.style.width = w; }, 80));
    });


});
</script>
{% endblock %}
