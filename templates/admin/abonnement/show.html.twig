{% extends 'admin/layout.html.twig' %}

{% block title %}{{ abonnement.nom }} — Détails Abonnement{% endblock %}
{% block page_title %}Détails Abonnement{% endblock %}

{% block stylesheets %}
<style>
@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
.show-page { font-family: 'Plus Jakarta Sans', sans-serif; }

.page-top {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 28px;
}
.page-top h1 { font-size: 24px; font-weight: 800; color: #1e2d40; margin: 0 0 4px; }
.breadcrumb-d { font-size: 13px; color: #8a9bb5; }
.breadcrumb-d a { color: #1a6fc4; text-decoration: none; }

.abo-hero {
    background: linear-gradient(135deg, #0f1f3d 0%, #1a6fc4 100%);
    border-radius: 16px; padding: 28px 32px;
    display: flex; align-items: center; gap: 20px;
    margin-bottom: 28px; position: relative; overflow: hidden;
}
.abo-hero::before {
    content: ''; position: absolute; top: -40px; right: -40px;
    width: 180px; height: 180px; border-radius: 50%;
    background: rgba(255,255,255,0.05);
}
.abo-hero-logo {
    width: 60px; height: 60px; border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    font-size: 20px; font-weight: 900; color: #fff;
    background: rgba(255,255,255,0.2); flex-shrink: 0;
}
.abo-hero-title { color: #fff; font-size: 22px; font-weight: 800; margin: 0 0 4px; }
.abo-hero-sub   { color: rgba(255,255,255,0.65); font-size: 13px; }
.abo-hero-badges { display: flex; gap: 8px; margin-top: 10px; flex-wrap: wrap; }
.abo-hero-badge {
    padding: 4px 12px; border-radius: 999px; font-size: 11px; font-weight: 700;
    background: rgba(255,255,255,0.15); color: #fff;
}
.abo-hero-price { margin-left: auto; text-align: right; flex-shrink: 0; }
.abo-hero-price .amount { font-size: 32px; font-weight: 900; color: #fff; line-height: 1; }
.abo-hero-price .freq   { font-size: 13px; color: rgba(255,255,255,0.6); margin-top: 4px; }
.hero-status {
    padding: 5px 12px; border-radius: 999px; font-size: 11px; font-weight: 700;
    margin-top: 8px; display: inline-block;
}
.hero-status.actif   { background: rgba(39,174,96,0.25);  color: #7dffa7; }
.hero-status.inactif { background: rgba(231,76,60,0.25);  color: #ffa7a7; }

.tabs-nav {
    display: flex; gap: 4px; background: #f0f2f7;
    border-radius: 12px; padding: 4px; margin-bottom: 28px; width: fit-content;
}
.tab-btn {
    padding: 9px 22px; border-radius: 9px; font-size: 13px; font-weight: 600;
    color: #8a9bb5; cursor: pointer; border: none; background: transparent;
    display: inline-flex; align-items: center; gap: 7px;
    transition: all 0.2s; font-family: 'Plus Jakarta Sans', sans-serif;
}
.tab-btn:hover { color: #1e2d40; }
.tab-btn.active { background: #fff; color: #1a6fc4; box-shadow: 0 1px 4px rgba(0,0,0,0.1); }
.tab-panel { display: none; }
.tab-panel.active { display: block; }

.info-card {
    background: #fff; border: 1px solid #e4e9f2;
    border-radius: 16px; overflow: hidden; margin-bottom: 20px;
}
.info-card-header {
    padding: 16px 24px; border-bottom: 1px solid #f0f3f9;
    font-size: 13px; font-weight: 700; color: #1e2d40;
    display: flex; align-items: center; gap: 8px;
}
.info-table { width: 100%; border-collapse: collapse; }
.info-table td { padding: 14px 24px; border-bottom: 1px solid #f7f8fb; font-size: 13px; vertical-align: middle; }
.info-table tr:last-child td { border-bottom: none; }
.info-table .lbl { color: #8a9bb5; font-weight: 600; width: 35%; }
.info-table .val { color: #1e2d40; font-weight: 600; }

.stats-mini {
    display: grid; grid-template-columns: repeat(4,1fr);
    gap: 14px; margin-bottom: 24px;
}
.stat-mini-box {
    background: #fff; border: 1px solid #e4e9f2;
    border-radius: 12px; padding: 16px 18px;
}
.stat-mini-val { font-size: 24px; font-weight: 800; color: #1e2d40; line-height: 1; }
.stat-mini-lbl { font-size: 11px; color: #8a9bb5; font-weight: 600; margin-top: 4px; }

.table-card {
    background: #fff; border: 1px solid #e4e9f2;
    border-radius: 16px; overflow: hidden;
}
.table-card-header {
    padding: 16px 24px; border-bottom: 1px solid #f0f3f9;
    display: flex; justify-content: space-between; align-items: center;
}
.table-card-title { font-size: 14px; font-weight: 700; color: #1e2d40; }
.count-badge {
    background: #f0f4ff; color: #1a6fc4;
    padding: 3px 10px; border-radius: 999px; font-size: 12px; font-weight: 700;
}

table.ctable { width: 100%; border-collapse: collapse; }
table.ctable thead tr { background: #f8f9fc; }
table.ctable th {
    padding: 11px 16px; text-align: left; font-size: 11px; font-weight: 700;
    text-transform: uppercase; letter-spacing: 1px; color: #8a9bb5;
    border-bottom: 1px solid #f0f3f9;
}
table.ctable td {
    padding: 13px 16px; border-bottom: 1px solid #f7f8fb;
    font-size: 13px; color: #3d5166; vertical-align: middle;
}
table.ctable tbody tr:hover { background: #fafbfd; }
table.ctable tbody tr:last-child td { border-bottom: none; }

.client-cell { display: flex; align-items: center; gap: 10px; }
.avatar {
    width: 34px; height: 34px; border-radius: 50%;
    background: linear-gradient(135deg, #1a6fc4, #1558a0);
    display: flex; align-items: center; justify-content: center;
    font-size: 12px; font-weight: 700; color: #fff; flex-shrink: 0;
}
.c-name { font-weight: 700; color: #1e2d40; font-size: 13px; }
.c-sub  { font-size: 11px; color: #8a9bb5; margin-top: 2px; }

.badge {
    display: inline-flex; align-items: center;
    padding: 4px 10px; border-radius: 50px; font-size: 11px; font-weight: 700;
}
.badge-paye       { background: rgba(39,174,96,0.1);   color: #27ae60; }
.badge-en_attente { background: rgba(243,156,18,0.12); color: #e67e22; }
.badge-echec      { background: rgba(231,76,60,0.1);   color: #e74c3c; }
.badge-rembourse  { background: rgba(127,140,141,0.12);color: #7f8c8d; }

.empty-state { text-align: center; padding: 60px 40px; color: #8a9bb5; }
.empty-state .ei { font-size: 48px; margin-bottom: 12px; }
.empty-state p { font-size: 14px; }

.actions-top { display: flex; gap: 10px; }
.btn-edit {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 9px 18px; border-radius: 9px; font-size: 13px; font-weight: 700;
    text-decoration: none; background: #f39c12; color: #fff; border: none; transition: all 0.2s;
}
.btn-edit:hover { background: #e67e22; color: #fff; }
.btn-back {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 9px 18px; border-radius: 9px; font-size: 13px; font-weight: 700;
    text-decoration: none; background: #f0f4f8; color: #5a6e84;
    border: 1px solid #e4e9f2; transition: all 0.2s;
}
.btn-back:hover { background: #e2e8f0; color: #1e2d40; }
.btn-sm {
    padding: 6px 14px; border-radius: 7px; font-size: 12px; font-weight: 700;
    border: 1.5px solid #e4e9f2; background: #fff; color: #1a6fc4; cursor: pointer;
    font-family: 'Plus Jakarta Sans', sans-serif; transition: all 0.2s;
    text-decoration: none; display: inline-flex; align-items: center; gap: 5px;
}
.btn-sm:hover { background: #1a6fc4; color: #fff; border-color: #1a6fc4; }
</style>
{% endblock %}

{% block body %}
<div class="show-page">

    {# ── Header ── #}
    <div class="page-top">
        <div>
            <h1>{{ abonnement.nom }}</h1>
            <div class="breadcrumb-d">
                <a href="{{ path('admin_abonnement_index') }}">Abonnements</a> → Détails
            </div>
        </div>
        <div class="actions-top">
            <a href="{{ path('admin_abonnement_edit', {id: abonnement.id}) }}" class="btn-edit">
                <i class="fa fa-pencil"></i> Modifier
            </a>
            <a href="{{ path('admin_abonnement_index') }}" class="btn-back">
                <i class="fa fa-arrow-left"></i> Retour
            </a>
        </div>
    </div>

    {# ── Hero ── #}
    <div class="abo-hero">
        <div class="abo-hero-logo" style="background:{{ abonnement.tierColor|default('#1a6fc4') }};">
            {% if abonnement.logoDomain %}
            <img src="https://logo.clearbit.com/{{ abonnement.logoDomain }}"
                 alt="{{ abonnement.nom }}"
                 style="width:100%;height:100%;object-fit:contain;padding:3px;"
                 onerror="this.src='https://www.google.com/s2/favicons?domain={{ abonnement.logoDomain }}&sz=54'; this.style.width='54px'; this.style.height='54px'; this.onerror=function(){ this.style.display='none'; document.getElementById('fallback-hero-{{ abonnement.id }}').style.display='flex'; };" />
            <div id="fallback-hero-{{ abonnement.id }}" class="logo-fallback-initials" style="display:none;width:100%;height:100%;">
                {{ abonnement.nom|slice(0,2)|upper }}
            </div>
            {% else %}
            {{ abonnement.nom|slice(0,2)|upper }}
            {% endif %}
        </div>
        <div>
            <div class="abo-hero-title">{{ abonnement.nom }}</div>
            <div class="abo-hero-sub">Plan #{{ abonnement.id }} · {{ abonnement.categorie|capitalize }}</div>
            <div class="abo-hero-badges">
                <span class="abo-hero-badge">{{ abonnement.tier }}</span>
                <span class="abo-hero-badge">{{ abonnement.frequence|capitalize }}</span>
                {% if abonnement.badge %}
                    <span class="abo-hero-badge">{{ abonnement.badge }}</span>
                {% endif %}
            </div>
            <span class="hero-status {{ abonnement.actif ? 'actif' : 'inactif' }}">
                {{ abonnement.actif ? '● Actif' : '● Inactif' }}
            </span>
        </div>
        <div class="abo-hero-price">
            <div class="amount">{{ abonnement.prixEffectif|number_format(2) }} DT</div>
            <div class="freq">/ {{ abonnement.frequence }}</div>
        </div>
    </div>

    {# ── Tabs ── #}
    <div class="tabs-nav">
        <button class="tab-btn active" onclick="switchTab('details', this)">
            <i class="fa fa-info-circle"></i> Informations
        </button>
        <button class="tab-btn" onclick="switchTab('clients', this)">
            <i class="fa fa-users"></i> Souscriptions clients
            <span style="background:#1a6fc4;color:#fff;border-radius:999px;padding:1px 7px;font-size:10px;">
                {{ paiements|length }}
            </span>
        </button>
    </div>

    {# ══════════════════════════════════════════
       ONGLET 1 — Informations
    ══════════════════════════════════════════ #}
    <div class="tab-panel active" id="tab-details">

        <div class="info-card">
            <div class="info-card-header">
                <i class="fa fa-tag" style="color:#1a6fc4;"></i> Informations générales
            </div>
            <table class="info-table">
                <tr>
                    <td class="lbl">Nom</td>
                    <td class="val">{{ abonnement.nom }}</td>
                </tr>
                <tr>
                    <td class="lbl">Prix</td>
                    <td class="val">
                        <strong style="color:#1a6fc4;font-size:18px;">{{ abonnement.prix }} DT</strong>
                        {% if abonnement.prixMarche %}
                            <span style="text-decoration:line-through;color:#8a9bb5;font-size:13px;margin-left:8px;">
                                {{ abonnement.prixMarche }} DT
                            </span>
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <td class="lbl">Fréquence</td>
                    <td class="val">
                        <span style="background:rgba(26,111,196,0.1);color:#1a6fc4;padding:4px 12px;border-radius:999px;font-size:12px;">
                            {{ abonnement.frequence|capitalize }}
                        </span>
                    </td>
                </tr>
                <tr>
                    <td class="lbl">Catégorie</td>
                    <td class="val">{{ abonnement.categorie ?? '—' }}</td>
                </tr>
                <tr>
                    <td class="lbl">Niveau</td>
                    <td class="val">{{ abonnement.tierLabel }}</td>
                </tr>
                <tr>
                    <td class="lbl">Date début</td>
                    <td class="val">{{ abonnement.dateDebut ? abonnement.dateDebut|date('d/m/Y') : '—' }}</td>
                </tr>
                <tr>
                    <td class="lbl">Créé le</td>
                    <td class="val">{{ abonnement.createdAt|date('d/m/Y H:i') }}</td>
                </tr>
                {% if abonnement.description %}
                <tr>
                    <td class="lbl">Description</td>
                    <td class="val" style="color:#5a6e84;">{{ abonnement.description }}</td>
                </tr>
                {% endif %}
            </table>
        </div>

        {% if abonnement.promotionsActives|length > 0 %}
        <div class="info-card">
            <div class="info-card-header">
                <i class="fa fa-percent" style="color:#27ae60;"></i> Promotions actives
            </div>
            <table class="info-table">
                {% for promo in abonnement.promotionsActives %}
                <tr>
                    <td class="lbl">{{ promo.label }}</td>
                    <td class="val">
                        <span style="color:#27ae60;font-weight:700;">-{{ promo.valeur }}%</span>
                        {% if promo.dateFin %}
                            <span style="color:#8a9bb5;font-size:12px;margin-left:8px;">
                                jusqu'au {{ promo.dateFin|date('d/m/Y') }}
                            </span>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </table>
        </div>
        {% endif %}

    </div>

    {# ══════════════════════════════════════════
       ONGLET 2 — Souscriptions clients
    ══════════════════════════════════════════ #}
    <div class="tab-panel" id="tab-clients">

        <div class="stats-mini">
            <div class="stat-mini-box">
                <div class="stat-mini-val">{{ clientStats.abonnesActifs }}</div>
                <div class="stat-mini-lbl">Abonnés actifs</div>
            </div>
            <div class="stat-mini-box">
                <div class="stat-mini-val">{{ clientStats.revenus|number_format(2) }} DT</div>
                <div class="stat-mini-lbl">Revenus / mois</div>
            </div>
            <div class="stat-mini-box">
                <div class="stat-mini-val">{{ clientStats.expirentBientot }}</div>
                <div class="stat-mini-lbl">Expirent bientôt</div>
            </div>
            <div class="stat-mini-box">
                <div class="stat-mini-val">{{ clientStats.enAttente }}</div>
                <div class="stat-mini-lbl">En attente paiement</div>
            </div>
        </div>

        <div class="table-card">
            <div class="table-card-header">
                <span class="table-card-title">Clients abonnés</span>
                <span class="count-badge">{{ paiements|length }} entrées</span>
            </div>

            {% if paiements is empty %}
            <div class="empty-state">
                <div class="ei">👤</div>
                <p>Aucun client n'a encore souscrit à cette offre.</p>
            </div>
            {% else %}
            <table class="ctable">
                <thead>
                    <tr>
                        <th>Client</th>
                        <th>Depuis</th>
                        <th>Expire</th>
                        <th>Montant</th>
                        <th>Mode</th>
                        <th>Statut</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                {% for p in paiements %}
                {# ↓ Utilise abonnementId (camelCase) car getter = getAbonnementId() #}
                {% set nomComplet = ((p.prenomTitulaire ?? '') ~ ' ' ~ (p.nomTitulaire ?? ''))|trim %}
                {% set initiales  = ((p.prenomTitulaire ?? '')|slice(0,1) ~ (p.nomTitulaire ?? '')|slice(0,1))|upper %}
                <tr>
                    <td>
                        <div class="client-cell">
                            <div class="avatar">{{ initiales ?: '?' }}</div>
                            <div>
                                <div class="c-name">{{ nomComplet ?: 'Client inconnu' }}</div>
                                <div class="c-sub">{{ p.modePaiement ?? '—' }}</div>
                            </div>
                        </div>
                    </td>
                    <td style="font-size:12px;color:#8a9bb5;">
                        {{ p.datePaiement|date('M Y') }}
                    </td>
                    <td style="font-size:12px;color:#8a9bb5;">
                        {% if abonnement.frequence == 'annuel' %}
                            {{ p.datePaiement|date_modify('+1 year')|date('M Y') }}
                        {% else %}
                            {{ p.datePaiement|date_modify('+1 month')|date('M Y') }}
                        {% endif %}
                    </td>
                    <td style="font-weight:800;color:#1e2d40;">
                        {{ p.montant|number_format(2) }} DT
                    </td>
                    <td style="font-size:12px;color:#8a9bb5;">
                        {{ p.modePaiement ?? '—' }}
                    </td>
                    <td>
                        {% set s = p.statut %}
                        <span class="badge badge-{{ s == 'payé' ? 'paye' : (s == 'en_attente' ? 'en_attente' : (s == 'échoué' ? 'echec' : 'rembourse')) }}">
                            {{ s|capitalize }}
                        </span>
                    </td>
                    <td>
                        <a href="{{ path('admin_paiement_index') }}" class="btn-sm">
                            <i class="fa fa-eye"></i> Voir
                        </a>
                    </td>
                </tr>
                {% endfor %}
                </tbody>
            </table>
            {% endif %}
        </div>

    </div>

</div>

<script>
function switchTab(name, btn) {
    document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.getElementById('tab-' + name).classList.add('active');
    btn.classList.add('active');
}
</script>
{% endblock %}
