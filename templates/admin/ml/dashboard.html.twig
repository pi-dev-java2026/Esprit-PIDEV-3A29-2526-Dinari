}
 

// ─── PROMO TIMING ────────────────────────────────────
async function loadPromoTiming() {
    const grid = document.getElementById('promo-grid');
    if (!grid) return;
    grid.innerHTML = '<div style="grid-column:1/-1;padding:1rem;color:var(--muted);font-family:var(--font-mono);font-size:12px;">⏳ Calcul GradientBoosting depuis BDD…</div>';

    try {
        const d = await apiFetch('/promo-timing');
        if (!d.success) throw new Error(d.error);

        const srcBadge = document.getElementById('promo-source-badge');
        if (srcBadge) {
            srcBadge.textContent = d.source === 'ml' ? 'GBR ML scoring' : 'BDD fallback';
            srcBadge.className = 'alert-badge ' + (d.source === 'ml' ? 'badge-blue' : 'badge-hist');
        }

        const maxScore = Math.max(...d.timing.map(m => m.score), 1);

        function scoreColor(s) {
            return s >= 80 ? '#16a34a' : s >= 60 ? '#f59e0b' : s >= 40 ? '#e84040' : '#94a3b8';
        }

        grid.innerHTML = '';

        d.timing.forEach((month, index) => {
            const isTop  = month.score === maxScore && month.score >= 80;
            const col    = scoreColor(month.score);
            const barW   = Math.round(month.score / maxScore * 100);
            const expl   = month.explication || month.conseil || (month.nom_mois + ' - Score: ' + month.score + '/100');
            const delay  = index * 0.05;

            const wrap = document.createElement('div');
            wrap.className = 'flip-card';
            wrap.style.animationDelay = delay + 's';

            wrap.innerHTML =
                '<div class="flip-card-inner">' +

                  '<div class="flip-face flip-front' + (isTop ? ' top-month' : '') + '">' +
                    '<div class="flip-month-name">' + month.nom_mois + (isTop ? ' ★' : '') + '</div>' +
                    '<div class="flip-score-big" style="color:' + col + ';">' + month.score + '</div>' +
                    '<div class="flip-score-sub">/ 100</div>' +
                    '<div class="flip-bar-track">' +
                      '<div class="flip-bar-fill" data-w="' + barW + '" style="width:0%;background:' + col + ';"></div>' +
                    '</div>' +
                    '<div class="flip-conv-lbl">Conv : ' + Math.round(month.taux_conv * 100) + '%</div>' +
                    (isTop
                      ? '<span class="flip-top-badge">Meilleur mois</span>'
                      : '<div class="flip-hint">Survolez pour le détail</div>') +
                  '</div>' +

                  '<div class="flip-face flip-back">' +
                    '<div class="flip-back-month">' + month.nom_mois.toUpperCase() + '</div>' +
                    '<div class="flip-back-score">' + month.score + '</div>' +
                    '<div class="flip-back-label">Score d\'impact ML</div>' +
                    '<span class="flip-back-conv">' + Math.round(month.taux_conv * 100) + '% conversion</span>' +
                    '<div class="flip-back-text">' + expl + '</div>' +
                  '</div>' +

                '</div>';

            grid.appendChild(wrap);
        });

        const legend = document.createElement('div');
        legend.className = 'score-legend';
        legend.innerHTML =
            '<div class="score-legend-item"><div class="score-legend-dot" style="background:#16a34a;"></div>Excellent ≥80</div>' +
            '<div class="score-legend-item"><div class="score-legend-dot" style="background:#f59e0b;"></div>Bon 60–79</div>' +
            '<div class="score-legend-item"><div class="score-legend-dot" style="background:#e84040;"></div>Faible 40–59</div>' +
            '<div class="score-legend-item"><div class="score-legend-dot" style="background:#94a3b8;"></div>Bas &lt;40</div>';
        grid.after(legend);

        setTimeout(() => {
            document.querySelectorAll('#promo-grid .flip-bar-fill').forEach(el => {
                el.style.width = el.dataset.w + '%';
            });
        }, 350);

    } catch(e) {
        console.error('Erreur promo timing:', e);
        grid.innerHTML = '<div style="grid-column:1/-1;padding:1rem;color:#dc2626;font-family:var(--font-mono);font-size:12px;background:#fee2e2;border-radius:14px;">✗ ' + e.message + '</div>';
    }
}

// ─── TRAIN ───────────────────────────────────────────
async function trainModel() {
    const btn = document.getElementById('train-btn');
    if (!btn) return;
    btn.disabled = true;
    btn.innerHTML = '<span class="material-symbols-outlined" style="font-size:16px;animation:spin 1s linear infinite;display:inline-block;">progress_activity</span> Entraînement…';
    showToast('⏳ Entraînement RandomForest + GradientBoosting depuis BDD…', 'info', 60000);

    try {
        const resp = await fetch('{{ path("admin_ml_train") }}', {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });
        const d = await resp.json();
        if (d.success) {
            localStorage.setItem('dinari_r2',    d.r2   || 0);
            localStorage.setItem('dinari_mae',   d.mae  || 0);
            localStorage.setItem('dinari_nfeat', d.n_features || 7);
            localStorage.setItem('dinari_ntrees',d.n_trees    || 200);

            if (d.feature_importances) {
                const top = Object.entries(d.feature_importances)[0];
                if (top) {
                    localStorage.setItem('dinari_top_feat',     top[0].replace('_enc','').replace('_normalise','').replace('_norm',''));
                    localStorage.setItem('dinari_top_feat_pct', Math.round(top[1]*100));
                }
            }
            showToast('✓ Modèles entraînés (BDD) — R²=' + parseFloat(d.r2).toFixed(3) + ' · MAE=' + parseFloat(d.mae).toFixed(2) + (d.promo_model_trained ? ' · Promo ML ✓' : ''), 'success', 5000);
            setTimeout(() => location.reload(), 4000);
        } else {
            showToast('✗ ' + (d.error || 'Erreur inconnue'), 'error', 5000);
        }
    } catch(e) {
        showToast('✗ Serveur ML inaccessible — démarrez app.py sur :5000', 'error', 5000);
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<span class="material-symbols-outlined" style="font-size:16px;">auto_awesome</span> Entraîner le modèle';
    }
}

// ─── INIT ────────────────────────────────────────────
async function initDashboard() {
    showToast('⏳ Connexion à l\'API ML…', 'info', 4000);
    try {
        const health = await apiFetch('/health');
        const statusEl = document.getElementById('model-status-badge');
        if (statusEl) {
            statusEl.textContent = health.model_ready ? '● Modèle prêt' : '● Modèle non entraîné';
            statusEl.style.color = health.model_ready ? '#16a34a' : '#dc2626';
        }

        const statsResp = await apiFetch('/stats');
        if (statsResp.success) statsData = statsResp;

        if (health.model_ready) {
            const predResp = await apiFetch('/predict');
            if (predResp.success && predResp.predictions && predResp.predictions.length) {
                predictions = predResp.predictions;
                MAX_VENTES  = predictions[0].ventes_totales || 1;
                metaData    = predResp.meta || {};

                setVelocity(
                    localStorage.getItem('dinari_r2')    || 0,
                    localStorage.getItem('dinari_mae')   || 0,
                    localStorage.getItem('dinari_nfeat') || 7,
                    localStorage.getItem('dinari_ntrees')|| 200
                );

                const growEl = document.getElementById('insight-growth');
                if (growEl && metaData.croissance_pct !== undefined) {
                    growEl.textContent = (metaData.croissance_pct >= 0 ? '+' : '') + metaData.croissance_pct + '%';
                    growEl.style.color = metaData.croissance_pct >= 0 ? '#16a34a' : '#dc2626';
                }
                const featEl2 = document.getElementById('insight-feature');
                const tfName  = localStorage.getItem('dinari_top_feat')     || metaData.top_feature || 'prix';
                const tfPct   = localStorage.getItem('dinari_top_feat_pct') || metaData.top_feature_pct || '–';
                if (featEl2) featEl2.textContent = tfName + ' ' + tfPct + '%';

                fillStatCards();
                await buildCharts();
                buildSparklines();
                buildSpotlight();
                renderTable();
                showToast('✓ ' + predictions.length + ' abonnements BDD chargés · Devise : DT', 'success', 3000);
            } else {
                showNotTrainedBanner();
            }
        } else {
            fillStatCards();
            showNotTrainedBanner();
            showToast('⚠ Cliquez "Entraîner le modèle" pour générer les prédictions', 'error', 6000);
        }

    } catch(e) {
        console.error(e);
        showToast('✗ Flask API inaccessible (port 5000) — démarrez app.py', 'error', 8000);
        const statusEl = document.getElementById('model-status-badge');
        if (statusEl) { statusEl.textContent = '● API hors ligne'; statusEl.style.color = '#dc2626'; }
    }
}

function showNotTrainedBanner() {
    const banner = document.createElement('div');
    banner.style.cssText = 'background:linear-gradient(135deg,#1a1625,#2d1f4e);border-radius:20px;padding:3rem;text-align:center;margin-bottom:2rem;';
    banner.innerHTML =
        '<div style="font-size:3rem;margin-bottom:1rem;">🤖</div>' +
        '<div style="font-size:1.5rem;font-weight:800;color:white;margin-bottom:.5rem;">Modèle non entraîné</div>' +
        '<div style="color:rgba(255,255,255,.5);font-family:var(--font-mono);font-size:13px;margin-bottom:2rem;">Lance l\'entraînement pour charger les données BDD et générer les prédictions ML</div>' +
        '<button class="btn-primary" onclick="trainModel()" style="margin:0 auto;"><span class="material-symbols-outlined" style="font-size:16px;">auto_awesome</span>Entraîner maintenant</button>';
    const tbody = document.querySelector('#rankings-tbody');
    if (tbody) tbody.closest('.card').before(banner);
}

document.addEventListener('DOMContentLoaded', initDashboard);
</script>
