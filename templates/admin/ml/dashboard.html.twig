{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
// ══════════════════════════════════════════════════════
//  DINARI ML DASHBOARD
//  - Devise : DT (Dinar Tunisien)
//  - Données : 100% depuis API Flask → BDD
//  - ML : RandomForest (ventes) + GradientBoosting (promo)
// ══════════════════════════════════════════════════════
const FLASK_API = 'http://localhost:5000/api/ml';
const DEVISE    = 'DT';

let predictions   = [];
let MAX_VENTES    = 1;
let statsData     = {};
let metaData      = {};
let trendChart    = null;
let categoryChart = null;
let currentPage   = 1;
let pageSize      = 10;
let analysisLoaded = false;

// ─── HELPERS ─────────────────────────────────────────
async function apiFetch(endpoint) {
    const r = await fetch(FLASK_API + endpoint);
    if (!r.ok) throw new Error('HTTP ' + r.status);
    return r.json();
}

function fmtPrix(val) {
    const n = parseFloat(val);
    if (isNaN(n)) return '– DT';
    return n.toFixed(3) + ' ' + DEVISE;
}

function fmtPrixShort(val) {
    const n = parseFloat(val);
    if (isNaN(n)) return '– DT';
    return n.toFixed(2) + ' ' + DEVISE;
}

// ─── TAB ─────────────────────────────────────────────
function switchTab(id, btn) {
    document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.getElementById('tab-' + id).classList.add('active');
    btn.classList.add('active');
    if (id === 'analysis' && !analysisLoaded) {
        loadUnderperforming();
        loadPromoTiming();
        analysisLoaded = true;
    }
}

// ─── TOAST ───────────────────────────────────────────
function showToast(msg, type = 'info', duration = 4000) {
    const t = document.getElementById('toast');
    t.className = 'toast-' + type;
    t.innerHTML = msg;
    t.style.display = 'block'; t.style.opacity = '1';
    clearTimeout(t._timer);
    t._timer = setTimeout(() => { t.style.opacity = '0'; setTimeout(() => t.style.display = 'none', 300); }, duration);
}

// ─── COUNT-UP ────────────────────────────────────────
function countUp(el, target, duration = 1600, fmt = null) {
    if (!el || isNaN(target)) return;
    let start = null;
    (function step(ts) {
        if (!start) start = ts;
        const p = Math.min((ts - start) / duration, 1);
        const e = 1 - Math.pow(1 - p, 3);
        el.textContent = fmt ? fmt(e * target) : Math.floor(e * target);
        if (p < 1) requestAnimationFrame(step);
    })(performance.now());
}

// ─── VELOCITY ────────────────────────────────────────
function setVelocity(r2, mae, nFeat, nTrees) {
    const r2El   = document.getElementById('v-r2');
    const maeEl  = document.getElementById('v-mae');
    const featEl = document.getElementById('v-feat');
    const trEl   = document.getElementById('v-trees');
    if (r2El)   countUp(r2El,   parseFloat(r2)||0, 1600, v => v.toFixed(2));
    if (maeEl)  countUp(maeEl,  parseFloat(mae)||0, 1600, v => v.toFixed(2));
    if (featEl) countUp(featEl, parseInt(nFeat)||0, 1200);
    if (trEl)   countUp(trEl,   parseInt(nTrees)||200, 1200);
}

// ─── STAT CARDS ──────────────────────────────────────
function fillStatCards() {
    const abEl  = document.getElementById('s-abonnements');
    const vtEl  = document.getElementById('s-ventes');
    if (abEl) countUp(abEl, statsData.abonnements_actifs||0, 1200);
    if (vtEl) countUp(vtEl, statsData.total_ventes||0, 1400);

    if (predictions.length) {
        const top = predictions[0];
        const nameEl = document.getElementById('s-top-name');
        const subEl  = document.getElementById('s-top-sub');
        if (nameEl) nameEl.textContent = top.nom;
        if (subEl)  subEl.textContent  = top.ventes_totales + ' ventes prévues · ' + fmtPrixShort(top.prix);
    }
}

// ─── PROGRESS BARS ───────────────────────────────────
function animateBarsAndConf() {
    document.querySelectorAll('.progress-fill').forEach(el => {
        el.style.width = '0%';
        setTimeout(() => { el.style.transition = 'width 2s cubic-bezier(.4,0,.2,1)'; el.style.width = el.dataset.width + '%'; }, 80);
    });
    document.querySelectorAll('.confidence-value').forEach(el => {
        countUp(el, parseInt(el.dataset.value)||0, 2000, v => Math.floor(v) + '%');
    });
}

// ─── SPARKLINES ──────────────────────────────────────
function buildSparkline(id, data, color) {
    const ctx = document.getElementById(id);
    if (!ctx) return;
    new Chart(ctx.getContext('2d'), {
        type: 'line',
        data: { labels: data.map((_,i)=>i), datasets:[{ data, borderColor:color, borderWidth:2, fill:true, tension:0.4, pointRadius:0, backgroundColor:color+'18' }] },
        options: { responsive:true, animation:{duration:1200}, plugins:{legend:{display:false},tooltip:{enabled:false}}, scales:{x:{display:false},y:{display:false}} }
    });
}

function buildSparklines() {
    const totalRev = predictions.reduce((s,p) => s + parseFloat(p.prix) * p.ventes_totales, 0);
    const totalReel = predictions.reduce((s,p) => s + parseFloat(p.prix) * (p.ventes_reelles||0), 0);

    const revEl = document.getElementById('spark-rev');
    if (revEl) countUp(revEl, totalRev, 1600, v => Math.floor(v).toLocaleString('fr') + ' ' + DEVISE);

    const changeEl = document.getElementById('spk-rev-change');
    if (changeEl && totalReel > 0) {
        const pct = Math.round((totalRev - totalReel) / totalReel * 100);
        changeEl.textContent = (pct >= 0 ? '+' : '') + pct + '%';
        changeEl.className = 'spark-change ' + (pct >= 0 ? 'change-up' : 'change-down');
    }

    const cats = [...new Set(predictions.map(p => p.categorie))];
    const catEl  = document.getElementById('spark-cat-val');
    const catChg = document.getElementById('spark-cats');
    if (catEl)  catEl.textContent  = cats.length;
    if (catChg) catChg.textContent = cats.length + ' segments';

    const prixMoyen = statsData.prix_moyen || (predictions.reduce((s,p) => s+parseFloat(p.prix),0) / Math.max(predictions.length,1));
    const prixEl = document.getElementById('spark-prix');
    if (prixEl) countUp(prixEl, prixMoyen, 1400, v => v.toFixed(3) + ' ' + DEVISE);

    const avgConf = Math.round(predictions.reduce((s,p) => s + (p.confidence||0), 0) / Math.max(predictions.length,1));
    const confEl = document.getElementById('spark-conf');
    if (confEl) countUp(confEl, avgConf, 1600, v => Math.floor(v) + '%');

    const months = [1.3,1.0,1.1,0.95,0.9,1.1,1.2,1.15,1.1,1.0,1.35,1.5];
    const base   = predictions.reduce((s,p) => s+p.ventes_totales,0) / 12;
    buildSparkline('sparkRev',  months.map(m => Math.round(base*m*prixMoyen)), 'rgba(107,89,232,1)');
    buildSparkline('sparkCats', cats.map((_,i)=>i+3), '#06b6d4');
    buildSparkline('sparkPrix', predictions.slice(0,12).map(p=>parseFloat(p.prix)), '#f59e0b');
    buildSparkline('sparkConf', months.map(m=>Math.min(99,Math.round(55+m*20))), '#22c55e');
}

// ─── SPOTLIGHT TOP 3 ─────────────────────────────────
function buildSpotlight() {
    const c = document.getElementById('spotlight-grid');
    if (!c || !predictions.length) return;
    c.innerHTML = '';
    const cls   = ['gold','silver','bronze'];
    const ranks = ['🥇 1er','🥈 2ème','🥉 3ème'];
    const rankC = ['rank-gold','rank-silver','rank-bronze'];

    predictions.slice(0,3).forEach((p, i) => {
        const div = document.createElement('div');
        div.className = 'spotlight-card ' + cls[i];
        div.innerHTML =
            '<span class="spotlight-rank ' + rankC[i] + '">' + ranks[i] + '</span>' +
            '<div class="spotlight-name">' + p.nom + '</div>' +
            '<div class="spotlight-cat">' + p.categorie + ' · <strong>' + p.tier + '</strong></div>' +
            '<div class="spotlight-metrics">' +
              '<div class="metric-box"><div class="metric-label">Ventes prédites</div><div class="metric-val" style="color:var(--accent);">' + p.ventes_totales + '</div></div>' +
              '<div class="metric-box"><div class="metric-label">Ventes réelles</div><div class="metric-val" style="color:#22c55e;">' + (p.ventes_reelles||0) + '</div></div>' +
              '<div class="metric-box"><div class="metric-label">Prix BDD</div><div class="metric-val" style="color:var(--text);">' + fmtPrixShort(p.prix) + '</div></div>' +
              '<div class="metric-box"><div class="metric-label">Confiance ML</div><div class="metric-val" style="color:#f59e0b;">' + (p.confidence||0) + '%</div></div>' +
            '</div>';
        c.appendChild(div);
    });
}



// ─── TABLE PAGINATION ────────────────────────────────
function renderTable() {
    const tbody = document.getElementById('rankings-tbody');
    const info  = document.getElementById('pagination-info');
    const ctrls = document.getElementById('pagination-controls');
    if (!tbody) return;

    const total   = predictions.length;
    const pages   = Math.max(1, Math.ceil(total / pageSize));
    if (currentPage > pages) currentPage = pages;
    const s     = (currentPage - 1) * pageSize;
    const slice = predictions.slice(s, s + pageSize);

    if (info) info.textContent = 'Affichage ' + (s+1) + '–' + Math.min(s+pageSize, total) + ' sur ' + total;
    document.getElementById('tab-count-pred').textContent = total;

    tbody.innerHTML = '';
    slice.forEach((p, idx) => {
        const g    = s + idx + 1;
        const conf = p.confidence || Math.min(99, Math.round(30 + p.ventes_totales/MAX_VENTES*69));
        const sym  = g===1?'🥇':g===2?'🥈':g===3?'🥉':g;
        const rCls = g===1?'top1':g===2?'top2':g===3?'top3':'';
        const tr = document.createElement('tr');
        tr.innerHTML =
            '<td><span class="rank-num ' + rCls + '">' + sym + '</span></td>' +
            '<td><div class="td-name"><div class="sub-icon"><span class="material-symbols-outlined" style="font-size:16px;">subscriptions</span></div><span class="sub-name">' + p.nom + '</span></div></td>' +
            '<td class="td-cat">' + p.categorie + '</td>' +
            '<td><span class="tier-badge ' + (p.tier||'').toLowerCase() + '">' + p.tier + '</span></td>' +
            '<td class="td-price">' + fmtPrixShort(p.prix) + '</td>' +
            '<td class="td-ventes">' + p.ventes_totales + '</td>' +
            '<td><div class="conf-bar-wrap"><div class="conf-bar-bg"><div class="conf-bar-fill progress-fill" style="width:0%;" data-width="' + conf + '"></div></div><span class="conf-pct confidence-value" data-value="' + conf + '">0%</span></div></td>';
        tbody.appendChild(tr);
    });
    setTimeout(animateBarsAndConf, 60);

    if (ctrls) {
        ctrls.innerHTML = '';
        const prev = document.createElement('button');
        prev.className = 'page-btn'; prev.innerHTML = '‹'; prev.disabled = currentPage === 1;
        prev.onclick = () => { currentPage--; renderTable(); };
        ctrls.appendChild(prev);
        buildPageRange(currentPage, pages).forEach(item => {
            if (item === '...') {
                const s2 = document.createElement('span');
                s2.textContent = '…';
                s2.style.cssText = 'font-family:var(--font-mono);font-size:12px;color:var(--muted);padding:0 4px;';
                ctrls.appendChild(s2);
            } else {
                const b = document.createElement('button');
                b.className = 'page-btn' + (item === currentPage ? ' active' : '');
                b.textContent = item;
                b.onclick = () => { currentPage = item; renderTable(); };
                ctrls.appendChild(b);
            }
        });
        const next = document.createElement('button');
        next.className = 'page-btn'; next.innerHTML = '›'; next.disabled = currentPage === pages;
        next.onclick = () => { currentPage++; renderTable(); };
        ctrls.appendChild(next);
    }
}

function buildPageRange(cur, total) {
    if (total <= 7) return Array.from({length:total},(_,i)=>i+1);
    if (cur <= 4)   { const p=[]; for(let i=1;i<=Math.min(5,total);i++) p.push(i); if(total>5){p.push('...');p.push(total);} return p; }
    if (cur >= total-3) { const p=[1,'...']; for(let i=total-4;i<=total;i++) p.push(i); return p; }
    return [1,'...',cur-1,cur,cur+1,'...',total];
}
function changePageSize(val) { pageSize = parseInt(val); currentPage = 1; renderTable(); }

// ─── CHARTS ──────────────────────────────────────────
async function buildCharts() {
    if (!predictions.length) return;
    if (trendChart)    { trendChart.destroy();    trendChart    = null; }
    if (categoryChart) { categoryChart.destroy(); categoryChart = null; }

    const months    = ['Jan','Fév','Mar','Avr','Mai','Jun','Jul','Aoû','Sep','Oct','Nov','Déc'];
    const totalAn   = predictions.reduce((s,p) => s+p.ventes_totales, 0);
    const totalReel = predictions.reduce((s,p) => s+(p.ventes_reelles||0), 0);
    const sais      = [1.3,1.0,1.1,0.95,0.9,1.1,1.2,1.15,1.1,1.0,1.35,1.5];

    let historical = sais.map(s => Math.round((totalReel/12)*s));

    try {
        const mb = await apiFetch('/monthly-breakdown');
        if (mb.success && mb.monthly && mb.monthly.length === 12) {
            const histVals = mb.monthly.map(m => m.ventes_hist || 0);
            if (histVals.reduce((s,v)=>s+v,0) > 0) historical = histVals;
        }
    } catch(e) {}

    const predicted = sais.map(s => Math.round((totalAn/12)*s));

    const ctxTrend = document.getElementById('trendChart');
    if (ctxTrend) {
        trendChart = new Chart(ctxTrend.getContext('2d'), {
            type: 'line',
            data: {
                labels: months,
                datasets: [
                    { label:'Réel BDD', data: historical, borderColor:'#6b59e8', backgroundColor:'rgba(107,89,232,0.09)', borderWidth:2.5, fill:true, tension:0.4, pointRadius:4, pointHoverRadius:7, pointBackgroundColor:'#6b59e8', pointBorderColor:'#fff', pointBorderWidth:2 },
                    { label:'Prédit RF 2026', data: predicted.map(()=>0), borderColor:'#22c55e', backgroundColor:'rgba(34,197,94,0.07)', borderWidth:2.5, borderDash:[7,5], fill:true, tension:0.4, pointRadius:4, pointHoverRadius:7, pointBackgroundColor:'#22c55e', pointBorderColor:'#fff', pointBorderWidth:2 }
                ]
            },
            options: {
                responsive:true, maintainAspectRatio:false, animation:false,
                plugins:{ legend:{display:false}, tooltip:{ backgroundColor:'#fff', titleColor:'#1a1625', bodyColor:'#7c7a9a', borderColor:'rgba(107,89,232,.2)', borderWidth:1, padding:12, callbacks:{ label: c => c.dataset.label+' : '+c.parsed.y+' ventes' } } },
                scales:{ x:{ ticks:{color:'#7c7a9a',font:{size:11,family:'DM Mono'}}, grid:{color:'rgba(107,89,232,.06)'} }, y:{ ticks:{color:'#7c7a9a',font:{size:11,family:'DM Mono'}}, grid:{color:'rgba(107,89,232,.06)'}, beginAtZero:true } }
            }
        });
        let s2=null;
        (function anim(ts){if(!s2)s2=ts;const p=Math.min((ts-s2)/2500,1);const e=1-Math.pow(1-p,3);trendChart.data.datasets[1].data=predicted.map(v=>Math.floor(v*e));trendChart.update({duration:0});if(p<1)requestAnimationFrame(anim);})(performance.now());
    }

    const byCat   = {};
    predictions.forEach(p => { const c=p.categorie||'Autre'; byCat[c]=(byCat[c]||0)+p.ventes_totales; });
    const cats    = Object.keys(byCat);
    const catData = cats.map(c=>byCat[c]);
    const total2  = catData.reduce((s,v)=>s+v,0);
    const colors  = ['#6b59e8','#22c55e','#f59e0b','#e84040','#06b6d4','#a855f7','#ec4899','#14b8a6'];

    let bestCat = cats[0];
    cats.forEach(c => { if(byCat[c]>byCat[bestCat]) bestCat=c; });
    const bestEl = document.getElementById('best-cat');
    if (bestEl && bestCat) bestEl.textContent = bestCat;

    const ctxCat = document.getElementById('categoryChart');
    if (ctxCat && cats.length) {
        categoryChart = new Chart(ctxCat.getContext('2d'), {
            type:'doughnut',
            data:{ labels:cats, datasets:[{ data:catData.map(()=>0), backgroundColor:colors.slice(0,cats.length), borderWidth:3, borderColor:'#fff', hoverOffset:12, borderRadius:6, spacing:3 }] },
            options:{ responsive:true, maintainAspectRatio:false, cutout:'60%', animation:false, plugins:{ legend:{ position:'bottom', labels:{ color:'#7c7a9a', font:{size:11,family:'DM Mono'}, usePointStyle:true, boxWidth:9, padding:12 } }, tooltip:{ backgroundColor:'#fff', titleColor:'#1a1625', bodyColor:'#7c7a9a', borderColor:'rgba(107,89,232,.2)', borderWidth:1, padding:12, callbacks:{ label: c => c.label+' : '+c.parsed+' ventes ('+Math.round(c.parsed/total2*100)+'%)' } } } }
        });
        let s3=null;
        (function animD(ts){if(!s3)s3=ts;const p=Math.min((ts-s3)/2000,1);const e=1-Math.pow(1-p,3);categoryChart.data.datasets[0].data=catData.map(v=>Math.floor(v*e));categoryChart.update({duration:0});if(p<1)requestAnimationFrame(animD);})(performance.now());
    }
}

// ─── SIMULATION DE PROMO ──────────────────────────────
async function simulatePromo(abonnementId, discount, element) {
    const parent = element.closest('.under-card') || element.closest('.uc-body');
    let existingPanel = parent.querySelector('.simulate-panel');
    if (existingPanel) existingPanel.remove();
    
    const loadingPanel = document.createElement('div');
    loadingPanel.className = 'simulate-panel';
    loadingPanel.innerHTML = '<div style="text-align:center;padding:10px;">⏳ Calcul de la simulation...</div>';
    parent.appendChild(loadingPanel);
    
    try {
        // 🔥 NOUVELLE URL (CORRECTE) - Appel direct à Flask sur le port 5000
        const response = await fetch('http://localhost:5000/api/ml/simulate-promo', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                abonnement_id: abonnementId,
                discount: discount
            })
        });
        const data = await response.json();
        loadingPanel.remove();
        
        if (data.success) {
            const sim = data.simulation;
            const gainClass = sim.gain_ventes >= 0 ? 'gain-positive' : 'gain-negative';
            const gainCaClass = sim.gain_ca >= 0 ? 'gain-positive' : 'gain-negative';
            
            let resultHtml = `
                <div class="simulate-panel">
                    <div style="font-weight:800; margin-bottom:8px;">📊 SIMULATION PROMO</div>
                    <div class="simulate-buttons">
                        <button onclick="event.stopPropagation(); simulatePromo(${abonnementId}, 10, this)">-10%</button>
                        <button onclick="event.stopPropagation(); simulatePromo(${abonnementId}, 20, this)">-20%</button>
                        <button onclick="event.stopPropagation(); simulatePromo(${abonnementId}, 30, this)">-30%</button>
                        <button onclick="event.stopPropagation(); simulatePromo(${abonnementId}, 50, this)">-50%</button>
                    </div>
                    <div class="simulate-result">
                        <strong>💰 Réduction de ${sim.discount_percent}%</strong><br>
                        📉 Prix: ${sim.prix_original.toFixed(2)} DT → <strong style="color:#059669;">${sim.prix_promo.toFixed(2)} DT</strong><br>
                        📈 Ventes: ${sim.ventes_originales} → <strong style="color:#059669;">${sim.ventes_simulees}</strong> <span class="${gainClass}">(+${sim.gain_ventes})</span><br>
                        💰 CA: ${sim.ca_original.toFixed(2)} DT → <strong style="color:#059669;">${sim.ca_simule.toFixed(2)} DT</strong> <span class="${gainCaClass}">(${sim.gain_ca >= 0 ? '+' : ''}${sim.gain_ca.toFixed(2)} DT)</span><br>
                        📊 Taux conversion estimé: ${sim.taux_conversion_estime}%<br>
                        💡 ${sim.recommandation}
                    </div>
                </div>
            `;
            parent.insertAdjacentHTML('beforeend', resultHtml);
            
            const newPanel = parent.querySelector('.simulate-panel:last-child');
            if (newPanel) {
                newPanel.style.opacity = '0';
                newPanel.style.transform = 'translateY(-10px)';
                setTimeout(() => {
                    newPanel.style.transition = 'all 0.3s ease';
                    newPanel.style.opacity = '1';
                    newPanel.style.transform = 'translateY(0)';
                }, 10);
            }
        } else {
            showToast('Erreur simulation: ' + (data.error || 'Erreur inconnue'), 'error');
        }
    } catch(e) {
        console.error('Erreur simulation:', e);
        loadingPanel.remove();
        showToast('Erreur: Serveur ML inaccessible (port 5000)', 'error');
    }
}

function buildInlineSparkline(data, color) {
    const w = 100, h = 32;
    const mx = Math.max(...data), mn = Math.min(...data), rng = mx - mn || 1;
    const pts = data.map((v, i) => {
        const x = i / (data.length - 1) * w;
        const y = h - (v - mn) / rng * (h - 4) - 2;
        return x + ',' + y;
    }).join(' ');
    return '<svg viewBox="0 0 ' + w + ' ' + h + '" preserveAspectRatio="none" style="width:100%;height:32px;display:block;">' +
           '<polyline points="' + pts + '" fill="none" stroke="' + color + '" stroke-width="1.5" stroke-linejoin="round"/>' +
           '</svg>';
}
// ─── UNDERPERFORMING AVEC RECOMMANDATIONS PROMO ET SIMULATION ──────────
async function loadUnderperforming() {
    const cont = document.getElementById('underperforming-list');
    if (!cont) return;
    cont.innerHTML = '<div style="padding:1.5rem;color:var(--muted);font-family:var(--font-mono);font-size:12px;">⏳ Chargement depuis BDD…</div>';
 
    try {
        const d = await apiFetch('/underperforming-with-promo?seuil=65');
        if (!d.success) throw new Error(d.error);
 
        const badge = document.getElementById('under-count-badge');
        if (badge) badge.textContent = d.total + ' alertes';
 
        cont.innerHTML = '';
        if (!d.underperforming.length) {
            cont.innerHTML = '<div style="padding:2rem;color:#16a34a;font-family:var(--font-mono);font-size:13px;background:#dcfce7;border-radius:14px;">✓ Tous les abonnements atteignent le seuil ML. Aucune alerte.</div>';
            return;
        }
 
        d.underperforming.forEach(item => {
            const isCrit = item.status === 'critique';
            const pct    = Math.round(item.pct_atteint);
            const promo  = item.promo_recommendation || {};
            const cls    = isCrit ? 'crit' : 'att';
 
            // Sparkline data (réel → prédit en 6 points)
            const sparkData = [item.ventes_reelles];
            for (let i = 1; i <= 5; i++) {
                sparkData.push(Math.round(item.ventes_reelles + (item.ventes_predites - item.ventes_reelles) / 6 * i));
            }
            const sparkSvg = buildInlineSparkline(sparkData, isCrit ? '#dc2626' : '#d97706');
 
            // Insight texte
            const insight = promo.message_alerte || (isCrit
                ? `Sous-performance critique : seulement ${pct}% du potentiel ML atteint`
                : `Potentiel inexploité : ${pct}% atteint, marge de progression de ${100 - pct}%`);
 
            // Promo block
            const reduction  = promo.reduction_pct || (isCrit ? 40 : 25);
            const prixPromo  = promo.prix_promo   || (item.prix * (1 - reduction / 100));
            const objVentes  = promo.objectif_ventes || Math.max(1, Math.round(item.ventes_predites * 0.3));
            const gainEst    = promo.gain_estime   || Math.round(item.ecart * prixPromo);
            const periode    = promo.periode_recommandee || (d.best_months && d.best_months[0] ? d.best_months[0].nom_mois : 'Juin');
 
            const card = document.createElement('div');
            card.className = 'under-card ' + (isCrit ? 'crit-card' : 'att-card');
            card.innerHTML =
                '<div class="uc-stripe ' + cls + '"></div>' +
                '<div class="uc-body">' +
                  '<div class="uc-header">' +
                    '<div class="uc-left">' +
                      '<div class="uc-avatar ' + cls + '">' + (isCrit ? '📉' : '⚠️') + '</div>' +
                      '<div>' +
                        '<div class="uc-name">' + item.nom + '</div>' +
                        '<div class="uc-meta">' + item.categorie + ' · ' + item.tier + ' · ' + item.frequence + '</div>' +
                      '</div>' +
                    '</div>' +
                    '<div class="uc-right">' +
                      '<div class="uc-price ' + cls + '">' + fmtPrixShort(item.prix) + '</div>' +
                      '<span class="uc-status-badge sb-' + cls + '">' + item.status + '</span>' +
                    '</div>' +
                  '</div>' +
 
                  '<div class="uc-metrics">' +
                    '<div class="uc-metric-box"><div class="uc-metric-lbl">Ventes réelles</div><div class="uc-metric-val green">' + item.ventes_reelles + '</div></div>' +
                    '<div class="uc-metric-box"><div class="uc-metric-lbl">Prédit ML</div><div class="uc-metric-val muted">' + item.ventes_predites + '</div></div>' +
                    '<div class="uc-metric-box"><div class="uc-metric-lbl">Écart</div><div class="uc-metric-val red">−' + item.ecart + '</div></div>' +
                  '</div>' +
 
                  '<div class="uc-progress-wrap">' +
                    '<div class="uc-progress-header">' +
                      '<span class="uc-progress-label">Taux d\'atteinte du potentiel ML</span>' +
                      '<span class="uc-progress-pct ' + cls + '">' + pct + '%</span>' +
                    '</div>' +
                    '<div class="uc-progress-track">' +
                      '<div class="uc-progress-fill ' + cls + '" data-width="' + pct + '" style="width:0%;"></div>' +
                    '</div>' +
                  '</div>' +
 
                  '<div class="uc-sparkline-wrap">' +
                    '<div class="uc-sparkline-lbl">Trajectoire réelle → prédiction ML</div>' +
                    sparkSvg +
                  '</div>' +
 
