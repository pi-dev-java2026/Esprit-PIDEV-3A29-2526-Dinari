{# templates/admin/ml/dashboard.html.twig #}

{% extends 'admin/layout.html.twig' %}

{% block title %}AI Subscription Predictions — Dinari Intelligence{% endblock %}

{% block stylesheets %}
{{ parent() }}
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:wght@300;400;500&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
    --bg: #f0eff9;
    --surface: #ffffff;
    --surface2: #eae8f5;
    --border: rgba(107,89,232,0.12);
    --border-hover: rgba(107,89,232,0.4);
    --accent: #6b59e8;
    --accent-light: #ede9fe;
    --accent2: #22c55e;
    --accent3: #e84040;
    --accent4: #f59e0b;
    --accent5: #06b6d4;
    --text: #1a1625;
    --muted: #7c7a9a;
    --radius: 20px;
    --radius-sm: 12px;
    --font-display: 'Syne', sans-serif;
    --font-mono: 'DM Mono', monospace;
    --shadow: 0 4px 24px rgba(107,89,232,0.10);
    --shadow-lg: 0 12px 48px rgba(107,89,232,0.18);
}

html, body { width: 100%; min-height: 100vh; font-family: var(--font-display); background: var(--bg); color: var(--text); }
.container, .container-fluid, .container-xl, .container-xxl,
main > .row, .main-wrapper, .content-wrapper { max-width: none !important; width: 100% !important; }

.admin-main-content {
    margin-left: 280px;
    padding: 3rem 4rem;
    min-height: 100vh;
    width: calc(100% - 280px);
    max-width: none !important;
    background:
        radial-gradient(ellipse 800px 600px at 0% 0%, rgba(107,89,232,0.06) 0%, transparent 70%),
        radial-gradient(ellipse 600px 400px at 100% 100%, rgba(34,197,94,0.04) 0%, transparent 60%),
        var(--bg);
}
@media (max-width: 1024px) { .admin-main-content { margin-left: 0; padding: 2rem; width: 100%; } }
@media (max-width: 768px)  { .admin-main-content { padding: 1.25rem; } }

/* ── HEADER ── */
.page-header {
    display: grid; grid-template-columns: 1fr auto;
    align-items: center; gap: 2rem; margin-bottom: 3.5rem;
    background: var(--surface); border: 1.5px solid var(--border);
    border-radius: var(--radius); padding: 2.25rem 2.75rem;
    box-shadow: var(--shadow); position: relative; overflow: hidden;
}
.page-header::before {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 4px;
    background: linear-gradient(180deg, var(--accent), #a78bfa, #22c55e);
    border-radius: 4px 0 0 4px;
}
.page-header::after {
    content: ''; position: absolute; right: -80px; top: -80px;
    width: 280px; height: 280px;
    background: radial-gradient(circle, rgba(107,89,232,0.07) 0%, transparent 70%);
    pointer-events: none;
}
.page-title { font-size: 2.4rem; font-weight: 800; letter-spacing: -.04em; color: var(--text); display: flex; align-items: center; gap: .7rem; margin-bottom: .45rem; }
.page-title-icon { width: 48px; height: 48px; background: var(--accent-light); border-radius: 14px; display: flex; align-items: center; justify-content: center; }
.page-meta { display: flex; align-items: center; gap: 1.25rem; font-family: var(--font-mono); font-size: 12px; color: var(--muted); flex-wrap: wrap; }
.live-dot { display: inline-flex; align-items: center; gap: 7px; }
.live-dot::before { content: ''; width: 8px; height: 8px; background: #22c55e; border-radius: 50%; box-shadow: 0 0 10px #22c55e88; animation: pulse 2s infinite; }
@keyframes pulse { 0%,100%{opacity:1;transform:scale(1);} 50%{opacity:.4;transform:scale(.8);} }

.header-actions { display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; }
.btn-primary { display: inline-flex; align-items: center; gap: .5rem; background: linear-gradient(135deg, var(--accent), #8b72f5); color: white; border: none; border-radius: var(--radius-sm); padding: 14px 28px; font-family: var(--font-display); font-size: 14px; font-weight: 700; cursor: pointer; transition: all .25s; box-shadow: 0 4px 20px rgba(107,89,232,.35); white-space: nowrap; }
.btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 32px rgba(107,89,232,.5); }
.btn-primary:disabled { opacity:.6; pointer-events:none; }

/* Devise badge */
.devise-badge { background: linear-gradient(135deg,#fef3c7,#fde68a); color: #b45309; font-family: var(--font-mono); font-size: 11px; font-weight: 800; padding: 5px 14px; border-radius: 20px; letter-spacing: .06em; }

/* ── TABS ── */
.tabs-nav { display: flex; gap: 8px; background: var(--surface); border: 1.5px solid var(--border); border-radius: var(--radius); padding: 8px; margin-bottom: 3rem; width: fit-content; box-shadow: var(--shadow); }
.tab-btn { display: inline-flex; align-items: center; gap: .65rem; padding: 14px 32px; border-radius: var(--radius-sm); border: none; background: transparent; color: var(--muted); font-family: var(--font-display); font-size: 14px; font-weight: 700; cursor: pointer; transition: all .25s; white-space: nowrap; }
.tab-btn:hover { color: var(--text); background: var(--surface2); }
.tab-btn.active { background: linear-gradient(135deg, var(--accent), #8b72f5); color: white; box-shadow: 0 4px 20px rgba(107,89,232,.4); }
.tab-count { background: rgba(255,255,255,.25); font-size: 11px; font-family: var(--font-mono); padding: 3px 10px; border-radius: 20px; }
.tab-btn:not(.active) .tab-count { background: var(--surface2); color: var(--muted); }

.tab-panel { display: none; animation: fadeUp .35s ease forwards; }
.tab-panel.active { display: block; }
@keyframes fadeUp { from{opacity:0;transform:translateY(12px);} to{opacity:1;transform:translateY(0);} }


/* Animation pour l'apparition des cartes */
@keyframes fadeInScale {
    from {
        opacity: 0;
        transform: scale(0.95);
    }
    to {
        opacity: 1;
        transform: scale(1);
    }
}

.flip-card {
    animation: fadeInScale 0.4s ease forwards;
    opacity: 0;
}

/* Style supplémentaire pour le flip */
.flip-card .flip-card-inner {
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
}

.flip-card:hover .flip-card-inner {
    transform: rotateY(180deg);
}

/* ── STAT GRID ── */
.stat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.75rem; margin-bottom: 2.5rem; }
@media(max-width:1400px){.stat-grid{grid-template-columns:repeat(2,1fr);}}
@media(max-width:640px) {.stat-grid{grid-template-columns:1fr;}}

.stat-card { background: var(--surface); border: 1.5px solid var(--border); border-radius: var(--radius); padding: 2rem; box-shadow: var(--shadow); transition: all .3s; position: relative; overflow: hidden; }
.stat-card:hover { border-color: var(--border-hover); box-shadow: var(--shadow-lg); transform: translateY(-3px); }
.stat-card::after { content: ''; position: absolute; right: -30px; bottom: -30px; width: 120px; height: 120px; border-radius: 50%; opacity: .06; pointer-events: none; }
.stat-card.purple-card::after { background: var(--accent); }
.stat-card.indigo-card::after { background: #6366f1; }
.stat-card.green-card::after  { background: var(--accent2); }
.stat-card.teal-card::after   { background: var(--accent5); }

.stat-card-label-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem; }
.stat-icon { width: 52px; height: 52px; border-radius: 16px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.stat-icon.purple { background: linear-gradient(135deg, #ede9fe, #ddd6fe); }
.stat-icon.indigo  { background: linear-gradient(135deg, #e0e7ff, #c7d2fe); }
.stat-icon.green   { background: linear-gradient(135deg, #dcfce7, #bbf7d0); }
.stat-icon.teal    { background: linear-gradient(135deg, #cffafe, #a5f3fc); }

.stat-badge { font-family: var(--font-mono); font-size: 10px; font-weight: 800; padding: 5px 12px; border-radius: 20px; text-transform: uppercase; letter-spacing: .08em; }
.badge-live     { background: #dcfce7; color: #16a34a; }
.badge-hist     { background: var(--accent-light); color: var(--accent); }
.badge-trending { background: #fef3c7; color: #b45309; }
.badge-best     { background: #cffafe; color: #0891b2; }

.stat-label { font-family: var(--font-mono); font-size: 10px; color: var(--muted); text-transform: uppercase; letter-spacing: .12em; margin-bottom: .6rem; font-weight: 600; }
.stat-value { font-size: 3.2rem; font-weight: 800; letter-spacing: -.05em; line-height: 1; }
.stat-value.large-text { font-size: 1.7rem; letter-spacing: -.02em; line-height: 1.2; }
.stat-sub { font-size: 12px; color: var(--muted); margin-top: .65rem; }

/* ── VELOCITY ── */
.velocity-panel { background: linear-gradient(135deg, #1a1625 0%, #2d1f4e 100%); border-radius: var(--radius); padding: 2.5rem; margin-bottom: 2.5rem; position: relative; overflow: hidden; box-shadow: 0 16px 56px rgba(107,89,232,.25); }
.velocity-panel::before { content: ''; position: absolute; top: -60px; right: -60px; width: 300px; height: 300px; border-radius: 50%; background: radial-gradient(circle, rgba(107,89,232,.3) 0%, transparent 70%); }
.velocity-panel::after  { content: ''; position: absolute; bottom: -40px; left: 200px; width: 200px; height: 200px; border-radius: 50%; background: radial-gradient(circle, rgba(34,197,94,.15) 0%, transparent 70%); }
.velocity-title { font-size: 1.5rem; font-weight: 800; color: white; margin-bottom: .5rem; }
.velocity-sub   { font-size: 13px; color: rgba(255,255,255,.5); margin-bottom: 2rem; }
.velocity-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; position: relative; z-index: 1; }
@media(max-width:900px){.velocity-stats{grid-template-columns:repeat(2,1fr);}}
.v-stat-val { font-size: 2.5rem; font-weight: 800; font-family: var(--font-mono); line-height: 1; }
.v-stat-lbl { font-size: 11px; color: rgba(255,255,255,.5); font-family: var(--font-mono); text-transform: uppercase; letter-spacing: .1em; margin-top: .4rem; }
.v-divider  { width: 1px; background: rgba(255,255,255,.1); align-self: stretch; }

/* ── CHARTS ── */
.charts-grid { display: grid; grid-template-columns: 1.8fr 1fr; gap: 1.75rem; margin-bottom: 2.5rem; }
@media(max-width:1200px){.charts-grid{grid-template-columns:1fr;}}
.card { background: var(--surface); border: 1.5px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); transition: all .25s; }
.card:hover { border-color: var(--border-hover); box-shadow: var(--shadow-lg); }
.chart-card { padding: 2.25rem; }
.chart-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: .5rem; flex-wrap: wrap; gap: .75rem; }
.chart-title { font-size: 1.2rem; font-weight: 800; color: var(--text); }
.chart-sub   { font-size: 12px; color: var(--muted); margin-bottom: 1.75rem; }
.chart-legend { display: flex; gap: 1.5rem; flex-wrap: wrap; }
.legend-item  { display: flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 11px; color: var(--muted); }
.legend-dot   { width: 10px; height: 10px; border-radius: 50%; }
.legend-dashed-line { width: 22px; border-top: 3px dashed; }

/* ── SPOTLIGHT ── */
.spotlight-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.75rem; margin-bottom: 2.5rem; }
@media(max-width:1100px){.spotlight-grid{grid-template-columns:1fr;}}
.spotlight-card { background: var(--surface); border: 1.5px solid var(--border); border-radius: var(--radius); padding: 2rem; box-shadow: var(--shadow); transition: all .3s; position: relative; overflow: hidden; }
.spotlight-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); border-color: var(--border-hover); }
.spotlight-card.gold   { border-color: rgba(245,158,11,.35); }
.spotlight-card.gold::before   { content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,#f59e0b,#fde68a,#f59e0b); }
.spotlight-card.silver { border-color: rgba(148,163,184,.4); }
.spotlight-card.silver::before { content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,#94a3b8,#e2e8f0,#94a3b8); }
.spotlight-card.bronze { border-color: rgba(180,130,80,.3); }
.spotlight-card.bronze::before { content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,#b4844e,#f5d5a8,#b4844e); }
.spotlight-rank { font-family: var(--font-mono); font-size: 11px; font-weight: 800; padding: 5px 14px; border-radius: 20px; display: inline-flex; align-items: center; gap: 6px; margin-bottom: 1.25rem; }
.rank-gold   { background: #fef3c7; color: #b45309; }
.rank-silver { background: #f1f5f9; color: #475569; }
.rank-bronze { background: #fdf4eb; color: #b4844e; }
.spotlight-name { font-size: 1.5rem; font-weight: 800; color: var(--text); margin-bottom: .4rem; }
.spotlight-cat  { font-size: 12px; color: var(--muted); margin-bottom: 1.5rem; }
.spotlight-metrics { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
.metric-box   { background: var(--bg); border-radius: 12px; padding: 1rem; }
.metric-label { font-family: var(--font-mono); font-size: 9px; text-transform: uppercase; letter-spacing: .1em; color: var(--muted); margin-bottom: .35rem; }
.metric-val   { font-family: var(--font-mono); font-size: 1.3rem; font-weight: 800; }

/* ── TABLE ── */
.rankings-card { overflow: hidden; }
.rankings-header { display: flex; justify-content: space-between; align-items: center; padding: 1.75rem 2.25rem; border-bottom: 1.5px solid var(--border); flex-wrap: wrap; gap: 1rem; }
.rankings-title  { font-size: 1.2rem; font-weight: 800; color: var(--text); }
.refresh-btn { display: flex; align-items: center; gap: 7px; font-family: var(--font-mono); font-size: 12px; color: var(--accent); background: var(--accent-light); border: 1.5px solid rgba(107,89,232,.25); border-radius: 10px; padding: 8px 16px; cursor: pointer; transition: all .2s; font-weight: 700; }
.refresh-btn:hover { background: var(--accent); color: white; }
.table-wrapper { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; min-width: 700px; }
thead tr { background: var(--surface2); }
th { padding: 1.1rem 2rem; font-family: var(--font-mono); font-size: 10px; color: var(--muted); text-transform: uppercase; letter-spacing: .12em; text-align: left; white-space: nowrap; font-weight: 700; }
tbody tr { border-bottom: 1.5px solid var(--border); transition: background .15s; }
tbody tr:last-child { border-bottom: none; }
tbody tr:hover { background: #f7f5ff; }
td { padding: 1.2rem 2rem; font-size: 14px; }
.td-name  { display: flex; align-items: center; gap: 1rem; }
.sub-icon { width: 40px; height: 40px; background: var(--accent-light); border-radius: 12px; display: flex; align-items: center; justify-content: center; color: var(--accent); flex-shrink: 0; }
.sub-name { font-weight: 700; color: var(--text); font-size: 14px; }
.td-cat   { color: var(--muted); font-size: 13px; }
.tier-badge { display: inline-block; padding: 4px 14px; border-radius: 20px; font-family: var(--font-mono); font-size: 11px; background: var(--accent-light); color: var(--accent); font-weight: 700; }
.tier-badge.platinum { background: linear-gradient(135deg,#ede9fe,#ddd6fe); color: #7c3aed; }
.tier-badge.gold     { background: linear-gradient(135deg,#fef3c7,#fde68a); color: #b45309; }
.tier-badge.silver   { background: linear-gradient(135deg,#f1f5f9,#e2e8f0); color: #475569; }
.tier-badge.bronze   { background: linear-gradient(135deg,#fdf4eb,#f5d5a8); color: #b4844e; }
/* Prix en DT */
.td-price  { font-family: var(--font-mono); font-size: 13px; color: var(--muted); }
.td-ventes { font-family: var(--font-mono); font-weight: 800; color: #16a34a; font-size: 15px; }
.conf-bar-wrap { display: flex; align-items: center; gap: 1rem; }
.conf-bar-bg   { flex: 1; height: 7px; background: var(--surface2); border-radius: 4px; overflow: hidden; min-width: 90px; }
.conf-bar-fill { height: 100%; border-radius: 4px; background: linear-gradient(90deg, var(--accent), #a78bfa); transition: width 2s cubic-bezier(.4,0,.2,1); }
.conf-pct  { font-family: var(--font-mono); font-size: 12px; color: var(--accent); min-width: 38px; font-weight: 800; }
.rank-num  { font-family: var(--font-mono); font-size: 14px; color: var(--muted); min-width: 28px; font-weight: 700; }
.rank-num.top1 { color: #f59e0b; font-weight: 900; font-size: 16px; }
.rank-num.top2 { color: #94a3b8; font-weight: 900; }
.rank-num.top3 { color: #b4844e; font-weight: 900; }

/* ── PAGINATION ── */
.pagination-wrap { display: flex; align-items: center; justify-content: space-between; padding: 1.5rem 2rem; border-top: 1.5px solid var(--border); flex-wrap: wrap; gap: .75rem; }
.pagination-info { font-family: var(--font-mono); font-size: 12px; color: var(--muted); }
.pagination-controls { display: flex; gap: 5px; align-items: center; }
.page-btn { width: 38px; height: 38px; border-radius: 10px; border: 1.5px solid var(--border); background: var(--surface); color: var(--muted); font-family: var(--font-mono); font-size: 13px; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all .2s; }
.page-btn:hover  { border-color: var(--accent); color: var(--accent); background: var(--accent-light); }
.page-btn.active { background: var(--accent); color: white; border-color: var(--accent); }
.page-btn:disabled { opacity:.35; pointer-events:none; }
.page-size-select { font-family: var(--font-mono); font-size: 12px; color: var(--muted); background: var(--surface); border: 1.5px solid var(--border); border-radius: 10px; padding: 7px 12px; cursor: pointer; }

/* ── SECTION ANALYSE ── */
.section-divider { border: none; border-top: 1.5px solid var(--border); margin: 3.5rem 0; }
.section-heading { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: .6rem; flex-wrap: wrap; gap: 1rem; }
.section-title  { font-size: 1.75rem; font-weight: 800; color: var(--text); letter-spacing: -0.03em; }
.section-sub    { font-size: 14px; color: var(--muted); margin-bottom: 2rem; }
.alert-badge    { display: inline-flex; align-items: center; padding: 7px 18px; border-radius: 20px; font-family: var(--font-mono); font-size: 12px; font-weight: 800; }
.badge-red      { background: #fee2e2; color: #dc2626; }
.badge-blue     { background: var(--accent-light); color: var(--accent); }
.filter-chips   { display: flex; gap: 10px; margin-bottom: 2rem; flex-wrap: wrap; }
.chip           { padding: 7px 18px; border-radius: 20px; font-family: var(--font-mono); font-size: 11px; font-weight: 800; }
.chip-red       { background: #fee2e2; color: #dc2626; }
.chip-amber     { background: #fef3c7; color: var(--accent4); }

/* ── UNDER CARDS ── */
.under-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(360px, 1fr)); gap: 1.25rem; margin-bottom: 3.5rem; }
.under-card { background: var(--surface); border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); transition: all .3s; border: 1.5px solid var(--border); }
.under-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-lg); }
.under-card.crit-card { border-color: rgba(220,38,38,.2); }
.under-card.att-card  { border-color: rgba(245,158,11,.2); }
.uc-stripe      { height: 3px; width: 100%; }
.uc-stripe.crit { background: linear-gradient(90deg, #dc2626, #f87171); }
.uc-stripe.att  { background: linear-gradient(90deg, #f59e0b, #fde68a); }
.uc-body        { padding: 1.25rem 1.5rem 1.5rem; }
.uc-header      { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
.uc-left        { display: flex; align-items: center; gap: .75rem; flex: 1; min-width: 0; }
.uc-avatar      { width: 40px; height: 40px; border-radius: 12px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 18px; }
.uc-avatar.crit { background: #fee2e2; }
.uc-avatar.att  { background: #fef3c7; }
.uc-name        { font-size: 14px; font-weight: 700; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.uc-meta        { font-size: 10px; color: var(--muted); margin-top: 3px; font-family: var(--font-mono); }
.uc-right       { flex-shrink: 0; text-align: right; }
.uc-price       { font-family: var(--font-mono); font-size: 1rem; font-weight: 800; }
.uc-price.crit  { color: #dc2626; }
.uc-price.att   { color: #d97706; }
.uc-status-badge{ display: inline-block; padding: 2px 9px; border-radius: 20px; font-family: var(--font-mono); font-size: 10px; font-weight: 700; margin-top: 4px; }
.sb-crit { background: #fee2e2; color: #dc2626; }
.sb-att  { background: #fef3c7; color: #b45309; }
 
/* Métriques 3 colonnes */
.uc-metrics      { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin-bottom: 1rem; }
.uc-metric-box   { background: var(--surface2); border-radius: 10px; padding: .65rem .75rem; }
.uc-metric-lbl   { font-family: var(--font-mono); font-size: 9px; text-transform: uppercase; letter-spacing: .1em; color: var(--muted); margin-bottom: .3rem; }
.uc-metric-val   { font-family: var(--font-mono); font-size: 1.2rem; font-weight: 800; color: var(--text); }
.uc-metric-val.green { color: #16a34a; }
.uc-metric-val.red   { color: #dc2626; }
.uc-metric-val.muted { color: var(--muted); }
 
/* Gauge */
.uc-progress-wrap    { margin-bottom: 1rem; }
.uc-progress-header  { display: flex; justify-content: space-between; align-items: center; margin-bottom: .45rem; }
.uc-progress-label   { font-family: var(--font-mono); font-size: 10px; color: var(--muted); font-weight: 600; }
.uc-progress-pct     { font-family: var(--font-mono); font-size: 1.1rem; font-weight: 800; }
.uc-progress-pct.crit{ color: #dc2626; }
.uc-progress-pct.att { color: #d97706; }
.uc-progress-track   { height: 8px; background: var(--surface2); border-radius: 4px; overflow: hidden; }
.uc-progress-fill    { height: 100%; border-radius: 4px; transition: width 1.5s cubic-bezier(.4,0,.2,1); }
.uc-progress-fill.crit { background: linear-gradient(90deg, #dc2626, #f87171); }
.uc-progress-fill.att  { background: linear-gradient(90deg, #f59e0b, #fde68a); }
 
/* Sparkline inline */
.uc-sparkline-wrap { margin-bottom: .85rem; }
.uc-sparkline-lbl  { font-family: var(--font-mono); font-size: 9px; color: var(--muted); text-transform: uppercase; letter-spacing: .08em; margin-bottom: .3rem; }
 
/* Insight ML */
.uc-insight { display: flex; align-items: flex-start; gap: .5rem; background: var(--surface2); border-radius: 10px; padding: .7rem .85rem; margin-bottom: 1rem; font-size: 12px; color: var(--muted); line-height: 1.5; border-left: 3px solid var(--accent); }
.uc-insight-icon { flex-shrink: 0; margin-top: 1px; font-size: 14px; }
 
/* Promo block redesigné */
.uc-promo-block { border: 1.5px solid rgba(245,158,11,.25); border-radius: 12px; padding: .85rem 1rem; margin-bottom: 1rem; background: rgba(254,243,199,.35); }
.uc-promo-header { display: flex; align-items: center; gap: .4rem; margin-bottom: .6rem; }
.uc-promo-title  { font-family: var(--font-mono); font-size: 11px; font-weight: 800; color: #b45309; text-transform: uppercase; letter-spacing: .06em; }
.uc-promo-grid   { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; margin-bottom: .5rem; }
.uc-promo-item   { text-align: center; background: rgba(255,255,255,.6); border-radius: 8px; padding: .4rem .3rem; }
.uc-promo-item-lbl { font-family: var(--font-mono); font-size: 8px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin-bottom: 2px; }
.uc-promo-item-val { font-family: var(--font-mono); font-size: 12px; font-weight: 800; color: var(--text); }
.uc-promo-period { font-family: var(--font-mono); font-size: 10px; color: #b45309; }
 
.uc-footer  { display: flex; justify-content: flex-end; gap: 8px; flex-wrap: wrap; }
.btn-analyse { display: inline-flex; align-items: center; gap: .4rem; background: var(--accent-light); color: var(--accent); border: 1.5px solid rgba(107,89,232,.25); border-radius: 10px; padding: 7px 16px; font-family: var(--font-mono); font-size: 11px; font-weight: 700; cursor: pointer; transition: all .2s; }
.btn-analyse:hover { background: var(--accent); color: white; }
.btn-simulate { display: inline-flex; align-items: center; gap: .4rem; background: linear-gradient(135deg, #f59e0b, #d97706); color: white; border: none; border-radius: 10px; padding: 7px 16px; font-family: var(--font-mono); font-size: 11px; font-weight: 700; cursor: pointer; transition: all .2s; }
.btn-simulate:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(245,158,11,0.4); }
 
/* Style pour la simulation promo */
.simulate-panel { background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%); border-radius: 10px; padding: .85rem; margin: .75rem 0; border-left: 3px solid #f59e0b; }
.simulate-buttons { display: flex; gap: 6px; margin: 8px 0; flex-wrap: wrap; }
.simulate-buttons button { background: rgba(255,255,255,.8); border: 1px solid #fde68a; padding: 4px 10px; border-radius: 7px; font-size: 11px; font-weight: 700; cursor: pointer; transition: all .2s; font-family: var(--font-mono); }
.simulate-buttons button:hover { background: #f59e0b; color: white; border-color: #f59e0b; }
.simulate-result { font-size: 11px; margin-top: 8px; padding: 8px 10px; background: rgba(255,255,255,.7); border-radius: 8px; line-height: 1.6; }
.simulate-result strong { color: #b45309; }
.simulate-result .gain-positive { color: #16a34a; font-weight: 800; }
.simulate-result .gain-negative { color: #dc2626; font-weight: 800; }
 
/* ── PROMO GRID ── */
.promo-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 1.25rem; }
@media(max-width:1200px){ .promo-grid { grid-template-columns: repeat(3, 1fr); } }
@media(max-width:800px)  { .promo-grid { grid-template-columns: repeat(2, 1fr); } }
@media(max-width:500px)  { .promo-grid { grid-template-columns: 1fr; } }
 
/* Flip cards */
.flip-card { perspective: 900px; height: 200px; }
@keyframes fadeInScale { from { opacity: 0; transform: scale(0.95); } to { opacity: 1; transform: scale(1); } }
.flip-card { animation: fadeInScale 0.4s ease forwards; opacity: 0; }
.flip-card-inner { position: relative; width: 100%; height: 100%; transition: transform .55s cubic-bezier(.4,0,.2,1); transform-style: preserve-3d; }
.flip-card:hover .flip-card-inner { transform: rotateY(180deg); }
 
.flip-face { position: absolute; inset: 0; backface-visibility: hidden; border-radius: var(--radius); padding: 1.1rem; display: flex; flex-direction: column; }
 
/* FRONT */
.flip-front { background: var(--surface); border: 1.5px solid var(--border); }
.flip-front.top-month { border: 2px solid #f59e0b; background: linear-gradient(135deg, #fffbeb, #fef3c7); }
.flip-month-name { font-family: var(--font-mono); font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: .1em; color: var(--muted); margin-bottom: .4rem; }
.flip-score-big  { font-family: var(--font-mono); font-size: 2.2rem; font-weight: 800; line-height: 1; }
.flip-score-sub  { font-size: 10px; color: var(--muted); margin-bottom: .5rem; }
.flip-bar-track  { height: 5px; background: var(--surface2); border-radius: 3px; overflow: hidden; margin-bottom: .4rem; }
.flip-bar-fill   { height: 100%; border-radius: 3px; width: 0%; transition: width 1.2s ease; }
.flip-conv-lbl   { font-family: var(--font-mono); font-size: 10px; color: var(--muted); }
.flip-top-badge  { display: inline-flex; align-items: center; gap: 4px; background: #fef3c7; color: #b45309; font-family: var(--font-mono); font-size: 9px; font-weight: 800; padding: 2px 8px; border-radius: 20px; margin-top: auto; width: fit-content; }
.flip-hint       { font-size: 10px; color: var(--muted); margin-top: auto; text-align: center; opacity: .7; }
 
/* BACK */
.flip-back { background: linear-gradient(135deg, var(--accent), #8b72f5); border: none; transform: rotateY(180deg); color: white; }
.flip-back-month { font-family: var(--font-mono); font-size: 10px; font-weight: 800; letter-spacing: .1em; color: rgba(255,255,255,.6); margin-bottom: .2rem; }
.flip-back-score { font-family: var(--font-mono); font-size: 2rem; font-weight: 800; line-height: 1; }
.flip-back-label { font-size: 10px; color: rgba(255,255,255,.6); margin-bottom: .5rem; }
.flip-back-conv  { display: inline-block; background: rgba(255,255,255,.2); border-radius: 20px; padding: 2px 10px; font-family: var(--font-mono); font-size: 10px; color: #fff; margin-bottom: .6rem; }
.flip-back-text  { font-size: 11px; color: rgba(255,255,255,.9); line-height: 1.5; flex: 1; }
 
.score-legend { display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap; margin-top: .75rem; margin-bottom: 1rem; }
.score-legend-item { display: flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 11px; color: var(--muted); }
.score-legend-dot  { width: 9px; height: 9px; border-radius: 50%; }
 
.score-expl {
    background: #f5f3ff;
    border: 1px solid rgba(107,89,232,.15);
    border-left: 4px solid var(--accent);
    border-radius: 16px;
    padding: 1rem 1.25rem;
    margin-top: 1rem;
}
.score-expl-title { font-size: 13px; font-weight: 800; color: var(--accent); margin-bottom: .25rem; }
.score-expl p { font-size: 12px; color: var(--muted); line-height: 1.5; }
 

/* ── INSIGHTS ── */
.insights-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-bottom: 3.5rem; }
@media(max-width:1000px){.insights-grid{grid-template-columns:1fr;}}
.insight-card  { background: var(--surface); border: 1.5px solid var(--border); border-radius: var(--radius); padding: 2rem; box-shadow: var(--shadow); transition: all .25s; }
.insight-card:hover { border-color: var(--border-hover); transform: translateY(-2px); }
.insight-icon-row { display: flex; align-items: center; gap: .85rem; margin-bottom: 1.25rem; }
.insight-icon  { width: 44px; height: 44px; border-radius: 14px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.insight-label { font-size: 13px; font-weight: 800; color: var(--text); }
.insight-sub   { font-size: 11px; color: var(--muted); margin-top: 2px; }
.insight-body  { font-size: 13px; color: var(--muted); line-height: 1.6; }
.insight-metric{ font-family: var(--font-mono); font-size: 2rem; font-weight: 800; margin-top: .75rem; }

/* ── SPARKLINES ── */
.sparkline-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; margin-bottom: 2.5rem; }
@media(max-width:1200px){.sparkline-grid{grid-template-columns:repeat(2,1fr);}}
@media(max-width:640px) {.sparkline-grid{grid-template-columns:1fr;}}
.spark-card    { background: var(--surface); border: 1.5px solid var(--border); border-radius: var(--radius); padding: 1.75rem 2rem; box-shadow: var(--shadow); transition: all .25s; }
.spark-card:hover { border-color: var(--border-hover); transform: translateY(-2px); }
.spark-top     { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: .75rem; }
.spark-title   { font-size: 13px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: .06em; }
.spark-change  { font-family: var(--font-mono); font-size: 11px; font-weight: 800; padding: 3px 9px; border-radius: 20px; }
.change-up     { background: #dcfce7; color: #16a34a; }
.change-down   { background: #fee2e2; color: #dc2626; }
.change-flat   { background: var(--surface2); color: var(--muted); }
.spark-val     { font-size: 2.1rem; font-weight: 800; letter-spacing: -.04em; margin-bottom: .5rem; }
.spark-sub     { font-size: 11px; color: var(--muted); font-family: var(--font-mono); }

/* ── TOAST ── */
#toast { position: fixed; bottom: 1.75rem; right: 1.75rem; z-index: 9999; padding: .9rem 1.5rem; border-radius: 14px; font-size: 13px; font-weight: 600; box-shadow: 0 12px 40px rgba(0,0,0,.2); display: none; max-width: 400px; transition: opacity .3s, transform .3s; font-family: var(--font-display); }
.toast-success { background: #16a34a; color: white; }
.toast-error   { background: #dc2626; color: white; }
.toast-info    { background: var(--accent); color: white; }

.material-symbols-outlined { font-variation-settings: 'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24; }
::-webkit-scrollbar { width: 6px; height: 6px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: rgba(107,89,232,.2); border-radius: 3px; }
canvas { max-height: 100%; width: 100% !important; }
@keyframes spin { to{ transform:rotate(360deg); } }
.empty-state { text-align: center; padding: 5rem 2rem; }
.empty-state p { color: var(--muted); margin-bottom: 1.25rem; }
</style>
{% endblock %}

{% block body %}
<div class="admin-main-content">

    <!-- ── PAGE HEADER ── -->
    <div class="page-header">
        <div>
            <h1 class="page-title">
                <div class="page-title-icon">
                    <span class="material-symbols-outlined" style="color:var(--accent);font-size:26px;">auto_awesome</span>
                </div>
                AI Subscription Predictions
            </h1>
            <div class="page-meta">
                <span class="live-dot">Live Inference Active</span>
                <span style="color:var(--border);">|</span>
                <span>Mise à jour : {{ "now"|date('H:i:s') }}</span>
                <span style="color:var(--border);">|</span>
                <span id="model-status-badge" style="font-weight:800;">● Vérification…</span>
                <span style="color:var(--border);">|</span>
                <span class="devise-badge">💵 Devise : DT</span>
            </div>
        </div>
        <div class="header-actions">
            <button class="btn-primary" id="train-btn" onclick="trainModel()">
                <span class="material-symbols-outlined" style="font-size:16px;">auto_awesome</span>
                Entraîner le modèle
            </button>
        </div>
    </div>

    <!-- ── TABS ── -->
    <div class="tabs-nav">
        <button class="tab-btn active" onclick="switchTab('predictions', this)">
            <span class="material-symbols-outlined" style="font-size:16px;">bar_chart</span>
            Prédictions 2026
            <span class="tab-count" id="tab-count-pred">–</span>
        </button>
        <button class="tab-btn" onclick="switchTab('analysis', this)">
            <span class="material-symbols-outlined" style="font-size:16px;">analytics</span>
            Analyse avancée
            <span class="tab-count">ML</span>
        </button>
    </div>

    <!-- ══════════════════════════════════════════════ -->
    <!--  TAB 1 — PRÉDICTIONS 2026                     -->
    <!-- ══════════════════════════════════════════════ -->
    <div id="tab-predictions" class="tab-panel active">

        <div style="display:flex;align-items:center;gap:.85rem;margin-bottom:2rem;">
            <h2 style="font-size:1.75rem;font-weight:800;color:var(--text);letter-spacing:-0.03em;">📊 Prédictions 2026</h2>
            <span style="background:var(--accent-light);color:var(--accent);font-family:var(--font-mono);font-size:11px;font-weight:800;padding:5px 14px;border-radius:20px;letter-spacing:.06em;">RandomForest</span>
            <span class="devise-badge">Prix en DT</span>
        </div>

        <!-- Stat Cards -->
        <div class="stat-grid">
            <div class="stat-card purple-card">
                <div class="stat-card-label-row">
                    <div class="stat-icon purple"><span class="material-symbols-outlined" style="color:var(--accent);font-size:24px;">analytics</span></div>
                    <span class="stat-badge badge-live">BDD Live</span>
                </div>
                <div class="stat-label">Abonnements BDD</div>
                <div class="stat-value count-up" id="s-abonnements" data-target="0" style="color:var(--accent);">–</div>
                <div class="stat-sub">Actifs en base de données</div>
            </div>
            <div class="stat-card indigo-card">
                <div class="stat-card-label-row">
                    <div class="stat-icon indigo"><span class="material-symbols-outlined" style="color:#6366f1;font-size:24px;">database</span></div>
                    <span class="stat-badge badge-hist">Historique</span>
                </div>
                <div class="stat-label">Ventes réelles BDD</div>
                <div class="stat-value count-up" id="s-ventes" data-target="0" style="color:var(--text);">–</div>
                <div class="stat-sub">Données réelles d'entraînement</div>
            </div>
            <div class="stat-card green-card" style="border-color:rgba(34,197,94,.25);">
                <div class="stat-card-label-row">
                    <div class="stat-icon green"><span class="material-symbols-outlined" style="color:#16a34a;font-size:24px;">emoji_events</span></div>
                    <span class="stat-badge badge-trending">N°1</span>
                </div>
                <div class="stat-label">Meilleur prédit</div>
                <div class="stat-value large-text" id="s-top-name" style="color:var(--text);font-weight:800;">–</div>
                <div class="stat-sub" id="s-top-sub">chargement…</div>
            </div>
            <div class="stat-card teal-card">
                <div class="stat-card-label-row">
                    <div class="stat-icon teal"><span class="material-symbols-outlined" style="color:#0891b2;font-size:24px;">category</span></div>
                    <span class="stat-badge badge-best">Best</span>
                </div>
                <div class="stat-label">Meilleure catégorie</div>
                <div class="stat-value large-text" id="best-cat" style="color:var(--text);font-weight:800;">–</div>
                <div class="stat-sub">Par volume total prédit</div>
            </div>
        </div>

        <!-- Velocity Panel -->
        <div class="velocity-panel">
            <div style="position:relative;z-index:1;">
                <div class="velocity-title">⚡ Pulse du modèle ML — RandomForest</div>
                <div class="velocity-sub">Métriques depuis l'entraînement sur données BDD réelles</div>
                <div class="velocity-stats">
                    <div class="v-stat"><div class="v-stat-val" style="color:#a78bfa;" id="v-r2">–</div><div class="v-stat-lbl">Score R²</div></div>
                    <div class="v-divider"></div>
                    <div class="v-stat"><div class="v-stat-val" style="color:#34d399;" id="v-mae">–</div><div class="v-stat-lbl">MAE (ventes)</div></div>
                    <div class="v-divider"></div>
                    <div class="v-stat"><div class="v-stat-val" style="color:#f59e0b;" id="v-feat">–</div><div class="v-stat-lbl">Features actives</div></div>
                    <div class="v-divider"></div>
                    <div class="v-stat"><div class="v-stat-val" style="color:#f87171;" id="v-trees">200</div><div class="v-stat-lbl">Arbres RF</div></div>
                </div>
            </div>
        </div>

        <!-- Sparklines -->
        <div class="sparkline-grid">
            <div class="spark-card">
                <div class="spark-top"><span class="spark-title">Revenue prédit (DT)</span><span class="spark-change change-up" id="spk-rev-change">+–%</span></div>
                <div class="spark-val" style="color:var(--accent);" id="spark-rev">– DT</div>
                <div class="spark-sub">Chiffre annuel estimé 2026</div>
                <canvas id="sparkRev" height="40" style="margin-top:.75rem;"></canvas>
            </div>
            <div class="spark-card">
                <div class="spark-top"><span class="spark-title">Catégories actives</span><span class="spark-change change-flat" id="spark-cats">–</span></div>
                <div class="spark-val" style="color:var(--accent5);" id="spark-cat-val">0</div>
                <div class="spark-sub">Segments BDD analysés</div>
                <canvas id="sparkCats" height="40" style="margin-top:.75rem;"></canvas>
            </div>
            <div class="spark-card">
                <div class="spark-top"><span class="spark-title">Prix moyen BDD</span><span class="spark-change change-flat">DT</span></div>
                <div class="spark-val" style="color:#f59e0b;" id="spark-prix">– DT</div>
                <div class="spark-sub">Prix unitaire moyen (BDD réel)</div>
                <canvas id="sparkPrix" height="40" style="margin-top:.75rem;"></canvas>
            </div>
            <div class="spark-card">
                <div class="spark-top"><span class="spark-title">Confiance moyenne</span><span class="spark-change change-up">ML</span></div>
                <div class="spark-val" style="color:#22c55e;" id="spark-conf">0%</div>
                <div class="spark-sub">Score de confiance RF</div>
                <canvas id="sparkConf" height="40" style="margin-top:.75rem;"></canvas>
            </div>
        </div>

        <!-- Charts -->
        <div class="charts-grid">
            <div class="card chart-card">
                <div class="chart-top">
                    <div>
                        <div class="chart-title">Trajectoire Ventes BDD → 2026</div>
                        <div class="chart-sub">Ventes réelles BDD vs prédictions RandomForest</div>
                    </div>
                    <div class="chart-legend">
                        <div class="legend-item"><div class="legend-dot" style="background:var(--accent);"></div>Réel BDD</div>
                        <div class="legend-item"><div class="legend-dashed-line" style="border-color:#22c55e;"></div>Prédit RF 2026</div>
                    </div>
                </div>
                <div style="height:340px;position:relative;"><canvas id="trendChart"></canvas></div>
            </div>
            <div class="card chart-card">
                <div class="chart-title">Répartition par catégorie</div>
                <div class="chart-sub">Ventes prédites par catégorie BDD</div>
                <div style="height:310px;position:relative;margin-top:.5rem;"><canvas id="categoryChart"></canvas></div>
            </div>
        </div>

        <!-- Spotlight Top 3 -->
        <div style="display:flex;align-items:center;gap:.85rem;margin-bottom:1.75rem;margin-top:.5rem;">
            <h3 style="font-size:1.35rem;font-weight:800;color:var(--text);">🥇 Top 3 Abonnements — données BDD</h3>
            <span class="devise-badge">Prix DT</span>
        </div>
        <div class="spotlight-grid" id="spotlight-grid"></div>

        <!-- Table -->
        <div class="card rankings-card">
            <div class="rankings-header">
                <div>
                    <span class="rankings-title">🏆 Classement complet — RandomForest</span>
                    <div style="font-size:12px;color:var(--muted);margin-top:4px;font-family:var(--font-mono);">Données réelles BDD · Prix en DT</div>
                </div>
                <button class="refresh-btn" onclick="trainModel()">
                    <span class="material-symbols-outlined" style="font-size:14px;">refresh</span>Refresh BDD
                </button>
            </div>
            <div class="table-wrapper">
                <table id="rankings-table">
                    <thead>
                        <tr>
                            <th>#</th><th>Abonnement</th><th>Catégorie</th><th>Tier</th>
                            <th>Prix (DT)</th><th>Ventes prédites</th><th>Confiance ML</th>
                        </tr>
                    </thead>
                    <tbody id="rankings-tbody">
                        <tr><td colspan="7" style="text-align:center;padding:2rem;color:var(--muted);font-family:var(--font-mono);">Chargement depuis la BDD…</td></tr>
                    </tbody>
                </table>
            </div>
            <div class="pagination-wrap">
                <div class="pagination-info" id="pagination-info"></div>
                <div style="display:flex;align-items:center;gap:.75rem;flex-wrap:wrap;">
                    <div style="display:flex;align-items:center;gap:.5rem;">
                        <span style="font-family:var(--font-mono);font-size:11px;color:var(--muted);">Lignes :</span>
                        <select class="page-size-select" id="page-size-select" onchange="changePageSize(this.value)">
                            <option value="5">5</option><option value="10" selected>10</option>
                            <option value="20">20</option><option value="50">50</option>
                        </select>
                    </div>
                    <div class="pagination-controls" id="pagination-controls"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- ══════════════════════════════════════════════ -->
    <!--  TAB 2 — ANALYSE AVANCÉE                      -->
    <!-- ══════════════════════════════════════════════ -->
    <div id="tab-analysis" class="tab-panel">

        <!-- SECTION 1 : SOUS-PERFORMANTS AVEC SIMULATION PROMO -->
        <div class="section-heading">
            <div>
                <div class="section-title">⚠ Abonnements sous-performants</div>
                <div class="section-sub">Ventes BDD en dessous du potentiel ML · Prix en DT</div>
            </div>
            <span class="alert-badge badge-red" id="under-count-badge">– alertes</span>
