                    '<span class="uc-insight-icon">💡</span>' +
                    insight +
                  '</div>' +
 
                  '<div class="uc-promo-block">' +
                    '<div class="uc-promo-header">' +
                      '<span style="font-size:14px;">🏷️</span>' +
                      '<span class="uc-promo-title">Recommandation promo ML</span>' +
                    '</div>' +
                    '<div class="uc-promo-grid">' +
                      '<div class="uc-promo-item"><div class="uc-promo-item-lbl">Réduction</div><div class="uc-promo-item-val">-' + reduction + '%</div></div>' +
                      '<div class="uc-promo-item"><div class="uc-promo-item-lbl">Prix promo</div><div class="uc-promo-item-val">' + parseFloat(prixPromo).toFixed(2) + ' DT</div></div>' +
                      '<div class="uc-promo-item"><div class="uc-promo-item-lbl">Objectif</div><div class="uc-promo-item-val">' + objVentes + '</div></div>' +
                      '<div class="uc-promo-item"><div class="uc-promo-item-lbl">Gain estimé</div><div class="uc-promo-item-val">' + parseFloat(gainEst).toFixed(2) + '</div></div>' +
                    '</div>' +
