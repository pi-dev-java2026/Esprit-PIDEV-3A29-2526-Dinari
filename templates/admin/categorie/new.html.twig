{% extends 'admin/layout.html.twig' %}
{% block title %}Nouvelle catégorie — Admin{% endblock %}
{% block topbar_title %}Catégories{% endblock %}
{% block topbar_sub %}Ajouter une nouvelle catégorie{% endblock %}

{% block stylesheets %}
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style>
.main-content, .main-content * { font-family: 'Poppins', sans-serif; }

.ph-wrap {
    display: flex; align-items: flex-start; justify-content: space-between;
    margin-bottom: 28px; flex-wrap: wrap; gap: 14px;
}
.ph-left h1 {
    font-size: 22px; font-weight: 700; color: #1e293b; margin: 0 0 4px;
    display: flex; align-items: center; gap: 10px;
}
.ph-left h1 .ph-icon {
    width: 38px; height: 38px; border-radius: 10px;
    background: linear-gradient(135deg, #1a6fc4, #2563eb);
    display: flex; align-items: center; justify-content: center;
    color: #fff; font-size: 17px; flex-shrink: 0;
    box-shadow: 0 4px 12px rgba(26,111,196,0.35);
}
.ph-breadcrumb { font-size: 12px; color: #94a3b8; }
.ph-breadcrumb a { color: #1a6fc4; text-decoration: none; font-weight: 500; }

/* Glass form card */
.glass-form-card {
    background: rgba(255,255,255,0.9);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255,255,255,0.7);
    border-radius: 16px;
    box-shadow: 0 4px 24px rgba(30,41,59,0.08);
    overflow: hidden;
    max-width: 560px;
    animation: fadeInUp 0.35s ease both;
}
.gfc-header {
    padding: 20px 28px 18px;
    background: linear-gradient(135deg, rgba(26,111,196,0.05) 0%, rgba(37,99,235,0.02) 100%);
    border-bottom: 1px solid rgba(226,232,240,0.8);
    display: flex; align-items: center; gap: 10px;
}
.gfc-header-icon {
    width: 36px; height: 36px; border-radius: 9px;
    background: linear-gradient(135deg, #1a6fc4, #2563eb);
    display: flex; align-items: center; justify-content: center;
    color: #fff; font-size: 16px;
    box-shadow: 0 3px 10px rgba(26,111,196,0.3);
}
.gfc-header-title { font-size: 15px; font-weight: 700; color: #1e293b; }
.gfc-header-sub { font-size: 12px; color: #94a3b8; margin-top: 1px; }

.gfc-body { padding: 28px; }

/* Form fields */
.fg-p { margin-bottom: 22px; }
.fg-p label {
    display: block; font-size: 12px; font-weight: 600;
    color: #475569; margin-bottom: 7px; letter-spacing: 0.3px;
    text-transform: uppercase;
}
.fg-p .fc-p {
    width: 100%; padding: 11px 15px;
    border: 1.5px solid #e2e8f0; border-radius: 10px;
    font-size: 14px; font-family: 'Poppins', sans-serif;
    color: #1e293b; background: #fff;
    transition: border-color 0.2s, box-shadow 0.2s;
    outline: none;
}
.fg-p .fc-p:focus {
    border-color: #1a6fc4;
    box-shadow: 0 0 0 3px rgba(26,111,196,0.12);
}

/* Form actions */
.form-actions-p {
    display: flex; gap: 10px; justify-content: flex-end;
    padding-top: 20px; border-top: 1px solid #f1f5f9;
    margin-top: 8px;
}
.btn-premium {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 10px 22px;
    background: linear-gradient(135deg, #1a6fc4 0%, #2563eb 100%);
    color: #fff; border-radius: 10px; font-size: 13px; font-weight: 600;
    border: none; cursor: pointer;
    box-shadow: 0 4px 14px rgba(26,111,196,0.35);
    transition: all 0.25s ease; font-family: 'Poppins', sans-serif;
}
.btn-premium:hover {
    background: linear-gradient(135deg, #1558a0 0%, #1d4ed8 100%);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(26,111,196,0.45);
}
.btn-cancel-p {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 10px 18px; border-radius: 10px;
    background: #f8fafc; color: #64748b;
    border: 1.5px solid #e2e8f0; font-size: 13px; font-weight: 600;
    text-decoration: none; transition: all 0.2s; font-family: 'Poppins', sans-serif;
}
.btn-cancel-p:hover {
    background: #f1f5f9; color: #334155; text-decoration: none;
    border-color: #cbd5e1;
}
.btn-back-dep {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 10px 18px; border-radius: 10px;
    background: #f8fafc; color: #1a6fc4;
    border: 1.5px solid rgba(26,111,196,0.3);
    font-size: 13px; font-weight: 600;
    text-decoration: none; transition: all 0.22s ease;
    font-family: 'Poppins', sans-serif;
}
.btn-back-dep:hover {
    background: linear-gradient(135deg, #1a6fc4 0%, #2563eb 100%);
    color: #fff; border-color: transparent;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(26,111,196,0.35);
    text-decoration: none;
}
.btn-back-dep i { font-size: 14px; }

@keyframes fadeInUp {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
}
</style>
{% endblock %}

{% block body %}

<div class="ph-wrap">
    <div class="ph-left">
        <h1>
            <span class="ph-icon"><i class="ri-price-tag-3-line"></i></span>
            Nouvelle catégorie
        </h1>
        <div class="ph-breadcrumb">
            <a href="{{ path('admin_index') }}">Dashboard</a>
            <span style="margin:0 5px;color:#cbd5e1;">›</span>
            <a href="{{ path('admin_depenses_dashboard') }}">Dépenses</a>
            <span style="margin:0 5px;color:#cbd5e1;">›</span>
            <a href="{{ path('admin_categorie_index') }}">Catégories</a>
            <span style="margin:0 5px;color:#cbd5e1;">›</span>
            Nouvelle
        </div>
    </div>
    <a href="{{ path('admin_depenses_dashboard') }}" class="btn-back-dep">
        <i class="ri-arrow-left-line"></i> Retour aux Dépenses
    </a>
</div>

<div class="glass-form-card">
    <div class="gfc-header">
        <div class="gfc-header-icon"><i class="ri-add-line"></i></div>
        <div>
            <div class="gfc-header-title">Créer une catégorie</div>
            <div class="gfc-header-sub">Renseignez le nom de la nouvelle catégorie</div>
        </div>
    </div>
    <div class="gfc-body">
        {{ include('admin/categorie/_form.html.twig', {
            form: form,
            button_label: 'Créer la catégorie'
        }) }}
    </div>
</div>

{% endblock %}
