{% extends 'admin/layout.html.twig' %}
{% block title %}Admin — Catégories{% endblock %}

{% block stylesheets %}
<style>
.admin-wrapper { max-width: 900px; margin: 0 auto; padding: 100px 30px 60px; }

.admin-header {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 32px; flex-wrap: wrap; gap: 16px;
}
.admin-title { font-family: 'Syne', sans-serif; font-size: 26px; font-weight: 700; color: var(--d-text); }
.admin-title span { color: var(--d-blue); }
.admin-badge {
    font-size: 11px; font-weight: 700; letter-spacing: 2px;
    text-transform: uppercase; background: rgba(26,111,196,0.1);
    color: var(--d-blue); padding: 4px 12px; border-radius: 20px;
    margin-left: 10px;
}

.btn-add {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 11px 22px; background: var(--d-blue); color: #fff;
    border-radius: 4px; font-weight: 600; font-size: 14px;
    text-decoration: none; transition: all 0.25s;
}
.btn-add:hover { background: var(--d-blue2); transform: translateY(-2px); color: #fff; text-decoration: none; }

.flash { padding: 12px 18px; border-radius: 6px; margin-bottom: 20px; font-size: 14px; font-weight: 500; }
.flash-success { background: rgba(39,174,96,0.1); border: 1px solid rgba(39,174,96,0.3); color: #1e8449; }
.flash-error   { background: rgba(231,76,60,0.1);  border: 1px solid rgba(231,76,60,0.3);  color: #c0392b; }

.table-card { background: #fff; border: 1px solid var(--d-border); border-radius: 8px; overflow: hidden; }
table { width: 100%; border-collapse: collapse; }
thead th {
    padding: 13px 20px; text-align: left;
    font-size: 11px; font-weight: 700; color: var(--d-muted);
    letter-spacing: 1.5px; text-transform: uppercase;
    background: #f9fafc; border-bottom: 1px solid var(--d-border);
}
tbody tr { border-bottom: 1px solid #f0f4f8; transition: background 0.15s; }
tbody tr:last-child { border-bottom: none; }
tbody tr:hover { background: #f9fafc; }
tbody td { padding: 14px 20px; font-size: 14px; color: var(--d-text); vertical-align: middle; }

.label-cell { display: flex; align-items: center; gap: 10px; }
.label-dot  { width: 10px; height: 10px; border-radius: 50%; background: var(--d-blue); flex-shrink: 0; }
.label-text { font-weight: 600; }

.nb-badge {
    display: inline-block; padding: 3px 10px;
    background: #f0f4f8; color: var(--d-muted);
    border-radius: 20px; font-size: 12px; font-weight: 600;
}
.nb-badge.has { background: rgba(26,111,196,0.1); color: var(--d-blue); }

.actions { display: flex; gap: 6px; }
.btn-action {
    display: inline-flex; align-items: center; justify-content: center;
    width: 32px; height: 32px; border-radius: 4px; font-size: 13px;
    text-decoration: none; transition: all 0.2s; border: none; cursor: pointer;
}
.btn-edit   { background: rgba(230,126,34,0.1); color: #e67e22; }
.btn-delete { background: rgba(231,76,60,0.1);  color: #e74c3c; }
.btn-edit:hover   { background: #e67e22; color: #fff; }
.btn-delete:hover { background: #e74c3c; color: #fff; }
.btn-delete:disabled { opacity: 0.4; cursor: not-allowed; }

.empty-state { text-align: center; padding: 60px; color: var(--d-muted); }
.empty-state i { font-size: 40px; display: block; margin-bottom: 12px; opacity: 0.25; }
.btn-add {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 24px;
    background: #27ae60; /* vert */
    color: #fff;
    border-radius: 6px;
    font-weight: 600;
    font-size: 14px;
    text-decoration: none;
    transition: all 0.25s ease;
    box-shadow: 0 4px 12px rgba(39, 174, 96, 0.25);
}

.btn-add:hover {
    background: #219150;
    transform: translateY(-2px);
    color: #fff;
    text-decoration: none;
    box-shadow: 0 6px 16px rgba(39, 174, 96, 0.35);
}
</style>
{% endblock %}

{% block body %}
<div class="admin-wrapper">

    {% for msg in app.flashes('success') %}
        <div class="flash flash-success"><i class="fa fa-check-circle"></i> {{ msg }}</div>
    {% endfor %}
    {% for msg in app.flashes('error') %}
        <div class="flash flash-error"><i class="fa fa-exclamation-circle"></i> {{ msg }}</div>
    {% endfor %}

    <div class="admin-header">
        <h1 class="admin-title">
            <i class="fa fa-tag" style="color:var(--d-blue);margin-right:8px;"></i>
            Catégories <span class="admin-badge">Admin</span>
        </h1>
        <a href="{{ path('admin_categorie_new') }}" class="btn-add">
            <i class="fa fa-plus"></i> Nouvelle catégorie
        </a>
    </div>

    <div class="table-card">
        {% if data is empty %}
            <div class="empty-state">
                <i class="fa fa-tag"></i>
                <p>Aucune catégorie enregistrée.</p>
            </div>
        {% else %}
            <table>
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Label</th>
                        <th>Dépenses liées</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in data %}
                    <tr>
                        <td style="color:var(--d-muted);font-size:12px;">{{ item.categorie.id }}</td>
                        <td>
                            <div class="label-cell">
                                <span class="label-dot"></span>
                                <span class="label-text">{{ item.categorie.label }}</span>
                            </div>
                        </td>
                        <td>
                            <span class="nb-badge {{ item.nbDepenses > 0 ? 'has' : '' }}">
                                {{ item.nbDepenses }} dépense{{ item.nbDepenses > 1 ? 's' : '' }}
                            </span>
                        </td>
                        <td>
                            <div class="actions">
                                <a href="{{ path('admin_categorie_edit', {id: item.categorie.id}) }}"
                                   class="btn-action btn-edit" title="Modifier">
                                    <i class="fa fa-pencil"></i>
                                </a>
                                <form method="post" action="{{ path('admin_categorie_delete', {id: item.categorie.id}) }}"
                                      onsubmit="return confirm('Supprimer « {{ item.categorie.label }} » ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_cat' ~ item.categorie.id) }}">
                                    <button type="submit" class="btn-action btn-delete"
                                            title="{{ item.nbDepenses > 0 ? 'Impossible : dépenses liées' : 'Supprimer' }}"
                                            {{ item.nbDepenses > 0 ? 'disabled' : '' }}>
                                        <i class="fa fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>

</div>
{% endblock %}
