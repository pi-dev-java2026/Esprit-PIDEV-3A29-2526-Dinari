{% extends 'admin/base.html.twig' %}

{% block title %}Liste des Offres{% endblock %}
{% block page_title %}Experts & Offres{% endblock %}
{% block section_title %}Offres de l'expert{% endblock %}

{% block stylesheets %}
<style>
    .offres-page {
        padding-top: 10px;
    }

    .offres-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 28px;
        flex-wrap: wrap;
        gap: 14px;
    }

    .offres-title {
        margin: 0;
        font-size: 2.1rem;
        font-weight: 800;
        color: #24364b;
    }

    .offres-subtitle {
        margin-top: 6px;
        color: #7a8a9a;
        font-size: 14px;
    }

    .offres-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 24px;
    }

    .offre-card {
        background: #fff;
        border: 1px solid #e7edf5;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(22, 34, 51, 0.06);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .offre-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 16px 40px rgba(22, 34, 51, 0.1);
    }

    .offre-top {
        padding: 22px 24px 12px;
        border-bottom: 1px solid #eef3f8;
        background: linear-gradient(135deg, #f8fbff, #eef5fc);
    }

    .offre-title {
        margin: 0;
        font-size: 1.25rem;
        font-weight: 800;
        color: #23384d;
    }

    .offre-badge {
        display: inline-block;
        margin-top: 10px;
        padding: 6px 12px;
        border-radius: 999px;
        background: rgba(26, 111, 196, 0.1);
        color: #1a6fc4;
        font-size: 12px;
        font-weight: 700;
    }

    .offre-body {
        padding: 22px 24px 18px;
    }

    .offre-info {
        display: grid;
        gap: 10px;
        margin-bottom: 14px;
    }

    .offre-info-item {
        display: flex;
        gap: 8px;
        font-size: 14px;
        color: #526274;
        line-height: 1.5;
    }

    .offre-info-item strong {
        color: #24364b;
        min-width: 70px;
    }

    .offre-description {
        padding: 14px 16px;
        border-radius: 14px;
        background: #f7f9fc;
        border: 1px solid #edf2f7;
        font-size: 14px;
        color: #5d6d7e;
        line-height: 1.6;
    }

    .offre-actions {
        padding: 0 24px 24px;
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .btn-custom {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 16px;
        border-radius: 10px;
        text-decoration: none;
        font-size: 14px;
        font-weight: 700;
        border: none;
        cursor: pointer;
        transition: 0.2s ease;
    }

    .btn-add {
        background: #1a6fc4;
        color: #fff;
    }

    .btn-add:hover {
        background: #155ca5;
        color: #fff;
    }

    .btn-edit {
        background: #f5b041;
        color: #fff;
    }

    .btn-edit:hover {
        background: #e29a21;
        color: #fff;
    }

    .btn-delete {
        background: #e74c3c;
        color: #fff;
    }

    .btn-delete:hover {
        background: #cb3d2e;
        color: #fff;
    }

    .btn-back {
        background: #eef3f8;
        color: #425466;
    }

    .btn-back:hover {
        background: #dfe8f1;
        color: #24364b;
    }

    .empty-state {
        background: #fff;
        border: 1px dashed #cfd9e6;
        border-radius: 18px;
        padding: 50px 24px;
        text-align: center;
        color: #718096;
    }

    .empty-state h3 {
        margin-bottom: 10px;
        color: #2d4055;
        font-size: 1.5rem;
    }

    .delete-form {
        display: inline;
        margin: 0;
    }
</style>
{% endblock %}

{% block body %}
{% if expert %}
    <p>Expert : {{ expert.nom }} {{ expert.prenom }}</p>
{% endif %}
<div class="offres-page">

    <div class="offres-header">
        <div>
            <h1 class="offres-title">Liste des Offres</h1>
            <div class="offres-subtitle">
                Gérez les offres liées à l’expert sélectionné.
            </div>
        </div>

        <a href="{{ path('app_offre_new', {'expert_id': expert_id}) }}" class="btn-custom btn-add">
            + Ajouter une Offre
        </a>
    </div>

    {% if offres|length > 0 %}
        <div class="offres-grid">
            {% for offre in offres %}
                <div class="offre-card">
                    <div class="offre-top">
                        <h2 class="offre-title">{{ offre.titre|replace({
    'budget_personnel': 'Gestion de budget personnel',
    'planification_financiere': 'Planification financière',
    'suivi_depenses': 'Suivi des dépenses',
    'audit_depenses': 'Audit des dépenses',
    'optimisation_fiscale': 'Optimisation fiscale',
    'conseil_investissement': 'Conseil en investissement',
    'analyse_financiere': 'Analyse financière',
    'plan_financier': 'Création de plan financier'
}) }}</h2>
                        <span class="offre-badge">Durée : {{ offre.duree }}</span>
                    </div>

                    <div class="offre-body">
                        <div class="offre-info">
                            <div class="offre-info-item">
                                <strong>Prix :</strong>
                                <span>{{ offre.prix }}</span>
                            </div>
                        </div>

                        <div class="offre-description">
                            <strong>Description :</strong><br>
                            {{ offre.description ?: 'Aucune description disponible.' }}
                        </div>
                    </div>

                    <div class="offre-actions">
                        <a href="{{ path('app_offre_edit', {'id': offre.id}) }}" class="btn-custom btn-edit">
                            Modifier
                        </a>

                        <form method="post"
                              action="{{ path('app_offre_delete', {'id': offre.id}) }}"
                              class="delete-form"
                              onsubmit="return confirm('Voulez-vous vraiment supprimer cette offre ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ offre.id) }}">
                            <button class="btn-custom btn-delete">Supprimer</button>
                        </form>

                        <a href="{{ path('app_expert_comptable_index') }}" class="btn-custom btn-back">
                            Retour Experts
                        </a>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="empty-state">
            <h3>Aucune offre trouvée</h3>
            <p>Cet expert n’a pas encore d’offres pour le moment.</p>
        </div>
    {% endif %}

</div>
{% endblock %}