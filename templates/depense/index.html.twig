{% extends 'base.html.twig' %}

{% block title %}Mes Dépenses — Dinari{% endblock %}

{% block stylesheets %}
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>

/* ─────────────────────────────────────────
   PAGE BACKGROUND  (only affects body when
   this page is active — scoped via wrapper)
───────────────────────────────────────── */
body {
    background: linear-gradient(145deg, #eaf2ff 0%, #f0f6ff 35%, #e8f4fd 65%, #f5f8ff 100%) !important;
    min-height: 100vh;
}

/* ─────────────────────────────────────────
   LAYOUT
───────────────────────────────────────── */
.page-wrapper {
    max-width: 1100px;
    margin: 0 auto;
    padding: 100px 30px 60px;
    font-family: 'Poppins', sans-serif;
}

/* ─────────────────────────────────────────
   PAGE HEADER
───────────────────────────────────────── */
.page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 32px;
    flex-wrap: wrap;
    gap: 16px;
}

.page-title {
    font-family: 'Poppins', sans-serif;
    font-size: 26px;
    font-weight: 700;
    color: #1e293b;
    letter-spacing: -0.3px;
}
.page-title span { color: #1a6fc4; }

/* ─────────────────────────────────────────
   ADD BUTTON  — premium blue gradient
───────────────────────────────────────── */
.btn-add {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 12px 26px;
    background: linear-gradient(135deg, #2563eb 0%, #1a6fc4 60%, #1558a0 100%);
    color: #fff;
    border-radius: 12px;
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: 14px;
    text-decoration: none;
    letter-spacing: 0.2px;
    box-shadow: 0 6px 20px rgba(26, 111, 196, 0.38);
    transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
}
.btn-add:hover {
    background: linear-gradient(135deg, #1d4ed8 0%, #1558a0 60%, #0f4080 100%);
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgba(26, 111, 196, 0.48);
    color: #fff;
    text-decoration: none;
}
.btn-add:active {
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(26, 111, 196, 0.35);
}

/* ── NAV SECONDARY BUTTON (outline blue) ── */
.btn-nav-secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 22px;
    background: rgba(255, 255, 255, 0.82);
    color: #1a6fc4;
    border: 1.5px solid rgba(26, 111, 196, 0.35);
    border-radius: 12px;
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: 14px;
    text-decoration: none;
    letter-spacing: 0.2px;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 3px 12px rgba(26, 111, 196, 0.10);
    transition: transform 0.25s ease, box-shadow 0.25s ease,
                background 0.25s ease, border-color 0.25s ease;
}
.btn-nav-secondary:hover {
    background: linear-gradient(135deg, #2563eb 0%, #1a6fc4 60%, #1558a0 100%);
    color: #fff;
    border-color: transparent;
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(26, 111, 196, 0.38);
    text-decoration: none;
}
.btn-nav-secondary:active {
    transform: translateY(-1px);
    box-shadow: 0 5px 14px rgba(26, 111, 196, 0.28);
}

/* ─────────────────────────────────────────
   FLASH MESSAGES
───────────────────────────────────────── */
.flash {
    padding: 13px 18px;
    border-radius: 10px;
    margin-bottom: 20px;
    font-size: 14px;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 10px;
}
.flash-success {
    background: rgba(39, 174, 96, 0.08);
    border: 1px solid rgba(39, 174, 96, 0.28);
    color: #166534;
}
.flash-error {
    background: rgba(231, 76, 60, 0.08);
    border: 1px solid rgba(231, 76, 60, 0.28);
    color: #991b1b;
}

/* ─────────────────────────────────────────
   HERO BANNER CARDS  (total + AI)
   — keep existing inline styles, just
     upgrade border-radius & shadow via
     a shared utility class added below
───────────────────────────────────────── */

/* ─────────────────────────────────────────
   STATS CARDS  — glassmorphism
───────────────────────────────────────── */
.stats-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    margin-bottom: 32px;
}

.stat-card {
    background: rgba(255, 255, 255, 0.78);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 18px;
    padding: 22px 22px 20px;
    box-shadow: 0 4px 18px rgba(26, 111, 196, 0.07);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    position: relative;
    overflow: hidden;
}
.stat-card::after {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, #2563eb, #60a5fa);
    border-radius: 18px 18px 0 0;
    opacity: 0;
    transition: opacity 0.3s;
}
.stat-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 14px 36px rgba(26, 111, 196, 0.13);
}
.stat-card:hover::after { opacity: 1; }

.stat-card-label {
    font-family: 'Poppins', sans-serif;
    font-size: 10.5px;
    font-weight: 600;
    color: #64748b;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    margin-bottom: 10px;
}
.stat-card-value {
    font-family: 'Poppins', sans-serif;
    font-size: 28px;
    font-weight: 800;
    color: #1e293b;
    letter-spacing: -0.5px;
    line-height: 1;
}
.stat-card-value.blue { color: #1a6fc4; font-size: 18px; font-weight: 700; }
.stat-card-value.green { color: #059669; font-size: 18px; font-weight: 700; }

/* ─────────────────────────────────────────
   TABLE CARD
───────────────────────────────────────── */
.table-card {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border: 1px solid rgba(255, 255, 255, 0.92);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(26, 111, 196, 0.09);
}

.table-card-header {
    padding: 20px 26px;
    border-bottom: 1px solid rgba(226, 232, 240, 0.7);
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(248, 250, 255, 0.6);
}
.table-card-header h3 {
    font-family: 'Poppins', sans-serif;
    font-size: 15px;
    font-weight: 700;
    color: #1e293b;
    margin: 0;
}

/* ─────────────────────────────────────────
   TABLE INTERNALS  (structure unchanged)
───────────────────────────────────────── */
table { width: 100%; border-collapse: collapse; }

thead th {
    padding: 13px 18px;
    text-align: left;
    font-family: 'Poppins', sans-serif;
    font-size: 10.5px;
    font-weight: 700;
    color: #64748b;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    background: rgba(241, 245, 249, 0.7);
    border-bottom: 1px solid rgba(226, 232, 240, 0.8);
}

tbody tr {
    border-bottom: 1px solid rgba(241, 245, 249, 0.9);
    transition: background 0.18s ease;
}
tbody tr:last-child { border-bottom: none; }
tbody tr:hover { background: rgba(37, 99, 235, 0.03); }

tbody td {
    padding: 14px 18px;
    font-family: 'Poppins', sans-serif;
    font-size: 13.5px;
    color: #1e293b;
    vertical-align: middle;
}

/* ─────────────────────────────────────────
   BADGES
───────────────────────────────────────── */
.badge-categorie {
    display: inline-block;
    padding: 4px 11px;
    border-radius: 20px;
    font-family: 'Poppins', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.3px;
    text-transform: uppercase;
}
.badge-loyer      { background: rgba(231,76,60,0.1);   color: #c0392b; }
.badge-nourriture { background: rgba(39,174,96,0.1);   color: #1e8449; }
.badge-transport  { background: rgba(52,152,219,0.1);  color: #1a5276; }
.badge-internet   { background: rgba(155,89,182,0.1);  color: #6c3483; }
.badge-loisirs    { background: rgba(243,156,18,0.1);  color: #9a7d0a; }
.badge-autre      { background: rgba(127,140,141,0.1); color: #5a6e84; }

.badge-paiement {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: 'Poppins', sans-serif;
    font-size: 12.5px;
    color: #64748b;
}

.montant-cell {
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: 14.5px;
    color: #1e293b;
    letter-spacing: -0.2px;
}

/* ─────────────────────────────────────────
   ACTION BUTTONS
───────────────────────────────────────── */
.actions { display: flex; gap: 6px; align-items: center; }

.btn-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px; height: 32px;
    border-radius: 8px;
    font-size: 13px;
    text-decoration: none;
    transition: all 0.22s ease;
    border: none;
    cursor: pointer;
}
.btn-show   { background: rgba(26,111,196,0.1);  color: #1a6fc4; }
.btn-edit   { background: rgba(243,156,18,0.1);  color: #e67e22; }
.btn-delete { background: rgba(231,76,60,0.1);   color: #e74c3c; }
.btn-show:hover   { background: #2563eb; color: #fff; transform: scale(1.08); box-shadow: 0 4px 12px rgba(37,99,235,0.3); }
.btn-edit:hover   { background: #e67e22; color: #fff; transform: scale(1.08); box-shadow: 0 4px 12px rgba(230,126,34,0.3); }
.btn-delete:hover { background: #e74c3c; color: #fff; transform: scale(1.08); box-shadow: 0 4px 12px rgba(231,76,60,0.3); }

/* ─────────────────────────────────────────
   JUSTIFICATIF BUTTONS
───────────────────────────────────────── */
.btn-justif {
    display: inline-flex; align-items: center; justify-content: center;
    width: 32px; height: 32px; border-radius: 8px; font-size: 13px;
    text-decoration: none; transition: all 0.22s ease; border: none; cursor: pointer;
}
.btn-justif-list { background: rgba(39,174,96,0.1); color: #27ae60; position: relative; }
.btn-justif-add  { background: rgba(155,89,182,0.1); color: #8e44ad; }
.btn-justif-list:hover { background: #27ae60; color: #fff; transform: scale(1.08); box-shadow: 0 4px 12px rgba(39,174,96,0.3); }
.btn-justif-add:hover  { background: #8e44ad; color: #fff; transform: scale(1.08); }

.justif-count {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 17px; height: 17px; border-radius: 20px;
    background: #27ae60; color: #fff;
    font-size: 9px; font-weight: 700;
    position: absolute; top: -4px; right: -4px;
    box-shadow: 0 2px 6px rgba(39,174,96,0.4);
}

/* ─────────────────────────────────────────
   EMPTY STATE
───────────────────────────────────────── */
.empty-state {
    text-align: center;
    padding: 64px 20px;
    color: #64748b;
}
.empty-state i { font-size: 48px; margin-bottom: 16px; opacity: 0.25; display: block; }
.empty-state p { font-family: 'Poppins', sans-serif; font-size: 15px; }

/* ─────────────────────────────────────────
   FILTER FORM  (unchanged structure)
───────────────────────────────────────── */
.filter-form { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
.filter-form select,
.filter-form input {
    padding: 8px 12px;
    border: 1.5px solid #e2e8f0;
    border-radius: 8px;
    font-size: 13px;
    color: #1e293b;
    outline: none;
    transition: border-color 0.2s;
    font-family: 'Poppins', sans-serif;
    background: #fff;
}
.filter-form select:focus,
.filter-form input:focus { border-color: #1a6fc4; }
.btn-filter {
    padding: 8px 16px;
    background: #f1f5f9;
    border: 1.5px solid #e2e8f0;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    color: #1e293b;
    cursor: pointer;
    transition: all 0.2s;
    font-family: 'Poppins', sans-serif;
}
.btn-filter:hover { background: #e2e8f0; }

/* ─────────────────────────────────────────
   RESPONSIVE
───────────────────────────────────────── */
@media(max-width: 768px) {
    .stats-row { grid-template-columns: repeat(2, 1fr); }
    .page-header { flex-direction: column; align-items: flex-start; }
    table { font-size: 13px; }
    thead th, tbody td { padding: 10px 12px; }
}
@media(max-width: 480px) {
    .page-wrapper { padding: 90px 16px 48px; }
    .stats-row { grid-template-columns: 1fr 1fr; gap: 12px; }
}
</style>
{% endblock %}

{% block body %}
<div class="page-wrapper">

    {# Flash messages #}
    {% for msg in app.flashes('success') %}
        <div class="flash flash-success"><i class="fa fa-check-circle"></i> {{ msg }}</div>
    {% endfor %}
    {% for msg in app.flashes('error') %}
        <div class="flash flash-error"><i class="fa fa-exclamation-circle"></i> {{ msg }}</div>
    {% endfor %}

    {# En-tête #}
    <div class="page-header">
        <h1 class="page-title">Mes <span>Dépenses</span></h1>
        <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap;">
            <a href="{{ path('budget_index') }}" class="btn-nav-secondary">
                <i class="fa fa-bar-chart"></i> Voir Budget
            </a>
            <a href="{{ path('historique_index') }}" class="btn-nav-secondary">
                <i class="fa fa-history"></i> Historique
            </a>
            <a href="{{ path('depense_new') }}" class="btn-add">
                <i class="fa fa-plus"></i> Ajouter une dépense
            </a>
        </div>
    </div>

    {# Stats #}
    {% set total = totalMontant %}

    {# Total card — prominent #}
    <div style="
        background: linear-gradient(135deg, #1a6fc4 0%, #1558a0 100%);
        border-radius: 10px;
        padding: 22px 28px;
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 20px;
        box-shadow: 0 6px 24px rgba(26,111,196,0.25);
    ">
        <div style="
            width: 56px; height: 56px;
            background: rgba(255,255,255,0.15);
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: 26px; flex-shrink: 0;
        ">💰</div>
        <div>
            <div style="font-size: 12px; font-weight: 700; color: rgba(255,255,255,0.65);
                        letter-spacing: 2px; text-transform: uppercase; margin-bottom: 4px;">
                Total dépensé
            </div>
            <div style="font-size: 32px; font-weight: 800; color: #fff; line-height: 1;">
                {{ totalMontant|number_format(2, ',', ' ') }} <span style="font-size:18px;font-weight:500;opacity:0.8;">TND</span>
            </div>
        </div>
        <div style="margin-left: auto; text-align: right;">
            <div style="font-size: 12px; color: rgba(255,255,255,0.55); margin-bottom: 4px;">Sur {{ depenses|length }} dépense{{ depenses|length != 1 ? 's' : '' }}</div>
            <div style="font-size: 13px; color: rgba(255,255,255,0.8); font-weight: 600;">
                Moy. {{ depenses|length > 0 ? (totalMontant / depenses|length)|number_format(2, ',', ' ') : '0,00' }} TND / dépense
            </div>
        </div>
    </div>



    {% if prediction %}
<div style="
    background: linear-gradient(135deg, #16a085 0%, #0e7c66 100%);
    border-radius: 10px;
    padding: 22px 28px;
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 20px;
    box-shadow: 0 6px 24px rgba(22,160,133,0.25);
">
    <div style="
        width: 56px; height: 56px;
        background: rgba(255,255,255,0.15);
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 26px;
    ">🤖</div>

    <div>
        <div style="
            font-size: 12px;
            font-weight: 700;
            color: rgba(255,255,255,0.65);
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: 4px;
        ">
            Prévision IA
        </div>

        <div style="
            font-size: 32px;
            font-weight: 800;
            color: #fff;
            line-height: 1;
        ">
            {{ prediction|number_format(2, ',', ' ') }}
            <span style="font-size:18px;font-weight:500;opacity:0.8;">TND</span>
        </div>
    </div>

    <div style="margin-left:auto; text-align:right;">
        <div style="font-size:12px;color:rgba(255,255,255,0.6);">
            Mois prochain
        </div>
        <div style="font-size:13px;color:rgba(255,255,255,0.85);font-weight:600;">
            Estimation basée sur IA
        </div>
    </div>
</div>
{% endif %}

    <div class="stats-row">
        <div class="stat-card">
            <div class="stat-card-label">Nombre</div>
            <div class="stat-card-value">{{ depenses|length }}</div>
        </div>
        <div class="stat-card">
            <div class="stat-card-label">Catégories utilisées</div>
            <div class="stat-card-value">{{ stats|length }}</div>
        </div>
        {% if stats|length > 0 %}
        <div class="stat-card">
            <div class="stat-card-label">Top catégorie</div>
            <div class="stat-card-value blue" style="font-size:18px;">{{ stats[0].categorie }}</div>
        </div>
        <div class="stat-card">
            <div class="stat-card-label">Dépense top catégorie</div>
            <div class="stat-card-value green">{{ stats[0].total|number_format(2, ',', ' ') }} TND</div>
        </div>
        {% else %}
        <div class="stat-card">
            <div class="stat-card-label">Top catégorie</div>
            <div class="stat-card-value">—</div>
        </div>
        <div class="stat-card">
            <div class="stat-card-label">Moyenne / dépense</div>
            <div class="stat-card-value green">0,00 TND</div>
        </div>
        {% endif %}
    </div>

    {# Table #}
    <div class="table-card">
        <div class="table-card-header">
            <h3><i class="fa fa-list" style="color:var(--d-blue);margin-right:8px;"></i>Liste des dépenses</h3>
          
        </div>

        {% if depenses is empty %}
            <div class="empty-state">
                <i class="fa fa-inbox"></i>
                <p>Aucune dépense enregistrée pour le moment.</p>
            </div>
        {% else %}
            <table>
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Date</th>
                        <th>Description</th>
                        <th>Catégorie</th>
                        <th>Mode paiement</th>
                        <th>Montant</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
    {% for depense in depenses %}
    <tr>
        <td style="color:var(--d-muted);font-size:12px;">{{ depense.id }}</td>
        <td>{{ depense.dateDepense|date('d/m/Y') }}</td>
        <td>{{ depense.description ?: '—' }}</td>
        <td>
            <span class="badge-categorie badge-{{ depense.categorie|lower }}">
                {{ depense.categorie }}
            </span>
        </td>
        <td>
            <span class="badge-paiement">
                {% if depense.modePaiement == 'Carte bancaire' %}
                    <i class="fa fa-credit-card"></i>
                {% elseif depense.modePaiement == 'Virement' %}
                    <i class="fa fa-exchange"></i>
                {% else %}
                    <i class="fa fa-money"></i>
                {% endif %}
                {{ depense.modePaiement }}
            </span>
        </td>
        <td class="montant-cell">{{ depense.montant|number_format(0, ',', ' ') }} DT</td>
        <td>
            <div class="actions">
                {# Voir détail #}
                <a href="{{ path('depense_show', {id: depense.id}) }}"
                   class="btn-action btn-show" title="Voir">
                    <i class="fa fa-eye"></i>
                </a>

                {# Modifier #}
                <a href="{{ path('depense_edit', {id: depense.id}) }}"
                   class="btn-action btn-edit" title="Modifier">
                    <i class="fa fa-pencil"></i>
                </a>

                {# Justificatifs (liste) #}
                <a href="{{ path('justificatif_list', {id: depense.id}) }}"
                   class="btn-justif btn-justif-list"
                   title="Voir les justificatifs ({{ depense.justificatifs|length }})">
                    <i class="fa fa-paperclip"></i>
                    {% if depense.justificatifs|length > 0 %}
                        <span class="justif-count">{{ depense.justificatifs|length }}</span>
                    {% endif %}
                </a>

              

                {# Supprimer #}
                <form method="post" action="{{ path('depense_delete', {id: depense.id}) }}"
                      onsubmit="return confirm('Supprimer cette dépense et ses justificatifs ?');"
                      style="display:inline;">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ depense.id) }}">
                    <button type="submit" class="btn-action btn-delete" title="Supprimer">
                        <i class="fa fa-trash"></i>
                    </button>
                </form>
            </div>
        </td>
    </tr>
    {% endfor %}
</tbody>

            </table>
        {% endif %}
    </div>

</div>
{% endblock %}

{% block javascripts %}
<script>
/* ── STAT CARD NUMBER COUNT-UP ── */
(function () {
    function easeOutQuart(t) { return 1 - Math.pow(1 - t, 4); }

    function countUp(el) {
        const raw    = el.textContent.replace(/\s/g, '').replace(',', '.').replace(/[^\d.]/g, '');
        const target = parseFloat(raw);
        if (isNaN(target) || target === 0) return;

        const isFloat  = el.textContent.includes(',');
        const duration = 1100;
        const start    = performance.now();

        function tick(now) {
            const progress = Math.min((now - start) / duration, 1);
            const current  = target * easeOutQuart(progress);
            el.textContent = isFloat
                ? current.toFixed(2).replace('.', ',')
                : Math.round(current).toLocaleString('fr-FR');
            if (progress < 1) requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);
    }

    const io = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                countUp(entry.target);
                io.unobserve(entry.target);
            }
        });
    }, { threshold: 0.4 });

    document.querySelectorAll('.stat-card-value').forEach(el => {
        const t = el.textContent.trim();
        if (/^[\d\s,.']+$/.test(t.replace(/[^\d,.\s]/g, '')) && t !== '—' && /\d/.test(t)) {
            io.observe(el);
        }
    });
})();

/* ── TABLE ROWS STAGGER FADE-IN ── */
(function () {
    document.querySelectorAll('tbody tr').forEach((row, i) => {
        row.style.cssText += 'opacity:0;transform:translateY(8px);transition:opacity 0.32s ease,transform 0.32s ease;';
        setTimeout(() => {
            row.style.opacity  = '1';
            row.style.transform = 'translateY(0)';
        }, 60 + i * 35);
    });
})();
</script>
{% endblock %}
